+function phoneImageTaskResult(result,task,mode) {
+  const text=String(result||'').trim().replace(/^```(?:json)?\s*|\s*```$/gi,'');
+  if (!text) throw Error('没有收到生图提示词。');
+  const wrapped=text.match(/<(PORTRAIT_JSON|WARDROBE_PROMPTS_JSON|ITEM_OVERVIEW_JSON)>([\s\S]+?)<\/\1>/i)?.[2];
+  const json=wrapped||text;
+  let parsed;
+  try {parsed=JSON.parse(json);}
+  catch {
+    const i=json.indexOf('{'),j=json.lastIndexOf('}');
+    if (i>=0&&j>i) {
+      try {parsed=JSON.parse(json.slice(i,j+1));} catch { /* A plain positive prompt is also accepted. */ }
+    }
+  }
+  const first=Array.isArray(parsed?.prompts)?parsed.prompts[0]:null;
+  const words=(Array.isArray(first?.tags)?first.tags:Array.isArray(parsed?.tags)?parsed.tags:[]);
+  let prompt=parsed?.prompt||first?.prompt||words.filter(w=>typeof w==='string').join(', ');
+  if (!prompt&&Array.isArray(parsed?.characters)) {
+    const characters=parsed.characters.filter(item=>item&&typeof item==='object');
+    prompt=[parsed.composition,...characters.flatMap(item=>[item.traits,item.outfit,item.action,item.interaction]),
+      parsed.entities,parsed.background].flat().filter(word=>typeof word==='string'&&word.trim()).join(mode==='zh'?'，':', ');
+  }
+  if (!prompt&&!parsed) {
+    const story=text.match(/image###\s*([\s\S]+?)###/i)?.[1];
+    prompt=story?story.split('\n').filter(line=>!/^\s*Character \d+ UC:/i.test(line))
+      .map(line=>line.replace(/^\s*(?:Scene Composition|Character \d+ Prompt):\s*/i,'')
+        .replace(/\|centers:[a-z]\d+\s*;?$/i,'').replace(/;$/,'').trim()).filter(Boolean).join(', ')
+      :text.startsWith('{')||text.startsWith('<')?'':text;
+  }
+  if (typeof prompt!=='string'||!prompt.trim()) throw Error('未读到正向提示词，可重试或手动填写。');
+  if (phoneGarmentTasks.includes(task)) {
+    const guard=mode==='zh'?'服装商品照，完整衣物平铺，纯净背景，无人物、无模特、无人体展示架。':
+      mode==='en'?'Garment product photography, flat lay, plain background, no person, no mannequin.':
+        'clothes focus, no humans, flat lay, simple background';
+    prompt=guard+' '+prompt.trim();
+  }
+  return prompt.trim();
+}
