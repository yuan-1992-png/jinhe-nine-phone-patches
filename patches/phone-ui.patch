+function safePhoneComfy(value) {
+  return {
+    base:typeof value?.base==='string'&&value.base.trim()?value.base.trim().slice(0,500):comfyDefaultBase,
+    model:typeof value?.model==='string'?value.model.trim().slice(0,240):'',
+    workflow:typeof value?.workflow==='string'?value.workflow.slice(0,comfyWorkflowLimit):'',
+    wardrobeWorkflow:typeof value?.wardrobeWorkflow==='string'?value.wardrobeWorkflow.slice(0,comfyWorkflowLimit):'',
+    selfieWorkflow:typeof value?.selfieWorkflow==='string'?value.selfieWorkflow.slice(0,comfyWorkflowLimit):'',
+  };
+}
+function phoneComfyWorkflow(raw) {
+  if (typeof raw!=='string'||raw.length>comfyWorkflowLimit) throw Error('请填写不超过 200 KB 的 API 工作流 JSON。');
+  let graph;
+  try {graph=JSON.parse(raw.trim().replace(/^\uFEFF/,''));}
+  catch {throw Error('ComfyUI 工作流 JSON 无法解析，占位符需要放在引号里。');}
+  const isObject=value=>value&&typeof value==='object'&&!Array.isArray(value);
+  if (isObject(graph?.workflow)) graph=graph.workflow;
+  if (isObject(graph?.prompt)) graph=graph.prompt;
+  if (!isObject(graph)||!Object.keys(graph).length||
+      !Object.values(graph).every(node=>isObject(node)&&typeof node.class_type==='string'&&isObject(node.inputs))) {
+    throw Error('请使用 ComfyUI 的 API 格式导出工作流，或从柏宝绘、瑟瑟状态栏复制工作流 JSON。');
+  }
+  return graph;
+}
+function renderPhoneComfyWorkflow(raw,prompt,config,kind) {
+  const graph=phoneComfyWorkflow(raw);
+  const {width,height}=imageDimensions(config,kind);
+  const opts=safeImageGeneration(config.generation);
+  const model=safePhoneComfy(config.comfy).model;
+  const sampler=opts.sampler||'euler';
+  const cfg=Number(opts.guidance)||7;
+  const replacements={
+    prompt,positive_prompt:prompt,nl:prompt,negative_prompt:opts.negative,width,height,
+    seed:opts.seed===''?Math.floor(Math.random()*2**53):imageNumber(opts.seed,'种子',0,Number.MAX_SAFE_INTEGER,true),
+    steps:Number(opts.steps)||24,cfg,scale:cfg,sampler,sampler_name:sampler,scheduler:'normal',
+    model,model_name:model,ckpt_name:model,unet_name:model,denoise:1,
+  };
+  let bound=false;
+  const fill=value=>{
+    if (Array.isArray(value)) return value.map(fill);
+    if (value&&typeof value==='object') return Object.fromEntries(Object.entries(value).map(([k,v])=>[k,fill(v)]));
+    if (typeof value!=='string') return value;
+    const take=(marker,name)=>{
+      name=name.toLowerCase();
+      if (!Object.hasOwn(replacements,name)) throw Error('工作流未配置 '+marker+'，请在 JSON 里填实际值。');
+      if (['prompt','positive_prompt','nl'].includes(name)) bound=true;
+      if (replacements[name]===''&&['model','model_name','ckpt_name','unet_name'].includes(name)) {
+        throw Error('请选择 ComfyUI 模型文件，或在工作流里填入实际文件名。');
+      }
+      return replacements[name];
+    };
+    const exact=value.match(/^%([a-z][a-z0-9_]*)%$/i);
+    return exact?take(...exact):value.replace(/%([a-z][a-z0-9_]*)%/gi,take);
+  };
+  for (const node of Object.values(graph)) node.inputs=fill(node.inputs);
+  if (!bound) {
+    // Find the text node directly feeding positive conditioning in common API exports.
+    const inputs=new Set(Object.values(graph).map(node=>node.inputs.positive)
+      .filter(Array.isArray).map(([id])=>graph[id]?.inputs).filter(input=>typeof input?.text==='string'));
+    if (inputs.size!==1) throw Error('工作流的正向提示词位置不明确，请在对应节点中写 "%prompt%"。');
+    inputs.values().next().value.text=prompt;
+  }
