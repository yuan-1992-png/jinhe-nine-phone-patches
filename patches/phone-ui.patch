inputs\": {\n      \"lora_name\": \"krea2文生模型\\\\真实场景Garland_Photography_V1.safetensors\",\n      \"strength_model\": 0.85,\n      \"model\": [\n        \"1\",\n        0\n      ]\n    }\n  }\n}","selfie":"{\n  \"1\": {\n    \"class_type\": \"UNETLoader\",\n    \"inputs\": {\n      \"unet_name\": \"krea2文生模型\\\\Krea2-TurboNSWAIO_v10_fp8.safetensors\",\n      \"weight_dtype\": \"default\"\n    }\n  },\n  \"2\": {\n    \"class_type\": \"CLIPLoader\",\n    \"inputs\": {\n      \"clip_name\": \"qwen3vl_4b_fp8_scaled.safetensors\",\n      \"type\": \"krea2\",\n      \"device\": \"default\"\n    }\n  },\n  \"3\": {\n    \"class_type\": \"VAELoader\",\n    \"inputs\": {\n      \"vae_name\": \"qwen_image_vae.safetensors\"\n    }\n  },\n  \"4\": {\n    \"class_type\": \"CLIPTextEncode\",\n    \"inputs\": {\n      \"text\": \"%prompt%\",\n      \"clip\": [\n        \"2\",\n        0\n      ]\n    }\n  },\n  \"5\": {\n    \"class_type\": \"ConditioningZeroOut\",\n    \"inputs\": {\n      \"conditioning\": [\n        \"4\",\n        0\n      ]\n    }\n  },\n  \"6\": {\n    \"class_type\": \"EmptyLatentImage\",\n    \"inputs\": {\n      \"width\": \"%width%\",\n      \"height\": \"%height%\",\n      \"batch_size\": 1\n    }\n  },\n  \"7\": {\n    \"class_type\": \"KSampler\",\n    \"inputs\": {\n      \"seed\": \"%seed%\",\n      \"steps\": 10,\n      \"cfg\": 1,\n      \"sampler_name\": \"euler\",\n      \"scheduler\": \"simple\",\n      \"denoise\": 1,\n      \"model\": [\n        \"11\",\n        0\n      ],\n      \"positive\": [\n        \"4\",\n        0\n      ],\n      \"negative\": [\n        \"5\",\n        0\n      ],\n      \"latent_image\": [\n        \"6\",\n        0\n      ]\n    }\n  },\n  \"8\": {\n    \"class_type\": \"VAEDecode\",\n    \"inputs\": {\n      \"samples\": [\n        \"7\",\n        0\n      ],\n      \"vae\": [\n        \"3\",\n        0\n      ]\n    }\n  },\n  \"9\": {\n    \"class_type\": \"SaveImage\",\n    \"inputs\": {\n      \"images\": [