n.method==='generate'?'txt2img':'img2img');\n    const bare={...config,base:(config.base||'').replace(/\\/sdapi\\/v1\\/(?:txt2img|img2img)\\/?$/,'')};\n    url=bareRoute(bare,fallback,/\\/sdapi\\/v1\\/(?:txt2img|img2img)$/,path);\n  } else if (config.provider==='novel') {\n    url=bareRoute(config,fallback,/\\/ai\\/generate-image$/,'/ai/generate-image');\n  } else {\n    url=baseRoute(config,fallback,config.provider,'/images/generations');\n  }\n  const response=await apiFetch(url,headers,body,150000);\n  return {...await decodeImageResponse(response,config.provider),generation};\n}\n// 柏宝绘的桥只存在于随卡版手机里：它由酒馆那一层调用扩展，页面这一层只递提示词。\nfunction baiBaiBridge() {\n  const bridge=globalThis.frameElement?.jinhePhoneBridge;\n  if (typeof bridge?.generateBaiBai!=='function') {\n    throw Error('「柏宝绘 · 本地 ComfyUI」要在装了柏宝绘的酒馆里打开九号机才能用。');\n  }\n  return bridge;\n}\n// 画幅交给柏宝绘的工作流；玩家在「自定义尺寸」里选的不传，免得和扩展的工作流打架。\nasync function requestBaiBaiImage(config,prompt,kind) {\n  const options=safeImageGeneration(config.generation);\n  const size=['portrait','square','landscape'].includes(options.frame)?options.frame:undefined;\n  const result=await baiBaiBridge().generateBaiBai({prompt,...(size?{size}:{})});\n  const address=typeof result==='string'?result:result?.dataUrl||result?.url||result?.path;\n  if (typeof address!=='string'||!address.trim()) throw Error('柏宝绘没有返回可读取的图片。');\n  const target=address.trim();\n  if (!/^(?:https?:|data:|\\/)/i.test(target)) {\n    throw Error('图已生成并留在柏宝绘图库（'+target+'）。这一版还不能直接取回这张图，可先在柏宝绘里查看。');\n  }\n  return downloadImage(target);\n}\nasync function decodeImageResponse(response,provider) {\n  if (provider==='novel') {\n    const blob=await response.blob();\n    if (blob.size>36_000_000) throw Error('NovelAI 图片包太大');\n    return {blob:await unpackNovel(new Uint8Array(await blob.arrayBuffer()))};\n  }\n  if (response.headers.get('content-type')?.toLowerCase().startsWith('image/')) return {blob:await readImageBlob(response)};\n  const data=await jsonResponse(response);\n  const item=data.data?.[0] || data.images?.[0];\n  if (typeof item==='string') return /^https?:|^data:/i.test(item) ? downloadImage(item) : {blob:pictureBlob(decodeBytes(item))};\n  if (typeof item?.b64_json==='string') return {blob:pictureBlob(decodeBytes(item.b64_json))};\n  if (typeof item?.url==='string') return downloadImage(item.url);\n  throw Error('画图接口没有返回可识别的图片');\n}\nfunction saveSettings(form) {\n  const kind=form.dataset.kind, config=getConfig(form);\n  const directChat=kind==='chat' && (config.forward==='self'||config.forward==='relay');\n  const baibai=kind==='image' && config.provider==='baibai';\n  const comfy=kind==='image' && config.provider==='comfy';\n  if ((directChat || kind==='image') && config.base) parseBase(config);\n  if ((directChat && config.live) || (kind==='image' && config.auto && !baibai && !comfy)) {\n    requireConfig({...config,model:config.model||(kind==='image'?imageDefaults[config.provider]?.[1]:'')},\n      !(kind==='image'&&config.provider==='sd'));\n  }\n  if (comfy) for (const use of comfyUses) {\n    const raw=config.comfy[use.workflow];\n    if (!raw) continue;\n    try {phoneComfyWorkflow(raw);}\n    catch(error) {throw Error(use.label+'工作流无法保存 · '+error.message);}\n  }\n  // 代发虽然由酒馆发出，地址和模型仍是手机这边填的，落盘前先确认填全了。\n  if (config.forward==='relay') {\n    if (!config.base && !config.key) throw Error('请先填写接口地址或密钥');\n    if (!config.model) throw Error('请填写模型 ID，或先拉取模型列表。');\n  }\n  settings[kind]=config;\n  persistPhoneApiSettings(settings);\n  save();render();\n  apiStatus(kind,'设置已保存。',$('settings-form'));\n}\nasync function handleNetworkButton(button,action) {\n  const form=button.closest('form'), kind=form.dataset.kind;\n  if (!form.reportValidity()) return;\n  const config=getConfig(form), started=performance.now(), index=opening;\n  button.disabled=true;\n  apiStatus(kind,action==='image'?'正在生成测试图…':'正在请求接口…',form);\n  try {\n    if (action==='models') {\n      // 代发的模型清单由酒馆后端去问接口，直连才在这里自己发请求。\n      const mode