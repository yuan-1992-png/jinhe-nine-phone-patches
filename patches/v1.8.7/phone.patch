;\n  if (!models?.length) throw Error('接口没有提供模型列表，可以手动填写模型 ID');\n  return [...new Set(models)].sort();\n}\nfunction decodeBytes(base64) {\n  if (base64.length > 48_000_000) throw Error('生成的图片太大，无法放进原型相册');\n  try {return Uint8Array.fromBase64 ? Uint8Array.fromBase64(base64) : Uint8Array.from(atob(base64),ch=>ch.charCodeAt(0));}\n  catch {throw Error('接口返回的图片数据损坏');}\n}\nfunction pictureBlob(bytes, invalidMessage='接口返回的内容不是 PNG、JPEG、WebP 或 AVIF 图片') {\n  const prefix = String.fromCharCode(...bytes.subarray(0,16));\n  const type = prefix.startsWith('\\x89PNG\\r\\n\\x1a\\n') ? 'image/png' : prefix.startsWith('\\xff\\xd8\\xff') ? 'image/jpeg' :\n    prefix.startsWith('RIFF') && prefix.slice(8,12)==='WEBP' ? 'image/webp' : prefix.slice(4,12)==='ftypavif' ? 'image/avif' : '';\n  if (!type) throw Error(invalidMessage);\n  return new Blob([bytes],{type});\n}\nfunction remotePhotoURL(address) {\n  if (typeof address!=='string' || !address.trim()) return '';\n  try { return parseBase({base:address}).href; } catch { return ''; }\n}\nfunction imageLinkError(remoteURL,message) {\n  return Object.assign(new Error(message),{remoteURL});\n}\nfunction setImageStatus(target,message,address) {\n  if (!target) return;\n  target.textContent=message;\n  const url=remotePhotoURL(address);\n  if (url) {\n    const button=document.createElement('button');\n    button.type='button';\n    button.className='btn';\n    button.dataset.do='open-original-image';\n    button.dataset.url=url;\n    button.textContent='打开原图';\n    target.append(' ',button);\n  }\n}\nfunction showImageError(target,error) {\n  setImageStatus(target,error.message,error.remoteURL);\n}\nasync function readImageBlob(response) {\n  const blob=await response.blob();\n  if (blob.size>36_000_000) throw Error('生成的图片太大，无法放进相册');\n  return pictureBlob(new Uint8Array(await blob.arrayBuffer()));\n}\nfunction canPreviewImage(url) {\n  return new Promise(resolve=>{\n    const image=new Image();\n    const finish=available=>{\n      c