s = new Map(source.places.map(place => [place.id, place]));\n// 自建地点：玩家自己往地图里补的地方。存在浏览器里，不写酒馆存档，\n// 所以换聊天、换开场都还在；点按所在片区自动生成，之后可以点地图微调。\nconst customPlaceKey = 'jinhe-phone-custom-places-v1';\nconst CUSTOM_PLACE_LIMIT = 40;\nconst validCustomPlace = place => Boolean(place) &&\n  typeof place.id === 'string' && /^custom_[a-z0-9-]{1,64}$/.test(place.id) &&\n  typeof place.name === 'string' && place.name.trim().length > 0 && place.name.length \u003c= 16 &&\n  Object.hasOwn(source.zones, place.zone) &&\n  Number.isFinite(place.x) && Number.isFinite(place.y) &&\n  place.x >= 0 && place.x \u003c= 100 && place.y >= 0 && place.y \u003c= 100;\nlet customPlaces = [];\ntry {\n  const stored = JSON.parse(localStorage.getItem(customPlaceKey) || '[]');\n  customPlaces = (Array.isArray(stored) ? stored : []).filter(validCustomPlace).slice(0, CUSTOM_PLACE_LIMIT)\n    .map(place => ({...place, custom:true, area:source.zones[place.zone],\n      aliases:Array.isArray(place.aliases) ? place.aliases.slice(0, 8) : []}));\n} catch {}\nfor (const place of customPlaces) places.set(place.id, place);\nconst allPlaces = () => source.places.concat(customPlaces);\nfunction saveCustomPlaces() {\n  try { localStorage.setItem(customPlaceKey, JSON.stringify(customPlaces)); }\n  catch { notify('浏览器没能保存自建地点，刷新后可能会丢。'); }\n}\nconst maxMonthlyRent = Math.max(...Object.values(source.assetTypes).flatMap(offer => offer.max ?? []));\nconst esc = value => String(value ?? '').replace(/[&\u003c>\"']/g, ch => ({'&':'&amp;','\u003c':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[ch]));\nconst money = value => '¥' + Number(value).toLocaleString('zh-CN', {maximumFractionDigits:2});\nconst uid = () => crypto.randomUUID?.() || Date.now().toString(36) + Math.random().toString(36).slice(2);\nconst jinheBridge=window.frameElement?.jinhePhoneBridge||null;\nconst storeKey=jinheBridge?.storageKey||'jinhe-phone-v142-design-2';\nconst imageDefaults = {\n  openai:['https://api.openai.com','gpt-image-1'],\n  silicon:['https://api.siliconflow.cn',''],\n  sd:['http://127.0.0.1:7860',''],\n  novel:['https://image.novelai.net','nai-diffusion-4-5-full'],\n  baibai:['',''],\n  comfy:['','']\n};\nconst novelModelChoices = [\n  ['nai-diffusion-4-5-full','V4.5 Full'],\n  ['nai-diffusion-4-5-curated','V4.5 Curated'],\n  ['nai-diffusion-4-full','V4 Full'],\n  ['nai-diffusion-4-curated-preview','V4 Curated'],\n  ['nai-diffusion-3','V3']\n];\nconst chatDefaults = {openai:'https://api.openai.com',claude:'https://api.anthropic.com',gemini:'https://generativelanguage.googleapis.com'};\n// JINHE_IMAGE_OPTIONS\nconst imageFrames = [\n  ['auto','按用途 · 小图'],['portrait','竖图'],['square','方图'],['landscape','横图'],['custom','自定义尺寸']\n];\nconst imageGenerationDefaults = {\n  frame:'auto',width:512,height:512,steps:24,guidance:'',seed:'',sampler:'',negative:'',quality:'',noise:'karras'\n};\nconst imageSmallSizes={portrait:[512,768],square:[512,512],landscape:[768,512]};\nconst imageSceneFrames={portrait:'portrait',selfie:'portrait',wardrobe:'portrait',moment:'square','live-cover':'landscape',test:'landscape'};\nconst imagePresetStorage='jinhe-phone-image-presets-v1';\nconst imageSizeText=({width,height})=>width+' × '+height;\n// 参考图选择器：把相册、衣柜、地点图和本机上传合成一份清单，喂给「以图改图」和「NovelAI 精准参考」。\n// 选中的图统一转成 blob + 一段视觉描述，接口支持图片就直接传，不支持就把描述并进提示词。\nconst referenceSources=[\n  ['album','📱 从私密相册选'],['wardrobe','👗 从金街衣柜选'],['place','🗺️ 从地点图选'],['upload','📁 从本机上传']\n];\nfunction referenceAlbumItems() {\n  return photos.filter(item=>item.opening===opening&&photoURL(item)&&item.kind!=='moment')\n    .slice().reverse().slice(0,24)\n    .map(item=>({id:'photo:'+item.id,label:item.title||'相册图片',kind:'album',photo:item,\n      description:item.description||item.title||'',url:photoURL(item)}));\n}\nfunction referenceWardrobeItems() {\n  // 衣柜里有图的直接给图，没图的给容器配色作为构图参考，不给假图片。\n  return wardrobeCatalogue().slice(0,20).map(look=>({\n    id:'look:'+look.id,label:look.label,kind:'wardrobe',photo:look.photo||null,\n    description:look.description||look.label,url:look.photo?photoURL(look.photo):'',\n    flatlay:look.photo?null:{index:look.index??0,color:outfitColors[(look.index??0)%outfitColors.length]}\n  }));\n}\nfunction referencePlaceItems() {\n  return source.places.filter(place=>assetFor(place.id)).slice(0,60).map(place=>({\n    id:'place:'+place.id,label:place.name,kind:'place',photo:null,\n    description:place.name+' · '+(place.area||source.zones[place.zone]||''),\n    url:osAsset(place.id),placeId:place.id\n  }));\n}\nfunction referenceItems(kind) {\n  if (kind==='album') return referenceAlbumItems();\n  if (kind==='wardrobe') return referenceWardrobeItems();\n  if (kind==='place') return referencePlaceItems();\n  return [];\n}\n// 把选中的参考图取成 blob。跨域图床读不出来就退回“只用描述”，并明确告诉玩家。\nasync function referenceBlob(item) {\n  if (item?.photo?.blob) return item.photo.blob;\n  const url=item?.url;\n  if (!url) return null;\n  try {\n    const response=await fetch(url,{mode:'cors',credentials:'omit'});\n    if (!response.ok) throw Error(String(response.status));\n    return await response.blob();\n  } catch {\n    return null;\n  }\n}\nfunction refSourceButtons(mode,current) {\n  return referenceSources.map(([id,label])=>{\n    // 这些按钮在 form 里，必须显式声明 type=button，否则点一下就会提交表单。\n    return '\u003cbutton type=\"button\" class=\"btn\" data-do=\"ref-tab\" data-kind=\"'+esc(id)+'\" data-mode=\"'+esc(mode)+'\" data-value=\"'+esc(id)+'\"'+\n      ' aria-pressed=\"'+(current===id)+'\">'+esc(label)+'\u003c/button>';\n  }).join('');\n}\nfunction referencePickerPanel(kind,mode,shot={}) {\n  const chosen=shot.referencePick;\n  const items=referenceItems(kind);\n  const grid=items.length?items.map(item=>{\n    const visual=item.url\n      ? `\u003cimg src=\"${esc(item.url)}\" alt=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer\">`\n      : item.flatlay\n        ? `\u003cspan class=\"jh-flatlay\" aria-hidden=\"true\" style=\"--product-position:${outfitPositions[item.flatlay.index%4]};--product-fallback:${item.flatlay.color}\">\u003c/span>`\n        : `\u003cspan class=\"jh-ref-empty\">无图\u003c/span>`;\n    return `\u003clabel class=\"jh-ref-item\">\u003cinput type=\"radio\" name=\"referencePick_${mode}\" value=\"${esc(item.id)}\" ${chosen===item.id?'checked':''}>\n      ${visual}\u003cspan>${esc(item.label)}\u003c/span>\u003c/label>`;\n  }).join(''):'\u003cp class=\"hint\">这一类暂时没有可用的图。\u003c/p>';\n  return `\u003cdiv class=\"jh-ref-picker\" data-ref-picker=\"${esc(kind)}\" data-ref-mode=\"${esc(mode)}\">\n    \u003cp class=\"hint\">${mode==='source'?'选一张图作为改图原图，或到下面本机上传。':'选一张图作为精准参考，保留人物或画风特征。'}\u003c/p>\n    ${kind==='upload'?`\u003clabel>本机图片\u003cinput name=\"${mode==='reference'?'imageReferencePick':'imageSourcePick'}\" type=\"file\" accept=\"image/png,image/jpeg,image/webp,image/avif\">\u003c/label>`\n      :`\u003cdiv class=\"jh-ref-grid\">${grid}\u003c/div>`}\n    ${chosen?`\u003cp class=\"hint\">已选：${esc(chosen)}\u003c/p>`:''}\n  \u003c/div>`;\n}\nconst imageHasDiffusion=provider=>provider==='novel'||provider==='sd';\nconst imageHasCharacters=(provider,model)=>provider==='novel'&&/^nai-diffusion-(?:4|5)(?:-|$)/.test(model);\nconst imageHasReference=(provider,model)=>provider==='novel'&&/^nai-diffusion-4-5-(?:full|curated)$/.test(model);\nconst imageHasQuality=({provider,model})=>provider==='openai'&&/^gpt-image(?:-|$)/.test(model||imageDefaults.openai[1]);\nfunction safeImageGeneration(value={}) {\n  return Object.fromEntries(Object.entries(imageGenerationDefaults).map(([key,fallback])=>{\n    const input=value?.[key];\n    const valid=typeof input==='string'||typeof input==='number'&&Number.isFinite(input);\n    return [key,valid?String(input).slice(0,key==='negative'?1500:80):fallback];\n  }));\n}\nfunction safeNovelImageOptions(value) {\n  const fallback=defaults.image.novel;\n  return {\n    artistTags:typeof value?.artistTags==='string'?value.artistTags.slice(0,1500):fallback.artistTags,\n    negativePrompt:typeof value?.negativePrompt==='string'?value.negativePrompt.slice(0,1500):fallback.negativePrompt,\n    qualityTags:value?.qualityTags!==false\n  };\n}\n// ── 本地 ComfyUI（独立）────────────────────────────────────\n// 不靠柏宝绘：走酒馆自带的 /api/sd/comfy/* 路由，由酒馆服务端去调 ComfyUI。\n// 所以浏览器不直连、不受跨域限制，填局域网或 Tailscale 地址也能用。\nconst comfyDefaultBase='http://127.0.0.1:8188';\nconst comfyWorkflowLimit=200000;\nconst comfyUses=[\n  {kind:'default',label:'通用',workflow:'workflow',model:'model',workflowField:'comfyWorkflow',modelField:'comfyModel'},\n  {kind:'wardrobe',label:'衣柜',workflow:'wardrobeWorkflow',model:'wardrobeModel',workflowField:'comfyWardrobeWorkflow',modelField:'comfyWardrobeModel'},\n  {kind:'selfie',label:'自拍',workflow:'selfieWorkflow',model:'selfieModel',workflowField:'comfySelfieWorkflow',modelField:'comfySelfieModel'},\n];\nconst comfyLoaderInputs={\n  CheckpointLoaderSimple:['checkpoint','ckpt_name'],\n  CheckpointLoader:['checkpoint','ckpt_name'],\n  UNETLoader:['unet','unet_name'],\n  UnetLoaderGGUF:['gguf','unet_name'],\n  UnetLoaderGGUFAdvanced:['gguf','unet_name'],\n};\nfunction safePhoneComfy(value) {\n  const text=(input,limit)=>typeof input==='string'?input.slice(0,limit):'';\n  const config={base:typeof value?.base==='string'&&value.base.trim()?value.base.trim().slice(0,500):comfyDefaultBase};\n  for (const use of comfyUses) {\n    config[use.model]=text(value?.[use.model],240).trim();\n    config[use.workflow]=text(value?.[use.workflow],comfyWorkflowLimit).trim();\n  }\n  return config;\n}\nfunction phoneComfyForKind(value,kind) {\n  const config=safePhoneComfy(value);\n  const use=comfyUses.find(item=>item.kind===kind)||comfyUses[0];\n  return {base:config.base,model:config[use.model]||config.model,workflow:config[use.workflow]||config.workflow};\n}\nfunction comfyWorkflowFields(use,config) {\n  const extra=use.kind!=='default';\n  const list='comfy-models-'+use.kind;\n  return `\u003cdiv class=\"stack\">\n    ${field('模型文件',use.modelField,config[use.model],'text',`list=\"${list}\" maxlength=\"240\" spellcheck=\"false\" placeholder=\"${extra?'留空沿用通用模型设置':'需要时填写 %model% 对应的文件名'}\"`)}\n    \u003cdatalist id=\"${list}\">\u003c/datalist>\n    \u003clabel>${use.label} API 工作流 JSON\u003ctextarea name=\"${use.workflowField}\" rows=\"5\" maxlength=\"${comfyWorkflowLimit}\" spellcheck=\"false\" placeholder=\"${extra?'留空沿用通用工作流':'留空使用酒馆默认工作流'}\">${esc(config[use.workflow])}\u003c/textarea>\u003c/label>\n    \u003cdiv class=\"buttons\">${btn('读取匹配模型','models-comfy',{kind:use.kind})}${extra?'':btn('载入默认工作流','workflow-comfy')}\u003c/div>\n  \u003c/div>`;\n}\nfunction readComfySettings(form,previous) {\n  const config=safePhoneComfy(previous);\n  if (!form.elements.comfyBase) return config;\n  config.base=formValue(form,'comfyBase')||config.base;\n  for (const use of comfyUses) {\n    config[use.model]=formValue(form,use.modelField);\n    config[use.workflow]=formValue(form,use.workflowField);\n  }\n  return safePhoneComfy(config);\n}\n// 认三种来源：直接粘的对象、ComfyUI 的 {\"prompt\": {...}}、酒馆工作流接口回的那串 JSON 文本。\nfunction phoneComfyWorkflow(raw) {\n  if (typeof raw==='object'&&raw) return phoneComfyGraph(raw);\n  if (typeof raw!=='string'||!raw.trim()) throw Error('请先填写或载入 ComfyUI 的 API 工作流 JSON。');\n  if (raw.length>comfyWorkflowLimit) throw Error('工作流太长，请控制在 200 KB 以内。');\n  let graph;\n  try {graph=JSON.parse(raw.replace(/^\\uFEFF/,'').trim());}\n  catch {throw Error('工作流 JSON 无法解析。占位符要写在引号里，例如 \"%prompt%\"。');}\n  if (typeof graph==='string') return phoneComfyWorkflow(graph);\n  return phoneComfyGraph(graph);\n}\nfunction phoneComfyGraph(graph) {\n  const isObject=value=>Boolean(value)&&typeof value==='object'&&!Array.isArray(value);\n  if (isObject(graph?.prompt)) graph=graph.prompt;\n  if (isObject(graph?.workflow)) graph=graph.workflow;\n  const nodes=isObject(graph)?Object.values(graph):[];\n  if (!nodes.length||!nodes.every(node=>isObject(node)&&typeof node.class_type==='string'&&isObject(node.inputs))) {\n    throw Error('请用 ComfyUI 的「另存为 API 格式」导出工作流，或从柏宝绘复制工作流 JSON。');\n  }\n  return JSON.parse(JSON.stringify(graph));\n}\n// 把当前画幅、种子和提示词写进工作流。占位符写成 %prompt% / %negative_prompt% /\n// %width% / %height% / %seed% / %steps% / %cfg% / %sampler% / %model% 这类即可。\nfunction renderPhoneComfyWorkflow(raw,prompt,config,kind) {\n  const graph=phoneComfyWorkflow(raw);\n  const {width,height}=imageDimensions(config,kind);\n  const options=safeImageGeneration(config.generation),comfy=safePhoneComfy(config.comfy);\n  const sampler=options.sampler||'euler',cfg=Number(options.guidance)||7;\n  const seed=options.seed===''?Math.floor(Math.random()*4294967296):imageNumber(options.seed,'随机种子',0,4294967295,true);\n  // 占位符大小写都能用；这里放常见的几种别名，别让玩家为了改名去改工作流。\n  const values={prompt,positive_prompt:prompt,nl:prompt,negative_prompt:options.negative,width,height,seed,\n    steps:Number(options.steps)||24,cfg,cfg_scale:cfg,scale:cfg,guidance:cfg,\n    sampler,sampler_name:sampler,scheduler:'normal',\n    model:comfy.model,model_name:comfy.model,ckpt_name:comfy.model,unet_name:comfy.model,denoise:1};\n  let boundPositive=false;\n  const fill=value=>{\n    if (Array.isArray(value)) return value.map(fill);\n    if (value&&typeof value==='object') return Object.fromEntries(Object.entries(value).map(([key,item])=>[key,fill(item)]));\n    if (typeof value!=='string') return value;\n    const take=(marker,name)=>{\n      const key=name.toLowerCase();\n      if (!Object.hasOwn(values,key)) throw Error('工作流里的 '+marker+' 不认识，请换成 %prompt%、%width% 这类占位符。');\n      if (['prompt','positive_prompt','nl'].includes(key)) boundPositive=true;\n      if (key==='model'&&!values.model) throw Error('请先填模型文件，或点「读取模型」选一个。');\n      return values[key];\n    };\n    const exact=value.match(/^%([a-z][a-z0-9_]*)%$/i);\n    return exact?take(...exact):value.replace(/%([a-z][a-z0-9_]*)%/gi,take);\n  };\n  for (const node of Object.values(graph)) node.inputs=fill(node.inputs);\n  if (!boundPositive) {\n    // 没写占位符时，按常见导出习惯找唯一一个喂给正向条件的文本节点。\n    const feeders=new Set(Object.values(graph).map(node=>node.inputs.positive)\n      .filter(Array.isArray).map(([id])=>graph[id]?.inputs).filter(inputs=>typeof inputs?.text==='string'));\n    if (feeders.size!==1) throw Error('没有找到唯一的正向提示词位置。请在对应节点的文本里写 \"%prompt%\"。');\n    feeders.values().next().value.text=prompt;\n  }\n  return graph;\n}\n// 测试图只为确认接线通不通：缩小、压步数、把保存换成预览，别往图库堆垃圾。\nfunction preparePhoneComfyTest(graph) {\n  const nodes=Object.values(graph);\n  const latents=nodes.filter(node=>node.class_type==='EmptyLatentImage');\n  const samplers=nodes.filter(node=>node.class_type==='KSampler');\n  if (latents.length===1&&samplers.length===1&&graph[samplers[0].inputs.latent_image?.[0]]===latents[0]) {\n    const latent=latents[0].inputs,sampler=samplers[0].inputs;\n    const tiny=typeof latent.width==='number'&&typeof latent.height==='number'&&latent.width*latent.height\u003c=384*256;\n    if (!tiny) {latent.width=384;latent.height=256;}\n    latent.batch_size=1;\n    if (typeof sampler.steps==='number') sampler.steps=Math.min(sampler.steps,4);\n  }\n  for (const node of nodes.filter(node=>node.class_type==='SaveImage')) {\n    node.class_type='PreviewImage';\n    node.inputs={images:node.inputs.images};\n  }\n  return graph;\n}\nfunction phoneComfyBridge(action,config,workflow) {\n  const bridge=globalThis.frameElement?.jinhePhoneBridge;\n  if (typeof bridge?.comfyRequest!=='function') throw Error('「本地 ComfyUI（独立）」要在酒馆里打开九号机才能用。');\n  return bridge.comfyRequest(action,config,workflow);\n}\nfunction phoneComfyModelRequests(graph) {\n  return Object.values(graph).flatMap(node=>{\n    const loader=comfyLoaderInputs[node.class_type];\n    return loader&&typeof node.inputs[loader[1]]==='string'?[{node:node.class_type,type:loader[0],value:node.inputs[loader[1]]}]:[];\n  });\n}\n// 酒馆的模型清单里 text 被去过扩展名、下划线也换了空格，真文件名只在 value 里。\nfunction phoneComfyModelNames(items) {\n  return (Array.isArray(items)?items:[])\n    .filter(item=>typeof item?.value==='string'&&item.value)\n    .map(item=>({value:item.value,type:String(item.text||'').startsWith('GGUF: ')?'gguf':String(item.text||'').startsWith('UNet: ')?'unet':'checkpoint'}));\n}\nasync function loadPhoneComfyWorkflow(comfy) {\n  return comfy.workflow||await phoneComfyBridge('workflow',comfy).catch(()=>{\n    throw Error('酒馆里还没有 ComfyUI 工作流。可以点「载入默认工作流」，或直接粘贴一份 API 工作流 JSON。');\n  });\n}\nasync function requestPhoneComfyImage(config,prompt,kind) {\n  const use=config.comfyUse||kind;\n  const comfy=phoneComfyForKind(config.comfy,use);\n  const raw=await loadPhoneComfyWorkflow(comfy);\n  const workflow=renderPhoneComfyWorkflow(raw,prompt,{...config,comfy},kind);\n  if (kind==='test') preparePhoneComfyTest(workflow);\n  let result;\n  try {\n    result=await phoneComfyBridge('generate',comfy,workflow);\n  } catch (error) {\n    // 500 多半是模型文件名对不上。去问一遍清单，指名道姓告诉玩家哪个节点加载不了哪个文件。\n    if (/HTTP 500/.test(String(error.message||''))) {\n      const list=await phoneComfyBridge('models',comfy).then(phoneComfyModelNames,()=>null);\n      const bad=list?.length&&phoneComfyModelRequests(workflow).find(model=>\n        list.some(item=>item.type===model.type)&&!list.some(item=>item.type===model.type&&item.value===model.value));\n      if (bad) throw Error(bad.node+' 无法加载「'+bad.value+'」。请点「读取模型」重新选一个和本机对得上的文件。');\n    }\n    throw error;\n  }\n  if (typeof result?.data!=='string'||!result.data) throw Error('ComfyUI 没有返回可读取的图片。');\n  const blob=pictureBlob(decodeBytes(result.data));\n  const bitmap=await createImageBitmap(blob);\n  try {\n    return {blob,generation:{provider:'comfy',model:phoneComfyModelRequests(workflow)[0]?.value||comfy.model||'本地 ComfyUI',prompt,method:'generate',\n      comfyUse:comfyUses.some(item=>item.kind===use)?use:'default',\n      width:bitmap.width,height:bitmap.height,options:safeImageGeneration(config.generation),characters:[]}};\n  } finally {bitmap.close();}\n}\nfunction imageDimensions(config,kind) {\n  const options=safeImageGeneration(config.generation);\n  // 柏宝绘的画幅由扩展的工作流决定，这里只按用途给相册记录一个参考尺寸。\n  if (config.provider==='baibai') {\n    const frame=options.frame==='auto'?(imageSceneFrames[kind]||'square'):options.frame==='custom'?'square':options.frame;\n    const size=imageSmallSizes[frame]||imageSmallSizes.square;\n    return {width:size[0],height:size[1]};\n  }\n  if (options.frame==='custom') {\n    const width=imageNumber(options.width,'宽度',64,4096,true),height=imageNumber(options.height,'高度',64,4096,true);\n    const multiple=config.provider==='novel'?64:['sd','comfy'].includes(config.provider)?8:1;\n    if (width%multiple||height%multiple) throw Error('这个接口的宽度和高度须为 '+multiple+' 的倍数。');\n    return {width,height};\n  }\n  const frame=options.frame==='auto'?(imageSceneFrames[kind]||'square'):options.frame;\n  let size=imageSmallSizes[frame]||imageSmallSizes.square;\n  if (config.provider==='silicon') {\n    // Keep the common model default for auto. The explicit choice is sent to the model.\n    size=options.frame==='auto'?[1024,1024]:({portrait:[768,1024],square:[1024,1024],landscape:[1024,768]}[frame]||[1024,1024]);\n  }\n  if (config.provider==='openai') {\n    const model=config.model||imageDefaults.openai[1];\n    if (model==='dall-e-2') {\n      if (options.frame!=='auto'&&frame!=='square') throw Error('DALL·E 2 只支持方图。');\n      size=[512,512];\n    } else if (model==='dall-e-3') {\n      size=({portrait:[1024,1792],square:[1024,1024],landscape:[1792,1024]}[frame]||[1024,1024]);\n    } else {\n      size=options.frame==='auto'&&!imageHasQuality(config)?[1024,1024]:\n        ({portrait:[1024,1536],square:[1024,1024],landscape:[1536,1024]}[frame]||[1024,1024]);\n    }\n  }\n  return {width:size[0],height:size[1]};\n}\nfunction imageNumber(value,label,min,max,integer=false) {\n  const parsed=Number(value);\n  if (!String(value).trim()||!Number.isFinite(parsed)||parsed\u003cmin||parsed>max||integer&&!Number.isInteger(parsed))\n    throw Error(label+'须为 '+min+' 到 '+max+' 之间的'+(integer?'整数。':'数字。'));\n  return parsed;\n}\nfunction imageRequestRecipe(config,prompt,kind,final=false) {\n  const {provider}=config,model=config.model||imageDefaults[provider]?.[1]||'';\n  // 柏宝绘不组装接口参数：工作流、画幅和采样都在扩展里，九号机只留一份相册记录。\n  if (provider==='baibai') {\n    const {width,height}=imageDimensions(config,kind);\n    return {body:{prompt},generation:{provider,model:'柏宝绘 ComfyUI',prompt,\n      options:safeImageGeneration(config.generation),width,height,method:'generate'}};\n  }\n  // 本地 ComfyUI 的「参数」藏在工作流里，这里只给预览和复制提示词用。\n  if (provider==='comfy') {\n    const {width,height}=imageDimensions(config,kind);\n    return {body:{prompt},generation:{provider,model:phoneComfyForKind(config.comfy,config.comfyUse||kind).model||'本地 ComfyUI',prompt,\n      options:safeImageGeneration(config.generation),width,height,method:'generate'}};\n  }\n  const options=safeImageGeneration(config.generation),novel=safeNovelImageOptions(config.novel);\n  const {width,height}=imageDimensions({...config,model},kind);\n  const input=provider==='novel'?withNovelArtistTags(prompt,novel.artistTags):prompt;\n  const method=config.imageSource?.mode||'generate';\n  const sourceOptions=config.imageSource?.options;\n  const characters=(config.characters||[]).slice(0,4).map(entry=>({\n    prompt:String(entry.prompt||'').slice(0,500),negative:String(entry.negative||'').slice(0,500),\n    position:['auto','left','middle','right'].includes(entry.position)?entry.position:'auto'\n  })).filter(entry=>entry.prompt);\n  const generation={provider,model,prompt,options,novel:provider==='novel'?novel:undefined,width,height,method,\n    sourceOptions,characters:imageHasCharacters(provider,model)?characters:[],reference:config.reference?.options,\n    // 参考图读不出来时，至少把那张图的画面描述带进提示词，别让玩家白选一张。\n    referenceNote:config.reference?.description||''};\n  let body;\n  if (imageHasDiffusion(provider)) {\n    const steps=imageNumber(options.steps,'步数',1,provider==='novel'?50:150,true);\n    const scale=options.guidance===''?(provider==='novel'?5:7):imageNumber(options.guidance,'提示词强度',1,30);\n    let seed=options.seed===''?undefined:imageNumber(options.seed,'随机种子',0,4_294_967_295,true);\n    if (final&&seed===undefined) seed=Math.floor(Math.random()*4_294_967_296);\n    if (seed!==undefined) generation.options.seed=String(seed);\n    if (provider==='sd') {\n      body={prompt,width,height,steps,batch_size:1,cfg_scale:scale,negative_prompt:options.negative,seed:seed??-1};\n      if (options.sampler) body.sampler_name=options.sampler;\n      if (method!=='generate') Object.assign(body,{init_images:[config.imageSource.image],denoising_strength:sourceOptions.strength});\n      if (method==='inpaint') Object.assign(body,{mask:config.imageSource.mask,inpainting_fill:1});\n    } else {\n      const parameters={params_version:3,width,height,n_samples:1,seed,steps,scale,sampler:options.sampler||'k_euler_ancestral',\n        ucPreset:0,negative_prompt:novel.negativePrompt,qualityToggle:novel.qualityTags};\n      if (imageHasCharacters(provider,model)) {\n        const coords={left:.2,middle:.5,right:.8};\n        const useCoords=characters.some(entry=>entry.position!=='auto');\n        const centers=entry=>[{x:coords[entry.position]??.5,y:.5}];\n        Object.assign(parameters,{noise_schedule:options.noise||'karras',legacy:false,legacy_v3_extend:false,\n          use_coords:useCoords,sm:false,sm_dyn:false,characterPrompts:characters.map(entry=>({\n            prompt:entry.prompt,uc:entry.negative,center:centers(entry)[0]\n          }))});\n        const captions=key=>characters.map(entry=>({char_caption:entry[key],centers:centers(entry)}));\n        parameters.v4_prompt={caption:{base_caption:input,char_captions:captions('prompt')},use_coords:useCoords,use_order:true};\n        parameters.v4_negative_prompt={caption:{base_caption:parameters.negative_prompt,char_captions:captions('negative')}};\n      }\n      if (method==='img2img') Object.assign(parameters,{image:config.imageSource.image,strength:sourceOptions.strength,\n        noise:sourceOptions.noise,extra_noise_seed:seed,add_original_image:false});\n      if (config.reference) {\n        const {base64,options:{type,strength,fidelity}}=config.reference;\n        Object.assign(parameters,{director_reference_images:[base64],\n          director_reference_descriptions:[{caption:{base_caption:type,char_captions:[]}}],\n          director_reference_information_extracted:[1],director_reference_strength_values:[strength],\n          director_reference_secondary_strength_values:[fidelity]});\n      }\n      body={input,model,action:method,parameters};\n    }\n  } else {\n    const size=width+'x'+height;\n    body=provider==='silicon'?{model,prompt,image_size:size}:{model,prompt,n:1,size};\n    if (provider==='silicon'&&options.negative) body.negative_prompt=options.negative;\n    if (imageHasQuality({provider,model})) {\n      body.quality=['low','medium','high','auto'].includes(options.quality)?options.quality:(options.frame==='auto'?'low':'auto');\n      generation.quality=body.quality;\n    }\n  }\n  return {body,generation};\n}\nfunction imageOptionsPanel(config,kind,shot=false) {\n  const {provider}=config,model=config.model||imageDefaults[provider]?.[1],value=safeImageGeneration(config.generation);\n  // 柏宝绘自己管地址、工作流和画幅，九号机这边没有可调的出图参数。\n  if (provider==='baibai') return '\u003cdiv class=\"image-options\">\u003cp class=\"hint\">柏宝绘负责 ComfyUI 地址、工作流和画幅。九号机只把画面提示词交给它，出图后存进私密相册。\u003c/p>\u003c/div>';\n  const novel=safeNovelImageOptions(config.novel),diffusion=imageHasDiffusion(provider);\n  // 本地 ComfyUI 没有「接口参数」，但工作流里能接画幅、种子、步数和采样器。\n  const comfy=provider==='comfy';\n  const select=(label,key,choices,current)=>'\u003clabel>'+label+'\u003cselect name=\"'+key+'\">'+\n    choices.map(([id,name])=>option(id,name,current)).join('')+'\u003c/select>\u003c/label>';\n  const textarea=(label,key,text,rows=2)=>'\u003clabel>'+label+'\u003ctextarea name=\"'+key+'\" rows=\"'+rows+'\" maxlength=\"1500\" spellcheck=\"false\">'+esc(text)+'\u003c/textarea>\u003c/label>';\n  const current=imageDimensionsForDisplay(config,kind);\n  const presetNames=shot?readImagePresets().filter(preset=>preset.provider===provider):[];\n  const mode=shot?.mode||'generate';\n  return '\u003cdiv class=\"image-options stack\">'+(presetNames.length||shot?'\u003cdiv class=\"pair\">'+\n      select('我的生图预设','imagePreset',[['','选择预设'],...presetNames.map(item=>[item.name,item.name])],'')+\n      '\u003cdiv class=\"buttons\">'+btn('载入','image-preset-load')+btn('管理','image-preset-manage')+'\u003c/div>\u003c/div>':'')+\n    select('画幅','imageFrame',imageFrames,value.frame)+\n    '\u003cp class=\"hint\" data-image-size>'+esc(current)+'\u003c/p>'+\n    '\u003cdiv class=\"pair\" data-image-custom'+(value.frame==='custom'?'':' hidden')+'>'+\n      field('宽度（像素）','image_width',value.width,'number','min=\"64\" max=\"4096\" step=\"1\"'+(value.frame==='custom'?'':' disabled'))+\n      field('高度（像素）','image_height',value.height,'number','min=\"64\" max=\"4096\" step=\"1\"'+(value.frame==='custom'?'':' disabled'))+'\u003c/div>'+\n    (shot&&provider==='novel'?'\u003cdetails class=\"image-advanced\">\u003csummary>NovelAI 画师串和反向词\u003c/summary>\u003cdiv class=\"stack\">'+\n      textarea('画师串','novelArtistTags',novel.artistTags)+textarea('反向提示词','novelNegativePrompt',novel.negativePrompt)+\n      check('自动质量标签','novelQualityTags',novel.qualityTags)+'\u003c/div>\u003c/details>':'')+\n    (shot&&!shot.textOnly&&diffusion?select('生成方式','imageMode',[['generate','文字生图'],['img2img','以图改图'],...(provider==='sd'?[['inpaint','局部重绘']]:[])],mode)+\n      '\u003cdiv class=\"stack\" data-image-source'+(mode==='generate'?' hidden':'')+'>'+\n      '\u003cdiv class=\"buttons\" data-ref-tabs=\"source\">'+refSourceButtons('source',shot.refPick?.source||'album')+'\u003c/div>'+\n      '\u003cdiv data-ref-panel=\"source\">'+(mode==='generate'?'':referencePickerPanel(shot.refPick?.source||'album','source',shot))+'\u003c/div>'+\n      '\u003cp class=\"hint\" data-image-original>'+esc(shot.originLabel||'')+'\u003c/p>'+\n      '\u003clabel data-image-mask'+(mode==='inpaint'?'':' hidden')+'>黑白遮罩（白色为重绘区域）\u003cinput name=\"imageMask\" type=\"file\" accept=\"image/png\">\u003c/label>'+\n      field('修改强度（0 到 1）','imageStrength',shot.sourceOptions?.strength??0.55,'number','min=\"0\" max=\"1\" step=\"0.01\"')+\n      (provider==='novel'?field('原图噪声（0 到 1）','imageNoise',shot.sourceOptions?.noise??0,'number','min=\"0\" max=\"1\" step=\"0.01\"'):'')+\n      '\u003c/div>':'')+\n    (diffusion||comfy||provider==='silicon'||imageHasQuality({provider,model})?'\u003cdetails class=\"image-advanced\">\u003csummary>高级参数\u003c/summary>\u003cdiv class=\"stack\">'+\n    (diffusion||comfy?'\u003cdiv class=\"pair\">'+field('步数','image_steps',value.steps,'number','min=\"1\" max=\"'+(provider==='novel'?50:150)+'\" step=\"1\"')+\n      field('提示词强度','image_guidance',value.guidance,'number','min=\"1\" max=\"30\" step=\"0.1\" placeholder=\"'+(provider==='novel'?5:7)+'\"')+'\u003c/div>'+\n      field('随机种子（留空随机）','image_seed',value.seed,'number','min=\"0\" max=\"4294967295\" step=\"1\"')+\n      field('采样器','image_sampler',value.sampler,'text','maxlength=\"80\" placeholder=\"'+(provider==='novel'?'k_euler_ancestral':comfy?'euler':'沿用界面默认')+'\" list=\"image-samplers\"')+\n      '\u003cdatalist id=\"image-samplers\">'+(provider==='novel'?['k_euler','k_euler_ancestral','k_dpmpp_2m','k_dpmpp_sde','k_dpmpp_2s_ancestral','ddim_v3']:\n        comfy?['euler','euler_ancestral','dpmpp_2m','dpmpp_sde','dpmpp_2m_sde','ddim']:['Euler','Euler a','DPM++ 2M','DPM++ SDE']).map(s=>option(s,s,'')).join('')+'\u003c/datalist>':'')+\n    (imageHasCharacters(provider,model)?select('降噪曲线','image_noise',[['karras','Karras'],['exponential','Exponential'],['polyexponential','Polyexponential'],['native','Native']],value.noise):'')+\n    (comfy||provider==='sd'||provider==='silicon'?textarea('反向提示词','image_negative',value.negative):'')+\n    (imageHasQuality({provider,model})?select('图片质量','image_quality',[['','跟随画幅'],['low','低'],['medium','中'],['high','高'],['auto','由模型选择']],value.quality):'')+\n    '\u003c/div>\u003c/details>':'')+\n    (shot&&imageHasCharacters(provider,model)?'\u003cdetails class=\"image-advanced\"'+(shot.characters?.length?' open':'')+'>\u003csummary>多人提示词（最多 4 人）\u003c/summary>\u003cdiv class=\"stack\">'+\n      Array.from({length:4},(_,i)=>{\n        const entry=shot.characters?.[i]||{};\n        return '\u003cdiv class=\"stack\">'+field('人物 '+(i+1)+' 提示词','imagePerson'+i,entry.prompt||'','text','maxlength=\"500\"')+\n          field('人物 '+(i+1)+' 反向词','imagePersonNegative'+i,entry.negative||'','text','maxlength=\"500\"')+\n          select('人物 '+(i+1)+' 位置','imagePersonPosition'+i,[['auto','自动'],['left','左'],['middle','中'],['right','右']],entry.position||'auto')+'\u003c/div>';\n      }).join('')+'\u003c/div>\u003c/details>':'')+\n    (shot&&imageHasReference(provider,model)?'\u003cdetails class=\"image-advanced\"'+(shot.reference?' open':'')+'>\u003csummary>NovelAI 精准参考\u003c/summary>\u003cdiv class=\"stack\">'+\n      '\u003cdiv class=\"buttons\" data-ref-tabs=\"reference\">'+refSourceButtons('reference',shot.refPick?.reference||'album')+'\u003c/div>'+\n      '\u003cdiv data-ref-panel=\"reference\">'+referencePickerPanel(shot.refPick?.reference||'album','reference',shot)+'\u003c/div>'+\n      '\u003cp class=\"hint\">用于保持人物特征，NovelAI 会另外计费。选中的参考图会临时取一次；跨域图床读不出来时，改用该图的画面描述参与提示词。\u003c/p>'+\n      select('参考内容','imageReferenceType',[['character','人物'],['character&style','人物和画风']],shot.reference?.type||'character')+\n      '\u003cdiv class=\"pair\">'+field('参考强度','imageReferenceStrength',shot.reference?.strength??0.6,'number','min=\"0\" max=\"1\" step=\"0.01\"')+\n      field('相似程度','imageReferenceFidelity',shot.reference?.fidelity??0.6,'number','min=\"0\" max=\"1\" step=\"0.01\"')+'\u003c/div>\u003c/div>\u003c/details>':'')+\n    (shot?'\u003cdetails class=\"image-advanced\" data-image-request>\u003csummary>发送前预览\u003c/summary>\u003cpre class=\"image-recipe\">\u003c/pre>'+btn('复制正向词','image-copy-prompt')+'\u003c/details>':'')+\n    '\u003c/div>';\n}\nfunction imageDimensionsForDisplay(config,kind) {\n  try {\n    // 工作流里没接画幅占位符时，尺寸就是工作流自己的事，别给个假数字。\n    const workflow=config.provider==='comfy'&&phoneComfyForKind(config.comfy,config.comfyUse||kind).workflow;\n    if (workflow&&!/%(?:width|height)%/i.test(workflow)) {\n      return '尺寸由 ComfyUI 工作流决定。';\n    }\n    const size=imageSizeText(imageDimensions(config,kind));\n    return '本次尺寸 '+size+(kind?'':'（方图示例，自动模式会随入口调整）');\n  } catch(error) {return error.message;}\n}\nfunction readImageGeneration(form,base) {\n  const result=safeImageGeneration(base);\n  if (form.elements.imageFrame) result.frame=formValue(form,'imageFrame');\n  for (const key of Object.keys(result)) {\n    if (form.elements['image_'+key]) result[key]=form.elements['image_'+key].value.trim();\n  }\n  return result;\n}\nfunction readImageShot(form,config) {\n  const novel=form.elements.novelArtistTags?{\n    artistTags:formValue(form,'novelArtistTags'),negativePrompt:formValue(form,'novelNegativePrompt'),\n    qualityTags:form.elements.novelQualityTags.checked\n  }:config.novel;\n  const characters=Array.from({length:4},(_,i)=>({prompt:formValue(form,'imagePerson'+i),\n    negative:formValue(form,'imagePersonNegative'+i),position:formValue(form,'imagePersonPosition'+i)})).filter(entry=>entry.prompt);\n  return {...config,generation:readImageGeneration(form,config.generation),novel,characters};\n}\n// 把选中的参考图解析成 blob：优先用选中的相册/地点图，其次本机上传，最后退回默认原图。\nfunction pickedReferenceItem(form,mode) {\n  const id=formValue(form,'referencePick_'+mode);\n  if (!id) return null;\n  const kind=id.split(':')[0];\n  const list=kind==='photo'?'album':kind==='look'?'wardrobe':kind==='place'?'place':'upload';\n  return referenceItems(list).find(item=>item.id===id) || null;\n}\nasync function resolveReferenceBlob(form,mode,fallback) {\n  // 「从本机上传」在两个模式里各有独立的文件框，先看属于这个模式的那一个。\n  const local=(mode==='reference'?form.elements.imageReferencePick:form.elements.imageSourcePick)?.files?.[0];\n  if (local) return loadLocalPhoto(local);\n  const item=pickedReferenceItem(form,mode);\n  if (item) {\n    const blob=await referenceBlob(item);\n    if (blob) return blob;\n  }\n  if (fallback) return fallback;\n  return null;\n}\nasync function readImageSource(form,context,provider) {\n  const mode=formValue(form,'imageMode');\n  if (!mode||mode==='generate') return undefined;\n  if (!imageHasDiffusion(provider)||!['img2img','inpaint'].includes(mode)||mode==='inpaint'&&provider!=='sd')\n    throw Error('当前接口不支持这种改图方式。');\n  const source=await resolveReferenceBlob(form,'source',context.origin?.blob);\n  if (!source) throw Error('先选一张原图，或切到「从本机上传」传一张。');\n  const maskFile=form.elements.imageMask?.files[0];\n  let mask;\n  if (mode==='inpaint') {\n    if (!maskFile||maskFile.type!=='image/png') throw Error('请上传 PNG 黑白遮罩。');\n    mask=await loadLocalPhoto(maskFile);\n    const [imageSize,maskSize]=await Promise.all([createImageBitmap(source),createImageBitmap(mask)].map(async task=>{\n      const bitmap=await task;\n      try {return bitmap.width+'x'+bitmap.height;} finally {bitmap.close();}\n    }));\n    if (imageSize!==maskSize) throw Error('遮罩须与原图尺寸一致。');\n  }\n  const data=await imageDataURL(source);\n  return {mode,image:provider==='novel'?data.split(',')[1]:data,mask:mask?await imageDataURL(mask):undefined,options:{\n    strength:imageNumber(formValue(form,'imageStrength'),'修改强度',0,1),\n    noise:provider==='novel'?imageNumber(formValue(form,'imageNoise'),'原图噪声',0,1):0\n  }};\n}\nfunction imageDataURL(blob) {\n  return new Promise((resolve,reject)=>{\n    const reader=new FileReader();\n    reader.onload=()=>resolve(String(reader.result));\n    reader.onerror=()=>reject(Error('无法读取改图文件。'));\n    reader.readAsDataURL(blob);\n  });\n}\nasync function readImageReference(form) {\n  // 参考强度只在 NovelAI 精准参考那一块里出现；没有这组输入就不算选了参考图。\n  if (!form.elements.imageReferenceStrength) return undefined;\n  const type=formValue(form,'imageReferenceType');\n  const options={type:type=