t:33px;border-radius:10px;flex:none;font-size:12px}\n.os-message.self{flex-direction:row-reverse}\n.os-message-body{min-width:0;max-width:calc(100% - 56px)}\n.os-message .bubble{margin:0;max-width:100%;border-radius:4px 14px 14px 14px;padding:10px 12px;background:#303b35;color:#f2f4ee;font-size:13px;line-height:1.65;overflow-wrap:anywhere;white-space:pre-wrap}\n.os-message.self .bubble{background:#c8e5a8;color:#253022;border-radius:14px 4px 14px 14px}\n.os-message .bubble.photo{padding:3px}\n.os-message .bubble .photo-btn{max-width:190px;border-radius:10px}\n.os-message .receipt{width:212px;max-width:100%;padding:0!important;background:linear-gradient(130deg,#e5a451,#de7c3c)!important;color:#fff6e5!important;overflow:hidden}\n.os-money-main{padding:15px 13px;display:flex;align-items:center;gap:10px}\n.os-money-main .ico{width:27px;height:27px}\n.os-money-main strong{display:block;font-size:17px;font-weight:500}\n.os-money-main small{display:block;font-size:10px;opacity:.85}\n.os-money-foot{border-top:1px solid #fff3;padding:5px 11px;background:#ffffff12;font-size:10px}\n.os-voice{border:0;background:transparent;color:inherit;display:flex;gap:18px;align-items:center;min-width:108px;text-align:left;min-height:27px}\n.os-voice-text{padding-top:9px;border-top:1px solid #ffffff20;margin-top:7px;font-size:12px}\n/* 语音条：正在播放时图标跳动，旁边「文」按钮负责展开或收起文字。 */\n.os-voice[data-playing=\"true\"]{color:#ffd6e7}\n.os-voice[data-playing=\"true\"] svg,\n.os-voice[data-playing=\"true\"] .icon{animation:osVoiceWave 900ms ease-in-out infinite}\n@keyframes osVoiceWave{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.22);opacity:1}}\n.os-voice-toggle{border:1px solid #ffffff2e;background:#ffffff12;color:#f2dfe9;border-radius:6px;font-size:11px;\n  min-width:26px;min-height:24px;margin-left:6px;cursor:pointer}\n.os-voice-toggle:hover{background:#ffffff22}\n.os-voice-toggle:focus-visible{outline:2px solid #9fe8ff;outline-offset:2px}\n.os-message-tools{display:flex;gap:6px;margin-top: