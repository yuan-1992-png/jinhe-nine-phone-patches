channel];\n  const topics=[...new Set([...(channelTopic?[channelTopic]:[]),...matched,'chat'])].slice(0,3);\n  const offset=jinheSpeechHash(seed+'|'+text+'|'+channel);\n  const examples=topics.flatMap((topic,index)=>{\n    const lines=data.scenes?.[topic]||[];\n    if(!lines.length)return [];\n    const at=(offset+index)%lines.length;\n    return [{topic,text:lines[at]},...(index===0&&lines.length>1?[{topic,text:lines[(at+1)%lines.length]}]:[])];\n  });\n  return {id,data,examples};\n}\nconst jinheNativeMandarin = [\n  '【人物口音：普通话】本人日常用自然普通话。对白、心里自语和手机消息使用普通话词汇和句式，按人物性格保留语速、称呼和口头禅。',\n  '人物的籍贯按档案写。原设定、旧对话和别人的方言只供了解背景；本人的话直接给原文，省略意译、拼音和方言注释。',\n  '日常语气参考：「我刚忙完，你到哪儿了？」「行，等我收拾一下就出来。」「这事儿我得先问清楚。」按情境换说法。',\n].join('\\n');\n\nfunction renderJinheSpeech(corpus,dialect,options={}) {\n  const selected=selectJinheSpeech(corpus,dialect,options);\n  if(!selected)return dialect === 'mandarin' ? jinheNativeMandarin : '';\n  const {data,examples,intimateStage,intimateTrack}=selected;\n  // 床笫语料：只给方言腔调和台词参考，剧情进展仍由正文决定。\n  if (intimateStage) {\n    return [\n      dialect === 'mandarin' ? jinheNativeMandarin : data.label.split('·')[0].trim()+' · 这是亲密场景，按本人方言说。',\n      '说话骨架与核心风格：'+(intimateTrack.grammar||[]).join('；')+'。',\n      '当前亲密阶段：'+intimateStage+'。按这个阶段该有的生理反应说话，别跳过前面直接到事后。',\n      '【性格自适应荤话生化】：台词例句是肉欲参考，严禁机械照搬！必须根据该角色的具体性格反差（太妹嘴硬爆粗怂包求饶 / 人妻端庄背德含泪迎合 / 痴女才女反差下贱求精 / 运动系好胜核心绞杀）自发演化出符合她人设与自尊底线的叫床与求饶口吻，严禁千人一面。',\n      '本阶段荤话台词参考：'+examples.map(line=>'「'+line.text+'」').join('；')+'。',\n      '身体反应直白展现，杜绝含蓄草率。',\n      intimateTrack.scene_rule || '',\n    ].filter(Boolean).join('\\n');\n  }\n  return [\n    data.label+' · 自然但明显。对白、心里自语和手机消息都沿用本人方言；长句也保持句式，普通话旁白照常。',\n    '说话骨架：'+data.grammar.join('；')+'。',\n    '分寸：'+data.avoid.join('；')+'。',\n    '按人物已有性格、称呼和关系表达同一件事，方言不替人物决定性格。短答可以只说一个自然的方言词，连续对白应从句式和常用动词听出地方味。',\n    '本轮日常表达参考（按意思重新说，别照抄或补出例句里的新事实）：'+examples.map(line=>'「'+line.text+'」').join('；')+'。',\n    '生成前默查本人问句、否定、动词和收尾是否符合档案口音，修正不自然的普通话直译。',\n    (options.channel??'story')==='story'\n      ? '保留角色的方言原话，按本轮正文对白格式呈现。'\n      : options.dialogueLanguage==='bilingual'\n        ? '保留方言原话，按本条消息的格式附普通话意译。'\n        : '直接给人物原话，不附翻译、拼音或方言教学。'\n  ].join('\\n');\n}\n\nconst jinheDialogueLabels = {\n  mandarin: '普通话',\n  dialect: '方言原声',\n  bilingual: '方言＋普通话意译',\n};\n\nfunction readJinheDialogueLanguage(metadata) {\n  const mode = metadata?.jinheDialogueLanguage;\n  if (typeof mode === 'string' && Object.hasOwn(jinheDialogueLabels, mode)) return mode;\n  return metadata?.jinheBilingualDialogue === false ? 'dialect' : 'bilingual';\n}\n\nconst phoneDialectCorpus={\"dongbei\":{\"label\":\"东北话\",\"aliases\":[\"东北\",\"沈阳\",\"哈尔滨\"],\"sample\":\"搁哪儿呢？先把这点事整利索了，咱再唠。\",\"grammar\":[\"问地点用搁哪儿，问办法用咋整，商量用咱先……再……\",\"瞅、寻思、唠、整按语境自然使用，普通小事也带口语节奏\",\"熟人省主语接短句，认真时照样讲清缘由\"],\"avoid\":[\"不句句堆贼、嘎嘎和扯犊子\",\"不把爽快固定成吵架或粗口\",\"不让所有人都自称姐、开口喊哥\"],\"scenes\":{\"greeting\":[\"搁这儿呢？我刚才还寻思你走了。\",\"你啥时候回来的？也没提前吱一声。\",\"早啊，今儿起挺早呗。\",\"好几天没瞅见你了，最近忙啥呢？\"],\"meal\":[\"你吃饭没？我还没顾上整口热乎的。\",\"别点那么老多，咱俩吃不完。\",\"这家我吃过，味儿还行，咸淡你先尝尝。\",\"我寻思整点儿面条得了，吃完再溜达。\"],\"work\":[\"我这头还差一点儿，整完就下班。\",\"别催了，交班那人还没来呢。\",\"今儿忙得脚不沾地，水都没顾上喝。\",\"临时替她顶一会儿，几点走我再给你信儿。\"],\"travel\":[\"你搁哪儿呢？我到路口了。\",\"先别往前骑，瞅见红招牌往左拐。\",\"车没电了，我寻思推到前头充一会儿。\",\"你慢点儿走，我就在门口等着，不着急。\"],\"money\":[\"这笔咋算的？咱把单子翻出来瞅瞅。\",\"钱收到了，回头咱对一下数。\",\"甭都让你掏，这回我来吧。\",\"借你的我记着呢，发了工资就还，差多少咱说明白。\"],\"weather\":[\"外头风老大了，你把拉链拉上。\",\"刚才还好好的，咋说下雨就下雨。\",\"热得我不想动，先搁这儿凉快会儿。\",\"这天儿瞅着不稳当，出门带把伞吧。\"],\"plans\":[\"明儿几点合适？我得先瞅瞅班表。\",\"今儿怕是赶不上了，咱换明儿成不？\",\"你先忙你的，定下来给我吱一声。\",\"咱别光说改天，挑个都不忙的点儿。\"],\"care\":[\"累了就歇会儿呗，非撑着干啥。\",\"到家给我回个信儿，省得我惦记。\",\"还疼啊？先别逞能，找人看看去。\",\"别搁那儿熬了，眼睛都睁不开了。\"],\"banter\":[\"哎呀，夸你两句还给你美上了。\",\"你可拉倒吧，刚才是谁先笑的？\",\"行，算你会唠，这句我爱听。\",\"咋的，今儿还专门捯饬了一下啊？\"],\"boundary\":[\"先别闹，我这儿还忙着呢。\",\"这事儿我不乐意，咱换个话题。\",\"你问我再决定呗，咋还替我答应上了。\",\"今儿真不去了，我想自己歇会儿。\"],\"repair\":[\"你先听我唠完，不是你寻思那回事儿。\",\"刚才那话我说急了，咱重新说。\",\"我没说不去，我说得晚点儿。\",\"哪儿没对上咱说明白，别自己搁那儿猜。\"],\"chat\":[\"嗯，我瞅见了，等会儿跟你说。\",\"先搁这儿吧，回头我来收拾。\",\"我刚才寻思了半天，还是这么整省事儿。\",\"你接着唠，我听着呢。\"],\"moments\":[\"今儿总算忙完了，整口热乎的再回家。\",\"这会儿河边风挺得劲儿，溜达一圈。\",\"寻思早点儿下班，结果又赶上补货。\",\"拍糊了也发吧，今儿就留个念想。\"],\"live\":[\"刚进来的先坐会儿，今儿唠点啥？\",\"看见你那条了，等我把话唠完。\",\"别着急刷，搁这儿听我唠也挺好。\",\"这歌我会一点儿，你们可别笑我跑调。\"],\"selfie\":[\"刚拍的，瞅瞅这张清不清楚。\",\"我挑半天了，就这张还挺精神。\",\"别笑啊，风给我头发吹乱套了。\",\"等会儿，我换个亮堂地儿再拍一张。\"]}},\"zhongyuan\":{\"label\":\"河南中原话\",\"aliases\":[\"河南\",\"中原\",\"豫\",\"洛阳\",\"郑州\"],\"sample\":\"恁搁这儿等会儿，中不中？俺对完账就来。\",\"grammar\":[\"答应用中、商量用中不中，问事用弄啥哩、咋弄\",\"俺或我、恁或你随本人档案与相处习惯保持一致\",\"哩用于合适语气，白闹、怪好等随意思出现\"],\"avoid\":[\"不把每句都改成恁加哩\",\"不用口头词替代清楚的事情和理由\",\"不把河南口音统一写成憨厚或讨好\"],\"scenes\":{\"greeting\":[\"恁搁这儿弄啥哩？我才瞅见恁。\",\"回来也不说一声，俺还以为恁忙着哩。\",\"早啊，恁吃过饭没有？\",\"好些天没碰着了，这阵子咋样？\"],\"meal\":[\"俺还没吃哩，恁要不一块儿？\",\"少点两个菜吧，够咱吃就中。\",\"这家汤怪得劲，恁先尝尝咸淡。\",\"恁想吃啥？俺都中，别光顾着问俺。\"],\"work\":[\"俺这单还没弄完哩，恁等一小会儿。\",\"交班的人还没来，现在走不中。\",\"今儿忙一晌了，才顾上坐下喝口水。\",\"俺先把货对上，忙完了给恁回话。\"],\"travel\":[\"恁到哪儿了？俺在路口等着哩。\",\"白往里走了，过了那家店就拐。\",\"电驴没电了，俺得先找个地方充上。\",\"恁骑慢点，俺又不急这一会儿。\"],\"money\":[\"这钱咋算哩？咱对一下单子。\",\"恁转的俺收着了，数俺再核核。\",\"这回俺来付就中，恁白抢了。\",\"欠恁的俺记着，啥时候还得先说准。\"],\"weather\":[\"外头风怪大，恁多披一件。\",\"刚还晴着哩，咋一转眼就落雨了。\",\"热得慌，咱找个凉快地方坐会儿。\",\"瞅这天怕是还得下，恁带着伞吧。\"],\"plans\":[\"明儿俺得先看看排班，晚点回恁中不中？\",\"今儿怕赶不及，咱改到明儿吧。\",\"恁定准了跟俺说一声，俺好腾时候。\",\"白光说改天了，咱挑个都闲的日子。\"],\"care\":[\"累了就歇歇，恁白硬撑着。\",\"到家了回俺一声，省得俺挂心。\",\"还疼哩？那得找人瞧瞧，白拖了。\",\"都这点了，恁还不睡弄啥哩？\"],\"banter\":[\"才夸恁一句，恁还美上了。\",\"恁白逗俺，俺正说事儿哩。\",\"中，这回算恁说得在理。\",\"今儿收拾得怪好，是专门来的？\"],\"boundary\":[\"白闹了，俺还忙着哩。\",\"这事俺不想应，恁别替俺做主。\",\"先问问俺中不中，哪能恁说了就算。\",\"今儿真不中，俺想早点回去歇着。\"],\"repair\":[\"恁先听俺说完，不是那个意思。\",\"刚那句话俺说急了，咱慢慢说。\",\"俺没说不去，俺是说得晚点。\",\"哪儿没对上咱讲清，白光搁心里猜。\"],\"chat\":[\"中，俺知道了，忙完就回恁。\",\"先搁这儿吧，等会儿俺来弄。\",\"俺寻思这么办怪省事，恁看中不中。\",\"恁接着说，俺听着哩。\"],\"moments\":[\"总算忙完了，先吃口热饭再回。\",\"今儿河边怪凉快，出来转一圈。\",\"本来想早下班，谁知道又来货了。\",\"这张拍得还中，留着当个记号。\"],\"live\":[\"刚来的坐会儿，恁想听俺聊啥？\",\"恁那条俺瞅见了，等俺说完这句。\",\"白急着送礼，陪俺说会儿话就中。\",\"这歌俺只会一段，唱跑了恁可别笑。\"],\"selfie\":[\"才拍好，恁瞅瞅清楚不清楚。\",\"挑了一会儿，俺看这张还中。\",\"头发叫风吹乱了，恁白笑。\",\"等俺换个亮地方，再给恁拍一张。\"]}},\"beijing\":{\"label\":\"北京话\",\"aliases\":[\"北京\",\"京腔\",\"京片子\",\"京话\",\"廊坊\",\"承德\",\"燕郊\",\"三河\",\"固安\",\"滦平\"],\"sample\":\"您甭急，这点儿事儿咱先捋清楚，成吗？\",\"grammar\":[\"商量用成吗、得，否定用甭、别介，叙事有咱先……回头……的节奏\",\"儿化落在会儿、点儿、这儿、信儿等自然位置\",\"您用于本人客气或调侃习惯，熟悉时可自然用你\",\"廊坊、承德、燕郊、三河、固安、滦平来的人说同一口京片子，只是比北京南城少几分贫嘴、多几分实在\"],\"avoid\":[\"不在每个字后硬加儿\",\"不句句您猜怎么着或爷们儿\",\"不把京腔演成相声台词，正经事能直说\"],\"scenes\":{\"greeting\":[\"哟，您也在这儿呢？我刚没瞧见。\",\"什么时候回来的，也不递个信儿。\",\"早啊，今儿怎么起这么早？\",\"有日子没碰见了，最近忙什么呢？\"],\"meal\":[\"你吃了吗？我正寻摸吃点儿什么呢。\",\"甭点那么多，够咱俩吃就成。\",\"这家我来过，您先尝尝，味儿还成。\",\"先垫吧两口，回头再慢慢逛。\"],\"work\":[\"我这儿还差个收尾，弄完就能走。\",\"甭催，接班那位还没露面儿呢。\",\"忙一下午了，刚得空喝口水。\",\"临时替人看会儿店，几点走我再跟你说。\"],\"travel\":[\"您到哪儿了？我就在路口这儿。\",\"先别往里走，瞧见红招牌往左拐。\",\"车没电了，我得先找地儿充上。\",\"慢点儿骑，我都到了，还能跑了不成。\"],\"money\":[\"这笔怎么记的？咱一条条捋，甭着急。\",\"钱瞧见了，我回头对一下数。\",\"别介，这回说好了我请。\",\"借你的我记着呢，还款的日子咱先定明白。\"],\"weather\":[\"外头风可不小，您把外套披上。\",\"这天说变就变，刚才还晒着呢。\",\"热得够呛，先找个地儿凉快会儿。\",\"瞧这天色不对，带把伞踏实点儿。\"],\"plans\":[\"明儿几点合适？我先瞧瞧班表。\",\"今儿怕是来不及了，咱改明儿成吗？\",\"你先忙，定下来给我递个信儿。\",\"别光说改天啊，咱挑个准日子。\"],\"care\":[\"累了就歇会儿，甭硬扛着。\",\"到家跟我说一声，省得我惦记。\",\"还疼呢？那甭拖了，找人看看去。\",\"眼睛都快睁不开了，您还熬着呢？\"],\"banter\":[\"得，夸您一句，还真当回事儿了。\",\"少来这套，刚才谁先乐的？\",\"行，这句还挺像样儿，我听着顺耳。\",\"今儿捯饬得挺齐整啊，什么安排？\"],\"boundary\":[\"先别逗了，我这儿还没忙完呢。\",\"这事儿我不答应，咱聊点儿别的。\",\"您先问问我啊，怎么还替我应下了？\",\"今儿真不去了，我想早点儿歇着。\"],\"repair\":[\"先听我把话说完，您理解岔了。\",\"刚才我话赶话了，咱重新说。\",\"我不是不去，我是得晚点儿。\",\"哪儿没说明白咱摊开说，甭自己瞎琢磨。\"],\"chat\":[\"得，我瞧见了，回头细说。\",\"先放这儿吧，一会儿我收拾。\",\"我琢磨这么办省事儿，你觉得呢？\",\"您接着说，我听着呢。\"],\"moments\":[\"忙完收工，寻摸点儿热乎的吃。\",\"今儿河边挺凉快，出来走两步。\",\"想赶个早下班，得，又来一车货。\",\"这张就算留个影儿吧，拍得还成。\"],\"live\":[\"新来的先坐会儿，您想聊点儿什么？\",\"瞧见您那条了，容我把这话说完。\",\"甭急着送礼，陪我聊两句就挺好。\",\"这歌我会半段，唱岔了您多担待。\"],\"selfie\":[\"刚拍的，您瞧这张清楚吗？\",\"挑来挑去，就这张还像点儿样。\",\"风把头发吹散了，您可甭笑。\",\"等我寻个亮堂地儿，再补一张。\"]}},\"sichuan\":{\"label\":\"川渝话\",\"aliases\":[\"四川\",\"川渝\",\"川话\",\"成都\",\"重庆\"],\"sample\":\"莫慌嘛，我这头弄完就来。你到了喊我一声哈。\",\"grammar\":[\"问办法用咋个、问事用啥子，否定自然用莫、没得、不得行\",\"动词后用起、到须符合语意，程度可用得很、安逸\",\"哈、嘛、噻随提醒、商量、解释变化，成都和重庆细词服从本人籍贯\"],\"avoid\":[\"不每句都连用嘛噻哈\",\"不用瓜娃子代替所有称呼\",\"不把川渝人物统一成大嗓门，轻声和正经话也有本人口音\"],\"scenes\":{\"greeting\":[\"你在这儿嗦？我刚才都没看到。\",\"啥时候回来的嘛，也不先说一声。\",\"早嘛，今天咋个起得这么早？\",\"好久没碰到了，这阵子在忙啥子？\"],\"meal\":[\"你吃饭没得？我还没顾得上吃。\",\"莫点恁个多，够我们两个吃就行。\",\"这家味道还可以，你先尝哈辣不辣。\",\"先吃点东西垫起嘛，饿着逛啥子。\"],\"work\":[\"我这边还没弄完，等我一哈儿。\",\"接班的还没来，现在哪个走得脱嘛。\",\"忙了一下午，才坐到喝口水。\",\"我先帮她顶到，几点下班再给你说。\"],\"travel\":[\"你到哪点了？我在路口等到的。\",\"莫往里头走，看到红招牌就往左拐。\",\"车子没得电了，我先找个地方充起。\",\"你骑慢点嘛，我又没催你。\"],\"money\":[\"这笔钱咋个算的？先把单子拿来对哈。\",\"钱收到了，我等哈核一下数。\",\"说好这回我来，你莫抢到付嘛。\",\"借你的我记到的，啥时候还先说清楚。\"],\"weather\":[\"外头风大得很，你把衣服穿起。\",\"刚才太阳还那么大，这哈就下雨了。\",\"热得遭不住，先找个凉快地方坐哈。\",\"看起还要下雨，你把伞带到哈。\"],\"plans\":[\"明天我先看哈班表，晚点给你说。\",\"今天怕是来不及了，改到明天要得不？\",\"你定好了喊我一声，我好留时间。\",\"莫光说改天嘛，选个都得空的日子。\"],\"care\":[\"累了就歇一哈，莫硬撑到。\",\"到家给我说一声哈，免得我挂到。\",\"还痛嗦？那就去看哈，莫一直拖。\",\"都打瞌睡了，你还不去睡嘛。\"],\"banter\":[\"才夸你两句，你就开始得意了嗦。\",\"你莫逗，我在说正事。\",\"要得，这句话我听起还舒服。\",\"今天打整得乖得很嘛，准备去哪儿？\"],\"boundary\":[\"先莫闹，我手头还有事。\",\"这个我不想答应，换个话题嘛。\",\"你先问下我噻，咋个直接帮我答应了。\",\"今天真不得行，我想早点回去歇到。\"],\"repair\":[\"你先听我说完，不是你想那个意思。\",\"刚才我说急了，重新摆嘛。\",\"我没说不去，我是说要晚点。\",\"哪点没对上就说清楚，莫自己闷到想。\"],\"chat\":[\"要得，我看到了，等哈回你。\",\"先放这儿嘛，等我来收拾。\",\"我想起这样弄省事些，你看喃？\",\"你接到说嘛，我在听。\"],\"moments\":[\"总算忙完了，吃点热的再回去。\",\"今天河边风吹起安逸，出来走哈。\",\"想早点下班，结果又来一批货。\",\"这张拍得还要得，留起算个纪念。\"],\"live\":[\"新来的坐一哈嘛，今天想摆啥子？\",\"看到你发的了，等我先把这句说完。\",\"莫忙到送礼，陪我摆哈龙门阵就要得。\",\"这首歌我只会一段，唱错了莫笑我哈。\"],\"selfie\":[\"刚拍的，你看清楚没得？\",\"选了半天，这张看起还要得。\",\"头发都吹乱了，你莫笑。\",\"等我换个亮点的地方再拍哈。\"]}},\"cantonese\":{\"label\":\"粤语·广州日常口语\",\"aliases\":[\"粤语\",\"粵語\",\"广东话\",\"廣東話\",\"广州话\",\"廣州話\",\"广府话\",\"廣府話\",\"Cantonese\",\"yue\"],\"sample\":\"你食咗饭未？我仲喺铺头，收工再搵你。\",\"grammar\":[\"判断用係、处所用喺；我你佢、呢个嗰个、边度乜嘢自然组织整句\",\"否定用唔或冇，完成用咗、进行用紧、尚且用仲；问句用有冇、得唔得、……未\",\"使用食、饮、返、搵、睇、畀、攞等日常动词，正文简体为主，保留係喺唔冇咗嘅啲等口语字\"],\"avoid\":[\"不把普通话加几个啦喎就当粤语\",\"不用咩替代所有问句，不堆粤语粗口或港片警匪台词\",\"广州粤语作当前底本，人物籍贯不自动改成香港；潮汕话和客家话不混进来\"],\"scenes\":{\"greeting\":[\"你喺呢度呀？我头先都睇唔到你。\",\"几时返嚟㗎？又唔提早讲声。\",\"早晨，今日咁早起身嘅？\",\"好耐冇见，呢排忙唔忙呀？\"],\"meal\":[\"你食咗饭未？我仲未得闲食。\",\"唔使叫咁多，够我哋两个食就得。\",\"呢间我食过，你试吓啱唔啱口味。\",\"食啲嘢先啦，唔好饿住周围行。\"],\"work\":[\"我仲喺铺头，做埋呢单就收工。\",\"接更嗰个仲未嚟，我未走得住。\",\"忙咗成个下昼，依家先得闲饮啖水。\",\"我帮佢顶住先，几点走得再话你知。\"],\"travel\":[\"你到咗边度？我喺路口等你。\",\"唔好再入去，见到红色招牌就转左。\",\"架车冇电喇，我搵个地方充住先。\",\"你慢慢嚟啦，我又唔赶时间。\"],\"money\":[\"呢笔数点计㗎？攞张单出嚟对吓先。\",\"钱收到了，等我再对吓个数。\",\"讲好今次我畀，你唔好争啦。\",\"借你嗰笔我记得，几时还先讲清楚。\"],\"weather\":[\"出面风好大，你着返件外套啦。\",\"头先仲出太阳，依家就落雨喇。\",\"热到唔想郁，搵个阴凉位坐吓先。\",\"睇个天仲会落雨，带埋遮稳阵啲。\"],\"plans\":[\"听日我睇吓更表先，晏啲再覆你。\",\"今日赶唔切喇，改听日得唔得？\",\"你定咗就话我知，我留返时间。\",\"唔好净係讲改日，搵日大家都得闲嘅。\"],\"care\":[\"攰就唞吓啦，唔好硬撑。\",\"返到屋企讲声，费事我挂住。\",\"仲痛呀？咁去睇吓，唔好拖住。\",\"眼都擘唔大喇，你仲唔去瞓？\"],\"banter\":[\"赞你两句，你就咁得戚喇。\",\"唔好玩我啦，我讲紧正经嘢。\",\"得啦，呢句我听得顺耳。\",\"今日执到咁靓，约咗人呀？\"],\"boundary\":[\"等阵先啦，我仲有嘢做。\",\"呢件事我唔想应承，倾第二样啦。\",\"你问过我先嘛，点可以帮我应承咗。\",\"今晚真係唔去喇，我想早点返屋企。\"],\"repair\":[\"你听我讲埋先，唔係你谂嗰个意思。\",\"头先我讲得急咗，慢慢倾返啦。\",\"我唔係话唔去，係要迟少少。\",\"边度唔清楚就讲，唔好自己估估吓。\"],\"chat\":[\"得，我睇到了，阵间覆你。\",\"摆喺呢度先啦，等我嚟执。\",\"我谂咁样做省事啲，你觉得点？\",\"你继续讲啦，我听紧。\"],\"moments\":[\"终于收工，食啲热嘢先返屋企。\",\"今日河边几凉爽，出来行个圈。\",\"谂住早点收工，点知又嚟一批货。\",\"呢张影得都几好，留返做纪念。\"],\"live\":[\"啱啱入嚟嘅坐阵啦，想倾啲乜？\",\"睇到你嗰句喇，等我讲埋先。\",\"唔使急住送礼，陪我倾两句就得。\",\"呢首我识唱一段，唱错唔好笑我呀。\"],\"selfie\":[\"啱啱影嘅，你睇吓清唔清楚。\",\"拣咗一阵，呢张都算影得好。\",\"头发畀风吹乱晒，唔好笑我呀。\",\"等我搵个光啲嘅位，再影一张。\"]}},\"guangxi\":{\"label\":\"广西话·南普桂柳混搭\",\"aliases\":[\"广西\",\"广西话\",\"南普\",\"桂柳\",\"南宁\",\"柳州\",\"桂林\",\"玉林\",\"钦州\",\"北海\",\"防城港\",\"桂\"],\"sample\":\"你克哪凯哦？我这头搞完手上的活就来，你等我一下啵。\",\"grammar\":[\"疑问、反问与确认自然用咩、啵、啵喂，商量或柔和收尾用捏、咧、咯\",\"去用克、哪里用哪凯、这样/怎么用更子、承受得住用顶得顺，按语境自然带出\",\"日常句子保持清爽利落的南普节奏，友女、酸嘢、公道等词随生活话题出现\"],\"avoid\":[\"不每句话都硬塞一串咩啵捏咧\",\"不写成外地人完全看不懂的生僻土白话，也不把广州纯粤语整句照搬过来\",\"不把广西口音写成只会吵架或搞怪网红腔，安静关心和说正事时同样自然\"],\"scenes\":{\"greeting\":[\"你在这凯啊？我刚才都没看见你啵。\",\"几时回来的哦？也不提前跟我讲一声。\",\"早啵，今天更子起得这么早？\",\"好久没见你露面咯，这阵子忙咩捏？\"],\"meal\":[\"你吃饭没哦？我肚子都饿扁去咯。\",\"莫点那么多啵，我们两个哪吃得完。\",\"这家粉味道几正宗的，你先尝一口看合不合胃口啵。\",\"先吃点热乎的垫下肚子咧，饿着克逛街顶不顺的。\"],\"work\":[\"我这头还差一点收尾，搞完就能下班咯。\",\"莫催我啵，交班那个友女还没到捏。\",\"今天忙得我头都昏埋，现在才得闲喝口水。\",\"我先帮她顶一下班，几点走得脱我再发消息给你啵。\"],\"travel\":[\"你克到哪凯了？我就在路口这头等你啵。\",\"莫再往里头骑咯，看见那个红招牌往左拐就是。\",\"电驴没电去咯，我得先推克前头充一下。\",\"你骑慢点啵，我又没催你，安全要紧捏。\"],\"money\":[\"这笔数更子算的哦？拿单子出来我们对一下先。\",\"你转过来的钱我收到咯，等下我再核一下数啵。\",\"讲好这顿我请的嘛，你莫跟我抢着买单啵。\",\"借你的那笔我记着捏，发了工资哪天还我们先讲清楚。\"],\"weather\":[\"外头风大得很