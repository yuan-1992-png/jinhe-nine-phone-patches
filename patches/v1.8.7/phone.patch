'.homebar');\n  homebar.tabIndex=0;homebar.setAttribute('role','button');homebar.setAttribute('aria-label','返回桌面');\n  homebar.addEventListener('click',()=>openPage('home'));\n  homebar.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();openPage('home');}});\n  submit['chat-form']=osSendChat;submit['os-live-form']=osLiveSubmit;\n  const originalSettingsSubmit=submit['settings-form'];\n  submit['settings-form']=form=>{\n    originalSettingsSubmit(form);\n    if(osIsHosted())jinheBridge.setChatConfig?.({...settings.chat});\n  };\n  actions['confirm-payment']=confirmPayment;\n  actions['image-dialog']=({kind,id})=>osImageDialog(kind,id);\n  bootImageSettings();\n  const oldHubSubmit=submit['hub-form'];\n  submit['hub-form']=form=>{\n    if (hubPage!=='camera') return oldHubSubmit(form);\n    const id=formValue(form,'person'),p=person(id);\n    if (!p) return;\n    osImageDialog('portrait',id);\n    const place=places.get(formValue(form,'cameraPlace'))||scene();\n    modalContext.place={...scene(),location_name:place.name||place.location_name};\n    $('image-form').elements.prompt.value=imagePrompt('portrait',p,formValue(form,'angle'),modalContext.place,settings.image.style);\n    syncImageOptions($('image-form'));\n  };\n  Object.assign(actions,{\n    'os-app':({id})=>id.startsWith('hub:')?selectHubModule(id.slice(4)):id==='editor'?actions['edit-open']({}):openPage(id),\n    'os-chat-tab':({id})=>{osTab=id;openPage('contacts');},\n    'os-proactive':()=>{\n      const enable=()=>{state.proactiveEnabled=true;save();closeModal();render();osIsHosted()&&jinheBridge.inboxSettings?.(true);};\n      if (state.proactiveEnabled) {state.proactiveEnabled=false;save();osIsHosted()&&jinheBridge.inboxSettings?.(false);render();return;}\n      modal('开启好友主动来信','\u003cp class=\"hint\">正文推进后，手机会偶尔向当前选择的聊天模型请求一条好友消息。使用独立接口时按该服务计费。每轮最多生成一条。\u003c/p>\u003cdiv class=\"buttons\">'+btn('开启','os-proactive-confirm',{},'primary')+'\u003c/div>');\n      actions['os-proactive-confirm']=enable;\n    },\n    'os-summary':()=>typeof openPhoneSummary==='function'?openPhoneSummary():openDraft(),\n    'os-lock':()=>osSetLock(true),'os-unlock':()=>osSetLock(false),\n    'os-lock-messages':()=>{osSetLock(false);openPage('contacts');},\n    'os-lock-camera':()=>{osSetLock(false);selectHubModule('camera');},\n    'os-island':()=>{\n      if(section==='call')return;\n      if(osTotalUnread())openPage('contacts');\n      else if(Object.values(state.phoneFeedback||{}).some(item=>item.running))selectHubModule('pulse');\n      else osSetLock(true);\n    },\n    'os-banner-open':({id})=>{osSetLock(false);$('os-banner').hidden=true;openPage('chat',id);},\n    'os-voice-mode':()=>{osVoice=!osVoice;render();},\n    'os-group-open':({id})=>{\n      activeGroup=id;\n      const group=groupById(id);\n      if(group){\n        group.readAt=Date.now();\n        try { saveGroup(group); } catch { /* 读取仍可用时保留群聊查看入口。 */ }\n      }\n      section='group';render();\n    },\n    'os-group-create':()=>{\n      const friends=state.friends.map(person).filter(Boolean);\n      if(friends.length\u003c2){notify('先加两位微信好友，才能建群。');return;}\n      modal('发起群聊','\u003cform class=\"form\" id=\"os-group-form\">'+\n        field('群名称','name',groupPresetNames[0],'text','maxlength=\"20\" required')+\n        '\u003cp class=\"hint\">从好友里勾 2 到 6 位，建好之后就能在群里说话、发群红包。\u003c/p>'+\n        '\u003cdiv class=\"stack\">'+friends.map(p=>'\u003clabel class=\"os-check\">\u003cinput type=\"checkbox\" name=\"members\" value=\"'+esc(p.id)+'\"> '+\n          esc(p.name)+' · '+esc(p.dialect_label)+'\u003c/label>').join('')+'\u003c/div>'+\n        '\u003cdiv class=\"buttons\">'+groupPresetNames.map(name=>btn(name,'os-group-preset',{name})).join('')+'\u003c/div>'+\n        '\u003cbutton class=\"primary\" type=\"submit\">建群\u003c/button>\u003c/form>');\n    },\n    'os-group-preset':({name})=>{\n      const field=$('os-group-form')?.elements.name;\n      if(field)field.value=name;\n    },\n    'os-group-settings':({id})=>{\n      const group=groupById(id);\n      if(!group)return;\n      const members=group.members.map(person).filter(Boolean).map(p=>p.name).join('、');\n      modal(group.name,'\u003cdiv class=\"stack\">\u003cp class=\"hint\">成员：'+esc(members)+'\u003c/p>'+\n        '\u003cdiv class=\"buttons\">'+btn('删除这个群','os-group-delete',{id})+'\u003c/div>\u003c/div>');\n    },\n    'os-group-context':({id})=>{\n      const group=groupById(id);\n      if(!group)return;\n      group.storyEnabled=!group.storyEnabled;\n      try {saveGroup(group);render();notify(group.storyEnabled?'这个群最近的对话将随正文发送。':'已停止把这个群的对话发给正文。');}\n      catch(error){notify(error.message);}\n    },\n    'os-group-delete':({id})=>{\n      if(waits.has('group-pay:'+id)){notify('这个群的红包还在处理。');return;}\n      try{removeGroup(id);}catch(error){notify(error.message);return;}\n      if(activeGroup===id){activeGroup='';section='contacts';}\n      closeModal();render();notify('已退出这个群');\n    },\n    'os-group-gift':({id})=>{\n      const group=groupById(id);\n      if(!group)return;\n      modal('发群红包','\u003cform class=\"form\" id=\"os-group-gift-form\" data-id=\"'+esc(id)+'\">'+\n        field('金额（元）','amount','66','number','min=\"1\" max=\"999999999999\" step=\"1\" required')+\n        '\u003cdiv class=\"buttons\">'+[['66','66 元'],['188','188 元'],['520','520 元']].map(([value,label])=>\n          btn(label,'os-group-gift-amount',{value})).join('')+'\u003c/div>'+\n        '\u003cp class=\"hint\">按群成员人数均摊，每人都会收到一点，好感各加一点。\u003c/p>'+\n        '\u003cbutton class=\"primary\" type=\"submit\">发出去\u003c/button>\u003c/form>');\n    },\n    'os-group-gift-amount':({value})=>{\n      const input=$('os-group-gift-form')?.elements.amount;\n      if(input)input.value=value;\n    },\n    'os-voice-text':({index})=>{const line=conversation(activePerson)[Number(index)];if(line){line.expanded=!line.expanded;save();render();}},\n    // 点语音条：按这个角色绑定的声线真念出来。念不了就把文字展开，并说明原因。\n    'os-voice-play