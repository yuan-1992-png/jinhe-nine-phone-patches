e] of Object.entries(theme.colors))root.style.setProperty('--jh-theme-'+key.replace(/[A-Z]/g,letter=>'-'+letter.toLowerCase()),value);\n  for(const [key,value] of Object.entries(theme.ui)){\n    if(key!=='fontFamily')root.style.setProperty('--jh-theme-'+key.replace(/[A-Z]/g,letter=>'-'+letter.toLowerCase()),value+(key==='columns'||key==='wallpaperDim'?'':'px'));\n  }\n  root.style.setProperty('--jh-theme-font',fonts[theme.ui.fontFamily]);\n  for(const [key,value] of Object.entries({ink:theme.colors.text,quiet:theme.colors.muted,line:theme.colors.border,panel:theme.colors.surface,deep:theme.colors.background,lime:theme.colors.accent}))root.style.setProperty('--'+key,value);\n  const home=document.querySelector('.os-home');\n  if(home)home.style.setProperty('--os-wallpaper','url('+JSON.stringify(theme.wallpaper||photoURL(photos.find(photo=>photo.id===state.wallpaper))||osAsset(scene().location_id))+')');\n  if(osIsHosted())jinheBridge.setAppearance?.({background:theme.colors.background,surface:theme.colors.surface,accent:theme.colors.accent,accentText:theme.colors.accentText,persist});\n}\nfunction phoneThemeSaveLibrary(next) {\n  const serialized=JSON.stringify(next);\n  if(serialized.length>2800000)throw Error('主题库空间不足，请删掉不用的主题，或使用较小的壁纸。');\n  try{localStorage.setItem(phoneThemeKey,serialized);}catch{throw Error('浏览器未能保存主题。请清理空间后重试，或先导出主题。');}\n  phoneThemeLibrary=next;\n}\nfunction phoneThemeSwitch(id) {\n  const item=[...phoneThemeBuiltins,...phoneThemeLibrary.custom].find(item=>item.id===id);\n  if(!item)throw Error('没有找到这套主题。');\n  phoneThemeSaveLibrary({...phoneThemeLibrary,active:id});\n  phoneThemeDraft=phoneThemeClone(item.theme);phoneThemeDirty=false;phoneThemeApply(item.theme);\n  phoneThemeStatus='已切换并保存 · '+item.theme.name;render();\n}\nfunction phoneThemeImport(text) {\n  if(text.length>phoneThemeMaxBytes)throw Error('主题文件过大，最多支持 1.2 MB。');\n  let value;try{value=JSON.parse(text);}catch{throw Error('JSON 无法读取，请检查括号、引号和逗号。');}\n  const theme=normalizePhoneTheme(value);\n  if(phoneThemeLibrary.custom.length>=phoneThemeLimit)throw Error('最多保存 12 套自建主题，请先删除一套。');\n  const id='custom-'+uid();\n  phoneThemeSaveLibrary({...phoneThemeLibrary,active:id,custom:[...phoneThemeLibrary.custom,{id,theme}]});\n  phoneThemeDraft=phoneThemeClone(theme);phoneThemeDirty=false;phoneThemeApply(theme);\n  return theme;\n}\nfunction phoneThemeExport(theme) {\n  const blob=new Blob([JSON.stringify(normalizePhoneTheme(theme),null,2)],{type:'application/json'}),url=URL.createObjectURL(blob);\n  const link=document.createElement('a');link.href=url;link.download=theme.name.replace(/[\u003c>:\"/\\\\|?*\\x00-\\x1f]/g,'_')+'.九号机主题.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1500);\n}\nfunction phoneThemePreview(theme) {\n  return '\u003cdiv class=\"jh-theme-preview\" aria-label=\"主题效果预览\">\u003cdiv class=\"jh-theme-preview-top\">'+esc(theme.name)+'\u003cspan>九号\u003c/span>\u003c/div>\u003cdiv class=\"jh-theme-preview-icons\">'+\n    ['contacts','photo','heart','settings'].map(glyph=>'\u003cspan>'+icon(glyph)+'\u003c/span>').join('')+'\u003c/div>\u003cdiv class=\"jh-theme-preview-message\">今天用这套主题。\u003c/div>\u003cdiv class=\"jh-theme-preview-message self\">好看，存下来。\u003c/div>\u003c/div>';\n}\nfunction phoneThemeField(label,path,value,type='color',attrs='') {\n  return '\u003clabel>'+label+'\u003cinput class=\"input\" type=\"'+type+'\" data-theme-path=\"'+path+'\" value=\"'+esc(value)+'\" '+attrs+'>\u003c/label>';\n}\nfunction renderPhoneThemes() {\n  phoneThemeDraft ||= phoneThemeClone(phoneThemeCurrent());\n  const theme=phoneThemeDraft,all=[...phoneThemeBuiltins,...phoneThemeLibrary.custom];\n  const themeCards=all.map(({id,theme})=>'\u003cbutton class=\"jh-theme-pick\" data-do=\"theme-switch\" data-id=\"'+id+'\" aria-pressed=\"'+(phoneThemeLibrary.active===id)+'\" style=\"--swatch-bg:'+theme.colors.background+';--swatch-accent:'+theme.colors.accent+';--swatch-text:'+theme.colors.text+'\">'+\n    '\u003cspan class=\"jh-theme-swatch\">\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003c/span>\u003cstrong>'+esc(theme.name)+'\u003c/strong>\u003csmall>'+(phoneThemeLibrary.active===id?'正在使用':id.startsWith('custom-')?'我的主题':'内置主题')+'\u003c/small>\u003c/button>').join('');\n  const range=(label,key,min,max,step=1)=>phoneThemeField(label,'ui.'+key,theme.ui[key],'range','min=\"'+min+'\" max=\"'+max+'\" step=\"'+step+'\" aria-label=\"'+label+'\"')+'\u003coutput data-theme-output=\"'+key+'\">'+theme.ui[key]+'\u003c/output>';\n  return '\u003csection class=\"jh-theme-manager\">\u003cdiv class=\"jh-theme-library\">'+themeCards+'\u003c/div>\u003cdiv class=\"buttons jh-theme-tools\">'+btn('导入 JSON','theme-import')+btn('导出当前主题','theme-export')+btn('下载模板','theme-template')+'\u003c/div>'+\n    '\u003cinput id=\"phone-theme-file\" type=\"file\" accept=\".json,application/json\" hidden>\u003cp id=\"phone-theme-status\" class=\"feedback\" role=\"status\">'+esc(phoneThemeStatus||'主题保存在当前浏览器，可导出 JSON 带到其他设备。')+'\u003c/p>'+\n    '\u003cdetails class=\"jh-theme-paste\">\u003csummary>粘贴主题 JSON\u003c/summary>\u003ctextarea id=\"phone-theme-paste\" class=\"input\" rows=\"5\" placeholder=\"粘贴完整的九号机主题 JSON\" aria-label=\"主题 JSON\">\u003c/textarea>'+btn('读取并应用','theme-paste')+'\u003c/details>'+\n    '\u003cform id=\"phone-theme-form\" class=\"form\">\u003cdiv class=\"jh-theme-edit-head\">\u003ch3>调整这套界面\u003c/h3>\u003cspan id=\"phone-theme-draft-state\">'+(phoneThemeDirty?'预览中 · 尚未保存':'改动时即时预览')+'\u003c/span>\u003c/div>'+phoneThemePreview(theme)+\n    phoneThemeField('主题名称','name',theme.name,'text','maxlength=\"30\" required')+\n    '\u003cdiv class=\"pair\">\u003clabel>明暗模式\u003cselect data-theme-path=\"mode\">'+option('dark','深色',theme.mode)+option('light','浅色',theme.mode)+'\u003c/select>\u003c/label>\u003clabel>字体\u003cselect data-theme-path=\"ui.fontFamily\">'+Object.entries(phoneThemeFonts).map(([id,label])=>option(id,label,theme.ui.fontFamily)).join('')+'\u003c/select>\u003c/label>\u003c/div>'+\n    '\u003cdetails open>\u003csummary>配色与聊天气泡\u003c/summary>\u003cdiv class=\"jh-theme-colors\">'+Object.entries(phoneThemeColors).map(([key,label])=>phoneThemeField(label,'colors.'+key,theme.colors[key])).join('')+'\u003c/div>\u003c/details>'+\n    '\u003cdetails>\u003csummary>图标、圆角与排版\u003c/summary>\u003cdiv class=\"jh-theme-ranges\">'+range('卡片圆角','cardRadius',0,28)+range('图标圆角','iconRadius',0,30)+range('图标大小','iconSize',40,60)+range('文字大小','fontSize',12,18)+range('毛玻璃程度','blur',0,24)+range('壁纸遮罩浓度','wallpaperDim',0,1,0.05)+'\u003c/div>'+\n    '\u003clabel>桌面列数\u003cselect data-theme-path=\"ui.columns\">'+option('4','每行四个',String(theme.ui.columns))+option('3','每行三个',String(theme.ui.columns))+'\u003c/select>\u003c/label>\u003c/details>'+\n    '\u003cdetails>\u003csummary>桌面应用图标与名称\u003c/summary>'+Object.entries(phoneThemeAppNames).map(([id,label])=>{\n      const current=theme.icons[id]||{};\n      return '\u003cfieldset class=\"jh-theme-icon-row\">\u003clegend>'+label+'\u003c/legend>\u003clabel>名称\u003cinput class=\"input\" data-theme-path=\"icons.'+id+'.label\" value=\"'+esc(current.label||'')+'\" placeholder=\"'+label+'\" maxlength=\"10\">\u003c/label>\u003cdiv class=\"pair\">\u003clabel>图形\u003cselect data-theme-path=\"icons.'+id+'.glyph\">'+option('','默认',current.glyph||'')+Object.entries(phoneThemeGlyphNames).map(([glyph,name])=>option(glyph,name,current.glyph||'')).join('')+'\u003c/select>\u003c/label>'+phoneThemeField('底色','icons.'+id+'.color',current.color||'#b5c9b0')+'\u003c/div>\u003c/fieldset>';\n    }).join('')+'\u003c/details>'+\n    '\u003cdetails>\u003csummary>桌面壁纸\u003c/summary>\u003cp class=\"hint\">留空时沿用相册选择或当前地点图。\u003c/p>'+phoneThemeField('HTTPS 图片网址','wallpaper',theme.wallpaper.startsWith('data:')?'':theme.wallpaper,'url','placeholder=\"https://…\"')+\n    '\u003clabel>从本机选壁纸\u003cinput id=\"phone-theme-wallpaper\" type=\"file\" accept=\"image/png,image/jpeg,image/webp\">\u003c/label>\u003cdiv class=\"buttons\">'+btn('恢复地点／相册壁纸','theme-wallpaper-reset')+'\u003c/div>\u003cp class=\"hint\">本机壁纸最多 750 KB，会一起装进主题 JSON。\u003c/p>\u003c/details>'+\n    '\u003cdiv class=\"jh-theme-save\">\u003cbutton class=\"primary\" type=\"submit\">保存并应用\u003c/button>'+btn('另存为新主题','theme-save-copy')+btn('放弃预览','theme-cancel')+'\u003c/div>\u003c/form>'+\n    (phoneThemeLibrary.active.startsWith('custom-')?'\u003cdiv class=\"buttons jh-theme-delete\">'+btn('删除当前自建主题','theme-delete')+'\u003c/div>':'')+'\u003c/section>';\n}\nfunction phoneThemeStatusUpdate(text) {phoneThemeStatus=text;const el=$('phone-theme-status');if(el)el.textContent=text;}\nfunction phoneThemeDraftApply() {\n  phoneThemeDirty=true;phoneThemeApply(phoneThemeDraft,false);\n  const status=$('phone-theme-draft-state');if(status)status.textContent='预览中 · 尚未保存';\n  const title=document.querySelector('.jh-theme-preview-top');if(title)title.firstChild.textContent=phoneThemeDraft.name;\n}\nfunction phoneThemeCommit(asCopy=false) {\n  const theme=normalizePhoneTheme(phoneThemeDraft),active=phoneThemeLibrary.active;\n  const replace=!asCopy&&active.startsWith('custom-');\n  if(!replace&&phoneThemeLibrary.custom.length>=phoneThemeLimit)throw Error('最多保存 12 套自建主题，请先删除一套。');\n  const id=replace?active:'custom-'+uid();\n  const custom=replace?phoneThemeLibrary.custom.map(item=>item.id===id?{id,theme}:item):[...phoneThemeLibrary.custom,{id,theme}];\n  phoneThemeSaveLibrary({...phoneThemeLibrary,active:id,custom});\n  phoneThemeDraft=phoneThemeClone(theme);phoneThemeDirty=false;phoneThemeApply(theme);phoneThemeStatus='已保存 · '+theme.name;render();\n}\nfunction bootPhoneThemes() {\n  try {\n    const saved=JSON.parse(localStorage.getItem(phoneThemeKey));\n    if(saved){\n      phoneThemeKeys(saved,['version','active','custom'],'主题库');\n      if(saved.version!==1||!Array.isArray(saved.custom)||saved.custom.length>phoneThemeLimit)throw Error('主题库格式不正确。');\n      const ids=new Set();\n      const custom=saved.custom.map(item=>{\n        if(typeof item?.id!=='string'||!/^custom-[a-z0-9_-]{1,100}$/i.test(item.id)||ids.has(item.id))throw Error('主题编号不正确。');\n        ids.add(item.id);return {id:item.id,theme:normalizePhoneTheme(item.theme)};\n      });\n      if(![...phoneThemeBuiltins,...custom].some(item=>item.id===saved.active))throw Error('正在使用的主题已丢失。');\n      phoneThemeLibrary={version:1,active:saved.active,custom};\n    }\n  } catch(error){phoneThemeStatus='已暂用默认主题，原主题库未覆盖。'+error.message;}\n  phoneThemeApply(phoneThemeCurrent());\n  names.settings='九号机设置';\n  screens.settings=()=>{\n    const tabs=[['chat','聊天模型'],['image','画图接口'],['tts','语音'],['prompts','提示词'],['theme','界面主题']];\n    const panels={\n      tts:['语音朗读与试听',ttsSettingsPanel],\n      prompts:['自定义生成内容',renderPhonePromptEditor],\n      theme:['你的界面，随时换一套',renderPhoneThemes],\n    };\n    const [subtitle,showPanel]=panels[settingsTab]||['聊天模型与画图接口',()=>settingsForm(settingsTab,settings[settingsTab])];\n    header(names.settings,subtitle);\n    const memory=settingsTab==='chat'?renderPhoneMemorySettings():'';\n    const content=memory+showPanel();\n    return '\u003cdiv class=\"pad\">\u003cdiv class=\"buttons jh-settings-tabs\">'+tabs.map(([id,label])=>'\u003cbutton class=\"filter\" data-do=\"settings-tab\" data-page=\"'+id+'\" aria-pressed=\"'+(settingsTab===id)+'\">'+label+'\u003c/button>').join('')+'\u003c/div>'+content+'\u003c/div>';\n  };\n  const attempt=fn=>{try{return fn();}catch(error){phoneThemeStatusUpdate(error.message);}};\n  Object.assign(actions,{\n    'theme-switch':({id})=>attempt(()=>phoneThemeSwitch(id)),\n    'theme-import':()=>$('phone-theme-file').click(),\n    'theme-paste':()=>attempt(()=>{const theme=phoneThemeImport($('phone-theme-paste').value);phoneThemeStatus='已导入并保存 · '+theme.name;render();}),\n    'theme-export':()=>attempt(()=>phoneThemeExport(phoneThemeCurrent())),\n    'theme-template':()=>phoneThemeExport({...phoneThemeClone(phoneThemeDefault),name:'我的金河主题'}),\n    'theme-save-copy':()=>attempt(()=>phoneThemeCommit(true)),\n    'theme-cancel':()=>{phoneThemeDraft=phoneThemeClone(phoneThemeCurrent());phoneThemeDirty=false;phoneThemeApply(phoneThemeDraft);phoneThemeStatus='已恢复保存的主题。';render();},\n    'theme-wallpaper-reset':()=>{phoneThemeDraft.wallpaper='';phoneThemeDraftApply();render();},\n    'theme-delete':()=>attempt(()=>{\n      phoneThemeSaveLibrary({...phoneThemeLibrary,active:'mist',custom:phoneThemeLibrary.custom.filter(item=>item.id!==phoneThemeLibrary.active)});\n      phoneThemeDraft=phoneThemeClone(phoneThemeCurrent());phoneThemeDirty=false;phoneThemeApply(phoneThemeDraft);phoneThemeStatus='已删除，恢复金河雾绿。';render();\n    })\n  });\n  submit['phone-theme-form']=()=>attempt(()=>phoneThemeCommit());\n  document.addEventListener('input',event=>{\n    const field=event.target,path=field.dataset?.themePath;if(!path||!phoneThemeDraft)return;\n    let value=field.value;\n    if(field.type==='range'||path==='ui.columns')value=Number(value);\n    const keys=path.split('.');\n    if(keys[0]==='icons'){\n      phoneThemeDraft.icons[keys[1]]||={};\n      if(value==='')delete phoneThemeDraft.icons[keys[1]][keys[2]];else phoneThemeDraft.icons[keys[1]][keys[2]]=value;\n    } else if(keys.length===2)phoneThemeDraft[keys[0]][keys[1]]=value;\n    else if(path==='wallpaper'){\n      try{value=phoneThemeWallpaperURL(value);}catch(error){phoneThemeStatusUpdate(error.message);return;}\n      phoneThemeDraft.wallpaper=value;\n    } else phoneThemeDraft[path]=value;\n    const output=document.querySelector('[data-theme-output=\"'+keys[1]+'\"]');if(output)output.textContent=value;\n    phoneThemeDraftApply();\n  });\n  document.addEventListener('change',async event=>{\n    const field=event.target;if(!['phone-theme-file','phone-theme-wallpaper'].includes(field.id))return;\n    const file=field.files?.[0],draft=phoneThemeDraft;if(!file)return;\n    try {\n      if(field.id==='phone-theme-file'){\n        if(file.size>phoneThemeMaxBytes)throw Error('主题文件过大，最多支持 1.2 MB。');\n        const text=await file.text();if(!osAlive)return;\n        const theme=phoneThemeImport(text);phoneThemeStatus='已导入并保存 · '+theme.name;render();\n      }else{\n        if(file.size>750000)throw Error('壁纸最多 750 KB，请先压缩图片。');\n        if(!['image/png','image/jpeg','image/webp'].includes(file.type))throw Error('壁纸支持 PNG、JPEG 或 WebP。');\n        const data=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(Error('图片读取失败。'));reader.readAsDataURL(file);});\n        const image=new Image();image.src=data;await image.decode();\n        if(!osAlive||phoneThemeDraft!==draft)return;\n        draft.wallpaper=phoneThemeWallpaperURL(data);phoneThemeDraftApply();phoneThemeStatus='壁纸已预览，点击保存后保留。';render();\n      }\n    }catch(error){phoneThemeStatusUpdate(error.message);}finally{field.value='';}\n  });\n  window.addEventListener('storage',event=>{if(event.key===phoneThemeKey)phoneThemeStatusUpdate('主题库已在另一页面更新，重新打开手机可同步。');});\n}\n\n// 九号机语音（TTS）。三条通道共用一套调用口：\n//  A 浏览器自带语音（Web Speech API）—— 零配置；\n//  B 酒馆宿主 TTS —— 走 jinheBridge.speakText 交给酒馆已有的 TTS 扩展；\n//  C 独立 TTS 接口 —— OpenAI /v1/audio/speech 兼容（硅基流动 FunAudioLLM、Fish Audio、GPT-SoVITS 等照此填）。\n// 默认值只有一份：页面早先定义的 tts 对象就是权威来源，这里只做兜底。\nconst ttsDefaults = typeof tts === 'object' && tts ? tts : {\n  channel: 'browser', autoRead: false, rate: 1, pitch: 1, voiceURI: '',\n  api: { base: 'https://api.openai.com', key: '', model: 'gpt-4o-mini-tts', voice: 'nova', format: 'mp3' }\n};\nconst ttsVoiceStorage = 'jinhe-phone-tts-voice-v1';\nlet activeTtsRequest;\nconst ttsVoiceProfiles = {\n  // 按方言给一套默认声线参数：语速与音调，真人味靠这两项比靠换人更稳。\n  dongbei: { rate: 1.08, pitch: 1.02, hint: '东北：爽脆、语速略快、音调略高' },\n  zhongyuan: { rate: 0.98, pitch: 1.0, hint: '河南中原：平实、语速略慢' },\n  beijing: { rate: 1.06, pitch: 0.98, hint: '北京：带儿化、尾音略压' },\n  sichuan: { rate: 1.02, pitch: 1.08, hint: '川渝：尾音上扬、音调偏高' },\n  cantonese: { rate: 0.98, pitch: 1.04, hint: '粤语：字字清楚、节奏均匀' },\n  guangxi: { rate: 1.0, pitch: 1.05, hint: '广西：南普腔、句尾软' },\n};\n// 每个角色可以单独绑一把嗓子；没绑就按方言取默认参数。\nfunction readTtsVoices() {\n  try {\n    const list = JSON.parse(localStorage.getItem(ttsVoiceStorage) || '{}');\n    return list && typeof list === 'object' && !Array.isArray(list) ? list : {};\n  } catch { return {}; }\n}\nfunction storeTtsVoices(list) {\n  try { localStorage.setItem(ttsVoiceStorage, JSON.stringify(list)); } catch {}\n}\nfunction ttsProfileFor(p) {\n  const base = ttsVoiceProfiles[p?.dialect] || { rate: 1, pitch: 1, hint: '按档案的说话习惯' };\n  const bound = p?.id ? readTtsVoices()[p.id] : null;\n  return {\n    rate: Number.isFinite(bound?.rate) ? bound.rate : (Number.isFinite(tts.rate)&&tts.rate!==1 ? tts.rate : base.rate),\n    pitch: Number.isFinite(bound?.pitch) ? bound.pitch : (Number.isFinite(tts.pitch)&&tts.pitch!==1 ? tts.pitch : base.pitch),\n    voiceURI: bound?.voiceURI || tts.voiceURI || '',\n    apiVoice: bound?.apiVoice || tts.api.voice,\n    locale:p?.dialect==='cantonese'?'yue-HK':'zh-CN',\n    speaker:p?.name||'',\n    hint: base.hint,\n  };\n}\n// 找一把能用的中文嗓子。系统里没有就退回第一个可用声音。\nfunction pickBrowserVoice(voiceURI,locale) {\n  if (!('speechSynthesis' in window)) return null;\n  const voices = speechSynthesis.getVoices();\n  if (!voices.length) return null;\n  if (voiceURI) {\n    const exact = voices.find(voice => voice.voiceURI === voiceURI);\n    if (exact) return exact;\n  }\n  if (locale==='yue-HK') {\n    const cantonese=voices.find(voice=>/^(?:yue|zh[-_](?:HK|Hant[-_]HK))/iu.test(voice.lang));\n    if(cantonese)return cantonese;\n  }\n  return voices.find(voice => /zh[-_]?(CN|Hans)/i.test(voice.lang)) ||\n    voices.find(voice => /^zh/i.test(voice.lang)) || voices[0] || null;\n}\nfunction ttsSupported() {\n  return 'speechSynthesis' in window || Boolean(jinheBridge?.speakText);\n}\n// 播放一段文字。返回 {channel, spoken:boolean}，前端据此决定是否显示“没接上”的提示。\nasync function speakJinheText(text, profile = {}) {\n  const content = String(text || '').trim();\n  if (!content) return { channel: tts.channel, spoken: false };\n  const channel = tts.channel;\n  if (channel === 'host') {\n    if (!jinheBridge?.speakText) throw Error('酒馆还没开启 TTS。可在酒馆的 TTS 扩展里选好引擎，或改用浏览器语音。');\n    await jinheBridge.speakText({text:content,speaker:profile.speaker});\n    return { channel, queued: true };\n  }\n  if (channel === 'api') {\n    const base = String(tts.api.base || '').trim().replace(/\\/+$/, '');\n    if (!base) throw Error('先填独立 TTS 的接口地址。');\n    stopJinheSpeech();\n    const controller = new AbortController();\n    activeTtsRequest = controller;\n    try {\n      const response = await fetch(base + '/v1/audio/speech', {\n      method: 'POST',\n      signal: controller.signal,\n      headers: { 'Content-Type': 'application/json', ...(tts.api.key ? { Authorization: 'Bearer ' + tts.api.key } : {}) },\n      body: JSON.stringify({\n        model: tts.api.model || 'gpt-4o-mini-tts',\n        voice: profile.apiVoice || tts.api.voice || 'nova',\n        input: content,\n        response_format: tts.api.format || 'mp3',\n        speed: Number.isFinite(profile.rate) ? Math.min(4, Math.max(0.25, profile.rate)) : 1,\n      }),\n      });\n      if (!response.ok) throw Error('语音接口返回 ' + response.status + '，可检查模型名与密钥。');\n      await playAudioBlob(await response.blob(), controller.signal);\n      return { channel, spoken: !controller.signal.aborted };\n    } catch (error) {\n      if (!controller.signal.aborted) throw error;\n      return {channel, spoken:false};\n    } finally {\n      if (activeTtsRequest === controller) activeTtsRequest = undefined;\n    }\n  }\n  // 浏览器自带语音：完全免费，开箱即用。\n  if (!('speechSynthesis' in window)) throw Error('这个浏览器不支持内置语音，可改用独立 TTS 接口。');\n  const voice = pickBrowserVoice(profile.voiceURI,profile.locale);\n  const utterance = new SpeechSynthesisUtterance(content);\n  if (voice) utterance.voice = voice;\n  utterance.lang = voice?.lang || profile.locale || 'zh-CN';\n  utterance.rate = Math.min(4, Math.max(0.25, Number.isFinite(profile.rate) ? profile.rate : 1));\n  utterance.pitch = Math.min(2, Math.max(0, Number.isFinite(profile.pitch) ? profile.pitch : 1));\n  stopJinheSpeech();\n  if (profile.waitForEnd) {\n    const controller=new AbortController();\n    activeTtsRequest=controller;\n    try {\n      const spoken=await new Promise((resolve,reject)=>{\n        controller.signal.addEventListener('abort',()=>resolve(false),{once:true});\n        utterance.onend=()=>resolve(true);\n        utterance.onerror=event=>{\n          if (controller.signal.aborted) resolve(false);\n          else reject(Error('浏览器语音没能播放：'+(event.error||'请检查设备的声音设置')));\n        };\n        speechSynthesis.speak(utterance);\n      });\n      return {channel,spoken};\n    } finally {if(activeTtsRequest===controller)activeTtsRequest=undefined;}\n  }\n  speechSynthesis.speak(utterance);\n  return { channel, spoken: true };\n}\nasync function playAudioBlob(blob, signal) {\n  if (signal.aborted) return;\n  const url = URL.createObjectURL(blob);\n  const audio = new Audio(url);\n  let stop;\n  try {\n    await new Promise((resolve, reject) => {\n      stop = () => { audio.pause(); resolve(); };\n      signal.addEventListener('abort', stop, {once:true});\n      audio.onended = resolve;\n      audio.onerror = () => reject(Error('这段音频没能播放。'));\n      audio.play().catch(reject);\n    });\n  } finally {\n    if(stop)signal.removeEventListener('abort',stop);\n    URL.revokeObjectURL(url);\n  }\n}\nfunction stopJinheSpeech() {\n  activeTtsRequest?.abort();\n  try { if ('speechSynthesis' in window) speechSynthesis.cancel(); } catch {}\n}\nfunction ttsDefaultVoiceField(selected) {\n  const voices = 'speechSynthesis' in window ? speechSynthesis.getVoices().filter(v => /^zh/i.test(v.lang)) : [];\n  const voiceOptions=voices.map(v=>option(v.voiceURI,v.name+' · '+v.lang,selected));\n  if (selected&&!voices.some(voice=>voice.voiceURI===selected)) {\n    voiceOptions.unshift(option(selected,'已保存的声音（当前不可用）',selected));\n  }\n  return `\u003clabel>浏览器默认发音\u003cselect name=\"voiceURI\">${option('','自动选择中文声音',selected)}${voiceOptions.join('')}\u003c/select>\u003c/label>\n    ${voices.length?'':'\u003cp class=\"hint\">浏览器暂未列出中文声音，可以先用默认。\u003c/p>'}`;\n}\nfunction ttsSettingsPanel() {\n  return `\u003cform class=\"card form\" id=\"tts-form\" autocomplete=\"off\">\n    \u003clabel>语音通道\u003cselect name=\"channel\">\n      ${option('browser', '浏览器自带语音（免费，开箱可用）', tts.channel)}\n      ${option('host', '酒馆 TTS 扩展（需酒馆已开启 TTS）', tts.channel)}\n      ${option('api', '独立 TTS 接口（OpenAI 兼容）', tts.channel)}\n    \u003c/select>\u003c/label>\n    \u003cdiv class=\"pair\">\n      ${field('语速','rate',tts.rate,'number','min=\"0.25\" max=\"4\" step=\"0.05\"')}\n      ${field('音调','pitch',tts.pitch,'number','min=\"0\" max=\"2\" step=\"0.05\"')}\n    \u003c/div>\n    \u003cdiv data-tts-voices>${ttsDefaultVoiceField(tts.voiceURI)}\u003c/div>\n    ${check('收到语音消息自动播放','autoRead',tts.autoRead)}\n    \u003cdiv class=\"stack\">\n      \u003cp class=\"hint\">选「独立 TTS 接口」时使用下面的设置。\u003c/p>\n      ${field('接口地址','apiBase',tts.api.base,'url','spellcheck=\"false\"')}\n      ${field('API 密钥','apiKey',tts.api.key,'password','autocomplete=\"off\" placeholder=\"本地无鉴权接口可留空\"')}\n      ${check('记住密钥','apiRemember',tts.api.rememberKey===true)}\n      \u003cdiv class=\"pair\">\n        ${field('模型','apiModel',tts.api.model,'text','spellcheck=\"false\" placeholder=\"gpt-4o-mini-tts\"')}\n        ${field('音色','apiVoice',tts.api.voice,'text','spellcheck=\"false\" placeholder=\"nova / alloy / 自定义音色 ID\"')}\n      \u003c/div>\n      ${field('返回格式','apiFormat',tts.api.format,'text','spellcheck=\"false\" placeholder=\"mp3\"')}\n    \u003c/div>\n    \u003cp class=\"hint\">保存语音设置后即可试听。单独调整某个角色时，在人物档案里点「🔊 声线」。\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">保存语音设置\u003c/button>${btn('试听一句','tts-test')}${btn('停止播放','tts-stop')}\u003c/div>\n    \u003cp id=\"tts-status\" class=\"feedback\" role=\"status\">${esc(notes['tts:settings'] || '')}\u003c/p>\n  \u003c/form>`;\n}\nfunction readTtsForm(form) {\n  const value = name => String(new FormData(form).get(name) || '').trim();\n  const num = (name, fallback, min, max) => {\n    const n = Number(value(name));\n    return Number.isFinite(n) && n >= min && n \u003c= max ? n : fallback;\n  };\n  return {\n    channel: ['browser', 'host', 'api'].includes(value('channel')) ? value('channel') : 'browser',\n    rate: num('rate', 1, 0.25, 4),\n    pitch: num('pitch', 1, 0, 2),\n    voiceURI: value('voiceURI'),\n    autoRead: Boolean(form.elements.autoRead?.checked),\n    api: {\n      base: value('apiBase'), key: value('apiKey'), rememberKey: form.elements.apiRemember?.checked === true,\n      model: value('apiModel') || 'gpt-4o-mini-tts',\n      voice: value('apiVoice') || 'nova',\n      format: value('apiFormat') || 'mp3',\n    },\n  };\n}\nfunction bootJinheTts() {\n  window.addEventListener('pagehide',stopJinheSpeech,{once:true});\n  // 系统声音异步到达时只更新声音列表，保留其他输入。\n  if ('speechSynthesis' in window) {\n    speechSynthesis.addEventListener?.('voiceschanged', () => {\n      const voices=$('tts-form')?.querySelector('[data-tts-voices]');\n      if (!voices) return;\n      const select=voices.querySelector('select');\n      const focused=document.activeElement===select;\n      voices.innerHTML=ttsDefaultVoiceField(select.value);\n      if (focused) voices.querySelector('select').focus({preventScroll:true});\n    });\n  }\n  submit['tts-form'] = form => {\n    Object.assign(tts, readTtsForm(form));\n    save();\n    notes['tts:settings'] = '语音设置已保存。';\n    render();\n  };\n  actions['tts-test'] = async () => {\n    try {\n      const result=await speakJinheText('喂，听得到不？这是金河九号机的语音试听。', ttsProfileFor({ dialect: 'dongbei' }));\n      notes['tts:settings'] = result.queued ? '已提交给酒馆语音。' : result.spoken ? '试听已播放。' : '本次试听已停止。';\n    } catch (error) { notes['tts:settings'] = error.message; }\n    render();\n  };\n  actions['tts-stop'] = () => { stopJinheSpeech(); notes['tts:settings'] = tts.channel==='host'\n    ? '酒馆语音由酒馆控制，请使用酒馆的播放控件停止。' : '已停止播放。'; render(); };\n  // 角色档案里单独绑嗓子。\n  actions['tts-voice-bind'] = ({ id }) => {\n    const p = person(id);\n    if (!p) return;\n    const bound = readTtsVoices()[id] || {};\n    const voices = 'speechSynthesis' in window ? speechSynthesis.getVoices().filter(v => /^zh/i.test(v.lang)) : [];\n    modal(p.name + ' · 声线', `\u003cform class=\"form\" id=\"tts-voice-form\" data-id=\"${esc(id)}\">\n      \u003cp class=\"hint\">${esc(ttsVoiceProfiles[p.dialect]?.hint || '按档案的说话习惯')}\u003c/p>\n      ${voices.length ? `\u003clabel>浏览器嗓子\u003cselect name=\"voiceURI\">${option('', '跟随全局默认', bound.voiceURI || '')}${voices.map(v => option(v.voiceURI, v.name + ' · ' + v.lang, bound.voiceURI || '')).join('')}\u003c/select>\u003c/label>` : ''}\n      \u003cdiv class=\"pair\">\n        ${field('语速','rate',bound.rate ?? '', 'number','min=\"0.25\" max=\"4\" step=\"0.05\" placeholder=\"留空跟随全局\"')}\n        ${field('音调','pitch',bound.pitch ?? '', 'number','min=\"0\" max=\"2\" step=\"0.05\" placeholder=\"留空跟随全局\"')}\n      \u003c/div>\n      ${field('独立接口音色','apiVoice',bound.apiVoice || '','text','spellcheck=\"false\" placeholder=\"留空跟随全局\"')}\n      \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">保存声线\u003c/button>${btn('清除绑定','tts-voice-clear',{id})}${btn('试听','tts-voice-test',{id})}\u003c/div>\n    \u003c/form>`);\n  };\n  submit['tts-voice-form'] = form => {\n    const id = form.dataset.id, p = person(id);\n    if (!p) return;\n    const list = readTtsVoices();\n    const num = (name) => {\n      const raw = String(new FormData(form).get(name) || '').trim();\n      const n = Number(raw);\n      return raw && Number.isFinite(n) ? n : undefined;\n    };\n    const rate = num('rate'), pitch = num('pitch');\n    list[id] = {\n      ...(form.elements.voiceURI ? { voiceURI: String(new FormData(form).get('voiceURI') || '') } : {}),\n      ...(rate === undefined ? {} : { rate: Math.min(4, Math.max(0.25, rate)) }),\n      ...(pitch === undefined ? {} : { pitch: Math.min(2, Math.max(0, pitch)) }),\n      ...(String(new FormData(form).get('apiVoice') || '').trim() ? { apiVoice: String(new FormData(form).get('apiVoice')).trim() } : {}),\n    };\n    storeTtsVoices(list);closeModal();notify('已保存 ' + p.name + ' 的声线');\n  };\n  actions['tts-voice-clear'] = ({ id }) => {\n    const list = readTtsVoices();\n    delete list[id];\n    storeTtsVoices(list);closeModal();notify('已恢复跟随全局语音');\n  };\n  actions['tts-voice-test'] = async ({ id }) => {\n    const p = person(id);\n    if (!p) return;\n    try { await speakJinheText('哥，我这会儿在忙，等下回你嘛。', ttsProfileFor(p)); }\n    catch (error) { notify(error.message); }\n  };\n}\n\n// A visible exit inside each phone surface, using the host's existing collapse action.\nfunction bootPhoneCloseButton() {\n  const bridge=window.frameElement?.jinhePhoneBridge;\n  if(typeof bridge?.close!=='function'||document.getElementById('jinhe-phone-close-style'))return;\n  const style=document.createElement('style');style.id='jinhe-phone-close-style';\n  style.textContent=`\n    .statusbar.jinhe-has-close{min-height:44px;height:44px;padding:2px 8px 2px 12px;align-items:center}\n    .statusbar.jinhe-has-close .hardware{display:none}\n    button.jinhe-phone-close{position:relative;z-index:10;display:inline-flex;align-items:center;justify-content:center;gap:5px;flex:none;min-height:40px;width:86px;margin:0;padding:5px 7px;border:1px solid var(--jh-theme-border,#62765d);border-radius:12px;background:var(--jh-theme-accent,#dafa85);color:var(--jh-theme-accent-text,#223022);font:700 11px/1.2 system-ui,\"Microsoft YaHei UI\",sans-serif;cursor:pointer;touch-action:manipulation;white-space:nowrap}\n    .statusbar>button.jinhe-phone-close{margin-left:auto}\n    button.jinhe-phone-close:focus-visible{outline:2px solid var(--jh-theme-text,#fff);outline-offset:2px}\n    .jinhe-close-dialog-head{gap:6px}\n    .jinhe-close-dialog-head h2{flex:1;min-width:0;overflow-wrap:anywhere}\n    #os-lock>button.jinhe-phone-close{position:absolute;top:8px;right:8px}\n    @media(max-width:300px){.statusbar.jinhe-has-close .os-island{width:86px;font-size:9px}}\n  `;\n  document.head.append(style);\n  const makeButton=id=>{\n    const button=document.createElement('button');button.id=id;button.type='button';button.className='jinhe-phone-close';\n    button.textContent='收起手机 ×';button.setAttribute('aria-label','收起手机，返回酒馆');\n    button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();bridge.close();});\n    return button;\n  };\n  const status=document.querySelector('.statusbar');\n  if(status){status.classList.add('jinhe-has-close');status.append(makeButton('jinhe-phone-close'));}\n  const dialogHead=document.querySelector('#modal .dialog-head');\n  if(dialogHead){dialogHead.classList.add('jinhe-close-dialog-head');dialogHead.append(makeButton('jinhe-phone-close-dialog'));}\n  const lock=document.getElementById('os-lock');\n  if(lock){\n    const attach=()=>{if(!lock.querySelector('#jinhe-phone-close-lock'))lock.append(makeButton('jinhe-phone-close-lock'));};\n    attach();\n    const observer=new MutationObserver(attach);observer.observe(lock,{childList:true});\n    window.addEventListener('pagehide',()=>observer.disconnect(),{once:true});\n  }\n}\n\n// 同城报道是手机内容。委托在此只准备玩家可编辑的正文草稿。\nconst lifeSeeds = [\n  ['night_market','夜市摊主换了招牌','@夜市找零找半天','东口那个烤冷面摊刚换了块红牌子。老板说今天配料照旧，排队别堵卖袜子的摊。','我跑了两趟才发现换牌没换人。'],\n  ['billiard_hall','皇冠球厅周末开双打桌','@球袋忘拿了','靠窗那张台今晚上能拼桌，先到的帮忙把分牌翻回来。','缺一个人，我七点下班能来。'],\n  ['bridge_north','桥北三号楼水管停水半小时','@三号楼门洞','师傅说换个阀门。三楼晾着的被单记得先收，楼道会抬梯子。','梯子已经到了，我帮忙看门。'],\n  ['mixue_gate','金街奶茶铺把错单贴门口了','@珍珠加半勺','两杯乌龙还在柜台，小票尾号是 12。谁取走了隔壁的柠檬水，回来换就行。','刚下晚班，取错的是我。'],\n  ['paris_bar','夜巴黎今晚招个临时帮手','@见习吧台','搬两箱饮料、收下空杯，想来搭班的先找值班经理问时间。','记得走河边那侧的员工门。'],\n  ['jinshui_resort','金水湾河坡的步道开放了','@饭后去走走','新修那一小段能走了。地面还有积水，骑车的到岔口记得下车。','东头那张长椅能看到河面。'],\n  ['bus_station','客运站失物台多了一串钥匙','@末班车站台','捡到个蓝绳钥匙扣，想领的去候车厅说一下绳头挂的东西。','我已经在楼栋群里转了一下。'],\n  ['north_market','桥北菜场明早从南门进','@每天挑姜','北边卸货口修门轴，摊贩说明早先从南门绕一下。','卖豆腐那摊还在原位。'],\n  ['county_hospital','医院门口的寄存架挪了位置','@陪诊回来','取外卖往西边走十来步，门卫那儿有牌子。骑手别再往急诊口挤。','急诊通道终于空出来了。'],\n  ['old_cotton_mill','老棉纺厂门房暂时代收包裹','@家属院老住户','院里修路，快递放门房到晚八点。去拿的时候先核姓名尾字。','我晚一点去，你们别帮我拆。'],\n].map(([placeId,title,author,body,comment], index)=>({\n  id:'seed_'+index,placeId,title,author,body,comments:[{author:'@隔条街的',text:comment,placeId}],local:true,\n}));\nconst lifeJobs = [{\"id\":\"billiards_shift\",\"placeId\":\"billiard_hall\",\"title\":\"台球厅顶班两小时\",\"pay\":200,\"personId\":\"girl_sichuan_lin_yaqi\",\"publisher\":\"皇冠台球厅前台\",\"affinity\":3,\"detail\":\"有人临时请假，前台需要帮忙登记台位、核对计时单。\"},{\"id\":\"sample_delivery\",\"placeId\":\"old_cotton_mill\",\"endId\":\"county_hospital\",\"title\":\"给医院送一袋样衣\",\"pay\":150,\"stamina\":20,\"publisher\":\"老棉纺厂门房\",\"shift\":\"day\",\"detail\":\"到家属区门房核对包裹，再送到医院交给对接的人。\"},{\"id\":\"bar_shift\",\"placeId\":\"paris_bar\",\"title\":\"夜巴黎临时吧台帮工\",\"pay\":300,\"publisher\":\"夜巴黎值班经理\",\"shift\":\"night\",\"detail\":\"找值班经理对好班次，帮忙备饮料、收杯和打烊整理。\"},{\"id\":\"market_loading\",\"placeId\":\"north_market\",\"title\":\"菜场收摊搬货\",\"pay\":170,\"stamina\":12,\"publisher\":\"桥北菜场摊主\",\"shift\":\"day\",\"detail\":\"帮摊主把没卖完的纸箱和周转筐搬到仓门，点清数量后当面结账。\"},{\"id\":\"parcel_sorting\",\"placeId\":\"east_parcels\",\"title\":\"集包场临时分件\",\"pay\":240,\"stamina\":18,\"publisher\":\"东郊集包场调度\",\"shift\":\"night\",\"detail\":\"跟值班员按线路分好包裹，把交接表上的件数对齐。\"},{\"id\":\"library_boxes\",\"placeId\":\"county_library\",\"title\":\"图书馆整理捐书\",\"pay\":160,\"stamina\":8,\"publisher\":\"图书馆服务台\",\"shift\":\"day\",\"detail\":\"把捐来的书按清单分箱，交给服务台复核后领今天的工钱。\"}];\nconst lifeTabs = [['feed','同城吃瓜'],['hot','金河热搜'],['jobs','江湖救急']];\nlet lifeTab = 'feed', lifeTopic = '', lifeSelection = null;\nconst lifeRequests = new WeakSet();\nconst lifePlace = id => places.get(id)?.name || '金河县';\nconst lifeData = () => state.jinheLife ??= {posts:[],drafts:{}};\nconst lifeText = (input, limit) => typeof input==='string' ? stripPhoneReasoning(input).replace(/[^\\S\\r\\n]+/gu,' ').slice(0,limit) : '';\nfunction lifePosts() {\n  const local = lifeSeeds.slice().sort((a,b)=>Number(places.get(b.placeId)?.zone===scene().zone_id)-\n    Number(places.get(a.placeId)?.zone===scene().zone_id));\n  const seen = new Set();\n  return [...lifeData().posts,...local].filter(post=>{\n    if (seen.has(post.title)) return false;\n    seen.add(post.title);\n    return true;\n  }).slice(0,10);\n}\n\nfunction parseLifePosts(raw, placeIds, knownIds, makeId) {\n  const data = JSON.parse(String(raw).trim().replace(/^```(?:json)?\\s*|\\s*```$/giu,''));\n  if (!Array.isArray(data?.posts)) throw Error('接口没有返回同城帖子。');\n  const titles = new Set();\n  const posts = [];\n  for (const item of data.posts.slice(0,10)) {\n    if (!placeIds.has(item?.placeId)) continue;\n    const title=lifeText(item.title,60), body=lifeText(item.body,360), author=lifeText(item.author,30);\n    if (!title||!body||!author||titles.has(title)) continue;\n    const comments = (Array.isArray(item.comments)?item.comments:[]).slice(0,3).flatMap(comment=>{\n      const name=lifeText(comment?.author,30), text=lifeText(comment?.text,140), personId=comment?.personId;\n      if (!text || (personId ? !knownIds.has(personId) : !name)) return [];\n      return [{author:name,text,placeId:placeIds.has(comment.placeId)?comment.placeId:item.placeId,...(personId?{personId}:{})}];\n    });\n    if (comments.length \u003c 2) continue;\n    posts.push({id:makeId(),placeId:item.placeId,title,body,author,comments,\n      ...(knownIds.has(item.personId)?{personId:item.personId}:{})});\n    titles.add(title);\n    if (posts.length===5) break;\n  }\n  if (posts.length\u003c3) throw Error('接口返回的有效帖子不足三条，已保留原来的内容。');\n  return posts;\n}\n\nfunction lifePrompt(location, availablePlaces, contacts) {\n  const language = {\n    mandarin:'发帖与评论统一使用自然普通话。',\n    dialect:'路人说自然县城口语，熟人评论用名单标明的本人口音。',\n    bilingual:'熟人评论各用本人的口音。方言原句另起一行给普通话意译，说普通话的人直接写原话。路人用自然口语。',\n  }[osDialogueLanguage()];\n  const nearEvent=String(state.hostLifeEvent||'').match(/^local_([a-z0-9_]+)(?:@|$)/u)?.[1];\n  return [\n    '你在模拟虚构的金河县同城论坛。生成 3 至 5 条短帖，每条有 2 至 3 条跟帖。',\n    phonePrompt('life',state.phonePrompts),\n    '只用给定地点 ID。同城是公开讨论，私人聊天和档案内容不能写进帖子。',\n    language,\n    '当前时间：'+location.time_slot+'，当前地点：'+lifePlace(location.location_id)+'，所在片区：'+(source.zones[location.zone_id]||'金河县')+'。',\n    nearEvent&&places.has(nearEvent)?'当前同城线索在'+lifePlace(nearEvent)+'附近。只写街坊能看到的现场，避免编造大范围突发事件。':'',\n    '可用地点：'+availablePlaces.map(p=>p.id+'='+p.name).join('、')+'。',\n    '玩家认识的人：'+(contacts.map(p=>p.id+'='+p.name+'（'+(p.dialect_label||'普通话')+\n      ((state.presentIds||[]).includes(p.id)?'，在当前地点附近':'')+'）').join('、')||'暂无')+'。只有这些人能附 personId。',\n    '只交付 JSON {\"posts\":[{\"placeId\":\"地点ID\",\"title\":\"短标题\",\"author\":\"网名\",\"personId\":\"可选\",\"body\":\"帖子正文\",\"comments\":[{\"author\":\"网名\",\"placeId\":\"评论者常去的已知地点ID\",\"personId\":\"可选\",\"text\":\"跟帖\"}]}]}。没有熟人身份时省略 personId。',\n  ].filter(Boolean).join('\\n');\n}\n\nasync function refreshLife() {\n  const current=state, currentOpening=opening;\n  if (lifeRequests.has(current)) return;\n  const location={...scene()};\n  const shortlisted = source.places.filter(p=>p.zone===location.zone_id||lifeSeeds.some(seed=>seed.placeId===p.id));\n  const deck=lifePosts();\n  if (!osModelEnabled()) {\n    const offset=((current.jinheLife?.demoTurn||0)+1)%lifeSeeds.length;\n    Object.assign(lifeData(),{demoTurn:offset,posts:[...lifeSeeds.slice(offset),...lifeSeeds.slice(0,offset)].slice(0,4)});\n    save();render();notify('已换一组本地示例。');return;\n  }\n  lifeRequests.add(current);render();\n  try {\n    const contacts=knownPeople().slice(0,12);\n    const prompt=lifePrompt(location,shortlisted,contacts);\n    const config={...settings.chat};\n    // 同城是一批短帖。自填接口使用本次独立的长度下限，原设置仍供微信等入口使用。\n    if (!osIsHosted()||config.forward==='self') config.tokens=Math.max(1200,Number(config.tokens)||0);\n    const raw=await osRequest(config,prompt,[{role:'user',content:'刷新同城帖子。'}]);\n    if (!osAlive||state!==current||opening!==currentOpening) return;\n    const newPosts=parseLifePosts(raw,new Set(shortlisted.map(p=>p.id)),new Set(contacts.map(p=>p.id)),osId);\n    const prior = lifeData();\n    const distinct = new Set(newPosts.map(post=>post.title));\n    prior.posts=[...newPosts,...deck.filter(post=>!post.local&&!distinct.has(post.title))].slice(0,10);\n    prior.context={place:location.location_id,time:location.time_slot};\n    lifeTopic='';save();\n  } catch (error) {\n    if (osAlive&&state===current&&opening===currentOpening) notify(error instanceof SyntaxError?'同城格式有误，原有帖子已保留。':error.message);\n  } finally {\n    lifeRequests.delete(current);\n    if (osAlive&&state===current&&section==='life') render();\n  }\n}\n\nfunction lifeAuthor(item) {\n  const known = item.personId && knownPeople().find(person=>person.id===item.personId);\n  return known?.name || item.author || '金河网友';\n}\nfunction lifeArticle(post, share=true) {\n  const liked=lifeData().likes?.[post.id]===true;\n  const comments=(post.comments||[]).slice(0,3);\n  return '\u003carticle class=\"life-post\">\u003cdiv class=\"life-meta\">\u003cstrong>'+esc(lifeAuthor(post))+'\u003c/strong>\u003cspan>'+esc(lifePlace(post.placeId))+'\u003c/span>'+\n    (post.local?'\u003cspan class=\"life-local\">本地示例\u003c/span>':'')+'\u003c/div>\u003ch3>'+esc(post.title)+'\u003c/h3>\u003cp>'+esc(post.body)+'\u003c/p>'+\n    '\u003cul class=\"life-comments\">'+comments.map(c=>'\u003cli>\u003cb>'+esc(lifeAuthor(c))+\n      '\u003c/b>\u003cdiv>\u003cspan>'+esc(c.text)+'\u003c/span>\u003csmall>属地 · '+esc(lifePlace(c.placeId||post.placeId))+'\u003c/small>\u003c/div>\u003c/li>').join('')+'\u003c/ul>'+\n    (share?'\u003cdiv class=\"life-actions\">\u003cbutton class=\"life-share\" data-do=\"life-like\" data-id=\"'+esc(post.id)+'\" aria-pressed=\"'+liked+'\">'+\n      icon('heart')+(liked?' 已赞':' 点赞')+'\u003c/button>\u003cbutton class=\"life-share\" data-do=\"life-share\" data-id=\"'+esc(post.id)+'\">'+\n      icon('arrow')+' 转发到微信\u003c/button>\u003c/div>':'')+'\u003c/article>';\n}\nfunction lifeVisibleJobs() {\n  const now=scene(),hours=Number(now.time_slot.match(/(\\d{1,2}):\\d{2}/u)?.[1]||12);\n  const shift=hours>=18||hours\u003c6?'night':'day',knownIds=new Set(knownPeople().map(p=>p.id));\n  const statuses=state.hostLifeJobs||{};\n  const score=job=>Number(job.placeId===now.location_id)*7+Number(places.get(job.placeId)?.zone===now.zone_id)*4+\n    Number(job.shift===shift)*2+Number(knownIds.has(job.personId));\n  return [...lifeJobs.filter(job=>statuses[job.id]),...lifeJobs.filter(job=>!statuses[job.id])\n    .sort((a,b)=>score(b)-score(a)).slice(0,3)];\n}\nfunction renderLife() {\n  const now=scene(), feed=lifePosts(), busy=lifeRequests.has(state);\n  header('金河同城',source.zones[now.zone_id]||'金河县');\n  const banner='\u003cdiv class=\"life-banner\" style=\"--life-photo:url(&quot;'+esc(osAsset(now.location_id))+'&quot;)\">'+\n    '\u003cdiv>\u003cspan>'+esc(now.time_slot)+'\u003c/span>\u003cstrong>'+esc(lifePlace(now.location_id))+'\u003c/strong>\u003c/div>\u003cbutton data-do=\"life-refresh\" '+(busy?'disabled':'')+'>'+ (busy?'刷新中…':'刷新同城')+'\u003c/button>\u003c/div>';\n  const tabs='\u003cnav class=\"life-tabs\" aria-label=\"金河同城栏目\">'+lifeTabs.map(([id,label])=>'\u003cbutton data-do=\"life-tab\" data-id=\"'+id+'\" aria-pressed=\"'+(id===lifeTab)+'\">'+label+'\u003c/button>').join('')+'\u003c/nav>';\n  const updated=lifeData().context;\n  const feedNote=updated?'\u003cspan>上次刷新 · '+esc(lifePlace(updated.place))+' · '+esc(updated.time)+'\u003c/span>':'\u003cspan>金河各处的街坊消息\u003c/span>';\n  let content='\u003cdiv class=\"life-sub\">\u003ch3>街坊帖子\u003c/h3>'+feedNote+'\u003c/div>'+feed.slice(0,5).map(post=>lifeArticle(post)).join('');\n  if (lifeTab==='hot') {\n    const topic=feed.find(post=>post.id===lifeTopic);\n    const likes=lifeData().likes||{};\n    const top=feed.slice().sort((a,b)=>Number(likes[b.id]===true)-Number(likes[a.id]===true)).slice(0,5);\n    content=topic?'\u003cbutton class=\"life-back\" data-do=\"life-topic\">返回热搜榜\u003c/button>'+lifeArticle(topic):\n      '\u003cdiv class=\"life-sub\">\u003ch3>金河热搜榜\u003c/h3>\u003cspan>点开查看讨论\u003c/span>\u003c/div>\u003col class=\"life-ranking\">'+top.map((post,index)=>\n        '\u003cli>\u003cbutton data-do=\"life-topic\" data-id=\"'+esc(post.id)+'\">\u003cstrong>'+String(index+1).padStart(2,'0')+'\u003c/strong>\u003cspan>'+esc(post.title)+\n        '\u003csmall>'+esc(lifePlace(post.placeId))+'\u003c/small>\u003c/span>'+icon('right')+'\u003c/button>\u003c/li>').join('')+'\u003c/ol>';\n  }\n  if (lifeTab==='jobs') {\n    content='\u003cdiv class=\"life-sub\">\u003ch3>便民委托\u003c/h3>\u003cspan>随位置与时段推荐\u003c/span>\u003c/div>'+lifeVisibleJobs().map(job=>\n      '\u003carticle class=\"life-post life-job\">\u003cdiv class=\"life-meta\">\u003cspan>'+esc(lifePlace(job.placeId))+'\u003c/span>\u003cstrong>'+money(job.pay)+'\u003c/strong>\u003c/div>'+\n      '\u003csmall class=\"life-job-publisher\">'+esc(knownPeople().find(p=>p.id===job.personId)?.name||job.publisher)+'\u003c/small>'+\n      '\u003ch3>'+esc(job.title)+'\u003c/h3>\u003cp>'+esc(job.detail)+'\u003c/p>'+\n      lifeJobStatus(job)+'\u003c/article>').join('');\n  }\n  return '\u003cdiv class=\"life-screen\">'+banner+tabs+'\u003cdiv class=\"life-content\" aria-busy=\"'+busy+'\">'+content+'\u003c/div>\u003c/div>';\n}\n\nfunction lifeShareText(post) {\n  return '我从金河同城转来一条帖子，标题「'+post.title+'」，地点是'+lifePlace(post.placeId)+'。帖子写道：“'+post.body+'” 你怎么看？';\n}\nfunction lifeShareBubble(line,group=false) {\n  const post=line.lifePost;\n  if (!post) return esc(line.text);\n  return '\u003cbutton class=\"life-link\" data-do=\"life-view-share\" data-id=\"'+esc(line.id)+'\" data-group=\"'+group+'\">\u003csmall>金河同城 · 转发\u003c/small>'+\n    '\u003cstrong>'+esc(post.title)+'\u003c/strong>\u003cspan>'+esc(lifePlace(post.placeId))+'\u003c/span>\u003c/button>';\n}\nfunction chooseLifeShare(id) {\n  const post=lifePosts().find(item=>item.id===id);\n  if (!post) return;\n  const friends=state.friends.map(person).filter(Boolean), groups=groupsForOpening();\n  lifeSelection={post,current:state,opening};\n  modal('转发到微信',friends.length||groups.length?'\u003cdiv class=\"stack\">'+friends.map(p=>\n    btn(esc(p.name),'life-send',{id:p.id,group:false})).join('')+groups.map(group=>\n    btn('群聊 · '+esc(group.name),'life-send',{id:group.id,group:true})).join('')+'\u003c/div>':\n    '\u003cp class=\"hint\">先在微信添加一位好友，再来转发这条帖子。\u003c/p>');\n}\nfunction sendLifeShare({id,group}) {\n  const selection=lifeSelection;\n  if (!selection||state!==selection.current||opening!==selection.opening) return;\n  const isGroup=group==='true';\n  if (isGroup?!groupById(id):!isFriend(id)) return;\n  if (waits.has(opening+':'+(isGroup?'group':'chat')+':'+id)) {notify('这段会话还在等回复，稍后再转发。');return;}\n  lifeSelection=null;closeModal();\n  if (isGroup) {\n    actions['os-group-open']({id});\n    return osSendGroupChat(null,selection.post);\n  }\n  openPage('chat',id);\n  return osSendChat(null,selection.post);\n}\nfunction lifeJobStatus(job) {\n  const status=state.hostLifeJobs?.[job.id];\n  if (status?.completedTurn!==undefined) return '\u003cp class=\"life-job-status\">已完成 · 已入账\u003c/p>';\n  if (status) return '\u003cp class=\"life-job-status\">进行中 · 已接单\u003c/p>\u003cdiv class=\"life-actions\">'+\n    btn('再取正文草稿','life-job',{id:job.id})+\n    ((job.endId||job.placeId)===scene().location_id?btn('确认完工','life-complete-ask',{id:job.id}):'')+'\u003c/div>';\n  return '\u003cbutton class=\"life-share\" data-do=\"life-job\" data-id=\"'+job.id+'\">'+\n    (lifeData().drafts?.[job.id]?'查看委托草稿':'接单写草稿')+'\u003c/button>';\n}\nfunction lifeJobModal(id) {\n  const job = lifeJobs.find(item=>item.id===id);\n  if (!job||state.hostLifeJobs?.[id]?.completedTurn!==undefined) return;\n  const contact=knownPeople().find(p=>p.id===job.personId)?.name;\n  const text=phonePrompt('life-draft',state.phonePrompts,{\n    标题:job.title,地点:lifePlace(job.placeId),联系人:contact||'委托联系人',\n    交接说明:job.endId?'确认以后再去'+lifePlace(job.endId)+'交接。':'',报酬:money(job.pay),\n  }).slice(0,1000);\n  modal(job.title,'\u003cp class=\"hint\">'+(osIsHosted()?'确认后登记接单，并把草稿放入正文输入框。':'预览可以编辑和保存草稿。')+'\u003c/p>'+\n    '\u003ctextarea id=\"life-draft-text\" class=\"draft\" aria-label=\"委托正文草稿\" maxlength=\"1000\">'+esc(lifeData().drafts?.[id]||text)+'\u003c/textarea>'+\n    '\u003cdiv class=\"buttons\">'+btn(osIsHosted()?'确认并放入正文':'保存委托草稿','life-draft',{id},'primary')+'\u003c/div>');\n}\n\nfunction bootJinheLife() {\n  screens.life=renderLife;\n  Object.assign(actions,{\n    'life-tab':({id})=>{if(lifeTabs.some(([tab])=>tab===id)){lifeTab=id;lifeTopic='';render(true);}},\n    'life-topic':({id})=>{\n      if(!id&&socialBackStack.at(-1)?.section==='life'){socialBack();return;}\n      const before=socialCapturePage();\n      lifeTopic=id||'';\n      if(id)socialRemember(before);\n      render(true);\n    },\n    'life-refresh':refreshLife,\n    'life-like':({id})=>{\n      if (!lifePosts().some(post=>post.id===id)) return;\n      const likes=lifeData().likes||={};\n      if (likes[id]===true) delete likes[id];\n      else likes[id]=true;\n      save();render();\n    },\n    'life-share':({id})=>chooseLifeShare(id),\n    'life-send':sendLifeShare,\n    'life-view-share':({id,group})=>{\n      const line=(group==='true'?groupById(activeGroup)?.lines:state.chats[activePerson])?.find(item=>item.id===id);\n      if (line?.lifePost) modal('金河同城',lifeArticle(line.lifePost,false));\n    },\n    'life-job':({id})=>lifeJobModal(id),\n    'life-complete-ask':({id})=>{\n      const job=lifeJobs.find(item=>item.id===id);\n      if (!osIsHosted()||!job||!state.hostLifeJobs?.[id]) return;\n      modal('确认委托完工','\u003cp class=\"hint\">请在正文中完成「'+esc(job.title)+'」且已收到工钱后确认。到账后会写入当前楼层。\u003c/p>'+\n        btn('已完成并收到报酬','life-complete',{id},'primary'));\n    },\n    'life-complete':async({id},button)=>{\n      if(button.disabled)return;\n      button.disabled=true;\n      try {\n        await hostWrite({type:'job-complete',id});\n        closeModal();render();notify('委托已结算。');\n      } finally {button.disabled=false;}\n    },\n    'life-draft':async({id},button)=>{\n      const draft=$('life-draft-text')?.value.trim();\n      if (!draft||!lifeJobs.some(job=>job.id===id)) return;\n      const drafts=lifeData().drafts||={};\n      const previous=drafts[id];\n      if (osIsHosted()) {\n        if(button.disabled)return;\n        button.disabled=true;\n        try {\n          await hostWrite({type:'job-accept',id});\n          drafts[id]=draft;save();\n          jinheBridge.draft(draft,{jobId:id,revision:hostRevision});\n        } finally {button.disabled=false;}\n        return;\n      }\n      if (previous!==draft) {\n        const existing=state.draft?.trim();\n        state.draft=existing&&previous&&existing.endsWith(previous)\n          ? existing.slice(0,-previous.length)+draft : [existing,'[金河委托接单 '+id+']\\n'+draft].filter(Boolean).join('\\n');\n      }\n      drafts[id]=draft;\n      save();\n      closeModal();render();openDraft();\n    },\n  });\n}\n\n\nconst socialPending = new Map(), socialQuotes = new Map(), socialBackStack = [];\nconst socialScope = (group,id) => opening+':'+(group?'group':'chat')+':'+id;\nlet socialCall=null, socialPressTimer=null, socialPressStart=null, socialMicrophone=null;\nfunction socialStart(scope,id=osId()) {\n  if (waits.has(scope)) return null;\n  const operation={id,scope,controller:new AbortController(),current:state};\n  socialPending.set(scope,operation);waits.add(scope);\n  return operation;\n}\nfunction socialCurrent(operation) {\n  return osAlive&&state===operation.current&&!operation.controller.signal.aborted;\n}\nfunction socialEnd(operation) {\n  if (socialPending.get(operation.scope)!==operation) return;\n  socialPending.delete(operation.scope);waits.delete(operation.scope);\n}\nfunction socialStop(scope) {\n  const operation=socialPending.get(scope);\n  if (!operation||operation.committing) return;\n  operation.controller.abort();\n  if (osIsHosted()) jinheBridge.cancelChat?.(operation.id);\n  if (scope===socialCall?.id) stopJinheSpeech();\n  socialEnd(operation);\n  notes[scope]='已中断发送。';\n  if (osAlive) render();\n}\nfunction socialChatControls(scope) {\n  const quote=socialQuotes.get(scope);\n  return quote?'\u003cdiv class=\"social-quote\">\u003cspan>'+esc(quote.label)+' · '+esc(quote.text)+'\u003c/span>'+\n    btn('取消引用','social-unquote',{scope})+'\u003c/div>':'';\n}\nfunction socialSendButton(scope) {\n  const pending=socialPending.get(scope);\n  if (pending&&!pending.committing) return '\u003cbutton class=\"social-stop\" type=\"button\" data-do=\"social-stop\" data-scope=\"'+esc(scope)+'\">■ 中断\u003c/button>';\n  return '\u003cbutton class=\"primary\" type=\"submit\" '+(pending?'disabled':'')+'>发送\u003c/button>';\n}\nfunction socialQuoteText(quote,text) {\n  return quote?'引用'+quote.label+'的话「'+quote.text+'」\\n'+text:text;\n}\nfunction socialChatHistory(lines) {\n  return lines.filter(item=>!item.kind||['voice','life-share'].includes(item.kind)).slice(-16)\n    .map(item=>({role:item.role,content:socialQuoteText(item.quote,phoneMessageText(item))})).filter(item=>item.content);\n}\nfunction socialBubbleAttrs(line,index,group=false) {\n  if (line.kind&&!['voice','life-share','call'].includes(line.kind)) return '';\n  return ' tabindex=\"0\" data-do=\"social-line\" data-index=\"'+index+'\" data-group=\"'+group+'\"';\n}\nfunction socialMessageDetails(line,index,group=false) {\n  const quote=line.quote?'\u003cdiv class=\"social-quoted\">'+esc(line.quote.label)+' · '+esc(line.quote.text)+'\u003c/div>':'';\n  const thought=line.thought?'\u003cbutton type=\"button\" class=\"social-aside-link\" data-do=\"social-aside\" data-index=\"'+index+\n    '\" data-group=\"'+group+'\" aria-haspopup=\"dialog\">\u003cspan aria-hidden=\"true\">╱\u003c/span> 弦外音\u003c/button>':'';\n  const photo=line.photoPrompt&&!group?'\u003cdiv class=\"social-photo\">'+(line.generatedPhoto&&photos.some(item=>item.id===line.generatedPhoto)\n    ?photoButton(photos.find(item=>item.id===line.generatedPhoto))\n    :'\u003cspan>'+esc(line.photoPrompt)+'\u003c/span>'+btn('立即查看','social-photo',{index}))+'\u003c/div>':'';\n  return quote+thought+photo;\n}\nfunction socialAside({group,index}) {\n  const mode=group==='true',{line,id}=socialReadLine(mode,Number(index));\n  if (!line?.thought) return;\n  const name=line.speaker||line.name||person(mode?line.personId:id)?.name||'对方';\n  modal('弦外音','\u003carticle class=\"social-aside-paper\">\u003cdiv class=\"social-aside-meta\">'+esc(name)+\n    (line.at?' · '+esc(osClock(line.at)):'')+'\u003c/div>\u003cblockquote>'+esc(phoneMessageText(line))+\n    '\u003c/blockquote>\u003cp class=\"social-aside-label\">没说出口\u003c/p>\u003cp class=\"social-aside-note\">'+esc(line.thought)+'\u003c/p>\u003c/article>');\n}\nfunction socialReadLine(group,index) {\n  if (group) {\n    const record=groupById(activeGroup);\n    return {record,lines:record?.lines||[],id:record?.id,line:record?.lines?.[index]};\n  }\n  const lines=state.chats[activePerson]||[];\n  return {lines,id:activePerson,line:lines[index]};\n}\nfunction socialLineMenu({index,group}) {\n  if ($('modal').open) return;\n  const groupMode=group==='true', item=socialReadLine(groupMode,Number(index)), line=item.line;\n  if (!line) return;\n  const data={index,group};\n  modal('消息操作','\u003cdiv class=\"stack\">'+\n    (line.role==='assistant'&&!line.kind||line.kind==='voice'&&line.role==='assistant'?btn('重说一次','social-regenerate',data):'')+\n    btn('引用回复','social-quote',data)+btn(line.role==='user'?'撤回这条消息':'删除这条消息','social-remove-confirm',data)+\n    (line.kind==='call'?btn('查看通话纪要','social-call-log',data):'')+\n    '\u003c/div>',{socialLine:line.id||JSON.stringify(line),scope:socialScope(groupMode,item.id)});\n}\nfunction socialSelected(group,index) {\n  const selected=socialReadLine(group,index);\n  if (!selected.line||modalContext?.scope!==socialScope(group,selected.id)||\n      (selected.line.id||JSON.stringify(selected.line))!==modalContext.socialLine) {\n    throw Error('这条消息的位置已变化，请重新选择。');\n  }\n  return selected;\n}\nfunction socialSaveLines(group,record) {\n  if (group) saveGroup(record);\n  else save();\n}\nasync function socialRegenerate({group,index}) {\n  const groupMode=group==='true', at=Number(index);\n  const {line,lines,id}=socialSelected(groupMode,at);\n  const p=person(groupMode?line.personId:id);\n  if (line.role!=='assistant'||!p) return;\n  const scope=socialScope(groupMode,id), operation=socialStart(scope);\n  if (!operation) throw Error('当前会话还在生成，请稍后。');\n  const history=socialChatHistory(lines.slice(0,at));\n  const topic=history.findLast(item=>item.role==='user')?.content||'请重新接着刚才的话题回复。';\n  closeModal();render();\n  try {\n    const raw=osModelEnabled()\n      ? await osRequest(settings.chat,characterPrompt(p,scene(),topic)+'\\n'+phonePrompt('regenerate',state.phonePrompts),\n        history.length?history:[{role:'user',content:topic}],operation,true)\n      : (localLines[p.dialect]||localLines.dongbei)[1];\n    if (!socialCurrent(operation)) return;\n    const parts=readPhoneMessageParts(raw);\n    if (!parts.text) throw Error('模型未返回重写正文。');\n    const latest=socialReadLine(groupMode,at);\n    if (latest.id!==id||JSON.stringify(line)!==JSON.stringify(latest.line)) throw Error('原消息已变化，取消替换。');\n    const replacement={...line,id:line.id||osId(),text:parts.text.replace(/\\s*\\|\\|\\s*/gu,' '),thought:parts.thought||undefined};\n    delete replacement.fullText;\n    delete replacement.photoPrompt;\n    delete replacement.generatedPhoto;\n    latest.lines[at]=replacement;\n    socialSaveLines(groupMode,latest.record);\n  } catch(error) {if(socialCurrent(operation))notes[scope]=error.message;}\n  finally {socialEnd(operation);if(osAlive&&state===operation.current)render();}\n}\nfunction socialPhotoEligible(p,topic) {\n  return affinity(p.id)>=40||(/(?:2[0-3]|0[0-5]):\\d\\d/u.test(scene().time_slot)&&/穿搭|衣服|试衣|生活照|自拍|照片/u.test(topic));\n}\nfunction socialPhotoPrompt(p,topic) {\n  return socialPhotoEligible(p,topic)?'\\n'+phonePrompt('photo',state.phonePrompts)+' 如果发照片，在对白后另起一行写 [照片: 简短画面]。':'';\n}\nfunction socialPhotoDialog({index}) {\n  const line=state.chats[activePerson]?.[Number(index)],p=person(activePerson);\n  if (!line?.photoPrompt||!p) return;\n  const context={kind:'selfie',sourceId:line.id,p,index:opening,title:p.name+'的生活照',place:scene(),socialMessageId:line.id};\n  openImageShot(context,imagePrompt('selfie',p,line.photoPrompt,scene(),settings.image.style));\n  // 柏宝绘和本地 ComfyUI 都没有地址和密钥，渠道在别处配好，所以也算能出图。\n  if (settings.image.base||settings.image.key||['sd','baibai','comfy'].includes(settings.image.provider)) {\n    return generatePhoto($('image-form'),false);\n  }\n}\n\nfunction socialCapturePage() {\n  return {current:state,section,person:activePerson,group:activeGroup,hub:hubPage,scrollTop:$('screen').scrollTop,\n    contacts:osTab,album:albumTab,settings:settingsTab,life:lifeTab,topic:lifeTopic};\n}\nfunction socialPageChanged(before) {\n  return before.section!==section||before.person!==activePerson||before.group!==activeGroup||before.hub!==hubPage||\n    (section==='life'&&before.topic!==lifeTopic);\n}\nfunction socialRemember(before) {\n  if (before.current!==state||before.section==='call'||!socialPageChanged(before)) return;\n  socialBackStack.push(before);\n  if (socialBackStack.length>30) socialBackStack.shift();\n}\nfunction socialBack() {\n  if ($('modal').open) {closeModal();return;}\n  if (section==='call'&&socialCall) {endSocialCall();return;}\n  let previous;\n  while ((previous=socialBackStack.pop())) {\n    if (previous.current!==state) continue;\n    const restored=previous;\n    section=restored.section;activePerson=restored.person;activeGroup=restored.group;hubPage=restored.hub;\n    osTab=restored.contacts;albumTab=restored.album;settingsTab=restored.settings;lifeTab=restored.life;lifeTopic=restored.topic;\n    render();\n    queueMicrotask(()=>{\n      if (restored.current!==state||socialPageChanged(restored)) return;\n      $('screen').scrollTop=restored.scrollTop;\n    });\n    return;\n  }\n  if (section!=='home') openPage('home');\n}\nfunction socialBindGestures() {\n  const screen=$('screen');\n  const clearPress=()=>{clearTimeout(socialPressTimer);socialPressStart=null;};\n  screen.addEventListener('pointerdown',event=>{\n    const bubble=event.target.closest('.bubble[data-do=social-line]');\n    if (event.pointerType!=='touch'||!bubble||event.target.closest('button,summary')) return;\n    socialPressStart={x:event.clientX,y:event.clientY};\n    socialPressTimer=setTimeout(()=>socialLineMenu(bubble.dataset),480);\n  });\n  screen.addEventListener('pointermove',event=>{\n    if (socialPressStart&&Math.hypot(event.clientX-socialPressStart.x,event.clientY-socialPressStart.y)>12) clearPress();\n  });\n  for (const event of ['pointerup','pointercancel']) screen.addEventListener(event,clearPress);\n  screen.addEventListener('keydown',event=>{\n    const bubble=event.target.closest('.bubble[data-do=social-line]');\n    if (bubble===event.target&&(event.key==='Enter'||event.key===' ')) {\n      event.preventDefault();socialLineMenu(bubble.dataset);\n    }\n    if (event.key==='Escape'&&section!=='home'&&!$('modal').open) socialBack();\n  });\n  let edge=null;\n  screen.addEventListener('touchstart',event=>{\n    edge=null;\n    if (event.touches.length!==1||['map','home'].includes(section)||$('modal').open||\n      document.activeElement?.closest('input, textarea, [contenteditable]')||\n      event.target.closest('input, textarea, button, .buttons, .map-stage, .os-tabs')) return;\n    const touch=event.touches[0],left=screen.getBoundingClientRect().left;\n    if (touch.clientX-left\u003c=35) edge={x:touch.clientX,y:touch.clientY};\n  },{passive:true});\n  screen.addEventListener('touchend',event=>{\n    const start=edge;edge=null;\n    if (!start) return;\n    const touch=event.changedTouches[0],x=touch.clientX-start.x,y=touch.clientY-start.y;\n    if (x>60&&x>Math.abs(y)*1.6) socialBack();\n  },{passive:true});\n  screen.addEventListener('touchcancel',()=>{edge=null;},{passive:true});\n}\nfunction socialCallDuration(seconds) {\n  return String(Math.floor(seconds/60)).padStart(2,'0')+'分'+String(seconds%60).padStart(2,'0')+'秒';\n}\nfunction socialCallClock(seconds) {\n  return String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');\n}\nfunction socialCallSeconds(call) {\n  return call.connectedAt?Math.max(0,Math.floor((Date.now()-call.connectedAt)/1000)):0;\n}\nfunction ringSocialCall() {\n  const Audio=window.AudioContext||window.webkitAudioContext;\n  if (!Audio) return;\n  try {\n    const context=new Audio(), oscillator=context.createOscillator(), gain=context.createGain();\n    oscillator.frequency.value=440;\n    gain.gain.setValueAtTime(0.035,context.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001,context.currentTime+0.45);\n    oscillator.connect(gain).connect(context.destination);\n    oscillator.onended=()=>context.close().catch(()=>{});\n    oscillator.start();oscillator.stop(context.currentTime+0.48);\n    context.resume().catch(()=>context.close().catch(()=>{}));\n  } catch { /* 静音或不支持 Web Audio 时仍显示呼叫状态。 */ }\n}\nfunction renderSocialCall() {\n  const call=socialCall,p=call&&person(call.personId);\n  if (!p) return osContacts();\n  header(call.video?'视频通话':'语音通话',p.name);\n  const existing=photos.find(item=>item.id===state.liveCovers?.[p.id]&&item.opening===opening);\n  const latest=photos.findLast(item=>item.personId===p.id&&item.opening===opening&&!item.sample&&photoURL(item));\n  const portrait=photoURL(existing)||photoURL(latest);\n  const cover=portrait||osAsset(castCover(p.id));\n  const busy=socialPending.has(call.id);\n  $('phone-footer').innerHTML='\u003cdiv class=\"social-call-footer\">'+\n    (call.connectedAt?'\u003cform id=