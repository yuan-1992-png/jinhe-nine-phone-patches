话回答。',[{role:'user',content:'你好，这是一条连接测试。'}],config);\n        apiStatus(kind,`酒馆代发成功 · ${Math.round(performance.now()-started)} ms\\n${reply.slice(0,180)}`,form);\n      } else if (route === 'host') {\n        const reply=await hostForwardChat('只用一句简短的话回答。',[{role:'user',content:'你好，这是一条连接测试。'}],await resolvePhoneHostPreset(config));\n        apiStatus(kind,`酒馆后端转发成功 · ${Math.round(performance.now()-started)} ms\\n${reply.slice(0,180)}`,form);\n      } else {\n        if (!jinheBridge) throw Error('酒馆主模型要在酒馆里打开九号机才能测。');\n        const reply=await jinheBridge.generate('只用一句简短的话回答。',[{role:'user',content:'你好，这是一条连接测试。'}]);\n        apiStatus(kind,`酒馆主模型连接成功 · ${Math.round(performance.now()-started)} ms\\n${String(reply).slice(0,180)}`,form);\n      }\n    } else {\n      const prompt='Landscape photograph of a quiet county street in China after rain, two parked electric scooters, everyday lighting, no people';\n      const image=await requestImage(config,prompt,'test');\n      const item=await finishPhoto({kind:'test',index,title:'接口测试图'},image);\n      apiStatus(kind,`${image.remoteURL?'图片可预览 · 保存了链接':'生成成功'} · ${Math.round(performance.now()-started)} ms`,form);\n      if (form.isConnected && opening===index && !$('modal').open) viewPhoto(item.id);\n    }\n  } catch (error) {\n    apiStatus(kind,error.message,form);\n    if (form.isConnected) showImageError(form.querySelector('#api-status'),error);\n  }\n  finally {button.disabled=false;}\n}\n\n// Design preview. The existing browser app remains the shared shell.\nconst hubApps = [\n  ['pulse','粉色小怪兽','#f3a4cd'],\n  ['debt','老哥扶持借条','#f7d69e'],\n  ['live','老铁同城夜聊','#f0a2ae'],\n  ['wardrobe','金街衣柜','#efb8d5'],\n  ['calendar','金河私历','#d7b5fa'],\n  ['meetup','九号夜约','#b9e4ae'],\n  ['camera','绝密黑匣子','#c0cbfc']\n];\nconst looks = [\n  ['night','夜市街头','短款机车外套、浅色上衣、牛仔短裤与深色短靴','going'],\n  ['casual','县城夏装','薄紫色上衣、深色百褶裙、灰色纹样丝袜','daily'],\n  ['counter','门店工装','浅粉背心、棕色工作围裙、深灰半身裙与白袜','work'],\n  ['stage','清吧演出','黑色真丝旗袍、黑色花纹丝袜与细带鞋','going'],\n  ['billiards','球厅晚班','黑色短袖针织衫、炭灰短裙、黑色细波点丝袜与银耳圈','work'],\n  ['riverside','滨河夜约','深酒红裹身短裙、菱格黑丝袜与扣带鞋','going'],\n  ['bridge','桥北日常','宽松深灰棉 T 恤、黑色运动短裤、白棉袜与帆布鞋','daily'],\n  ['scooter','九号兜风','炭灰夏季骑行衫、藏青工装短裤与灰色运动鞋','daily'],\n  ['bakery','金街早班','淡黄短袖、鼠尾草绿围裙、深色牛仔裙与米白细针织丝袜','work'],\n  ['sweet','甜酷宵夜','粉色荷叶边背心、黑色叠层短裙、米白花纹网袜与酒红玛丽珍鞋','going'],\n  ['retro','老城复古','焦糖条纹短袖衬衫、方领上衣、深靛九分牛仔裤与黄铜耳圈','daily'],\n  ['lobby','前台夏班','黑色马甲、炭灰 A 字裙、暗纹灰丝袜与黑色乐福鞋','work']\n];\nconst wardrobeGroups = [['all','全部'],['daily','日常'],['work','工装'],['going','夜出'],['custom','自建']];\nconst editorTabs = [['cast','角色'],['player','玩家'],['scene','场景'],['history','历史'],['json','JSON']];\nconst edits = ['scenePatch','profiles','presentIds','knownIds','friends','affinity','cash','stamina','items','property','returnProfile','ledger','phoneFeedback'];\nconst appMetadata = new Map(hubApps.map(([id,title,color])=>[id,{title,color}]));\nlet hubPage = 'pulse', editorTab = 'cast', editorPerson = '', editNotice = '';\nlet visitPerson = '', visitPlace = '', editorReturn = 'home';\n\nfunction onboard() {\n  state.profiles ||= {};\n  state.knownIds ||= Object.keys(source.openings[opening].people);\n  state.presentIds ||= Object.keys(source.openings[opening].people);\n  state.items ||= (source.designItems?.[opening] || []).slice();\n  state.edits ||= [];\n  state.phoneFeedback ||= {};\n}\nfunction currentPerson(id) {\n  return {...source.designFacts?.[id]?.profile,...(source.openings[opening].people[id] || source.people[id]),...state.profiles?.[id]};\n}\nfunction currentCast() {\n  return (state.presentIds ?? Object.keys(source.openings[opening].people)).map(currentPerson).filter(p=>p.id);\n}\nfunction currentPlace() {\n  return state.scenePatch || source.openings[opening].scene;\n}\nfunction knownPeople() {\n  return [...new Set([...(state.knownIds || []),...state.friends,...(state.presentIds || [])])].map(currentPerson).filter(p=>p.id);\n}\nfunction assetFor(id) {\n  return source.locationArt?.[id] || null;\n}\nfunction sceneImage(id) {\n  const asset = assetFor(id), place = places.get(id);\n  if (!asset || !place) return '';\n  return `\u003cfigure class=\"place-photo\">\u003cimg src=\"${esc(osAsset(id))}\" data-remote=\"${esc(asset.url || '')}\" alt=\"${esc(place.name)}场景\" loading=\"lazy\" width=\"1536\" height=\"1024\">\u003cfigcaption>${esc(place.name)}${asset.url ? `\u003ca href=\"${esc(asset.url)}\" target=\"_blank\" rel=\"noopener noreferrer\">图床原图 ↗\u003c/a>` : ''}\u003c/figcaption>\u003c/figure>`;\n}\nfunction locationOptions(current,includeCustom=false) {\n  const pool = includeCustom ? allPlaces() : source.places;\n  return Object.entries(source.zones).map(([id,name])=>`\u003coptgroup label=\"${esc(name)}\">${pool.filter(p=>p.zone===id).map(p=>option(p.id,p.name,current)).join('')}\u003c/optgroup>`).join('');\n}\nfunction selectorPeople(current, all=false) {\n  const people = all ? Object.values(source.people).map(p=>currentPerson(p.id)) : knownPeople();\n  return people.map(p=>option(p.id,p.name+(state.presentIds?.includes(p.id)?' · 在场':state.knownIds?.includes(p.id)?' · 通讯录':' · 预设'),current)).join('');\n}\nfunction appSelect(label, name, options) {\n  return `\u003clabel>${label}\u003cselect name=\"${name}\" required>${options}\u003c/select>\u003c/label>`;\n}\nconst count = (label,name,value,min,max) => field(label,name,value,'number',`min=\"${min}\" max=\"${max}\" step=\"1\" required`);\nfunction range(label,name,value) {\n  return `\u003clabel class=\"range-field\">\u003cspan>${label}\u003coutput>${esc(value)}\u003c/output>\u003c/span>\u003cinput type=\"range\" min=\"0\" max=\"100\" step=\"1\" name=\"${name}\" value=\"${esc(value)}\">\u003c/label>`;\n}\nfunction formTitle(button,id,body) {\n  return `\u003cform id=\"${id}\" class=\"form card stack\">${body}\u003cdiv>\u003cbutton class=\"primary\" type=\"submit\">${button}\u003c/button>\u003c/div>\u003c/form>`;\n}\nfunction localFacts(id) {\n  return source.designFacts?.[id] || {};\n}\nfunction appProfileField(p) {\n  return `\u003cdiv class=\"inline-head\">${avatar(p)}\u003cdiv>\u003cstrong>${esc(p.name)}\u003c/strong>\u003cbr>\u003csmall>${esc(p.work || '预设人物')} · ${esc(p.dialect_label)}\u003c/small>\u003c/div>\u003c/div>`;\n}\n\nconst hubLabels = {\n  pulse:'档位与反馈',debt:'欠款与帮付',live:'竖屏直播',\n  wardrobe:'选款与试穿',calendar:'日历与图鉴',meetup:'看图选房间',camera:'取景与相册'\n};\nconst waveHeights=[12,18,24,16,28,45,58,39,21,33,57,43,64,34,48,62,32,56,46,26,43,22,29,15,12];\nconst outfitPositions=['0% 0%','100% 0%','0% 100%','100% 100%'];\nconst outfitColors=['#a68fae','#c49ca8','#d9bfb2','#8490a8','#6d7660','#a77175','#a3bcb0','#8d9fae','#d6ad90','#ad8198','#8796c1','#507f82'];\nconst pulseProfiles = [\n  ['轻颤',8,0,10],['脉冲',15,0,18],['阶梯',25,20,25],['高频',40,30,35],['间歇',12,5,12]\n];\nconst cameraAngles=['街边全景','半身','镜前','定妆'];\nconst livePositions={bus_station:'82% 64%',night_market:'64% 62%',bridge_north:'87% 58%',longteng_spa:'66% 56%',old_cotton_mill:'39% 56%',mixue_gate:'52% 58%',paris_bar:'54% 65%',jazz_bar:'75% 58%'};\nconst liveComments = new Map();\nlet pulsePick=1, dayPick=null, calendarMode='days', cameraAngle='街边全景', cameraPlace='', pkPick='';\nlet wardrobeGroup='all', wardrobeChoice='';\n\nfunction hubMark(id) {\n  const {color}=appMetadata.get(id);\n  return `\u003cspan class=\"hub-mark\" style=\"--hub-mark:${color}\" aria-hidden=\"true\">${icon('app-'+id)}\u003c/span>`;\n}\n\nfunction moduleHeader(id) {\n  const {title,color}=appMetadata.get(id);\n  $('phone-header').innerHTML=`\u003cdiv class=\"app-header hub-module-header\" style=\"--hub-mark:${color}\">${iconBtn('返回金河应用','left','open',{page:'hub'})}\n    ${hubMark(id)}\u003cdiv>\u003ch2>${title}\u003c/h2>\u003csmall>${hubLabels[id]}\u003c/small>\u003c/div>\u003c/div>`;\n}\n\nfunction coverPhoto(id, positioning='center', override='') {\n  const art=assetFor(id);\n  const local=osAsset(id);\n  return `\u003cimg class=\"jh-cover\" src=\"${esc(override||local)}\" data-art-fallback=\"${esc(override?local:art?.url||'')}\" alt=\"\" style=\"--cover-position:${positioning}\">`;\n}\nfunction castCover(id) {\n  const op=source.openings.find(item=>Object.hasOwn(item.people,id));\n  return op?.scene.location_id || scene().location_id;\n}\nfunction wave(className='') {\n  return `\u003cdiv class=\"jh-wave ${className}\" aria-hidden=\"true\">${waveHeights.map((height,index)=>`\u003cspan style=\"--bar:${height}px;--order:${index}\">\u003c/span>`).join('')}\u003c/div>`;\n}\nfunction renderHub() {\n  onboard();\n  header('金河应用',scene().location_name);\n  const thumbnails={\n    pulse:wave('motif wave-token'),\n    debt:'\u003cspan class=\"motif\" aria-hidden=\"true\">¥\u003c/span>',\n    wardrobe:'\u003cspan class=\"motif wardrobe-token jh-flatlay\" style=\"--product-position:100% 0%\" aria-hidden=\"true\">\u003c/span>',\n    calendar:`\u003cspan class=\"motif\">第 ${scene().day||1} 天\u003c/span>`,\n    meetup:coverPhoto(scene().location_id),\n    camera:'\u003cspan class=\"motif brackets\" aria-hidden=\"true\">\u003c/span>'\n  };\n  return `\u003cdiv class=\"jh-hub\">\n    \u003cbutton class=\"jh-hub-hero jh-shade\" data-do=\"hub-app\" data-id=\"live\">\n      ${coverPhoto('paris_bar','center 12%',source.appArt?.xiaomanLive)}\n      \u003cspan class=\"hub-feature-mark\">${hubMark('live')}\u003c/span>\n      \u003cspan class=\"jh-hero-tag\">同城直播 · 预览\u003c/span>\n      \u003cstrong>老铁同城夜聊\u003c/strong>\u003csmall>任小满 · 球厅直播预览\u003c/small>\n      \u003cspan class=\"entry-arrow\">${icon('arrow')}\u003c/span>\n    \u003c/button>\n    \u003cdiv class=\"jh-app-grid\">${hubApps.filter(([id])=>id!=='live').map(([id,title])=>`\n      \u003cbutton class=\"jh-app-card ${id} ${id==='meetup'?'jh-shade':''}\" data-do=\"hub-app\" data-id=\"${id}\">\n        ${thumbnails[id]}${hubMark(id)}\u003cstrong>${title}\u003c/strong>\u003csmall>${hubLabels[id]}\u003c/small>\n      \u003c/button>`).join('')}\u003c/div>\n  \u003c/div>`;\n}\nfunction inlinePerson(p) {\n  if (!p?.id) return '';\n  return `\u003cdiv class=\"form jh-inline-person\">${appSelect('人物','person',selectorPeople(p.id))}\u003c/div>`;\n}\nfunction pulseValues(p) {\n  const seed=localFacts(p.id).reaction || {};\n  return state.phoneFeedback[p.id]?.metrics || {\n    arousal:p.arousal??seed.arousal??0,\n    shame:p.shame??seed.shame??0,\n    wetness:p.wetness??seed.wetness??0\n  };\n}\nfunction dial(label,value,color) {\n  return `\u003cdiv class=\"jh-gauge\">\u003cdiv class=\"jh-dial\" style=\"--progress:${value}%;--arc:${color}\">\u003cb>${value}\u003c/b>\u003c/div>${label}\u003c/div>`;\n}\nfunction renderPulse(p) {\n  const feedback=state.phoneFeedback[p.id];\n  const running=feedback?.running===true;\n  const values=pulseValues(p);\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    ${inlinePerson(p)}\n    \u003csection class=\"jh-control\">\n      \u003cdiv class=\"jh-overline\">\u003cstrong>${running?'运行中 · '+feedback.level+' 档':'待机'}\u003c/strong>\u003cspan>档位 ${pulsePick} · ${pulseProfiles[pulsePick-1][0]}\u003c/span>\u003c/div>\n      \u003cdiv class=\"jh-wave-panel\" data-running=\"${running}\">${wave()}\u003c/div>\n      \u003cdiv class=\"jh-gauges\" aria-label=\"角色状态，满值 100\">\n        ${dial('动情度',values.arousal,'#f291cb')}${dial('羞耻度',values.shame,'#d3a2f6')}${dial('湿润度',values.wetness,'#eb88aa')}\n      \u003c/div>\n      \u003cdiv class=\"jh-levels\" aria-label=\"选择档位\">${pulseProfiles.map(([label],index)=>`\u003cbutton class=\"btn\" data-do=\"jh-level\" data-level=\"${index+1}\" aria-label=\"${index+1}档 ${label}\" aria-pressed=\"${pulsePick===index+1}\">${index+1}\u003c/button>`).join('')}\u003c/div>\n      \u003cinput name=\"level\" type=\"hidden\" value=\"${pulsePick}\">\n      \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">${running?'应用此档':'试运行'}\u003c/button>\n        ${running?btn('停止','pulse-stop',{id:p.id},'btn jh-stop'):''}\u003c/div>\n      \u003cp class=\"jh-connect\">剧情状态演示\u003c/p>\n    \u003c/section>\n  \u003c/form>`;\n}\nfunction debtDue(p) {\n  if (p.debt===undefined) return localFacts(p.id).debtAmount;\n  if (/无负债|结清|已帮付/.test(p.debt)) return 0;\n  return Number((p.debt.match(/(\\d[\\d,]*)\\s*(?:元|块)/)?.[1]||'').replaceAll(',',''));\n}\nfunction renderDebt(p) {\n  const amount=debtDue(p);\n  const settled=typeof p.debt==='string'&&p.debt.startsWith('已帮付');\n  const status=p.debt|| (amount?'待帮付':'没有核实到欠款');\n  const already=state.ledger.filter(item=>item.name===p.name&&item.kind==='support');\n  return `\u003cform class=\"form stack\" id=\"hub-form\">\n    ${inlinePerson(p)}\n    \u003cdiv class=\"jh-receipt\">\n      \u003cdiv class=\"jh-overline\">\u003cspan>金河扶持账单\u003c/span>\u003cspan>${esc(p.name)}\u003c/span>\u003c/div>\n      \u003cstrong class=\"amount\">${settled?'已帮付':amount?money(amount):'待核对'}\u003c/strong>\n      \u003cdl>\u003cdiv>\u003cdt>当前余额\u003c/dt>\u003cdd>${money(state.cash)}\u003c/dd>\u003c/div>\u003c/dl>\n      \u003cfooter>${esc(status)}\u003c/footer>\n    \u003c/div>\n    ${count('本次帮付（元）','amount',settled?100:amount||100,1,999999999999)}\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">核对帮付\u003c/button>${btn('看钱包','open',{page:'wallet'})}\u003c/div>\n    ${already.length?`\u003cdiv class=\"card\">\u003ch3>最近帮付\u003c/h3>${already.slice(-3).reverse().map(item=>`\u003cp class=\"hint\">${esc(item.time)} · ${money(item.amount)}\u003c/p>`).join('')}\u003c/div>`:''}\n  \u003c/form>`;\n}\nfunction roomComments(p) {\n  return liveComments.get(opening+':'+p.id) || ['九号阿凯：到哪儿打球？','同城·小梅：外面刚下过雨。'];\n}\nasync function importLiveCover(file,id) {\n  const index=opening, p=person(id);\n  if (!p || !file) return;\n  const blob=await loadLocalPhoto(file);\n  const item=await finishPhoto({kind:'live-cover',index,p,title:p.name+'的直播封面'},{blob});\n  setLiveCover(id,item.id,index);\n}\nfunction setLiveCover(id,photoId,index) {\n  const current=getState(index);\n  (current.liveCovers ||= {})[id]=photoId;\n  save();\n  if (opening===index && section==='hub-app' && hubPage==='live') render();\n}\nasync function checkPhotoSize(blob) {\n  let sample;\n  try { sample=await createImageBitmap(blob); }\n  catch { throw Error('无法读出这张图片，请换一个可打开的文件'); }\n  const valid=sample.width>0 && sample.height>0 && sample.width*sample.height\u003c=24_000_000;\n  sample.close();\n  if (!valid) throw Error('照片尺寸太大，请换一张');\n  return blob;\n}\nasync function loadLocalPhoto(file) {\n  if (file.size>8_000_000) throw Error('请选 8 MB 以内的图片');\n  const bytes=new Uint8Array(await file.arrayBuffer());\n  return checkPhotoSize(pictureBlob(bytes,'请选择有效的 PNG、JPG、WebP 或 AVIF 图片'));\n}\nfunction renderLive(p) {\n  const frame=castCover(p.id);\n  const comments=roomComments(p);\n  const gifts=state.ledger.filter(item=>item.name===p.name&&item.kind==='gift');\n  const imported=photos.find(item=>item.id===state.liveCovers?.[p.id]&&item.opening===opening);\n  const cover=photoURL(imported)||(p.id==='girl_dongbei_ren_xiaoman'?source.appArt?.xiaomanLive:'');\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    \u003cdiv class=\"jh-live-room jh-shade\">\n      ${coverPhoto(frame,cover?'center 45%':livePositions[frame]||'center 63%',cover)}\n      \u003cdiv class=\"jh-live-top\">${avatar(p)}\u003cdiv>\u003cstrong>${esc(p.name)}的直播间\u003c/strong>\u003csmall>金河同城\u003c/small>\u003c/div>\u003cspan class=\"jh-hero-tag\">场景预览\u003c/span>\u003c/div>\n      \u003cdiv class=\"jh-live-chat\" aria-live=\"polite\">${comments.slice(-4).map(line=>`\u003cdiv>${esc(line)}\u003c/div>`).join('')}\u003c/div>\n    \u003c/div>\n    ${inlinePerson(p)}\n    \u003cdiv class=\"jh-cover-picker\">\u003cspan class=\"hint\">${imported?'本地自选封面':cover?'任小满 · 专属直播封面':'地点场景封面'}\u003c/span>\n      \u003cinput type=\"file\" id=\"live-cover-import\" accept=\"image/png,image/jpeg,image/webp,image/avif\" hidden>\n      ${btn('更换封面','upload-live-cover',{id:p.id})}${imported?btn('恢复默认','reset-live-cover',{id:p.id}):''}\u003c/div>\n    \u003cdiv class=\"jh-live-composer\">\u003cinput class=\"input\" aria-label=\"弹幕\" name=\"message\" placeholder=\"发条弹幕…\" maxlength=\"100\" required>\u003cbutton class=\"primary\" type=\"submit\">发送\u003c/button>\u003c/div>\n    \u003cdiv class=\"buttons\">${[[66,'火箭'],[188,'穿云箭'],[520,'嘉年华']].map(([n,name])=>btn(icon('gift')+' '+name+' '+money(n),'show-payment',{id:p.id,kind:'gift',amount:n})).join('')}\u003c/div>\n    \u003cdiv class=\"jh-round\">\u003cdiv class=\"jh-overline\">\u003cspan>同城 PK\u003c/span>\u003cspan>累计打赏 ${money(gifts.reduce((sum,item)=>sum+item.amount,0))}\u003c/span>\u003c/div>\n      \u003cp class=\"hint\">${pkPick?esc(pkPick):'抽一个下一轮挑战'}\u003c/p>\u003cdiv class=\"buttons\">${btn('抽挑战','jh-round',{id:p.id})}\u003c/div>\u003c/div>\n  \u003c/form>`;\n}\nfunction wardrobeCatalogue() {\n  const builtin=looks.map(([id,label,description,group],index)=>({id,label,description,group,index}));\n  const custom=photos.filter(photo=>photo.kind==='wardrobe').map(photo=>({\n    id:photo.id,label:photo.title,description:photo.description||photo.title,group:photo.group,photo\n  }));\n  return [...builtin,...custom.reverse()];\n}\nfunction wardrobeCard(look,selected) {\n  const {id,label,index,photo}=look;\n  const sheet=Math.floor(index/4);\n  const visual=photo\n    ? `\u003cimg class=\"jh-custom-look\" src=\"${esc(photoURL(photo))}\" alt=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer\">`\n    : `\u003cspan class=\"jh-flatlay\" aria-hidden=\"true\" style=\"--outfit-sheet:var(--jh-clothing${sheet?'-'+sheet:''});--product-position:${outfitPositions[index%4]};--product-fallback:${outfitColors[index]}\">\u003c/span>`;\n  return `\u003clabel class=\"jh-product\">\u003cinput type=\"radio\" name=\"look\" value=\"${esc(id)}\" ${selected?'checked':''}>\n    ${visual}\u003cspan>${esc(label)}\u003c/span>\u003c/label>`;\n}\nfunction renderWardrobe(p) {\n  const catalogue=wardrobeCatalogue();\n  const shown=catalogue.filter(look=>wardrobeGroup==='all' || (wardrobeGroup==='custom' ? look.photo : look.group===wardrobeGroup));\n  const selected=shown.find(look=>look.id===wardrobeChoice) ||\n    shown.find(look=>look.id===p?.styleKey) || shown.find(look=>look.label===p?.style) || shown[0];\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    ${inlinePerson(p)}\n    \u003cdiv class=\"jh-overline\">\u003cstrong>衣服与搭配\u003c/strong>\u003cspan>${shown.length} / ${catalogue.length} 套\u003c/span>\u003c/div>\n    \u003cdiv class=\"buttons jh-look-create\">${btn(icon('album')+' 上传图片','add-custom-look',{mode:'upload'})}\n      ${btn(icon('photo')+' AI 生图','add-custom-look',{mode:'generate'})}\u003c/div>\n    \u003cdiv class=\"buttons jh-look-category\">${wardrobeGroups.map(([key,label])=>`\u003cbutton class=\"filter\" type=\"button\" data-do=\"jh-look-group\" data-id=\"${key}\" aria-pressed=\"${wardrobeGroup===key}\">${label}\u003c/button>`).join('')}\u003c/div>\n    ${selected?`\u003cdiv class=\"jh-product-grid\">${shown.map(look=>wardrobeCard(look,selected.id===look.id)).join('')}\u003c/div>\n    \u003cdiv class=\"jh-look-actions\">\u003cstrong id=\"jh-look-name\">${esc(selected.label)}\u003c/strong>\u003cp class=\"hint\" id=\"jh-look-description\">${esc(selected.description)}\u003c/p>\n      \u003cp class=\"hint\">${p?.style ? '当前穿着 · '+esc(p.style) : p ? '保存后替换当前穿搭' : '选定人物后就可以试穿'}\u003c/p>\n      \u003cdiv class=\"buttons\">${p ? `\u003cbutton class=\"primary\" type=\"submit\">保存试穿\u003c/button>${btn('打开试穿相机','image-dialog',{kind:'portrait',id:p.id})}` : btn('添加人物','edit-open')}\u003c/div>\n    \u003c/div>`:empty('还没有自建衣服','选一张本地图片，或用 AI 设计一套。')}\n  \u003c/form>`;\n}\nfunction showCustomLookEditor(mode) {\n  const upload=mode==='upload';\n  modal(upload?'上传衣服图片':'AI 设计衣服',`\u003cform id=\"custom-look-form\" class=\"form\">\n    ${upload?'\u003clabel>衣服图片\u003cinput type=\"file\" name=\"picture\" class=\"jh-look-file\" accept=\"image/png,image/jpeg,image/webp,image/avif\" required>\u003c/label>':''}\n    ${field('衣服名称','title','','text','maxlength=\"30\" placeholder=\"例如：滨河夜班装\" required')}\n    ${appSelect('分类','group',wardrobeGroups.slice(1,4).map(([id,name])=>option(id,name,'daily')).join(''))}\n    \u003clabel>${upload?'穿搭描述（选填）':'想生成什么款式'}\n      \u003ctextarea name=\"description\" rows=\"3\" maxlength=\"180\" ${upload?'':'required'} placeholder=\"例如：酒红色薄针织上衣、黑色百褶裙、灰色纹样丝袜\">\u003c/textarea>\u003c/label>\n    ${upload?'':`\u003clabel>自定义提示词（可选）\u003ctextarea name=\"prompt\" rows=\"3\" maxlength=\"2200\" placeholder=\"留空时使用上面的衣服名称和款式\">\u003c/textarea>\u003c/label>${imageOptionsPanel(settings.image,'wardrobe',{textOnly:true})}`}\n    \u003cfigure class=\"jh-look-preview\" id=\"custom-look-preview\" hidden>\u003cimg alt=\"衣服预览\">\u003c/figure>\n    \u003cp class=\"feedback\" id=\"custom-look-status\" role=\"status\">\u003c/p>\n    \u003cdiv class=\"buttons\">\n      ${upload?'':btn('生成预览','generate-custom-look')}\n      \u003cbutton class=\"primary\" type=\"submit\" disabled>保存进衣柜\u003c/button>\n      ${upload?'':btn('画图设置','image-settings')}\n    \u003c/div>\n    \u003cp class=\"hint\">${upload?'支持 PNG、JPG、WebP、AVIF，图片保存在这个浏览器。':'调用你在画图设置里选的接口，先看图，再决定是否保存。'}\u003c/p>\n  \u003c/form>`,{kind:'wardrobe-editor',mode,sequence:0,busy:false});\n}\nfunction setLookPreview(form,draft,result) {\n  if (draft.lookPreviewUrl) URL.revokeObjectURL(draft.lookPreviewUrl);\n  const figure=form.querySelector('#custom-look-preview'), image=figure.querySelector('img');\n  draft.image=result;\n  draft.lookPreviewUrl=result?.blob?URL.createObjectURL(result.blob):'';\n  figure.hidden=!result;\n  image.referrerPolicy='no-referrer';\n  if (result) image.src=draft.lookPreviewUrl || result.remoteURL;\n  else image.removeAttribute('src');\n  form.querySelector('[type=submit]').disabled=!result;\n}\nasync function previewUploadedLook(field) {\n  const form=field.form,draft=modalContext,file=field.files[0];\n  if (draft?.kind!=='wardrobe-editor'||draft.mode!=='upload'||draft.busy) return;\n  const sequence=++draft.sequence;\n  const status=form.querySelector('#custom-look-status');\n  setLookPreview(form,draft,null);\n  status.textContent=file?'正在读取图片…':'';\n  if (!file) return;\n  if (!form.elements.title.value) form.elements.title.value=file.name.replace(/\\.[^.]+$/,'').slice(0,30);\n  try {\n    const blob=await loadLocalPhoto(file);\n    if (modalContext!==draft || sequence!==draft.sequence) return;\n    setLookPreview(form,draft,{blob});\n    status.textContent='';\n  } catch(error) {\n    if (modalContext===draft && sequence===draft.sequence) status.textContent=error.message;\n  }\n}\nasync function generateCustomLook(button) {\n  const form=button.form,draft=modalContext,submitButton=form.querySelector('[type=submit]');\n  const description=formValue(form,'description'),title=formValue(form,'title');\n  if (draft?.kind!=='wardrobe-editor'||draft.mode!=='generate'||draft.busy||!form.reportValidity()) return;\n  const status=form.querySelector('#custom-look-status');\n  if (!title||!description) {status.textContent='填写衣服名称和想生成的款式。';return;}\n  draft.busy=true;\n  button.disabled=submitButton.disabled=true;\n  status.textContent='正在生成衣服预览…';\n  let prompt=formValue(form,'prompt')||wardrobeImagePrompt(title,description);\n  try {\n    const reference=await readImageReference(form);\n    if (reference?.unavailable&&reference.description){\n      const note='参考图画面：'+reference.description+'。';\n      if (!prompt.includes(note)) prompt=prompt+'\\n'+note;\n    }\n    const usableReference=reference&&!reference.unavailable?reference:null;\n    const image=await requestImage({...readImageShot(form,imageFormConfig()),reference:usableReference},prompt,'wardrobe');\n    if (image.blob) await checkPhotoSize(image.blob);\n    if (modalContext!==draft) return;\n    setLookPreview(form,draft,image);\n    setImageStatus(status,image.remoteURL?'预览已生成，衣柜可保存图片链接。':'预览已生成。',image.remoteURL);\n  } catch(error) {\n    if (modalContext===draft) showImageError(status,error);\n  } finally {\n    draft.busy=false;\n    button.disabled=false;\n    submitButton.disabled=!draft.image;\n  }\n}\nfunction wardrobeImagePrompt(title,description) {\n  return `写实服装商品照，完整服装平铺，无人物，干净背景。款式「${title}」。搭配：${description}。展示布料纹理、颜色和配饰。`;\n}\nasync function saveCustomLook(form) {\n  const draft=modalContext,title=formValue(form,'title'),group=formValue(form,'group');\n  if (draft?.kind!=='wardrobe-editor'||draft.busy||!draft.image) return;\n  if (!title) {form.querySelector('#custom-look-status').textContent='请输入衣服名称。';return;}\n  if (!wardrobeGroups.slice(1,4).some(([key])=>key===group)) return;\n  const item={id:'look-'+uid(),kind:'wardrobe',title,group,description:formValue(form,'description'),...draft.image,createdAt:Date.now()};\n  const buttons=[...form.querySelectorAll('button')];\n  draft.busy=true;\n  buttons.forEach(button=>button.disabled=true);\n  let persisted=true;\n  try { await storage.savePhoto(item); }\n  catch { persisted=false; }\n  photos.push(item);\n  if (modalContext===draft) closeModal();\n  if (section==='hub-app' && hubPage==='wardrobe') {\n    wardrobeGroup='custom';wardrobeChoice=item.id;render(true);\n    $('hub-form').querySelector('[name=look]:checked')?.focus({preventScroll:true});\n  }\n  notify(persisted?'已存入自建衣柜':'衣服已临时加入，浏览器未能保存');\n}\nfunction renderCalendar(p) {\n  const today=scene().day||1, base=Math.floor((today-1)/14)*14+1, selected=dayPick??today;\n  const phase=p.phase||localFacts(p.id).phase||'未告知';\n  const baseline=localFacts(p.id).chart || [null,null,null,null];\n  const numbers=[p.tightness??baseline[0],p.suction??baseline[1],state.phoneFeedback[p.id]?.metrics?.wetness??p.wetness??baseline[2],p.development??baseline[3]];\n  const axes=['紧致度','吸力','湿润度','开发度'];\n  if (calendarMode==='chart') queueMicrotask(()=>drawHubChart(numbers));\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    ${inlinePerson(p)}\n    \u003cdiv class=\"buttons\" aria-label=\"日历应用页面\">\n      \u003cbutton class=\"filter\" data-do=\"jh-calendar-tab\" data-page=\"days\" aria-pressed=\"${calendarMode==='days'}\">剧情日历\u003c/button>\n      \u003cbutton class=\"filter\" data-do=\"jh-calendar-tab\" data-page=\"chart\" aria-pressed=\"${calendarMode==='chart'}\">状态图鉴\u003c/button>\n    \u003c/div>\n    ${calendarMode==='chart'?`\u003cdiv class=\"jh-chart\">${p.traitName?`\u003ch3>${esc(p.traitName)}\u003c/h3>\u003cp class=\"hint\">${esc(p.traitGrade||'')}\u003c/p>`:''}\u003ccanvas id=\"jh-radar\" width=\"300\" height=\"177\" role=\"img\" aria-label=\"角色属性雷达图\">\u003c/canvas>\n      \u003cdiv class=\"jh-chart-values\">${axes.map((name,i)=>`\u003cdiv>${name} · \u003cb>${numbers[i]??'未记录'}\u003c/b>\u003c/div>`).join('')}\u003c/div>\u003c/div>`:\n      `\u003cdiv class=\"jh-calendar\">\n        \u003cdiv class=\"jh-overline\">\u003cstrong>第 ${selected} 天\u003c/strong>\u003cspan>剧情进行至第 ${today} 天\u003c/span>\u003c/div>\n        \u003cdiv class=\"jh-days\">${Array.from({length:14},(_,i)=>base+i).filter(day=>day\u003c=999999).map(day=>`\u003cbutton class=\"${day===today?'is-today':''}\" aria-label=\"剧情第 ${day} 天\" aria-pressed=\"${day===selected}\" data-do=\"jh-day\" data-day=\"${day}\">${day}\u003c/button>`).join('')}\u003c/div>\n        \u003cp class=\"hint\">${selected===today?'档案状态 · '+esc(phase)+(p.fertility?' · '+esc(p.fertility):''):'这一天暂无单独档案。'}\u003c/p>\n      \u003c/div>`}\n    \u003cdiv class=\"buttons\">${btn('编辑角色档案','edit-open',{id:p.id})}\u003c/div>\n  \u003c/form>`;\n}\nfunction drawHubChart(values) {\n  const canvas=$('jh-radar');\n  if (!canvas) return;\n  const ctx=canvas.getContext('2d'), x=150, y=88, radius=64;\n  const coords=(index,scale)=>[x+Math.sin(index*Math.PI/2)*radius*scale,y-Math.cos(index*Math.PI/2)*radius*scale];\n  function polygon(scales,fill,stroke) {\n    ctx.beginPath();\n    scales.forEach((scale,index)=>{\n      if (index===0) ctx.moveTo(...coords(index,scale));else ctx.lineTo(...coords(index,scale));\n    });\n    ctx.closePath();if(fill){ctx.fillStyle=fill;ctx.fill();}\n    ctx.strokeStyle=stroke;ctx.stroke();\n  }\n  ctx.clearRect(0,0,300,177);\n  for (const step of [.25,.5,.75,1]) polygon([step,step,step,step],'','#815471');\n  ctx.strokeStyle='#815471';\n  for (let i=0;i\u003c4;i++) {ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(...coords(i,1));ctx.stroke();}\n  if (values.some(value=>value!==null)) polygon(values.map(value=>(value??0)/100),'#f582c05d','#f0a9d3');\n  ctx.fillStyle='#f4d1ea';ctx.font='11px sans-serif';ctx.textAlign='center';\n  ctx.fillText('紧致度',150,17);ctx.fillText('吸力',233,91);ctx.fillText('湿润度',150,170);ctx.fillText('开发度',61,91);\n}\nfunction venuePanel(id) {\n  const p=places.get(id);\n  if (!p) return '';\n  const link=assetFor(id)?.url;\n  return `\u003cdiv class=\"jh-venue jh-shade\" id=\"jh-venue\">\n    ${assetFor(id)?coverPhoto(id,'center 52%'):''}\n    \u003csmall>${esc(p.area)}\u003c/small>\u003ch3>${esc(p.name)}\u003c/h3>\n    ${link?`\u003ca class=\"jh-link\" href=\"${esc(link)}\" target=\"_blank\" rel=\"noopener noreferrer\">查看地点原图 ↗\u003c/a>`:''}\n  \u003c/div>`;\n}\nfunction renderMeetup(p) {\n  const id=visitPlace||scene().location_id;\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    ${venuePanel(id)}\n    ${appSelect('目的地','location',locationOptions(id,true))}\n    ${meetupPeople()}\n    ${field('具体位置','spot','','text','maxlength=\"80\" list=\"edit-scene-spots\" placeholder=\"如二楼靠窗包厢\"')}\n    ${spotOptions(id)}\n    ${field('见面时间','when','现在','text','maxlength=\"32\" required')}\n    \u003cdiv class=\"jh-time-chips\">${['现在','21:30','23:00'].map(time=>btn(time,'jh-time',{time})).join('')}\u003c/div>\n    \u003cdiv>\u003cbutton class=\"primary\" type=\"submit\">生成邀约草稿\u003c/button>\u003c/div>\n  \u003c/form>`;\n}\nfunction renderCamera(p) {\n  const positions=['center','center 68%','center 56%','center 62%'];\n  const id=cameraPlace||scene().location_id, venue=places.get(id);\n  return `\u003cform id=\"hub-form\" class=\"form stack\">\n    \u003cdiv class=\"jh-viewfinder jh-shade\">\n      ${coverPhoto(id,positions[cameraAngles.indexOf(cameraAngle)])}\n      \u003cspan>${esc(venue?.name||scene().location_name)} · ${esc(cameraAngle)}${assetFor(id)?'':' · 取景示意'}\u003c/span>\n    \u003c/div>\n    ${inlinePerson(p)}\n    ${appSelect('取景地点','cameraPlace',locationOptions(id,true))}\n    \u003cdiv class=\"buttons\" aria-label=\"取景方式\">${cameraAngles.map(angle=>`\u003cbutton class=\"filter\" data-do=\"jh-angle\" data-id=\"${angle}\" aria-pressed=\"${cameraAngle===angle}\">${angle}\u003c/button>`).join('')}\u003c/div>\n    \u003cinput type=\"hidden\" name=\"angle\" value=\"${esc(cameraAngle)}\">\n    \u003cdiv class=\"jh-shutter-row\">\u003cbutton class=\"jh-shutter\" type=\"submit\" aria-label=\"打开拍摄面板\">${icon('photo')}\u003c/button>\u003cspan class=\"jh-shutter-label\">拍摄提示词\u003c/span>${btn('相册','open',{page:'album'})}\u003c/div>\n  \u003c/form>`;\n}\nconst renderModule={pulse:renderPulse,debt:renderDebt,live:renderLive,wardrobe:renderWardrobe,calendar:renderCalendar,meetup:renderMeetup,camera:renderCamera};\nfunction renderHubApp() {\n  onboard();\n  moduleHeader(hubPage);\n  const candidates=knownPeople();\n  const p=candidates.find(item=>item.id===visitPerson)||candidates[0];\n  if (!p && hubPage!=='meetup' && hubPage!=='wardrobe') {\n    return `\u003cdiv class=\"jh-app\">${empty('暂无可选人物','可在改变量里选择预设人物，让她加入当前场景。',btn('改变量','edit-open'))}\u003c/div>`;\n  }\n  return `\u003cdiv class=\"jh-app\">${renderModule[hubPage](p)}\u003c/div>`;\n}\nfunction adjustPulse(p,level) {\n  const previous=pulseValues(p), [,arousal,shame,wetness]=pulseProfiles[level-1];\n  state.phoneFeedback[p.id]={running:true,level,metrics:{\n    arousal:Math.min(100,previous.arousal+arousal),\n    shame:Math.min(100,previous.shame+shame),\n    wetness:Math.min(100,previous.wetness+wetness)\n  }};\n}\nfunction selectHubModule(id) {\n  if (!appMetadata.has(id)) return;\n  hubPage=id;\n  visitPerson=visitPlace='';\n  pulsePick=1;calendarMode='days';dayPick=null;cameraAngle='街边全景';cameraPlace='';pkPick='';\n  wardrobeGroup='all';wardrobeChoice='';\n  openPage('hub-app');\n}\nfunction refineHubActions() {\n  Object.assign(actions,{\n    'hub-app':({id})=>selectHubModule(id),\n    'jh-level':({level})=>{\n      const chosen=Number(level);\n      if (chosen>=1&&chosen\u003c=pulseProfiles.length) {pulsePick=chosen;render();}\n    },\n    'jh-calendar-tab':({page})=>{calendarMode=page;render();},\n    'jh-day':({day})=>{dayPick=Number(day);render();},\n    'jh-time':({time})=>{$('hub-form').elements.when.value=time;},\n    'jh-angle':({id})=>{cameraAngle=id;render();},\n    'jh-look-group':({id})=>{\n      wardrobeGroup=id;render(true);\n      $('screen').querySelector('[data-do=jh-look-group][aria-pressed=true]')?.focus({preventScroll:true});\n    },\n    'add-custom-look':({mode})=>showCustomLookEditor(mode),\n    'generate-custom-look':(_,button)=>generateCustomLook(button),\n    'upload-live-cover':({id})=>{const file=$('live-cover-import');file.dataset.person=id;file.click();},\n    'reset-live-cover':({id})=>{delete state.liveCovers[id];save();render();},\n    'jh-round':()=>{const challenges=['打一杆长台，把球稳稳送进底袋。','挑一首金河夜市歌单里的老歌。','用家乡话念一句同城打招呼。'];pkPick=challenges[(challenges.indexOf(pkPick)+1)%challenges.length];render();}\n  });\n}\n\nfunction paymentPreview({id,kind,amount}) {\n  const cents=Number(amount), p=currentPerson(id);\n  const names={gift:'礼物',shared:'共同消费',support:'帮付'};\n  if (!p.id || !Number.isSafeInteger(cents) || cents\u003c1 || !Object.hasOwn(names,kind)) throw Error('请选择人物并填写有效金额');\n  modal(names[kind]+'给'+p.name,`\u003cdiv class=\"card\">\u003ch3>这笔费用 ${money(cents)}\u003c/h3>\u003cp>当前余额 ${money(state.cash)}\u003c/p>\u003cp class=\"hint\">${jinheBridge?'确认后按原卡规则结算，写入当前酒馆楼层。':'原型账本，现场结算可在钱包查看。'}\u003c/p>\u003c/div>\u003cdiv class=\"buttons\">${btn(jinheBridge?'确认付款':'确认（演示）','confirm-payment',{id,kind,amount:cents},'primary')}\u003c/div>`);\n}\nasync function confirmPayment({id,kind,amount},button) {\n  const spent=Number(amount), p=currentPerson(id);\n  if (!$('modal').open || !p.id || !Number.isSafeInteger(spent) || spent\u003c1) return;\n  if (jinheBridge) {\n    const line=await payInHost(id,kind,spent,debtDue(p),button);\n    if (line) {\n      rememberPhoneAction('给'+p.name+'支付'+money(spent)+'。');\n      closeModal();render();notify('已记账');\n    }\n    return;\n  }\n  const cash=state.cash;\n  if (!state.presentIds.includes(id) || spent>cash) {\n    $('modal-body').innerHTML=`\u003cdiv class=\"card\">${!state.presentIds.includes(id)?'角色未到场，原卡结算需要确认收款对象。':'余额不足，未扣款。'}\u003c/div>`;\n    return;\n  }\n  state.cash=cash-spent;\n  state.ledger.push({kind,name:p.name,amount:spent,time:scene().time_slot});\n  if (kind==='support' && debtDue(p) && spent>=debtDue(p)) {\n    state.profiles[id]={...state.profiles[id],debt:'已帮付 '+money(spent)};\n  }\n  closeModal();save();render();\n  notify('已记账');\n}\nasync function runHubForm(form) {\n  const id=formValue(form,'person'), p=currentPerson(id);\n  if (hubPage==='meetup') {\n    const place=places.get(formValue(form,'location')), where=formValue(form,'spot'), when=formValue(form,'when');\n    if (!place || !when) return;\n    const ids=new FormData(form).getAll('guests');\n    if (ids.length>3) throw Error('一次最多邀请 3 位。');\n    const names=ids.filter(id=>state.presentIds.includes(id)||state.friends.includes(id)).map(person).filter(Boolean).map(item=>item.name);\n    const dest=place.name+(where?' · '+where:'');\n    setDraft(names.length?'[手机邀约] 我'+when+'去'+dest+'，约'+names.join('、')+'在那里见面。':'[手机出发] 我'+when+'去'+dest+'。');\n  } else if (!p.id) {\n    return;\n  } else if (hubPage==='pulse') {\n    const level=Number(formValue(form,'level'));\n    if (![1,2,3,4,5].includes(level)) return;\n    const saved=structuredClone(state.phoneFeedback);\n    adjustPulse(p,level);\n    if (jinheBridge) {\n      const metrics=state.phoneFeedback[id].metrics;\n      try {await hostWrite({type:\"edit\",patch:{personEdits:{[id]:metrics}}});}\n      catch (error) {state.phoneFeedback=saved;throw error;}\n    }\n    rememberPhoneAction('为'+p.name+'切换到 '+level+' 档。');render();\n  } else if (hubPage==='debt') {\n    paymentPreview({id,kind:'support',amount:formValue(form,'amount')});\n  } else if (hubPage==='live') {\n    const message=formValue(form,'message');\n    if (!message) return;\n    liveComments.set(opening+':'+id,[...roomComments(p),'你：'+message].slice(-5));\n    render();\n  } else if (hubPage==='wardrobe') {\n    const look=wardrobeCatalogue().find(item=>item.id===formValue(form,'look'));\n    if (!look) return;\n    wardrobeChoice=look.id;\n    await recordEdit({profiles:{...state.profiles,[id]:{...state.profiles[id],wardrobe:look.description,style:look.label,styleKey:look.id}}},'试穿 · '+p.name);\n    render();\n    rememberPhoneAction(p.name+'换上了「'+look.label+'」。');\n    notify('已试穿 · '+look.label);\n  } else if (hubPage==='camera') {\n    imageDialog('portrait',id);\n    const field=$('image-form')?.elements.prompt;\n    const place=places.get(formValue(form,'cameraPlace'));\n    if (field) field.value=imagePrompt('portrait',p,formValue(form,'angle')+'拍摄',\n      {...scene(),location_name:place?.name||scene().location_name},settings.image.style);\n  } else {\n    render();\n  }\n}\nfunction formatChanges(value) {\n  return value==null?'空':Array.isArray(value)?value.join('、'):typeof value==='object'?JSON.stringify(value):String(value);\n}\nasync function recordEdit(next,label) {\n  const changes=Object.entries(next).filter(([key,value])=>edits.includes(key)&&JSON.stringify(state[key])!==JSON.stringify(value)).map(([key,value])=>({\n    key,before:state[key]===undefined?null:structuredClone(state[key]),missing:state[key]===undefined,after:structuredClone(value)\n  }));\n  if (!changes.length) {editNotice='当前值没有改动。';return;}\n  if (jinheBridge) {\n    await saveHostedChanges(next);\n    for (const change of changes) change.after=structuredClone(state[change.key]??null);\n  } else for (const change of changes) state[change.key]=change.after;\n  state.edits=[...state.edits,{label,changes}].slice(-5);\n  editNotice=jinheBridge?'已保存到酒馆当前楼层。':'已保存到当前开场的预览。';\n  save();\n}\nasync function undoEdit() {\n  const last=state.edits.at(-1);\n  if (!last) return;\n  if (last.changes.some(change=>JSON.stringify(state[change.key])!==JSON.stringify(change.after))) {\n    editNotice='这些字段随后又有变更。请先核对当前值，再手动调整。';\n  } else {\n    if (jinheBridge) await saveHostedChanges(Object.fromEntries(last.changes.map(change=>[change.key,change.before])),true);\n    else for (const change of last.changes) {\n      if (change.missing) delete state[change.key];\n      else state[change.key]=structuredClone(change.before);\n    }\n    state.edits.pop();\n    editNotice='已撤销 '+last.label;\n    save();\n  }\n  render();\n}\nfunction activeEditorPerson() {\n  return editorPerson && source.people[editorPerson] ? editorPerson : knownPeople()[0]?.id || Object.keys(source.people)[0];\n}\n\nconst dialectLabels={dongbei:'东北官话',zhongyuan:'中原官话',beijing:'北京官话',sichuan:'川渝方言',cantonese:'粤语·广州',guangxi:'广西话·南普桂柳',mandarin:'普通话',none:'未设定'};\nconst phases=['未告知','经期','非经期','已确认怀孕'];\nconst traitGrades=['凡品','良器','名器','极品名器','传说绝器'];\nconst profileSections=[\n  ['life','方言与日常',[\n    ['hometown','籍贯','text',40],['dialect_label','口音显示标签','text',100],['interactionStyle','相处方式','area',240],\n    ['work','工作','text',180],['income','收入情况','text',150],['routine','日常行程','area',240],\n    ['availability','可约时间','text',180],['lastLocation','通讯录上次地点','text',120],['rosterNote','通讯录备注','area',180]\n  ]],\n  ['appearance','外观与穿搭',[\n    ['look','照片外观要点','area',180],['figureSummary','身形简表','text',180],['figure','外观细节','area',400],\n    ['tattoo','纹身与穿环','area',240],['bodyTags','外观标签（每行一条）','list',120],['bodyMarks','印记（每行一条，最多两条）','list',120,2],\n    ['style','穿搭风格','text',180],['wardrobe','当前外穿','area',180],['innerWear','里衣','area',180],['dressState','衣着状态','text',120]\n  ]],\n  ['reaction','即时状态',[\n    ['arousal','动情度','range',100],['shame','羞耻度','range',100],['posture','动作与姿势','text',160],\n    ['reaction','当前反应','area',240],['sensitivity','敏感标签（每行一条）','list',120],\n    ['preference','偏好记录','area',240],['voice','内心独白','area',400],['contrast','人物反差','area',300]\n  ]],\n  ['trait','专属属性',[\n    ['traitName','称号','text',120],['traitGrade','品阶','grade',80],\n    ['tightness','紧致度','range',100],['suction','吸力','range',100],['wetness','湿润度','range',100],['development','开发度','range',100],\n    ['peakCount','高潮累计','count',9999],['insideCount','内射累计','count',9999],\n    ['outerShape','外形描述','area',400],['innerTexture','质感描述','area',400],['reflex','反应描述','area',400]\n  ]],\n  ['history','周期与经历',[\n    ['phase','周期状态','phase',16],['fertility','周期备注','area',180],\n    ['contraception','避孕记录','text',80],['pregnancyNote','怀孕备注','text',100],\n    ['pastExperience','过往经历','area',400],['datingCount','恋爱次数','count',999],['partnerCount','伴侣次数','count',999],\n    ['pregnancyHistory','过往孕产记录','area',180],['experienceBasic','基础经历','area',400],\n    ['experienceAdvanced','进阶经历','area',400],['experienceExtreme','极限经历','area',400],['experienceSpecial','特殊场所经历','area',400]\n  ]],\n  ['debt','账务', [['debt','负债备注','area',180]]]\n];\nconst editorProfileFields=new Map(profileSections.flatMap(([, ,fields])=>fields.map(field=>[field[0],field])));\nconst metricKeys=['arousal','shame','wetness'];\nconst returnFields=[[\"identity\", \"身份或称呼\", 60], [\"gender\", \"性别或称谓\", 30], [\"work\", \"职业或谋生方式\", 80], [\"appearance\", \"外形特征\", 100], [\"outfit\", \"穿着\", 90], [\"personality\", \"性格与习惯\", 90], [\"speech\", \"说话方式\", 60], [\"reason\", \"回乡缘由\", 100], [\"away\", \"离县经历\", 100], [\"housing\", \"住处\", 80], [\"vehicle\", \"交通工具\", 60], [\"ties\", \"在金河的熟人\", 120], [\"details\", \"其他背景\", 100], [\"limits\", \"希望避开的情节\", 100]];\nconst historyResetFields=['pastExperience','pregnancyHistory','experienceBasic','experienceAdvanced','experienceExtreme','experienceSpecial'];\nlet openEditSections=new Set();\n\nfunction longField(label,name,value='',limit=180) {\n  return `\u003clabel>${label}\u003ctextarea class=\"edit-text\" name=\"${name}\" rows=\"2\" maxlength=\"${limit}\">${esc(value)}\u003c/textarea>\u003c/label>`;\n}\nfunction listValues(value) {\n  return value.split(/[，,\\n]/).map(item=>item.trim()).filter(Boolean);\n}\nfunction profileValue(p,key) {\n  if (metricKeys.includes(key)) return pulseValues(p)[key];\n  if (key==='phase') return p.phase||localFacts(p.id).phase||'未告知';\n  if (key==='debt') return p.debt??(localFacts(p.id).debtAmount?'待还 '+localFacts(p.id).debtAmount+' 元':'');\n  return p[key];\n}\nfunction renderProfileControl(fieldInfo,p) {\n  const [name,label,type,limit]=fieldInfo,value=profileValue(p,name);\n  if (type==='range') return range(label,name,value??0);\n  if (type==='count') return count(label,name,value??0,0,limit);\n  if (type==='phase') return appSelect(label,name,phases.map(phase=>option(phase,phase,value)).join(''));\n  if (type==='area') return longField(label,name,value??'',limit);\n  if (type==='list') return longField(label,name,Array.isArray(value)?value.join('\\n'):'',limit*(fieldInfo[4]||12)+12);\n  if (type==='grade') return field(label,name,value??'','text',`maxlength=\"${limit}\" list=\"edit-trait-grades\"`)\n    + `\u003cdatalist id=\"edit-trait-grades\">${traitGrades.map(grade=>option(grade,grade,'')).join('')}\u003c/datalist>`;\n  return field(label,name,value??'','text',`maxlength=\"${limit}\"`);\n}\nfunction detailEditor(id,label,body,countValue='') {\n  return `\u003cdetails class=\"modifier-panel\" data-edit-section=\"${id}\" ${openEditSections.has(id)?'open':''}>\n    \u003csummary>\u003cstrong>${label}\u003c/strong>${countValue?`\u003cspan>${countValue}\u003c/span>`:''}\u003c/summary>\n    \u003cdiv class=\"stack\">${body}\u003c/div>\u003c/details>`;\n}\nfunction profileShortcuts(id) {\n  if (id==='reaction') return `\u003cdiv class=\"buttons\">${btn('动情度满值','quick-edit',{key:'arousal',value:100})}${btn('羞耻度清零','quick-edit',{key:'shame',value:0})}${btn('羞耻度满值','quick-edit',{key:'shame',value:100})}\u003c/div>`;\n  if (id==='trait') return btn('四项数值设为 100','profile-preset',{id:'all-traits'});\n  if (id==='history') return `\u003cdiv class=\"buttons\">${['安全期','危险期','经期','已确认怀孕'].map(label=>btn(label,'profile-preset',{id:'phase',label})).join('')}${btn('清空过往经历','profile-preset',{id:'reset-history'})}\u003c/div>`;\n  if (id==='debt') return `\u003cdiv class=\"buttons\">${['无负债','网贷待还 1800 元','逾期 3800 元','已由玩家结清'].map(value=>btn(value,'quick-edit',{key:'debt',value})).join('')}\u003c/div>`;\n  return '';\n}\nfunction editCard() {\n  const id=activeEditorPerson(), p=currentPerson(id);\n  const panels=profileSections.map(([key,label,fields])=>detailEditor(key,label,profileShortcuts(key)+fields.map(info=>renderProfileControl(info,p)).join(''),fields.length+' 项')).join('');\n  return formTitle('保存人物修改','edit-form',\n    appSelect('选人物','person',selectorPeople(id,true))+appProfileField(p)+\n    `\u003cdiv class=\"modifier-switches\">${check('该人物在场','present',state.presentIds.includes(id))}${check('微信已解锁','wechat',state.friends.includes(id))}\u003c/div>`+\n    range('好感度','affinity',affinity(id))+btn('好感度设为 100','quick-edit',{key:'affinity',value:100})+\n    appSelect('方言','dialect',Object.entries(dialectLabels).map(([value,label])=>option(value,label,p.dialect)).join(''))+\n    panels);\n}\nfunction inventoryChips(items) {\n  return items.length?items.map((item,index)=>`\u003cbutton type=\"button\" class=\"btn inventory-chip\" data-do=\"remove-item\" data-index=\"${index}\" aria-label=\"移除${esc(item)}\">${esc(item)} \u003cspan aria-hidden=\"true\">×\u003c/span>\u003c/button>`).join(''):'\u003cspan class=\"hint\">暂时没有随身道具\u003c/span>';\n}\nfunction editPlayer() {\n  const property=state.property||{}, last=state.ledger.at(-1);\n  return formTitle('保存玩家修改','edit-form',\n    count('余额（元）','cash',state.cash,0,999999999999)+\n    `\u003cdiv class=\"buttons\">${[1000,10000,100000].map(n=>btn('+ '+money(n),'cash-shortcut',{amount:n})).join('')}${btn('设为 999 万','cash-shortcut',{amount:9_990_000,replace:'true'})}\u003c/div>`+\n    range('体力','stamina',state.stamina)+btn('体力恢复至 100','quick-edit',{key:'stamina',value:100})+\n    detailEditor('inventory','随身道具',\n      `\u003cdiv class=\"buttons\" id=\"edit-inventory-chips\">${inventoryChips(state.items)}\u003c/div>`+\n      field('新增道具','newItem','','text','maxlength=\"100\"')+btn('加入道具','add-item')+\n      longField('批量编辑道具（每行一条）','items',state.items.join('\\n'),1600),state.items.length+' 件')+\n    detailEditor('property','物业与租约',\n      appSelect('物业类型','asset',option('none','无',property.type||'none')+\n        Object.entries(source.assetTypes).filter(([key,offer])=>offer.max&&!state.properties?.[key])\n          .map(([key,offer])=>option(key,offer.label,property.type)).join(''))+\n      field('物业名称','property',property.property,'text','maxlength=\"80\"')+\n      count('月租（元）','rent',property.monthly_cost||0,0,maxMonthlyRent)+\n      count('到期日','dueDay',property.due_day||Math.min(999999,(scene().day||1)+30),1,999999)+\n      `\u003cdiv class=\"stack\">\u003cstrong>同住或看店人员\u003c/strong>\u003cdiv class=\"modifier-people\">${knownPeople().map(p=>`\u003clabel class=\"check\">\u003cinput name=\"occupants\" type=\"checkbox\" value=\"${p.id}\" ${property.occupants?.includes(p.id)?'checked':''}>${esc(p.name)}\u003c/label>`).join('')||'\u003cp class=\"hint\">当前通讯录为空\u003c/p>'}\u003c/div>\u003c/div>`,\n      property.type?'已登记':'')+\n    detailEditor('player-profile','玩家档案',returnFields.map(([name,label,limit])=>longField(label,'return_'+name,(state.returnProfile||source.designReturn?.[opening])?.[name],limit)).join(''))+\n    `\u003cdiv class=\"modifier-receipt\">\u003cstrong>最近一笔账单\u003c/strong>\u003cp class=\"hint\">账本只记实际支出，改金额不影响已发生的剧情。\u003c/p>\n    ${last?`\u003cp class=\"hint\">最近一笔 · ${money(last.amount)}${last.kind==='property'?' · 买断物业':''}\u003c/p>${last.kind==='property'?'':btn('更正最近一笔','edit-receipt')}`:'\u003cp class=\"hint\">还没有账单。\u003c/p>'}\u003c/div>`);\n}\nfunction spotOptions(id) {\n  const spaces=source.designSpaces?.[id] || [];\n  return `\u003cdatalist id=\"edit-scene-spots\">${spaces.map(space=>option(space,space,'')).join('')}\u003c/datalist>`;\n}\nfunction editScene() {\n  const now=scene(), people=Object.values(source.people);\n  return formTitle('保存场景修改','edit-form',\n    appSelect('选择地点','location',locationOptions(now.location_id))+sceneImage(now.location_id)+\n    field('具体位置','spot',now.spot,'text','maxlength=\"80\" list=\"edit-scene-spots\"')+spotOptions(now.location_id)+\n    count('当前天数','day',now.day||1,1,999999)+\n    field('时间','time',now.time_slot,'text','maxlength=\"12\" placeholder=\"周五 23:30\" required')+\n    `\u003cdiv class=\"buttons\">${['09:00','15:00','18:30','21:30','23:30','00:30'].map(time=>btn(time,'edit-time',{time})).join('')}\u003c/div>`+\n    longField('环境备注','vibe',now.vibe_note,180)+\n    detailEditor('attendance','在场人物',`\u003cdiv class=\"modifier-people\">${people.map(({id})=>`\u003clabel class=\"check\">\n    \u003cinput type=\"checkbox\" name=\"attendance\" value=\"${id}\" ${state.presentIds.includes(id)?'checked':''}>${esc(currentPerson(id).name)}\u003c/label>`).join('')}\u003c/div>`,state.presentIds.length+' 人'));\n}\nfunction getProfileEdits(form,p,dialect) {\n  const profile={};\n  for (const [name,,type,max,size] of editorProfileFields.values()) {\n    const value=formValue(form,name);\n    if (type==='range'||type==='count') profile[name]=Number(value);\n    else if (type==='list') {\n      const values=value.split(/\\r?\\n/).map(item=>item.trim()).filter(Boolean);\n      if ((size && values.length>size)||values.some(item=>item.length>max)) {\n        const label=editorProfileFields.get(name)[1];\n        throw Error(size?`${label}，每条最多 ${max} 字。`:`${label}，每条最多 ${max} 字。`);\n      }\n      profile[name]=values;\n    } else profile[name]=value;\n  }\n  profile.dialect=dialect;\n  if (dialect!==p.dialect && !profile.hometown && p.hometown===undefined && p.dialect!=='mandarin') {\n    profile.hometown=(p.dialect_label||'').slice(0,40);\n  }\n  if (dialect==='mandarin' || (dialect!==p.dialect && profile.dialect_label===(p.dialect_label||''))) {\n    profile.dialect_label=dialectLabels[dialect];\n  }\n  const was=(key,type)=>{\n    const previous=profileValue(p,key);\n    if (type==='range'||type==='count') return previous??0;\n    if (type==='list') return Array.isArray(previous)?previous:[];\n    return previous??'';\n  };\n  const patch=Object.fromEntries(Object.entries(profile).filter(([key,value])=>\n    JSON.stringify(value)!==JSON.stringify(was(key,editorProfileFields.get(key)?.[2]))));\n  if (Object.hasOwn(patch,'style')||Object.hasOwn(patch,'wardrobe')) patch.styleKey='';\n  return patch;\n}\n\nfunction matchingPhoneFeedback(profiles) {\n  let feedback=state.phoneFeedback;\n  for (const [id,profile] of Object.entries(profiles || {})) {\n    const previous=feedback[id];\n    if (!previous?.metrics) continue;\n    const next=Object.fromEntries(metricKeys.filter(key=>Object.hasOwn(profile,key)).map(key=>[key,profile[key]]));\n    if (Object.keys(next).length) feedback={...feedback,[id]:{...previous,metrics:{...previous.metrics,...next}}};\n  }\n  return feedback;\n}\nfunction adjustInventory(form,items) {\n  form.elements.items.value=items.join('\\n');\n  $('edit-inventory-chips').innerHTML=inventoryChips(items);\n}\nfunction quickEdit(key,value) {\n  const field=$('edit-form')?.elements[key];\n  if (!field) return;\n  field.value=value;\n  field.dispatchEvent(new Event('input',{bubbles:true}));\n}\nfunction applyProfilePreset(id,label) {\n  if (id==='all-traits') {\n    for (const key of ['tightness','suction','wetness','development']) quickEdit(key,100);\n  } else if (id==='phase') {\n    quickEdit('phase',['经期','已确认怀孕'].includes(label)?label:'非经期');\n    quickEdit('fertility',label);\n  } else if (id==='reset-history') {\n    for (const key of historyResetFields) quickEdit(key,'');\n    quickEdit('datingCount',0);quickEdit('partnerCount',0);\n    notify('经历字段已清空，点保存后生效。');\n  }\n}\nfunction editLastReceipt() {\n  const last=state.ledger.at(-1);\n  if (!last) return;\n  modal('更正最近一笔账单',`\u003cform class=\"form\" id=\"edit-receipt-form\">\u003cp class=\"hint\">${esc(last.name)} · 已记支出 ${money(last.amount)}。改金额后，余额按差额调整。\u003c/p>\n    ${count('实际支出（元）','amount',last.amount,1,999999999999)}\n    \u003cp class=\"feedback\" id=\"edit-receipt-status\" role=\"status\">\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">保存账单更正\u003c/button>\u003c/div>\u003c/form>`,\n    {kind:'receipt-edit',opening,fingerprint:JSON.stringify(last),length:state.ledger.length});\n}\nasync function saveLastReceipt(form) {\n  const expected=modalContext,last=state.ledger.at(-1);\n  const notice=form.querySelector('#edit-receipt-status');\n  if (expected?.kind!=='receipt-edit'||expected.opening!==opening||expected.length!==state.ledger.length||expected.fingerprint!==JSON.stringify(last)) {\n    notice.textContent='最新账单有变，请重新打开。';return;\n  }\n  const amount=Number(formValue(form,'amount'));\n  if (!Number.isSafeInteger(amount)||amount\u003c1) {notice.textContent='支出金额需要是正整数。';return;}\n  const cash=state.cash+last.amount-amount;\n  if (cash\u003c0||cash>999999999999) {notice.textContent='按这个金额调整后，余额会超出允许范围。';return;}\n  await recordEdit({cash,ledger:[...state.ledger.slice(0,-1),{...last,amount}]},'更正最近账单');\n  closeModal();render();\n}\n\nfunction exportLocal() {\n  const result={schema:'jinhe-phone-preview/v2',opening,values:Object.fromEntries(edits.filter(key=>key!=='phoneFeedback'&&state[key]!==undefined).map(key=>[key,state[key]]))};\n  return JSON.stringify(result,null,2);\n}\nfunction editJSON() {\n  return `\u003cform id=\"design-json\" class=\"form stack\">\u003cp class=\"hint\">编辑或导入此原型的 JSON 备份。保存前检查字段类型和范围。\u003c/p>\n  \u003clabel>读取文件\u003cinput type=\"file\" id=\"design-import\" accept=\".json,application/json\">\u003c/label>\n  \u003clabel>JSON\u003ctextarea id=\"design-json-text\" rows=\"16\" spellcheck=\"false\">${esc(exportLocal())}\u003c/textarea>\u003c/label>\n  \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">校验并保存\u003c/button>${btn('导出 JSON','design-export')}\u003c/div>\u003c/form>`;\n}\nfunction editHistory() {\n  const labels={scenePatch:'场景',profiles:'人物档案',knownIds:'通讯录名单',presentIds:'在场名单',friends:'微信好友',affinity:'好感度',cash:'余额',stamina:'体力',items:'道具',property:'物业',returnProfile:'玩家档案',ledger:'账单',phoneFeedback:'档位'};\n  return `\u003cdiv class=\"buttons\">${btn('导出 JSON','design-export')}\u003c/div>${state.edits.length ? state.edits.slice().reverse().map((entry,index)=>`\u003cdiv class=\"card\">\u003ch3>${esc(entry.label)}\u003c/h3>\n    \u003cp class=\"hint\">${entry.changes.map(change=>labels[change.key]).join(' · ')}\u003c/p>\n    \u003cdetails>\u003csummary>查看差异\u003c/summary>${entry.changes.map(change=>`\u003cp class=\"hint\">${labels[change.key]} · ${esc(formatChanges(change.before))} → ${esc(formatChanges(change.after))}\u003c/p>`).join('')}\u003c/details>\n    ${index===0?btn('撤销最近一次修改','design-undo'):''}\u003c/div>`).join('') : empty('还没有快改记录','保存一笔修改后，就可以在这里核对和撤销。')}`;\n}\nfunction renderEditor() {\n  onboard();\n  header('金河金手指',jinheBridge?'当前聊天 · 酒馆存档':'当前开场 · 本地快改','',editorReturn);\n  const content={cast:editCard,player:editPlayer,scene:editScene,history:editHistory,json:jinheBridge?editHostJSON:editJSON}[editorTab];\n  return `\u003cdiv class=\"pad stack\">\u003cdiv class=\"filters\" aria-label=\"快改页面\">${editorTabs.map(([id,title])=>`\u003cbutton class=\"filter\" data-do=\"edit-tab\" data-id=\"${id}\" aria-pressed=\"${editorTab===id}\">${title}\u003c/button>`).join('')}\u003c/div>\n    \u003cp class=\"feedback\" role=\"status\">${esc(editNotice)}\u003c/p>${content()}\u003c/div>`;\n}\nfunction nextScene(old,id,when,day,spot,vibe) {\n  const p=places.get(id);\n  if (!p || !/^周[一二三四五六日] (?:[01]\\d|2[0-3]):[0-5]\\d$/.test(when)) throw Error('请选择有效地点，并用「周五 23:30」的格式填时间');\n  return {...old,location_id:p.id,location_name:p.name,zone_id:p.zone,time_slot:when,day,spot,vibe_note:vibe};\n}\n\nasync function submitEdit(form) {\n  openEditSections=new Set([...form.querySelectorAll('[data-edit-section][open]')].map(panel=>panel.dataset.editSection));\n  if (editorTab==='cast') {\n    const id=formValue(form,'person'),p=currentPerson(id),dialect=formValue(form,'dialect');\n    if (!p.id || !Object.hasOwn(dialectLabels,dialect)) return;\n    const members=(list,checked)=>checked?[...new Set([...list,id])]:list.filter(key=>key!==id);\n    const profile=getProfileEdits(form,p,dialect);\n    const profiles={...state.profiles,[id]:{...state.profiles[id],...profile}};\n    await recordEdit({\n      profiles,\n      affinity:{...state.affinity,[id]:Number(formValue(form,'affinity'))},\n      knownIds:[...new Set([...state.knownIds,id])],\n      presentIds:members(state.presentIds,form.elements.present.checked),\n      friends:members(state.friends,form.elements.wechat.checked),\n      phoneFeedback:matchingPhoneFeedback({[id]:profile})\n    },p.name+'档案');\n  } else if (editorTab==='player') {\n    const returnProfile=Object.fromEntries(returnFields.map(([key])=>[key,formValue(form,'return_'+key)]));\n    const next={cash:Number(formValue(form,'cash')),stamina:Number(formValue(form,'stamina')),\n      items:listValues(formValue(form,'items')).slice(0,50),returnProfile};\n    const type=form.elements.asset.value;\n    const typeChanged=type!==(state.property?.type||'none');\n    const occupantFields=[...form.querySelectorAll('input[name=\"occupants\"]')];\n    const occupantsChanged=occupantFields.some(input=>input.checked!==input.defaultChecked);\n    const leaseChanged=['property','rent','dueDay'].some(key=>form.elements[key].value!==form.elements[key].defaultValue);\n    if (typeChanged||(type!=='none'&&(leaseChanged||occupantsChanged))) {\n      const visibleIds=new Set(occupantFields.map(input=>input.value));\n      const occupants=[...new FormData(form).getAll('occupants'),\n        ...(state.property?.occupants||[]).filter(id=>!visibleIds.has(id))];\n      if (type!=='none'&&occupants.length>3) throw Error('租约最多可记录 3 位同住或看店人员');\n      next.property=type==='none'?null:{type,property:formValue(form,'property'),monthly_cost:Number(formValue(form,'rent')),\n        due_day:Number(formValue(form,'dueDay')),occupants};\n    }\n    await recordEdit(next,'玩家');\n  } else if (editorTab==='scene') {\n    const id=formValue(form,'location');\n    const spot=id===scene().location_id || form.elements.spot.value!==form.elements.spot.defaultValue?formValue(form,'spot'):'';\n    const vibe=id===scene().location_id || form.elements.vibe.value!==form.elements.vibe.defaultValue?formValue(form,'vibe'):'';\n    const presentIds=new FormData(form).getAll('attendance');\n    await recordEdit({\n      scenePatch:nextScene(scene(),id,formValue(form,'time'),Number(formValue(form,'day')),spot,vibe),\n      presentIds,knownIds:[...new Set([...state.knownIds,...presentIds])]\n    },'场景');\n  }\n  render();\n}\nfunction assertPreviewJSON(parsed) {\n  const isId=id=>typeof id==='string'&&Object.hasOwn(source.people,id);\n  const object=value=>value!==null&&typeof value==='object'&&!Array.isArray(value);\n  const num=(value,min,max)=>Number.isSafeInteger(value)&&value>=min&&value\u003c=max;\n  const str=(value,max)=>typeof value==='string'&&value.length\u003c=max;\n  const ids=value=>Array.isArray(value)&&value.length\u003c=Object.keys(source.people).length&&value.every(isId)&&new Set(value).size===value.length;\n  const each=(value,check)=>object(value)&&Object.entries(value).every(([key,item])=>isId(key)&&check(item));\n  const validateProfile=(key,value)=>{\n    if (key==='dialect') return Object.hasOwn(dialectLabels,value);\n    if (key==='styleKey') return str(value,180);\n    const field=editorProfileFields.get(key);\n    if (!field) return false;\n    const [,,type,limit,total]=field;\n    if (type==='range'||type==='count') return num(value,0,limit);\n    if (type==='phase') return phases.includes(value);\n    if (type==='list') return Array.isArray(value)&&(!total||value.length\u003c=total)&&value.every(item=>str(item,limit));\n    return str(value,limit);\n  };\n  const validators={\n    cash:value=>num(value,0,999999999999),\n    stamina:value=>num(value,0,100),\n    items:value=>Array.isArray(value)&&value.length\u003c=50&&value.every(item=>str(item,1600)),\n    knownIds:ids,presentIds:ids,friends:ids,\n    affinity:value=>each(value,item=>num(item,0,100)),\n    property:value=>value===null||object(value)&&Object.hasOwn(source.assetTypes,value.type)&&source.assetTypes[value.type].max&&str(value.property,80)&&num(value.monthly_cost,0,maxMonthlyRent)&&\n      (value.due_day===undefined||num(value.due_day,1,999999))&&(value.occupants===undefined||ids(value.occupants)&&value.occupants.length\u003c=3),\n    returnProfile:value=>object(value)&&Object.entries(value).every(([key,item])=>{\n      const descriptor=returnFields.find(field=>field[0]===key);\n      return descriptor&&str(item,descriptor[2]);\n    }),\n    ledger:value=>Array.isArray(value)&&value.every(item=>object(item)&&str(item.name,80)&&str(item.time,20)&&\n      num(item.amount,1,999999999999)&&\n      (item.kind===undefined||['gift','shared','support','expense'].includes(item.kind))),\n    profiles:value=>each(value,item=>object(item)&&Object.entries(item).every(([key,val])=>validateProfile(key,val))),\n    scenePatch:value=>object(value)&&num(value.day,1,999999)&&str(value.spot,80)&&str(value.vibe_note,180)&&\n      places.has(value.location_id)&&/^周[一二三四五六日] (?:[01]\\d|2[0-3]):[0-5]\\d$/.test(value.time_slot)\n  };\n  if (!parsed || parsed.schema!=='jinhe-phone-preview/v2'||parsed.opening!==opening||!object(parsed.values)) throw Error('请导入当前开场导出的预览 JSON');\n  for (const [key,value] of Object.entries(parsed.values)) {\n    if (!Object.hasOwn(validators,key)||!validators[key](value)) throw Error('字段格式或范围有误 · '+key);\n  }\n  const values={...parsed.values};\n  if (values.scenePatch) {\n    const s=values.scenePatch;\n    values.scenePatch=nextScene(source.openings[opening].scene,s.location_id,s.time_slot,s.day,s.spot,s.vibe_note);\n  }\n  if (values.profiles) values.phoneFeedback=matchingPhoneFeedback(values.profiles);\n  return values;\n}\n\nasync function writeDesignJSON() {\n  const input=$('design-json-text');\n  try {\n    const values=assertPreviewJSON(JSON.parse(input.value));\n    await recordEdit(values,'JSON 导入');render();\n  } catch(error) {\n    $('screen').querySelector('.feedback').textContent=error instanceof SyntaxError?'JSON 格式有误，请检查括号和引号。':error.message;\n  }\n}\nfunction exportDesignJSON() {\n  const url=URL.createObjectURL(new Blob([exportLocal()],{type:'application/json'}));\n  const a=document.createElement('a');\n  a.href=url;a.download='金河九号机-开场'+(opening+1)+'-预览备份.json';\n  a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);\n}\nconst existingMap=screens.map;\nscreens.map=()=>existingMap().replace('\u003cinput class=\"input\" id=\"map-search\"',sceneImage(destination||scene().location_id)+'\u003cinput class=\"input\" id=\"map-search\"');\nObject.assign(screens,{hub:renderHub,'hub-app':renderHubApp,editor:renderEditor});\nObject.assign(names,{hub:'金河应用',editor:'金河金手指'});\nappTiles.push(['hub','bolt','#efbadb','七项金河应用'],['editor','settings','#d4dcad','人物、玩家和场景']);\nObject.assign(actions,{\n  'pulse-stop':({id})=>{state.phoneFeedback[id]={...state.phoneFeedback[id],running:false};save();render();},\n  'show-payment':paymentPreview,\n  'confirm-payment':confirmPayment,\n  'edit-open':({id})=>{if(section!=='editor')editorReturn=section;if(id)editorPerson=id;editorTab='cast';editNotice='';openEditSections=new Set();openPage('editor');},\n  'edit-tab':({id})=>{editorTab=id;editNotice='';openEditSections=new Set();render(true);},\n  'quick-edit':({key,value})=>quickEdit(key,value),\n  'profile-preset':({id,label})=>applyProfilePreset(id,label),\n  'edit-time':({time})=>{\n    const input=$('edit-form').elements.time;\n    quickEdit('time',(input.value.match(/^周[一二三四五六日]/)?.[0]||scene().time_slot.slice(0,2))+' '+time);\n  },\n  'add-item':()=>{\n    const form=$('edit-form'), item=formValue(form,'newItem');\n    if (!item) return;\n    adjustInventory(form,[...new Set([...listValues(form.elements.items.value),item])]);\n    form.elements.newItem.value='';\n  },\n  'remove-item':({index})=>{\n    const form=$('edit-form');\n    adjustInventory(form,listValues(form.elements.items.value).filter((item,i)=>i!==Number(index)));\n  },\n  'edit-receipt':editLastReceipt,\n  'design-undo':undoEdit,\n  'design-export':exportDesignJSON,\n  'cash-shortcut':({amount,replace})=>{const input=$('edit-form').elements.cash;input.value=replace?Number(amount):Math.min(999999999999,Number(input.value)+Number(amount));}\n});\nObject.assign(submit,{'hub-form':runHubForm,'edit-form':submitEdit,'design-json':writeDesignJSON,'custom-look-form':saveCustomLook,'edit-receipt-form':saveLastReceipt});\ndocument.addEventListener('input',event=>{\n  if (event.target.type==='range') event.target.previousElementSibling?.querySelector('output')?.replaceChildren(event.target.value);\n  if (event.target.form?.id==='edit-form' && event.target.name==='items') $('edit-inventory-chips').innerHTML=inventoryChips(listValues(event.target.value));\n});\ndocument.addEventListener('change',async event=>{\n  const field=event.target, form=field.form;\n  if (form?.id==='edit-form' && field.name==='person') {editorPerson=field.value;editNotice='';render();}\n  if (form?.id==='edit-form' && field.name==='location') {\n    const figure=form.querySelector('.place-photo');\n    if (figure) figure.remove();\n    field.closest('label').insertAdjacentHTML('afterend',sceneImage(field.value));\n    const choices=$('edit-scene-spots');\n    if (choices) choices.outerHTML=spotOptions(field.value);\n  }\n  if (form?.id==='hub-form' && field.name==='person') {\n    visitPerson=field.value;\n    if (hubPage!=='meetup') {\n      pulsePick=state.phoneFeedback[visitPerson]?.level||1;pkPick='';wardrobeChoice='';render();\n    }\n  }\n  if (form?.id==='hub-form' && field.name==='look') {\n    const look=wardrobeCatalogue().find(item=>item.id===field.value);\n    if (look) {\n      wardrobeChoice=look.id;\n      $('jh-look-name').textContent=look.label;\n      $('jh-look-description').textContent=look.description;\n    }\n  }\n  if (form?.id==='hub-form' && field.name==='cameraPlace') {\n    cameraPlace=field.value;\n    render();\n    $('hub-form').elements.cameraPlace.focus({preventScroll:true});\n  }\n  if (field.id==='live-cover-import') {\n    try {await importLiveCover(field.files[0],field.dataset.person);}\n    catch (error) {notify('封面导入失败 · '+error.message);}\n  }\n  if (form?.id==='custom-look-form' && field.name==='picture') await previewUploadedLook(field);\n  if (form?.id==='hub-form' && field.name==='location') {\n    visitPlace=field.value;\n    const existing=$('jh-venue');\n    if (existing) existing.outerHTML=venuePanel(visitPlace);\n    const options=$('edit-scene-spots');\n    if (options) options.outerHTML=spotOptions(visitPlace);\n  }\n  if (field.id==='design-import') {\n    const file=field.files[0];\n    if (!file) return;\n    if (file.size>256_000) {notify('备份文件超过 256 KB。');return;}\n    try {$('design-json-text').value=await file.text();}\n    catch {notify('无法读取这份备份。');}\n  }\n});\ndocument.addEventListener('error',event=>{\n  const target=event.target;\n  if (!(target instanceof HTMLImageElement)) return;\n  if (target.classList.contains('jh-cover')) {\n    const next=target.dataset.artFallback;\n    target.dataset.artFallback='';\n    if (next) target.src=next;\n    else if (target.getAttribute('src')!==source.wallpaper) target.src=source.wallpaper;\n    return;\n  }\n  if (!target.closest('.place-photo')) return;\n  const remote=target.dataset.remote;\n  if (remote) {target.dataset.remote='';target.src=remote;}\n  else target.closest('.place-photo').hidden=true;\n},true);\n\nrefineHubActions();\n// The same page also runs directly as a browser preview. Only this adapter knows about Tavern Helper.\nconst previewPeople={...source.people};\nlet hostRevision=0, queuedHostSnapshot=null;\nlet hostPosition=null, paymentInFlight=false;\nconst pendingPaymentFallback=new Map();\nlet hostGroupPayments=[];\nconst hostEqual=(left,right)=>JSON.stringify(left)===JSON.stringify(right);\nconst hostHas=(obj,key)=>Object.hasOwn(obj||{},key);\nconst hostProfileKeys=()=>[...editorProfileFields.keys(),'dialect','styleKey'];\n\nfunction applyHostSnapshot(snapshot) {\n  const {data,revision}=snapshot;\n  if (revision\u003chostRevision) return;\n  hostRevision=revision;\n  hostPosition=snapshot.position;\n  if (queuedHostSnapshot?.revision\u003c=revision) queuedHostSnapshot=null;\n  const copy=structuredClone(data);\n  hostGroupPayments=copy.groupPayments||[];\n  state.hostPhoneGifts=copy.phoneGifts||[];\n  state.hostLifeJobs=copy.lifeJobs||{};\n  state.hostLifeEvent=copy.localEvent||'';\n  state.hostIncome=copy.income||0;state.hostIncomeReason=copy.incomeReason||'';\n  state.incomeLedger=copy.incomeLedger||[];\n  source.people={...previewPeople,...copy.people};\n  source.openings[0].people=copy.people;\n  source.openings[0].scene=copy.scene;\n  const styleIds=state.hostStyleIds||{};\n  state.profiles=Object.fromEntries(Object.entries(copy.people).map(([id,profile])=>{\n    const fields=Object.fromEntries(hostProfileKeys().filter(key=>hostHas(profile,key)).map(key=>[key,profile[key]]));\n    if (styleIds[id]&&styleIds[id].wardrobe===profile.wardrobe) fields.styleKey=styleIds[id].id;\n    return [id,fields];\n  }));\n  for (const key of ['knownIds','presentIds','friends','affinity','cash','stamina','items','property','properties','returnProfile','ledger']) state[key]=copy[key];\n  state.scenePatch=copy.scene;\n  // 主剧情摘要只在手机内部用，不写回存档；重进游戏时由宿主按当前楼层重新提供。\n  state.storyMemory=Array.isArray(snapshot.storyMemory)?snapshot.storyMemory:[];\n  state.moments=copy.moments.map(moment=>({\n    ...moment,personId:moment.girl_id,added:moment.id.startsWith('phone_'),\n    comments:String(moment.comments||'').split(' ｜ ').filter(Boolean),\n    liked:Boolean(state.hostLikes?.[moment.id])\n  }));\n  for (const [id,feedback] of Object.entries(state.phoneFeedback||{})) {\n    const p=copy.people[id];\n    if (p) feedback.metrics={arousal:p.arousal||0,shame:p.shame||0,wetness:p.wetness||0};\n  }\n}\n\nfunction flushHostSnapshot() {\n  if (!queuedHostSnapshot || $('modal').open) return false;\n  applyHostSnapshot(queuedHostSnapshot);\n  return true;\n}\n\nasync function hostWrite(action) {\n  const snapshot=await jinheBridge.write(hostRevision,action);\n  applyHostSnapshot(snapshot);\n  return snapshot.data;\n}\n\nasync function saveHostedChanges(next, restoring=false) {\n  const patch={};\n  const styles={...state.hostStyleIds};\n  for (const [key,value] of Object.entries(next)) {\n    if (hostEqual(state[key],value)) continue;\n    if (['cash','stamina','items','property','returnProfile','scenePatch','presentIds','friends'].includes(key)) patch[key]=value;\n    if (key==='knownIds') {\n      const removed=state.knownIds.filter(id=>!value.includes(id));\n      if (removed.length) patch.forgotten=removed;\n      patch.learned=value.filter(id=>!state.knownIds.includes(id));\n    }\n    if (key==='affinity') {\n      patch.affinity=Object.fromEntries(Object.entries(value).filter(([id,amount])=>!hostEqual(state.affinity[id],amount)));\n    }\n    if (key==='profiles') {\n      patch.personEdits={};\n      for (const [id,fields] of Object.entries(value)) {\n        const old=state.profiles[id]||{};\n        const diff=Object.fromEntries(Object.entries(fields).filter(([name,value])=>name!=='styleKey'&&!hostEqual(old[name],value)));\n        if (restoring) for (const key of ['bodyMarks','contraception','pregnancyNote']) {\n          if (hostHas(old,key)&&!hostHas(fields,key)) diff[key]=null;\n        }\n        if (restoring&&hostHas(old,'hometown')&&!hostHas(fields,'hometown')) diff.hometown='';\n        if (Object.keys(diff).length) patch.personEdits[id]=diff;\n        if (old.styleKey!==fields.styleKey) {\n          if (fields.styleKey) styles[id]={id:fields.styleKey,wardrobe:fields.wardrobe??currentPerson(id).wardrobe};\n          else delete styles[id];\n        }\n      }\n    }\n    if (key==='ledger') {\n      const old=state.ledger.at(-1), line=value.at(-1);\n      if (!old||!line||old.kind!==line.kind||old.name!==line.name||\n          !hostEqual(state.ledger.slice(0,-1),value.slice(0,-1))) throw Error('这里只能更正当前楼层最近一笔账单的金额。');\n      patch.receiptLine={amount:line.amount};\n    }\n  }\n  if (Object.keys(patch).length) await hostWrite({type:'edit',patch});\n  state.hostStyleIds=styles;\n  for (const [id,profile] of Object.entries(state.profiles)) {\n    if (styles[id]&&styles[id].wardrobe===profile.wardrobe) profile.styleKey=styles[id].id;\n    else delete profile.styleKey;\n  }\n  if (hostHas(next,'phoneFeedback')) state.phoneFeedback=structuredClone(next.phoneFeedback||{});\n}\n\nfunction phonePaymentKey() {\n  return hostPosition?storeKey+':pending-payment:'+hostPosition.floor+':'+hostPosition.swipe:'';\n}\nfunction pendingPhonePayment(key=phonePaymentKey()) {\n  if (!key) return null;\n  try {return pendingPaymentFallback.get(key)||JSON.parse(localStorage.getItem(key));}\n  catch {return pendingPaymentFallback.get(key)||null;}\n}\nfunction storePendingPhonePayment(key,payment) {\n  if (payment) pendingPaymentFallback.set(key,payment);\n  else pendingPaymentFallback.delete(key);\n  try {\n    if (payment) localStorage.setItem(key,JSON.stringify(payment));\n    else localStorage.removeItem(key);\n  } catch { /* Keep the pending request in this phone while storage is unavailable. */ }\n}\nasync function payInHost(id,kind,amount,debtDue,button) {\n  if (paymentInFlight||button?.disabled) return null;\n  const key=phonePaymentKey();\n  if (!key) throw Error('无法确认付款楼层，请重新打开九号机。');\n  const prior=pendingPhonePayment(key);\n  if (prior&&(prior.id!==id||prior.kind!==kind||prior.amount!==amount)) {\n    throw Error('本楼层有一笔付款待确认。请到钱包点「重试保存付款」。');\n  }\n  const payment=prior||{type:'pay',id,kind,amount,debtDue,...hostPosition,requestId:uid().replace(/-/g,'').slice(0,32)};\n  storePendingPhonePayment(key,payment);\n  paymentInFlight=true;\n  if (button) button.disabled=true;\n  try {\n    const snapshot=await jinheBridge.write(hostRevision,payment);\n    applyHostSnapshot(snapshot);\n    storePendingPhonePayment(key,null);\n    return snapshot.paymentLine;\n  } catch (error) {\n    if (!prior&&error?.paymentPending!==true) storePendingPhonePayment(key,null);\n    throw error;\n  } finally {\n    paymentInFlight=false;\n    if (button) button.disabled=false;\n  }\n}\n\n// 九号机的四条出模型路径，按设置里的 forward 分派：\n//   tavern  —— 交给酒馆主模型（generateRaw，原有方式，会受主聊天生成状态影响）\n//   host    —— 走酒馆后端转发，用酒馆已配好的连接与密钥\n//   relay   —— 用九号机自填的地址与密钥，仍由酒馆后端代发（旧卡的「通过酒馆后端转发」）\n//   self    —— 九号机自填接口，浏览器直连\nfunction phoneChatRoute() {\n  const forward = settings.chat.forward;\n  if (['host', 'relay', 'self'].includes(forward)) return forward;\n  return 'tavern';\n}\nfunction usePhoneModel(config) {\n  // 只要有酒馆桥、或开了自填接口，就算是能出真回复；三者都不可用时才退到本地占位。\n  return Boolean(jinheBridge) || config.live === true;\n}\n// 自定义开场里填的「身份或称呼」。预设开场没有这一项，注入会自动跳过。\nfunction phonePlayerIdentity() {\n  const identity = state?.player?.return_profile?.identity;\n  return typeof identity === 'string' ? identity : '';\n}\nasync function requestPhoneChat(config, system, messages, operation, includeMemory=false) {\n  const route = config.forward || phoneChatRoute();\n  const request = {...settings.chat,...config,forward:route};\n  // 私聊、群聊、来信、朋友圈都从这句系统提示出发，统一带上玩家身份。\n  const prompt = withPlayerIdentity(system, phonePlayerIdentity());\n  if (jinheBridge) jinheBridge.setChatConfig?.(request);\n  if (route === 'self') return requestChat(config,includeMemory?withPhoneStorySummary(prompt,jinheBridge?.readStoryMemory?.()):prompt,\n    messages,operation?.controller.signal);\n  if (jinheBridge) return jinheBridge.generate(prompt,messages,request,operation?.id,includeMemory);\n  if (route === 'host') return hostForwardChat(prompt, messages, await resolvePhoneHostPreset(request), operation?.controller.signal);\n  // 代发要靠酒馆进程发请求；单独打开预览页时没有酒馆可借。\n  if (route === 'relay') return relayChat(prompt, messages, request, operation?.controller.signal);\n  return requestChat(config, prompt, messages, operation?.controller.signal);\n}\nfunction phoneContextButton(id) {\n  if (!jinheBridge) return '';\n  const enabled=state.phoneChatMuted?.[id]!==true;\n  const meaning='开启后，和这位好友最近有回复的私聊会随当前存档的正文发给主模型。';\n  return btn('接入正文'+(enabled?' · 开':' · 关'),'toggle-phone-context',{id})\n    .replace(' data-do=', ' aria-pressed=\"'+enabled+'\" title=\"'+meaning+'\" data-do=');\n}\nfunction rememberPhoneAction(text) {\n  state.phoneActions=[...(state.phoneActions||[]),text].slice(-8);\n  save();\n}\nfunction openPhoneSummary() {\n  const actions=(state.phoneActions||[]).filter(note=>typeof note==='string');\n  const notes=[...actions,state.draft].filter(Boolean);\n  if (!notes.length) {notify('还没有可同步的手机操作。');return;}\n  openDraft();\n  $('modal-title').textContent='同步手机操作';\n  const input=$('modal-draft');\n  input.value='[金河九号机操作摘要]\\n'+notes.join('\\n');\n  input.dataset.summary='true';\n  if (jinheBridge) {\n    $('modal-body').querySelector('[data-do=send-draft-to-tavern]').dataset.summary='true';\n  }\n}\nfunction meetupPeople() {\n  const allowed=[...new Set([...(state.presentIds||[]),...state.friends])].map(person).filter(Boolean);\n  if (!allowed.length) return '\u003cp class=\"hint\">可先从绿泡泡加好友，也可以只生成出发草稿。\u003c/p>';\n  return '\u003cfieldset class=\"form\">\u003clegend>邀请对象（最多 3 人）\u003c/legend>'+\n    allowed.map(p=>'\u003clabel class=\"check\">\u003cinput type=\"checkbox\" name=\"guests\" value=\"'+esc(p.id)+'\"> '+esc(p.name)+'\u003c/label>').join('')+'\u003c/fieldset>';\n}\nlet rawBaseline=null;\nconst rawUndo=[];\nfunction rawTree(object,query='') {\n  const terms=query.toLowerCase().trim(), matches=[];\n  function visit(value,path) {\n    if (matches.length>=120) return;\n    if (value&&typeof value==='object') {\n      if (terms&&path.toLowerCase().includes(terms)) matches.push(path);\n      for (const [key,item] of Object.entries(value)) visit(item,path+'.'+key);\n      return;\n    }\n    const line=path+' = '+String(value);\n    if (!terms||line.toLowerCase().includes(terms)) matches.push(line);\n  }\n  if (terms) visit(object,'stat_data');\n  if (terms) return matches.length?'\u003cpre>'+esc(matches.join('\\n'))+'\u003c/pre>':'\u003cp class=\"hint\">没找到匹配项。\u003c/p>';\n  return Object.entries(object).map(([key,value])=>'\u003cdetails>\u003csummary>'+esc(key)+'\u003c/summary>\u003cpre>'+\n    esc(JSON.stringify(value,null,2))+'\u003c/pre>\u003c/details>').join('');\n}\nfunction editHostJSON() {\n  try {\n    const {raw,snapshot}=jinheBridge.readRaw();\n    applyHostSnapshot(snapshot);\n    rawBaseline={raw,revision:snapshot.revision};\n    return '\u003cform id=\"raw-host-form\" class=\"form stack\">\u003cp class=\"hint\">原始楼层变量。可搜索、改 JSON 或导入备份，提交前会检查字段。\u003c/p>'+\n      '\u003clabel>读取备份\u003cinput id=\"raw-host-file\" type=\"file\" accept=\".json,application/json\">\u003c/label>'+\n      '\u003clabel>JSON\u003ctextarea id=\"raw-host-text\" rows=\"14\" spellcheck=\"false\">'+esc(JSON.stringify(raw,null,2))+'\u003c/textarea>\u003c/label>'+\n      '\u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">查看修改差异\u003c/button>'+btn('导出原始 JSON','raw-download')+\n      (rawUndo.length?btn('撤销最近一次源码修改','raw-undo'):'')+'\u003c/div>'+\n      '\u003clabel>搜索字段或内容\u003cinput class=\"input\" id=\"raw-host-search\" type=\"search\">\u003c/label>'+\n      '\u003cdiv id=\"raw-host-tree\" class=\"raw-tree\">'+rawTree(raw)+'\u003c/div>\u003c/form>';\n  } catch (error) {return empty('暂时无法打开原始变量',esc(error.message));}\n}\nfunction prepareRawWrite() {\n  let next;\n  try {next=JSON.parse($('raw-host-text').value);}\n  catch {throw Error('JSON 格式有误，请检查括号和引号。');}\n  if (!next||typeof next!=='object'||Array.isArray(next)) throw Error('请输入完整的 stat_data 对象。');\n  const before=rawBaseline.raw;\n  const keys=[...new Set([...Object.keys(before),...Object.keys(next)])].filter(key=>!hostEqual(before[key],next[key]));\n  if (!keys.length) {notify('原始变量没有改动。');return;}\n  modal('确认写入酒馆变量','\u003cp class=\"hint\">以下部分的字段有变动。保存时会对齐人物的在场档案与通讯录快照。\u003c/p>\u003cul>'+\n    keys.map(key=>'\u003cli>'+esc(key)+'\u003c/li>').join('')+'\u003c/ul>'+\n    '\u003cdiv class=\"buttons\">'+btn('确认写入','raw-confirm',{},'primary')+'\u003c/div>',{next,before,revision:rawBaseline.revision});\n}\nasync function writeRawHost(button) {\n  const {next,before,revision}=modalContext;\n  button.disabled=true;\n  try {\n    const snapshot=await jinheBridge.write(revision,{type:'replace',raw:next});\n    applyHostSnapshot(snapshot);\n    rawUndo.push({before,expected:jinheBridge.readRaw().raw});\n    if (rawUndo.length>5) rawUndo.shift();\n    closeModal();render();notify('原始变量已写入当前楼层。');\n  } finally {button.disabled=false;}\n}\nasync function undoRawHost() {\n  const last=rawUndo.at(-1);\n  if (!last) return;\n  const {raw,snapshot}=jinheBridge.readRaw();\n  if (!hostEqual(raw,last.expected)) throw Error('这个楼层后来又改过，请先核对当前变量。');\n  applyHostSnapshot(await jinheBridge.write(snapshot.revision,{type:'replace',raw:last.before}));\n  rawUndo.pop();render();notify('原始变量已撤销。');\n}\nfunction bootPhoneDialogueLanguage() {\n  if(!jinheBridge?.getDialogueLanguage||!jinheBridge?.saveDialogueLanguage)return;\n  const originalSettings=screens.settings;\n  let pendingMode=null;\n  screens.settings=()=>{\n    if (settingsTab==='prompts'||settingsTab==='tts') return originalSettings();\n    const content=originalSettings(), mode=pendingMode ?? jinheBridge.getDialogueLanguage();\n    const card=`\u003csection class=\"card form\" style=\"margin-bottom:14px\">\n      \u003clabel>对白语言\u003cselect data-jinhe-dialogue-language aria-describedby=\"jinhe-dialogue-language-hint\" ${pendingMode?'disabled':''} style=\"min-height:44px\">\n        ${Object.entries(jinheDialogueLabels).map(([id,label])=>option(id,label,mode)).join('')}\n      \u003c/select>\u003c/label>\n      \u003cp class=\"hint\" id=\"jinhe-dialogue-language-hint\">只影响当前聊天新生成的正文、心声和九号机消息。\u003c/p>\n    \u003c/section>`;\n    return content.replace('\u003cdiv class=\"pad\">','\u003cdiv class=\"pad\">'+card);\n  };\n  document.addEventListener('change',async event=>{\n    const control=event.target;\n    if(!control.matches('[data-jinhe-dialogue-language]')||pendingMode)return;\n    pendingMode=control.value;\n    control.disabled=true;\n    try {\n      await jinheBridge.saveDialogueLanguage(pendingMode);\n      notify('对白语言已保存 · '+jinheDialogueLabels[pendingMode]);\n    } catch(error) {\n      notify('设置未保存 · '+error.message);\n    } finally {\n      pendingMode=null;\n      const select=document.querySelector('[data-jinhe-dialogue-language]');\n      if(select){\n        select.disabled=false;\n        select.value=jinheBridge.getDialogueLanguage();\n        if(document.activeElement===document.body) select.focus();\n      }\n    }\n  });\n}\nfunction bootHostClient() {\n  actions['phone-summary']=openPhoneSummary;\n  if (!jinheBridge) return;\n  document.body.classList.add('tavern-phone');\n  onboard();\n  applyHostSnapshot(jinheBridge.initial);\n  actions['retry-phone-payment']=async(_,button)=>{\n    const payment=pendingPhonePayment();\n    if (!payment) return;\n    const {id,kind,amount,debtDue}=payment;\n    const line=await payInHost(id,kind,amount,debtDue,button);\n    if (line) {\n      rememberPhoneAction('给'+line.name+'支付'+money(amount)+'。');\n      render();notify('已记账');\n    }\n  };\n  actions['list-property']=()=>{\n    const offers=Object.entries(source.assetTypes);\n    const group=business=>offers.filter(([,offer])=>Boolean(offer.business)===business).map(([id,offer])=>{\n      const action=state.properties?.[id]?'已拥有':btn('买断','quote-property',{id});\n      return `\u003cdiv class=\"card ledger-row\" data-property-search=\"${esc(offer.property)}\">\u003cdiv>\u003cstrong>${esc(offer.property)}\u003c/strong>\u003cbr>\u003csmall>${money(offer.price)}\u003c/small>\u003c/div>\u003cdiv>${action}\u003c/div>\u003c/div>`;\n    }).join('');\n    modal('买断物业',`\u003cdiv class=\"stack\">\u003clabel>搜索物业\u003cinput id=\"buy-property-search\" type=\"search\">\u003c/label>\n      ${heading('住宅')}${group(false)}${heading('经营场地')}${group(true)}\u003c/div>`);\n    $('buy-property-search').addEventListener('input',event=>{\n      const query=event.target.value.trim().toLowerCase();\n      for (const row of $('modal-body').querySelectorAll('[data-property-search]')) {\n        row.style.display=row.dataset.propertySearch.toLowerCase().includes(query)?'':'none';\n      }\n    });\n  };\n  actions['quote-property']=({id})=>{\n    const offer=source.assetTypes[id];\n    if (!Object.hasOwn(source.assetTypes,id)||state.properties?.[id]) return;\n    const canPay=state.cash>=offer.price;\n    const leaseNote=state.property?.type===id?'当前租约会转为自有，原有人员安排保留。':'买断后无需续租。';\n    modal('确认买断',`\u003cdiv class=\"card\">\u003ch3>${esc(offer.property)}\u003c/h3>\u003cp>全款 ${money(offer.price)} · 当前余额 ${money(state.cash)}\u003c/p>\n      \u003cp class=\"hint\">${leaseNote}\u003c/p>\u003c/div>\u003cdiv class=\"buttons\">${btn('返回报价','list-property')}${canPay?btn('确认付款','confirm-property',{id},'primary'):'\u003cspan>余额不足\u003c/span>'}\u003c/div>`);\n  };\n  actions['confirm-property']=async({id},button)=>{\n    if (button.disabled||!$('modal').open) return;\n    button.disabled=true;\n    try {\n      await hostWrite({type:'buy-property',assetType:id});\n      closeModal();render();notify('已买断，查看自有物业。');\n    } finally {button.disabled=false;}\n  };\n  actions['toggle-phone-context']=({id})=>{\n    const muted=state.phoneChatMuted||={};\n    muted[id]=muted[id]!==true;\n    save();render();\n    notify(muted[id]?'已暂停同步这位好友的私聊':'这位好友的最近私聊会接入正文');\n  };\n  actions['send-draft-to-tavern']=({summary})=>{\n    jinheBridge.draft($('modal-draft').value);\n    if (summary) {state.phoneActions=[];state.draft='';save();}\n  };\n  actions['raw-confirm']=(_,button)=>writeRawHost(button);\n  actions['raw-undo']=undoRawHost;\n  actions['raw-download']=()=> {\n    const url=URL.createObjectURL(new Blob([JSON.stringify(rawBaseline.raw,null,2)],{type:'application/json'}));\n    const link=document.createElement('a');\n    link.href=url;link.download='金河-stat_data.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);\n  };\n  submit['raw-host-form']=prepareRawWrite;\n  document.addEventListener('input',event=>{\n    if (event.target.id==='raw-host-search') $('raw-host-tree').innerHTML=rawTree(rawBaseline.raw,event.target.value);\n  });\n  document.addEventListener('change',async event=>{\n    if (event.target.id!=='raw-host-file') return;\n    const file=event.target.files[0];\n    if (!file) return;\n    if (file.size>1024*1024) {notify('备份文件超过 1 MB。');return;}\n    try {$('raw-host-text').value=await file.text();}\n    catch {notify('无法读取这份备份。');}\n  });\n  window.receiveJinheSnapshot=snapshot=>{\n    queuedHostSnapshot=structuredClone(snapshot);\n    const active=document.activeElement;\n    if ($('modal').open||active?.closest('form')||section==='editor'||section==='settings') return;\n    if (flushHostSnapshot()) render();\n  };\n  window.showJinheHostStatus=message=>{\n    if (window.lastJinheStatus===message) return;\n    window.lastJinheStatus=message;\n    notify(message);\n  };\n}\n\nbootHostClient();\n// JINHE_EXPERIENCE_CODE\nconst jinheDirtyTalk={\"dongbei\":{\"label\":\"东北话 · 床笫荤话\",\"aliases\":[\"东北\",\"沈阳\",\"哈尔滨\"],\"grammar\":[\"逞强用“咋的”“你瞅啥”“谁怕谁”，软下来立刻换成“哥”“整不动了”\",\"骂人与求饶混着说，越到紧要关头越爱带哭腔的鼻音\",\"身体反应直说，不绕弯：整化了、烫得慌、站不住、骚水直流\"],\"stages\":{\"tease\":[\"咋的，就搁这儿瞅啊？手要是痒痒就往里头搁，光看有啥意思。\",\"你瞅瞅我这腿，今儿特意穿了薄丝的