次刷\u003c/span>\n      \u003cdiv class=\"buttons\">${MOMENT_REFRESH_CHOICES.map(value =>\n        `\u003cbutton class=\"filter\" data-do=\"moment-count-pick\" data-count=\"${value}\" aria-pressed=\"${count===value}\">${value===6?'6 条':value+' 条'}\u003c/button>`).join('')}\u003c/div>\n    \u003c/div>\n    ${busy('moments') ? '\u003cdiv class=\"feedback\" role=\"status\">正在刷动态…\u003c/div>' : ''}\n    ${entries.length ? entries.map(moment => {\n      const p = person(moment.personId);\n      const photo = photos.findLast(item => item.opening === opening && item.sourceId === moment.id);\n      const replyPrefix = moment.name+'回复你：';\n      const comments = [...(moment.comments || []),...(moment.replies || [])].map(text=>{\n        if (typeof text !== 'string') return '';\n        if (text.startsWith('你：')) return text;\n        if (!text.startsWith(replyPrefix)) return stripPhoneReasoning(text);\n        const reply = stripPhoneReasoning(text.slice(replyPrefix.length));\n        return reply ? replyPrefix+reply : '';\n      }).filter(Boolean);\n      const photoDescription = stripPhoneReasoning(moment.photo);\n      return `\u003carticle class=\"card\">\u003cdiv class=\"inline-head\">${avatar(p)}\u003cdiv>\u003cstrong>${esc(moment.name)}\u003c/strong> ${moment.private_only ? badge('好友可见') : ''}\u003cbr>\u003csmall>${esc(moment.time)}${moment.demo ? ' · 演示动态' : ''}\u003c/small>\u003c/div>\u003c/div>\n        \u003cp class=\"moment-text\">${esc(stripPhoneReasoning(moment.text))}\u003c/p>\n        ${photo ? photoButton(photo) : photoDescription ? `\u003cdiv class=\"photo-pending\">${icon('photo')}\u003cspan>${esc(photoDescription)}\u003c/span>\u003c/div>` : ''}\n        \u003cdiv class=\"moment-actions\">\n          \u003cbutton class=\"btn\" data-do=\"like\" data-id=\"${esc(moment.id)}\" aria-pressed=\"${Boolean(moment.liked)}\">${icon('heart')} ${moment.liked ? '已赞' : '点赞'}\u003c/button>\n          ${btn('评论','comment',{id:moment.id})}\n          ${photoDescription ? btn(photo ? '重绘' : '显影','image-dialog',{kind:'moment',id:moment.id},'btn light') : ''}\n        \u003c/div>\n        ${renderSocialMomentThread(moment)}\n        ${comments.length ? `\u003cdiv class=\"comments\">${comments.map(text=>`\u003cdiv>${esc(text)}\u003c/div>`).join('')}\u003c/div>` : ''}\n      \u003c/article>`;\n    }).join('') : empty('这条街还没刷出动态',jinheBridge?'主聊天遇到熟人后就能刷新动态。':'切一个开场，或等遇到熟人后再刷新。')}\u003c/div>`;\n}\nfunction visibleMoment(moment) { return !moment.private_only || isFriend(moment.personId); }\nfunction renderAlbum() {\n  header(names.album);\n  const list = photos.filter(item => item.opening === opening).slice().reverse();\n  return `\u003cdiv class=\"pad\">\n    \u003cdiv class=\"buttons\" style=\"margin-bottom:11px\">\n      \u003cbutton class=\"filter\" data-do=\"album-tab\" data-page=\"photos\" aria-pressed=\"${albumTab === 'photos'}\">相册 · ${list.length}\u003c/button>\n      \u003cbutton class=\"filter\" data-do=\"album-tab\" data-page=\"people\" aria-pressed=\"${albumTab === 'people'}\">人物图鉴 · ${Object.keys(source.people).length}\u003c/button>\n    \u003c/div>\n    ${albumTab === 'photos' ? (list.length ? `\u003cdiv class=\"album-grid\">${list.map(item => photoButton(item,item.title)).join('')}\u003c/div>`\n      : empty('相册还是空的','从朋友圈显影、微信自拍或人物定妆照存进第一张。',btn('看朋友圈','open',{page:'moments'})))\n      : Object.values(source.people).map(p => `\u003cbutton class=\"row\" data-do=\"album-person\" data-id=\"${p.id}\">${avatar(p)}\u003cspan class=\"grow\">\u003cstrong>${esc(p.name)}\u003c/strong>\u003csmall>${esc(p.age_tag)} · ${esc(p.dialect_label)} · ${esc(p.work)}\u003c/small>\u003c/span>${icon('right')}\u003c/button>`).join('')}\n  \u003c/div>`;\n}\nfunction renderWallet() {\n  header(names.wallet,jinheBridge?'酒馆当前楼层账本':'本地演示账本');\n  const totals = state.ledger.reduce((sum,item)=>({spent:sum.spent+item.amount}),{spent:0});\n  const pending=osIsHosted()?pendingPhonePayment():null;\n  return `\u003cdiv class=\"pad\">\u003cdiv class=\"ledger-top\">\u003csmall>当前余额\u003c/small>\u003cstrong>${money(state.cash)}\u003c/strong>\u003cdiv class=\"totals\">\u003cspan>已支出\u003cb>${money(totals.spent)}\u003c/b>\u003c/span>\u003cspan>体力\u003cb>${state.stamina}\u003c/b>\u003c/span>\u003c/div>\u003c/div>\n    ${pending?`\u003cdiv class=\"card form\">\u003cp>付款 ${money(pending.amount)} 待确认存盘\u003c/p>${btn('重试保存付款','retry-phone-payment',{},'primary')}\u003c/div>`:''}\n    ${state.hostIncome ? '\u003cp class=\"hint\">最近入账 '+money(state.hostIncome)+' '+esc(state.hostIncomeReason||'')+'\u003c/p>' : ''}\n    ${heading('支出明细')}\u003cdiv class=\"stack\">${state.ledger.length ? state.ledger.slice().reverse().map(item =>\n      `\u003cdiv class=\"card ledger-row\">\u003cdiv>\u003cstrong>${({gift:'礼物给',support:'帮付给',shared:'共付给',property:'买断',lease:'租金',expense:'开销'}[item.kind] || '红包给')} ${esc(item.name)}\u003c/strong>\u003cbr>\u003csmall>${esc(item.time)} · 支出 ${money(item.amount)}\u003c/small>\u003c/div>\u003c/div>`\n    ).join('') : empty('暂无支出','正文或九号机完成的付款会显示在这里。')}\u003c/div>\n    ${state.incomeLedger?.length ? heading('收入明细')+'\u003cdiv class=\"stack\">'+state.incomeLedger.slice().reverse().map(item=>\n      '\u003cdiv class=\"card ledger-row\">\u003cdiv>\u003cstrong>'+esc(item.name)+'\u003c/strong>\u003cbr>\u003csmall>'+\n      esc(item.time)+' · 入账 '+money(item.amount)+'\u003c/small>\u003c/div>\u003c/div>').join('')+'\u003c/div>' : ''}\n    ${heading('产业与租约')}\u003cp class=\"hint\">${state.property ? esc(state.property.property || '已登记物业')+' · 月租 '+money(state.property.monthly_cost)+(state.property.due_day?' · 第 '+state.property.due_day+' 天到期':'')+(state.property.occupants?.length?' · '+state.property.occupants.map(id=>esc(person(id)?.name||id)).join('、'):'') : '当前开场没有产业租约。'}\u003c/p>\n    ${osIsHosted() ? heading('自有物业')+\n      Object.values(state.properties??{}).map(item=>`\u003cdiv class=\"card\">\u003cstrong>${esc(item.property)}\u003c/strong>\u003cp class=\"hint\">已全款 · ${money(item.purchase_price)}${item.occupants?.length?' · '+item.occupants.map(id=>esc(person(id)?.name||id)).join('、'):''}\u003c/p>\u003c/div>`).join('')+\n      btn('查看可买断物业','list-property',{},'primary') : ''}\n  \u003c/div>`;\n}\nfunction routeBetween(from,to) {\n  if (from === to) return {minutes:0,zones:[from]};\n  const queue = [{minutes:0,zones:[from]}], visited = new Set();\n  while (queue.length) {\n    queue.sort((a,b) => a.minutes-b.minutes);\n    const route = queue.shift(), current = route.zones.at(-1);\n    if (visited.has(current)) continue;\n    if (current === to) return route;\n    visited.add(current);\n    for (const [a,b,time] of source.roads) {\n      const next = a === current ? b : b === current ? a : '';\n      if (next && !visited.has(next)) queue.push({minutes:route.minutes+time,zones:[...route.zones,next]});\n    }\n  }\n  return null;\n}\nconst roughZones = {west_new:{x:10,y:73},east_logistics:{x:97,y:65},west_town:{x:3,y:43},south_town:{x:65,y:94}};\nconst hasPoint = p => Number.isFinite(p?.x) && Number.isFinite(p?.y);\nconst zonePoint = new Map(Object.keys(source.zones).map(zone => [zone,source.places.find(p=>p.zone===zone && p.pin && hasPoint(p)) ||\n  source.places.find(p=>p.zone===zone && hasPoint(p)) || roughZones[zone]]));\n// 片区锚点只看表里写死的坐标，避免自动落点反过来影响锚点。\nconst zoneAnchor = zone => {\n  const points = allPlaces().filter(place => place.zone === zone && hasPoint(place));\n  if (!points.length) return roughZones[zone] || {x:50,y:50};\n  return {x:points.reduce((sum,place)=>sum+place.x,0)/points.length,\n    y:points.reduce((sum,place)=>sum+place.y,0)/points.length};\n};\nconst pointDistance = (a,b) => Math.hypot((a.x-b.x)*4.96,(a.y-b.y)*2.48);\nconst generatedPoints = new Map();\n// 没有坐标的地点（新增或剧情补的）在所属片区里自动找一个不挤的位置。\nfunction autoPoint(zone,seed='',skipId='') {\n  const anchor = zoneAnchor(zone);\n  const used = allPlaces().filter(place=>place.id!==skipId&&place.id!==seed).map(pointFor).filter(hasPoint);\n  const drift = [...String(seed)].reduce((sum,ch)=>sum+ch.charCodeAt(0),0) % 360;\n  for (const gap of [16,12,8]) {\n    for (let step = 0; step \u003c 72; step++) {\n      const ring = Math.floor(step/12), index = step%12;\n      const angle = (drift+index*30+ring*17)*Math.PI/180, radius = 3+ring*2.2;\n      const point = {x:Math.min(96,Math.max(4,+(anchor.x+Math.cos(angle)*radius).toFixed(1))),\n        y:Math.min(94,Math.max(6,+(anchor.y+Math.sin(angle)*radius*0.7).toFixed(1)))};\n      if (used.every(other=>pointDistance(other,point)>=gap)) return point;\n    }\n  }\n  return {x:+anchor.x.toFixed(1),y:+anchor.y.toFixed(1)};\n}\nfunction pointFor(place) {\n  if (hasPoint(place)) return {x:place.x,y:place.y};\n  if (!place) return {x:50,y:50};\n  if (!generatedPoints.has(place.id)) {\n    const anchor = zoneAnchor(place.zone);\n    generatedPoints.set(place.id,{x:+anchor.x.toFixed(1),y:+anchor.y.toFixed(1)});\n    generatedPoints.set(place.id,autoPoint(place.zone,place.id,place.id));\n  }\n  return generatedPoints.get(place.id);\n}\nfunction mapCountLabel() { return `${Object.keys(source.zones).length} 片区 · ${allPlaces().length} 个地点`; }\nfunction drawMap() {\n  const canvas = $('map-canvas');\n  if (!canvas) return;\n  const ctx = canvas.getContext('2d'), width = canvas.width, height = canvas.height;\n  const project = p => {\n    const point = hasPoint(p) ? p : pointFor(p);\n    return [22+point.x/100*(width-44),16+point.y/100*(height-32)];\n  };\n  ctx.clearRect(0,0,width,height);\n  ctx.fillStyle = '#272235'; ctx.fillRect(0,0,width,height);\n  ctx.strokeStyle = '#3a3149'; ctx.lineWidth = 1;\n  for (let step = 0; step \u003c width; step += 26) {\n    ctx.beginPath(); ctx.moveTo(step,0); ctx.lineTo(step,height); ctx.stroke();\n  }\n  for (let step = 0; step \u003c height; step += 26) {\n    ctx.beginPath(); ctx.moveTo(0,step); ctx.lineTo(width,step); ctx.stroke();\n  }\n  ctx.beginPath(); ctx.moveTo(-12,164); ctx.bezierCurveTo(174,212,250,92,558,117); ctx.lineWidth=28;ctx.strokeStyle='#343c58';ctx.stroke();\n  ctx.lineCap = ctx.lineJoin = 'round';\n  function line(points,color,weight) {\n    if (points.length \u003c 2) return;\n    ctx.beginPath();ctx.moveTo(...project(points[0]));points.slice(1).forEach(point=>ctx.lineTo(...project(point)));\n    ctx.strokeStyle = color;ctx.lineWidth = weight;ctx.stroke();\n  }\n  for (const [from,to] of source.roads) line([zonePoint.get(from),zonePoint.get(to)],'#675a78',2);\n  const current = places.get(scene().location_id), next = places.get(destination);\n  if (current && next && next.id !== current.id) {\n    const route = routeBetween(current.zone,next.zone);\n    const waypoints = route?.zones.slice(1,-1).map(zone=>zonePoint.get(zone)) || [];\n    line([current,...waypoints,next],'#dafa85',4);\n  }\n  const currentId = current?.id, nextId = next?.id;\n  for (const p of allPlaces()) {\n    const mark = p.id === currentId || p.id === nextId;\n    const [x,y] = project(pointFor(p));\n    ctx.fillStyle=p.id === currentId ? '#dafa85' : p.id === nextId ? '#f3aac9' : p.custom ? '#8fe0d0' : p.pin ? '#b79bdc' : '#8a7999';\n    if (mark) {ctx.beginPath();ctx.arc(x,y,10,0,2*Math.PI);ctx.globalAlpha=.28;ctx.fill();ctx.globalAlpha=1;}\n    ctx.beginPath();ctx.arc(x,y,mark ? 5 : p.custom ? 3.4 : p.pin ? 3 : 1.6,0,2*Math.PI);ctx.fill();\n  }\n  ctx.font='13px Microsoft YaHei UI, sans-serif';\n  ctx.fillStyle='#c1b0cf';\n  for (const zone of ['old','north','river','south_ind','transit','west_new','resort_bay']) {\n    const [x,y] = project(zonePoint.get(zone));\n    ctx.textAlign=x>width*.75?'right':'left';\n    ctx.fillText(source.zones[zone].replace('商业区','').replace('片区',''),x+(x>width*.75?-8:8),y-8);\n  }\n}\nfunction mapResults() {\n  const query = mapQuery.trim().toLowerCase();\n  const matching = allPlaces().filter(p => (!mapZone || p.zone === mapZone) &&\n    (!query || [p.name,p.area,p.note,...(p.aliases||[])].filter(Boolean).some(value => String(value).toLowerCase().includes(query))));\n  return `\u003cp class=\"zone\">找到 ${matching.length} / ${allPlaces().length} 个地点\u003c/p>${matching.length ? matching.map(p =>\n    `\u003cbutton class=\"row\" data-do=\"destination\" data-id=\"${p.id}\">\u003cspan class=\"grow\">\u003cstrong>${esc(p.name)}${p.custom ? ' \u003cspan class=\"badge\">自建\u003c/span>' : ''}\u003c/strong>\u003csmall>${esc(p.area)}${p.id === scene().location_id ? ' · 当前位置' : ''}${p.note ? ' · ' + esc(p.note) : ''}\u003c/small>\u003c/span>${icon('right')}\u003c/button>`\n  ).join('') : empty('没找到这个地方','换个地点名，或选择全部片区。')}`;\n}\nfunction renderMap() {\n  header(names.map,mapCountLabel());\n  const dest = places.get(destination);\n  const route = dest ? routeBetween(scene().zone_id,dest.zone) : null;\n  const atCurrent = dest?.id === scene().location_id;\n  const eta = route?.minutes ? `骑行约 ${route.minutes} 分钟` : route ? '同一片区' : '暂无片区路程';\n  const routeCard = dest ? `\u003cdiv class=\"card route\">\u003ch3>${esc(dest.name)} · ${atCurrent ? '当前位置' : eta}\u003c/h3>\n    \u003cp class=\"hint\">${route?.zones.map(zone=>esc(source.zones[zone])).join(' → ') || esc(dest.area)}\u003c/p>\n    ${!atCurrent ? `\u003cdiv class=\"buttons\">${btn('写出发草稿','route-draft',{id:dest.id},'primary')}${state.friends.length ? btn('约好友去这儿','invite',{place:dest.id}) : ''}\u003c/div>` : ''}\n  \u003c/div>` : '';\n  const here = peopleHere();\n  const placingName = places.get(placingPlace)?.name || '';\n  const customRows = customPlaces.map(place => `\u003cdiv class=\"custom-place\">\n    \u003cspan class=\"grow\">\u003cstrong>${esc(place.name)}\u003c/strong>\u003csmall>${esc(place.area)}${place.note ? ' · ' + esc(place.note) : ''}\u003c/small>\u003c/span>\n    ${jinheBridge ? (state.properties?.[place.id] ? '\u003csmall>已买断\u003c/small>' : state.customPropertyOffers?.[place.id]\n      ? btn('查看报价','quote-property',{id:place.id}) : btn('设为可买断','place-list-property',{id:place.id})) : ''}\n    \u003cbutton class=\"btn compact\" data-do=\"place-locate\" data-id=\"${place.id}\" aria-pressed=\"${placingPlace === place.id}\">${placingPlace === place.id ? '点地图' : '定位置'}\u003c/button>\n    \u003cbutton class=\"btn compact\" data-do=\"place-delete\" data-id=\"${place.id}\">删掉\u003c/button>\n  \u003c/div>`).join('');\n  return `\u003cdiv class=\"pad\">\n    \u003cdiv class=\"map\">\u003ccanvas id=\"map-canvas\" width=\"540\" height=\"280\" role=\"img\" aria-label=\"金河县示意图，亮绿色是当前地点，粉色是所选目的地，青色是自建地点\">\u003c/canvas>\u003c/div>\n    \u003cp class=\"hint\" style=\"margin-bottom:8px\">位置示意 · 骑行时间按片区估算\u003c/p>\n    ${routeCard}\n    \u003cinput class=\"input\" id=\"map-search\" type=\"search\" aria-label=\"搜索金河县地点\" placeholder=\"搜地点，如：皇冠台球厅\" value=\"${esc(mapQuery)}\">\n    \u003cdiv class=\"filters\">\u003cbutton class=\"filter\" data-do=\"map-zone\" data-id=\"\" aria-pressed=\"${!mapZone}\">全部\u003c/button>${Object.entries(source.zones).map(([id,name])=>`\u003cbutton class=\"filter\" data-do=\"map-zone\" data-id=\"${id}\" aria-pressed=\"${mapZone===id}\">${esc(name)}\u003c/button>`).join('')}\u003c/div>\n    \u003cdiv class=\"card custom-places\">\n      \u003cdiv class=\"custom-head\">\u003ch3>自建地点\u003c/h3>${btn('＋ 添加','place-add')}\u003c/div>\n      ${placingPlace ? `\u003cp class=\"hint\">在地图上点一下，把「${esc(placingName)}」放过去。\u003c/p>` : ''}\n      ${customRows || '\u003cp class=\"hint\">新地方可以加进地图，点上会自动落在所属片区。\u003c/p>'}\n    \u003c/div>\n    ${here.length ? `\u003cp class=\"hint\" style=\"margin:3px 0 6px\">附近遇见：${here.map(p=>esc(p.name)).join('、')}\u003c/p>` : ''}\n    \u003cdiv id=\"map-results\">${mapResults()}\u003c/div>\n  \u003c/div>`;\n}\nfunction propertyPriceFields() {\n  return '\u003clabel>买断总价（元）\u003cinput class=\"input\" name=\"price\" type=\"number\" min=\"1\" max=\"999999999999\" step=\"1\" required>\u003c/label>'+\n    '\u003clabel>物业类型\u003cselect name=\"usage\">\u003coption value=\"home\">住宅\u003c/option>\u003coption value=\"shop\">经营场地\u003c/option>\u003c/select>\u003c/label>';\n}\nasync function registerMapProperty(form, id, name) {\n  const price = Number(formValue(form,'price'));\n  if (!Number.isSafeInteger(price) || price \u003c 1 || price > 999999999999) throw Error('总价请填 1 到 999999999999 之间的整数。');\n  await hostWrite({type:'register-property',assetType:id,name,price,business:formValue(form,'usage')==='shop'});\n}\nfunction listMapProperty(id) {\n  const place = places.get(id);\n  if (!jinheBridge || !place?.custom) return;\n  modal('设为可买断', '\u003cform class=\"form\" id=\"place-list-form\" data-id=\"'+esc(id)+'\">\u003ch3>'+esc(place.name)+'\u003c/h3>'+\n    propertyPriceFields()+'\u003cbutton type=\"submit\" class=\"primary\">加入可买断物业\u003c/button>\u003c/form>');\n}\nasync function submitMapListing(form) {\n  const place = places.get(form.dataset.id);\n  if (!place?.custom || form.dataset.busy) return;\n  form.dataset.busy='1';\n  try {\n    await registerMapProperty(form, place.id, place.name);\n    closeModal(); render(true); notify('已加入钱包的可买断物业');\n  } finally { delete form.dataset.busy; }\n}\nfunction addPlaceDialog() {\n  const zone = scene().zone_id || Object.keys(source.zones)[0];\n  modal('添加地图地点',`\u003cform class=\"form\" id=\"place-form\">\n    \u003clabel>地点名\u003cinput class=\"input\" name=\"name\" maxlength=\"16\" required placeholder=\"比如：阿珍麻辣烫\">\u003c/label>\n    \u003clabel>放在哪个片区\u003cselect name=\"zone\">${Object.entries(source.zones).map(([id,name])=>option(id,name,zone)).join('')}\u003c/select>\u003c/label>\n    \u003clabel>怎么走（可选）\u003cinput class=\"input\" name=\"note\" maxlength=\"40\" placeholder=\"比如：桥北菜市场对面的小巷\">\u003c/label>\n    \u003cp class=\"hint\">保存后在选中的片区生成一个点，地图、搜索和「写出发草稿」都能用。\u003c/p>\n    ${jinheBridge ? '\u003clabel>\u003cinput type=\"checkbox\" name=\"buyable\"> 可买断\u003c/label>\u003cfieldset hidden disabled>'+propertyPriceFields()+'\u003c/fieldset>' : ''}\n    \u003cp id=\"place-status\" class=\"feedback\" role=\"status\">\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">加到地图\u003c/button>\u003c/div>\n  \u003c/form>`);\n  const checkbox = $('place-form')?.elements.buyable;\n  if (checkbox) checkbox.addEventListener('change', () => {\n    const fields = checkbox.form.querySelector('fieldset');\n    fields.hidden = fields.disabled = !checkbox.checked;\n  });\n}\nasync function addPlaceFromForm(form) {\n  const name = formValue(form,'name').replace(/\\s+/g,' ');\n  const zone = formValue(form,'zone');\n  if (!name) throw Error('先给这个地方起个名字。');\n  if (!Object.hasOwn(source.zones,zone)) throw Error('先选一个片区。');\n  if (allPlaces().some(place=>place.name === name)) throw Error('地图上已经有叫「' + name + '」的地方。');\n  if (customPlaces.length >= CUSTOM_PLACE_LIMIT) throw Error('自建地点最多 ' + CUSTOM_PLACE_LIMIT + ' 个，先删掉几个。');\n  if (form.dataset.busy) return;\n  const id = form.dataset.placeId ||= 'custom_' + uid();\n  if (form.elements.buyable?.checked) {\n    form.dataset.busy = '1';\n    try { await registerMapProperty(form,id,name); }\n    finally { delete form.dataset.busy; }\n  }\n  const place = {id,name,area:source.zones[zone],zone,...autoPoint(zone,id,id),pin:true,aliases:[],\n    note:formValue(form,'note').slice(0,40),custom:true};\n  customPlaces = [...customPlaces,place];\n  places.set(place.id,place);\n  saveCustomPlaces();\n  destination = place.id;\n  closeModal();\n  render(true);\n  notify('已加进' + place.area + '，地图上生成了一个点');\n}\nfunction toggleLocate(id) {\n  if (!places.get(id)?.custom) return;\n  placingPlace = placingPlace === id ? '' : id;\n  render(true);\n  notify(placingPlace ? '在地图上点一下就能挪过去' : '不挪了');\n}\nfunction deletePlaceDialog(id) {\n  const place = places.get(id);\n  if (!place?.custom) return;\n  modal('删掉这个地点',`\u003cp class=\"hint\">把「${esc(place.name)}」从地图上删掉？酒馆里的剧情和存档不受影响，想加还能再加。\u003c/p>\n    \u003cdiv class=\"buttons\">${btn('删掉','place-delete-confirm',{id},'primary')}${btn('留下','close')}\u003c/div>`);\n}\nfunction removeCustomPlace(id) {\n  if (!places.get(id)?.custom) return;\n  customPlaces = customPlaces.filter(place=>place.id !== id);\n  places.delete(id);\n  if (destination === id) destination = '';\n  if (placingPlace === id) placingPlace = '';\n  saveCustomPlaces();\n  closeModal();\n  render(true);\n  notify('已从地图上删掉');\n}\nconst chatProviders = {openai:'OpenAI 兼容',claude:'Claude 原生',gemini:'Gemini 原生'};\nconst imageProviders = {openai:'OpenAI 兼容生图',silicon:'硅基流动',sd:'SD WebUI / Forge',novel:'NovelAI',baibai:'柏宝绘 · 本地 ComfyUI',comfy:'本地 ComfyUI（独立）'};\nfunction renderSettings() {\n  header(names.settings,'按需填写 · 本地浏览器直连');\n  return `\u003cdiv class=\"pad\">\n    \u003cdiv class=\"buttons\" style=\"margin-bottom:11px\">\u003cbutton class=\"filter\" data-do=\"settings-tab\" data-page=\"chat\" aria-pressed=\"${settingsTab === 'chat'}\">聊天模型\u003c/button>\u003cbutton class=\"filter\" data-do=\"settings-tab\" data-page=\"image\" aria-pressed=\"${settingsTab === 'image'}\">画图接口\u003c/button>\u003c/div>\n    ${settingsForm(settingsTab,settings[settingsTab])}\n  \u003c/div>`;\n}\nfunction forwardStatusPanel(config) {\n  const status = typeof hostForwardStatus === 'function' ? hostForwardStatus() : {ok:false,reason:'这个页面读不到酒馆。'};\n  const presets = Array.isArray(hostPresetCache.names) ? hostPresetCache.names : [];\n  const forward = config.forward || 'tavern';\n  const mode = config.presetMode || 'follow';\n  const rows = [\n    `\u003clabel>出模型方式\u003cselect name=\"forward\">${Object.entries({tavern:'酒馆主模型（推荐）',host:'酒馆后端转发',relay:'手机自填，由酒馆代发',self:'九号机自填接口（浏览器直连）'})\n      .map(([id,label])=>option(id,label,forward)).join('')}\u003c/select>\u003c/label>`,\n    `\u003cp class=\"hint\">${forward==='tavern'?'交给酒馆主聊天用的那个模型生成，和正文同一套。':\n      forward==='host'?'由酒馆后端代发，用酒馆里已经配好的连接和密钥，浏览器不接触密钥，也不受跨域限制。':\n      forward==='relay'?'用下面填的地址、密钥和模型，但请求仍交给酒馆后端发出。浏览器不直连远端，可绕开跨域；按 OpenAI 兼容协议代发。':\n      '用下面填的地址和密钥，由浏览器直接连。需要该接口允许网页跨域。'}\u003c/p>`,\n  ];\n  {\n    rows.push(`\u003clabel>酒馆预设\u003cselect name=\"presetMode\">${Object.entries({follow:'沿用酒馆当前预设',pick:'选一套酒馆预设',manual:'用手填参数'})\n      .map(([id,label])=>option(id,label,mode)).join('')}\u003c/select>\u003c/label>`);\n    if (mode === 'pick') {\n      rows.push(presets.length\n        ? `\u003clabel>酒馆预设\u003cselect name=\"presetName\">${option('','选择一套预设',config.presetName||'')}${presets.map(name=>option(name,name,config.presetName||'')).join('')}\u003c/select>\u003c/label>`\n        : `\u003cdiv class=\"buttons\">${btn('读取酒馆预设列表','forward-presets')}\u003c/div>\u003cp class=\"hint\">还没读到预设列表。${esc(hostPresetCache.error||'')}\u003c/p>`);\n    }\n    rows.push('\u003cp class=\"hint\">选一套预设后，手机请求会带上其中已启用的提示词。剧情记忆来源可单独选择。\u003c/p>');\n    if(forward==='host') rows.push(`\u003cp class=\"hint\">连接状态：${status.ok?esc('可用 · '+status.source+' · '+status.model+\n      (status.preset_name?' · 预设 '+status.preset_name:'')):esc(status.reason||'不可用')}\u003c/p>`);\n    if(forward==='host') rows.push(`\u003cdiv class=\"buttons\">${btn('刷新连接状态','forward-refresh')}\u003c/div>`);\n  }\n  if (forward === 'relay') {\n    rows.push(check('沿用酒馆预设的采样参数','relayPreset',config.relayPreset===true));\n    rows.push('\u003cp class=\"hint\">打开后顺带用酒馆当前预设的温度、惩罚、top_p 和停止串；关着就只按下面填的参数发。\u003c/p>');\n  }\n  return rows.join('');\n}\nfunction settingsForm(kind, config) {\n  const text = kind === 'chat';\n  const providers = text ? chatProviders : imageProviders;\n  const base = text ? chatDefaults[config.provider] : imageDefaults[config.provider]?.[0];\n  const model = text ? '填写接口支持的模型 ID' : imageDefaults[config.provider]?.[1];\n  const novel = !text && config.provider === 'novel';\n  const novelOptions = {...defaults.image.novel,...config.novel};\n  const currentModel = config.model || (novel ? model : '');\n  // 柏宝绘没有地址、密钥和模型可填，渠道整块由扩展管。\n  const baibai = !text && config.provider === 'baibai';\n  // 本地 ComfyUI 走酒馆自带的 ComfyUI 路由，只要地址、模型文件和工作流。\n  const comfy = !text && config.provider === 'comfy';\n  const comfyOptions = {...defaults.image.comfy,...config.comfy};\n  const forward = text ? (config.forward || 'tavern') : 'self';\n  // 代发（relay）用手机上填的地址和密钥，所以这几项照常显示；\n  // 走酒馆主模型或后端转发时，地址/密钥/模型都由酒馆决定，这几项收起来免得误填。\n  const relay = text && forward === 'relay';\n  const selfFields = !text || forward === 'self' || relay;\n  const apiNote = relay ? '请求由酒馆后端代发，浏览器不直接连远端地址，可绕开跨域。'\n    : baibai ? '由柏宝绘调用本地 ComfyUI，地址、工作流和画幅都在柏宝绘里设置。'\n    : comfy ? '由酒馆服务端去调 ComfyUI，浏览器不直连，所以填局域网或 Tailscale 地址也行。'\n    : selfFields ? '接口需允许浏览器网页直连。若显示拦截，可换允许跨域的接口地址或自己的转发服务。'\n    : '选定酒馆主模型或后端转发时，地址与密钥沿用酒馆里已经配好的那一份。';\n  return `\u003cform class=\"card form\" id=\"settings-form\" data-kind=\"${kind}\" autocomplete=\"off\">\n    ${text ? `\u003cdiv class=\"stack\">${forwardStatusPanel(config)}\u003c/div>` : ''}\n    ${selfFields ? `${relay ? '' : `\u003clabel>接口类型\u003cselect name=\"provider\">${Object.entries(providers).map(([id,name])=>option(id,name,config.provider)).join('')}\u003c/select>\u003c/label>`}\n    ${baibai || comfy ? '' : `${field('接口地址（Base URL）','base',config.base,'url',`placeholder=\"${esc(base)}\" spellcheck=\"false\"`)}\n    ${field('API 密钥','key',config.key,'password','placeholder=\"本地无鉴权接口可留空\" autocomplete=\"off\"')}`}` : ''}\n    ${!text && config.provider === 'sd' || baibai || comfy ? '' : selfFields || forward === 'host' && config.presetMode === 'manual' ? field('模型 ID','model',currentModel,'text',`list=\"models\" placeholder=\"${esc(model || '填写接口支持的模型 ID')}\" spellcheck=\"false\"`) : ''}\n    ${comfy ? `\u003cdiv class=\"stack\">\n      ${field('ComfyUI 地址','comfyBase',comfyOptions.base,'url','spellcheck=\"false\" placeholder=\"http://127.0.0.1:8188\"')}\n      ${comfyWorkflowFields(comfyUses[0],comfyOptions)}\n      ${comfyUses.slice(1).map(use=>`\u003cdetails class=\"image-advanced\">\u003csummary>${use.label}工作流（可选）\u003c/summary>${comfyWorkflowFields(use,comfyOptions)}\u003c/details>`).join('')}\n      \u003cp class=\"hint\">用 ComfyUI「另存为 API 格式」导出的 JSON。正向词写成 %prompt%，画幅写成 %width% / %height%，其余支持 %negative_prompt%、%seed%、%steps%、%cfg%（也认 %cfg_scale%）、%sampler%、%model%（也认 %MODEL_NAME%）。\u003c/p>\n      \u003cdiv class=\"buttons\">${btn('测试连接','test-comfy')}\u003c/div>\n    \u003c/div>` : ''}\n    \u003cdatalist id=\"models\">${novel ? novelModelChoices.map(([id,label])=>option(id,label,'')).join('') : ''}\u003c/datalist>\n    ${novel ? `\u003cdiv class=\"buttons\" aria-label=\"NovelAI 模型快捷选择\">${novelModelChoices.slice(0,2).map(([id,label])=>`\u003cbutton type=\"button\" class=\"filter\" data-do=\"novel-model\" data-id=\"${id}\" aria-pressed=\"${currentModel===id}\">${label}\u003c/button>`).join('')}\u003c/div>` : ''}\n    ${text?'':`\u003cdiv ${novel?'class=\"stack\"':'hidden'}>\n      \u003clabel>画师串\u003ctextarea name=\"novelArtistTags\" rows=\"3\" maxlength=\"1500\" spellcheck=\"false\" placeholder=\"{artist:画师名}, artist:另一个画师\">${esc(novelOptions.artistTags)}\u003c/textarea>\u003c/label>\n      \u003cp class=\"hint\">可直接粘贴多组标签，按填写顺序加到 NovelAI 画面描述前。保留括号与权重写法，数值权重适用于 V4 及以上。\u003c/p>\n      \u003clabel>反向提示词\u003ctextarea name=\"novelNegativePrompt\" rows=\"2\" maxlength=\"1500\" spellcheck=\"false\" placeholder=\"不想画进去的内容\">${esc(novelOptions.negativePrompt)}\u003c/textarea>\u003c/label>\n      ${check('使用 NovelAI 自动质量标签','novelQualityTags',novelOptions.qualityTags!==false)}\n    \u003c/div>`}\n    ${text ? `${field('朋友圈模型（可选）','momentsModel',config.momentsModel,'text','list=\"models\" placeholder=\"留空沿用聊天模型\"')}\n      ${field('画图提示词模型（可选）','promptModel',config.promptModel,'text','list=\"models\" placeholder=\"留空沿用聊天模型\"')}\n      \u003cdiv class=\"pair\">${field('回复随机度','temperature',config.temperature,'number','min=\"0\" max=\"1\" step=\"0.05\" required')}${field('最大回复长度','tokens',config.tokens,'number','min=\"64\" max=\"4096\" step=\"1\" required')}\u003c/div>\n      ${check(jinheBridge?'微信和朋友圈使用独立 API':'微信和刷新朋友圈使用真实 API','live',config.live)}`\n      : `\u003clabel>照片风格\u003cselect name=\"style\">${['手机随拍','夜景胶片','韩漫插画','日系插画'].map(value=>option(value,value,config.style)).join('')}\u003c/select>\u003c/label>\n      ${imageOptionsPanel(config,'')}\n      ${check('刷新朋友圈时自动画图','auto',config.auto)}`}\n    ${baibai || comfy ? '' : check('在当前浏览器记住密钥','remember',config.remember)}\n    \u003cp class=\"hint\">${text ? '启用后，发送消息或刷新动态会按上面的出模型方式发出请求。测试连接会请求一段短回复。'\n      : baibai ? '点生成会把画面提示词交给柏宝绘，由它按自己的 ComfyUI 工作流出图，费用和工作流都在柏宝绘那边。'\n      : comfy ? '点生成会按工作流在本机 ComfyUI 上出图；测试图会自动缩小并把保存换成预览，不往图库堆垃圾。'\n      : '点生成会向所填地址发送图片提示词，费用由该服务决定。可先用示例图试手感。'}\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">保存设置\u003c/button>\n      ${text ? (selfFields ? btn('拉取模型','models') : '') + btn('测试连接','test-chat')\n        : (baibai ? btn('检查渠道','test-baibai') : '') + btn('生成测试图','test-image')}\u003c/div>\n    \u003cp id=\"api-status\" class=\"feedback\" role=\"status\">${esc(notes[kind+':settings'] || '')}\u003c/p>\n    \u003cp class=\"hint\">${apiNote}\u003c/p>\n  \u003c/form>`;\n}\nconst chatSettingsDrafts = new WeakMap();\nfunction redrawChatSettings(form, config, control) {\n  form.outerHTML = settingsForm('chat', config);\n  const nextForm = $('settings-form');\n  chatSettingsDrafts.set(nextForm, config);\n  nextForm.elements[control]?.focus();\n}\nfunction getConfig(form) {\n  const kind = form.dataset.kind;\n  const previous = kind === 'chat' ? (chatSettingsDrafts.get(form) || settings.chat) : settings.image;\n  // 隐藏的连接字段保留原值。显示中的字段可以由用户主动清空。\n  const pick = (name, fallback = '') => form.elements[name] ? formValue(form,name) : previous[name] ?? fallback;\n  // 柏宝绘没有密钥，「记住密钥」这一项不显示，那就沿用原来那只勾。\n  const remember = form.elements.remember ? form.elements.remember.checked : previous.remember === true;\n  if (kind === 'chat') {\n    const forward = pick('forward','tavern');\n    // 代发只按 OpenAI 兼容协议发，接口类型这一项在代发模式下不显示。\n    return {provider:forward==='relay'?'openai':pick('provider','openai'),base:pick('base'),key:pick('key'),model:pick('model'),\n      remember,momentsModel:formValue(form,'momentsModel'),promptModel:formValue(form,'promptModel'),\n      tokens:Number(form.elements.tokens.value),temperature:Number(form.elements.temperature.value),live:form.elements.live.checked,\n      forward,presetMode:pick('presetMode','follow'),presetName:pick('presetName'),hostSource:pick('hostSource'),\n      relayPreset:form.elements.relayPreset?form.elements.relayPreset.checked:previous.relayPreset===true};\n  }\n  const provider = formValue(form,'provider') || 'openai';\n  return {provider,base:pick('base'),key:pick('key'),model:pick('model'),remember,\n    style:formValue(form,'style'),auto:form.elements.auto.checked,\n    generation:readImageGeneration(form,settings.image.generation),\n    comfy:readComfySettings(form,previous.comfy),\n    novel:{artistTags:formValue(form,'novelArtistTags'),negativePrompt:formValue(form,'novelNegativePrompt'),\n      qualityTags:form.elements.novelQualityTags.checked}};\n}\nfunction apiStatus(kind,message,form) {\n  notes[kind+':settings'] = message;\n  if (form?.isConnected) form.querySelector('#api-status').textContent = message;\n}\nconst screens = {home:renderHome,contacts:renderContacts,profile:renderProfile,'album-profile':renderProfile,chat:renderChat,\n  moments:renderMoments,album:renderAlbum,wallet:renderWallet,map:renderMap,settings:renderSettings};\nfunction render(resetScroll = false) {\n  const screen = $('screen'), previous = screen.scrollTop;\n  $('phone-header').innerHTML = '';\n  $('phone-footer').innerHTML = '';\n  screen.innerHTML = screens[section]();\n  screen.scrollTop = section === 'chat' ? screen.scrollHeight : resetScroll ? 0 : previous;\n  $('dock').innerHTML = ['home','contacts','moments','map','editor'].map((page,index)=>{\n    const active = page === section || (page === 'contacts' && ['chat','profile'].includes(section));\n    if (page==='editor') return `\u003cbutton class=\"quick-editor\" data-do=\"edit-open\" ${active?'aria-current=\"page\"':''}>${icon('bolt')}\u003cspan>改变量\u003c/span>\u003c/button>`;\n    return `\u003cbutton data-do=\"open\" data-page=\"${page}\" ${active?'aria-current=\"page\"':''}>${icon(page)}\u003cspan>${['桌面','微信','朋友圈','地图'][index]}\u003c/span>\u003c/button>`;\n  }).join('');\n  $('status-time').textContent = section === 'home' ? '金河' : clockTime();\n  $('opening').value = opening;\n  $('rail-location').textContent = placeTitle();\n  $('rail-time').textContent = scene().time_slot + ' · ' + source.zones[scene().zone_id];\n  if ($('desktop-draft').value !== state.draft) $('desktop-draft').value = state.draft;\n  $('desktop-mode').textContent = settings.chat.live ? '聊天接口已启用' : '离线演示可用';\n  if (section === 'map') drawMap();\n}\nfunction openPage(page, id = '') {\n  if (!Object.hasOwn(screens,page)) return;\n  if (id) activePerson = id;\n  section = page;\n  if (jinheBridge) flushHostSnapshot();\n  render(true);\n  $('screen').focus({preventScroll:true});\n}\nfunction selectOpening(index) {\n  if (jinheBridge || !source.openings[index] || index === opening) return;\n  editorPerson = visitPerson = visitPlace = '';editNotice = '';\n  opening = index;\n  state = getState(index);\n  mapZone = mapQuery = destination = activePerson = '';\n  save();\n  closeModal();\n  openPage('home');\n}\nfunction setDraft(text) {\n  state.draft = text;\n  save();\n  $('desktop-draft').value = text;\n  openDraft();\n}\nlet modalContext = null;\nfunction modal(title, content, context = {}) {\n  if (modalContext!==context && modalContext?.lookPreviewUrl) URL.revokeObjectURL(modalContext.lookPreviewUrl);\n  $('modal-title').textContent = title;\n  $('modal-body').innerHTML = content;\n  modalContext = context;\n  if (!$('modal').open) $('modal').showModal();\n}\nfunction closeModal() {\n  if ($('modal').open) $('modal').close();\n  if (modalContext?.lookPreviewUrl) URL.revokeObjectURL(modalContext.lookPreviewUrl);\n  modalContext = null;\n  if (jinheBridge&&flushHostSnapshot()) render();\n}\nfunction openDraft(withOpening = false) {\n  withOpening=withOpening&&!jinheBridge;\n  modal(withOpening ? '开场与草稿' : '剧情草稿', `\u003cdiv class=\"form\">\n    ${withOpening ? `\u003clabel>当前开场\u003cselect id=\"modal-opening\">${openingOptions()}\u003c/select>\u003c/label>` : ''}\n    \u003clabel>剧情草稿\u003ctextarea id=\"modal-draft\" class=\"draft\" placeholder=\"约见或出发的短句会出现在这里。\">${esc(state.draft)}\u003c/textarea>\u003c/label>\n    \u003cdiv class=\"buttons\">${jinheBridge?btn('放入主聊天输入框','send-draft-to-tavern',{},'primary'):''}${btn('复制草稿','copy-draft',{},jinheBridge?'btn':'primary')}\u003c/div>\n    \u003cp class=\"hint\">可修改后复制到酒馆的聊天输入框。\u003c/p>\u003c/div>`);\n}\nasync function copyDraft() {\n  const text=$('modal-draft')?.value??state.draft;\n  if (!text.trim()) { notify('草稿还是空的。'); return; }\n  try { await navigator.clipboard.writeText(text); }\n  catch {\n    const field = $('modal-draft') || $('desktop-draft');\n    field.focus();field.select();\n    if (!document.execCommand('copy')) {notify('已选中草稿，可以手动复制。');return;}\n  }\n  const feedback = $('modal')?.open && $('modal-body').querySelector('.hint');\n  if ($('modal-draft') && feedback) feedback.textContent = '已复制，可以粘贴到酒馆的聊天输入框。';\n  notify('剧情草稿已复制');\n}\nasync function addFriend(id) {\n  if (isFriend(id) || !peopleHere().some(p => p.id === id)) return;\n  if (jinheBridge) await hostWrite({type:'edit',patch:{learned:[id],friends:[...state.friends,id]}});\n  else state.friends.push(id);\n  save();\n  openPage('chat',id);\n  notify(jinheBridge?'已写入酒馆微信好友名单':'已在这个开场交换微信');\n}\nconst localLines = {\n  mandarin:['你到哪儿了？我刚忙完。','行，你到了喊我一声。','等我把手头的事弄完就回你。'],\n  dongbei:['你搁哪儿呢？我才忙完，外头可还下着小雨呢。','妥妥的。你说个地儿，我骑九号过来。','哎呀，先别催。等我把这边整利索了再唠。'],\n  zhongyuan:['恁到哪儿了？俺在球厅这儿呢。','中，搁门口等着，我忙完这把就来。','别着慌，俺先把手头这点活儿忙完。'],\n  beijing:['哟，您到哪儿了？我这儿刚腾出手。','得嘞，您到了招呼一声，我下来。','甭急，我把手里这点儿事儿收拾完就回您。'],\n  sichuan:['你到哪儿咯？我这头刚忙完噻。','要得，你到了喊我一声哈。','莫催嘛，我把手头这点事弄完就来。'],\n  cantonese:['你食咗饭未？我仲喺铺头。','得，你到咗就话我知。','终于收工，食啲热嘢先返屋企。'],\n  guangxi:['你吃饭没哦？我还在店里忙着捏。','得咧，你克到路口就喊我一声啵。','总算下班收工咯，克吃碗热粉再回屋。']\n};\nconst countyDialogue={\"dongbei\":{\"label\":\"东北话\",\"aliases\":[\"东北\",\"沈阳\",\"哈尔滨\"],\"sample\":\"搁哪儿呢？先把这点事整利索了，咱再唠。\",\"grammar\":[\"问地点用搁哪儿，问办法用咋整，商量用咱先……再……\",\"瞅、寻思、唠、整按语境自然使用，普通小事也带口语节奏\",\"熟人省主语接短句，认真时照样讲清缘由\"],\"avoid\":[\"不句句堆贼、嘎嘎和扯犊子\",\"不把爽快固定成吵架或粗口\",\"不让所有人都自称姐、开口喊哥\"],\"scenes\":{\"greeting\":[\"搁这儿呢？我刚才还寻思你走了。\",\"你啥时候回来的？也没提前吱一声。\",\"早啊，今儿起挺早呗。\",\"好几天没瞅见你了，最近忙啥呢？\"],\"meal\":[\"你吃饭没？我还没顾上整口热乎的。\",\"别点那么老多，咱俩吃不完。\",\"这家我吃过，味儿还行，咸淡你先尝尝。\",\"我寻思整点儿面条得了，吃完再溜达。\"],\"work\":[\"我这头还差一点儿，整完就下班。\",\"别催了，交班那人还没来呢。\",\"今儿忙得脚不沾地，水都没顾上喝。\",\"临时替她顶一会儿，几点走我再给你信儿。\"],\"travel\":[\"你搁哪儿呢？我到路口了。\",\"先别往前骑，瞅见红招牌往左拐。\",\"车没电了，我寻思推到前头充一会儿。\",\"你慢点儿走，我就在门口等着，不着急。\"],\"money\":[\"这笔咋算的？咱把单子翻出来瞅瞅。\",\"钱收到了，回头咱对一下数。\",\"甭都让你掏，这回我来吧。\",\"借你的我记着呢，发了工资就还，差多少咱说明白。\"],\"weather\":[\"外头风老大了，你把拉链拉上。\",\"刚才还好好的，咋说下雨就下雨。\",\"热得我不想动，先搁这儿凉快会儿。\",\"这天儿瞅着不稳当，出门带把伞吧。\"],\"plans\":[\"明儿几点合适？我得先瞅瞅班表。\",\"今儿怕是赶不上了，咱换明儿成不？\",\"你先忙你的，定下来给我吱一声。\",\"咱别光说改天，挑个都不忙的点儿。\"],\"care\":[\"累了就歇会儿呗，非撑着干啥。\",\"到家给我回个信儿，省得我惦记。\",\"还疼啊？先别逞能，找人看看去。\",\"别搁那儿熬了，眼睛都睁不开了。\"],\"banter\":[\"哎呀，夸你两句还给你美上了。\",\"你可拉倒吧，刚才是谁先笑的？\",\"行，算你会唠，这句我爱听。\",\"咋的，今儿还专门捯饬了一下啊？\"],\"boundary\":[\"先别闹，我这儿还忙着呢。\",\"这事儿我不乐意，咱换个话题。\",\"你问我再决定呗，咋还替我答应上了。\",\"今儿真不去了，我想自己歇会儿。\"],\"repair\":[\"你先听我唠完，不是你寻思那回事儿。\",\"刚才那话我说急了，咱重新说。\",\"我没说不去，我说得晚点儿。\",\"哪儿没对上咱说明白，别自己搁那儿猜。\"],\"chat\":[\"嗯，我瞅见了，等会儿跟你说。\",\"先搁这儿吧，回头我来收拾。\",\"我刚才寻思了半天，还是这么整省事儿。\",\"你接着唠，我听着呢。\"],\"moments\":[\"今儿总算忙完了，整口热乎的再回家。\",\"这会儿河边风挺得劲儿，溜达一圈。\",\"寻思早点儿下班，结果又赶上补货。\",\"拍糊了也发吧，今儿就留个念想。\"],\"live\":[\"刚进来的先坐会儿，今儿唠点啥？\",\"看见你那条了，等我把话唠完。\",\"别着急刷，搁这儿听我唠也挺好。\",\"这歌我会一点儿，你们可别笑我跑调。\"],\"selfie\":[\"刚拍的，瞅瞅这张清不清楚。\",\"我挑半天了，就这张还挺精神。\",\"别笑啊，风给我头发吹乱套了。\",\"等会儿，我换个亮堂地儿再拍一张。\"]}},\"zhongyuan\":{\"label\":\"河南中原话\",\"aliases\":[\"河南\",\"中原\",\"豫\",\"洛阳\",\"郑州\"],\"sample\":\"恁搁这儿等会儿，中不中？俺对完账就来。\",\"grammar\":[\"答应用中、商量用中不中，问事用弄啥哩、咋弄\",\"俺或我、恁或你随本人档案与相处习惯保持一致\",\"哩用于合适语气，白闹、怪好等随意思出现\"],\"avoid\":[\"不把每句都改成恁加哩\",\"不用口头词替代清楚的事情和理由\",\"不把河南口音统一写成憨厚或讨好\"],\"scenes\":{\"greeting\":[\"恁搁这儿弄啥哩？我才瞅见恁。\",\"回来也不说一声，俺还以为恁忙着哩。\",\"早啊，恁吃过饭没有？\",\"好些天没碰着了，这阵子咋样？\"],\"meal\":[\"俺还没吃哩，恁要不一块儿？\",\"少点两个菜吧，够咱吃就中。\",\"这家汤怪得劲，恁先尝尝咸淡。\",\"恁想吃啥？俺都中，别光顾着问俺。\"],\"work\":[\"俺这单还没弄完哩，恁等一小会儿。\",\"交班的人还没来，现在走不中。\",\"今儿忙一晌了，才顾上坐下喝口水。\",\"俺先把货对上，忙完了给恁回话。\"],\"travel\":[\"恁到哪儿了？俺在路口等着哩。\",\"白往里走了，过了那家店就拐。\",\"电驴没电了，俺得先找个地方充上。\",\"恁骑慢点，俺又不急这一会儿。\"],\"money\":[\"这钱咋算哩？咱对一下单子。\",\"恁转的俺收着了，数俺再核核。\",\"这回俺来付就中，恁白抢了。\",\"欠恁的俺记着，啥时候还得先说准。\"],\"weather\":[\"外头风怪大，恁多披一件。\",\"刚还晴着哩，咋一转眼就落雨了。\",\"热得慌，咱找个凉快地方坐会儿。\",\"瞅这天怕是还得下，恁带着伞吧。\"],\"plans\":[\"明儿俺得先看看排班，晚点回恁中不中？\",\"今儿怕赶不及，咱改到明儿吧。\",\"恁定准了跟俺说一声，俺好腾时候。\",\"白光说改天了，咱挑个都闲的日子。\"],\"care\":[\"累了就歇歇，恁白硬撑着。\",\"到家了回俺一声，省得俺挂心。\",\"还疼哩？那得找人瞧瞧，白拖了。\",\"都这点了，恁还不睡弄啥哩？\"],\"banter\":[\"才夸恁一句，恁还美上了。\",\"恁白逗俺，俺正说事儿哩。\",\"中，这回算恁说得在理。\",\"今儿收拾得怪好，是专门来的？\"],\"boundary\":[\"白闹了，俺还忙着哩。\",\"这事俺不想应，恁别替俺做主。\",\"先问问俺中不中，哪能恁说了就算。\",\"今儿真不中，俺想早点回去歇着。\"],\"repair\":[\"恁先听俺说完，不是那个意思。\",\"刚那句话俺说急了，咱慢慢说。\",\"俺没说不去，俺是说得晚点。\",\"哪儿没对上咱讲清，白光搁心里猜。\"],\"chat\":[\"中，俺知道了，忙完就回恁。\",\"先搁这儿吧，等会儿俺来弄。\",\"俺寻思这么办怪省事，恁看中不中。\",\"恁接着说，俺听着哩。\"],\"moments\":[\"总算忙完了，先吃口热饭再回。\",\"今儿河边怪凉快，出来转一圈。\",\"本来想早下班，谁知道又来货了。\",\"这张拍得还中，留着当个记号。\"],\"live\":[\"刚来的坐会儿，恁想听俺聊啥？\",\"恁那条俺瞅见了，等俺说完这句。\",\"白急着送礼，陪俺说会儿话就中。\",\"这歌俺只会一段，唱跑了恁可别笑。\"],\"selfie\":[\"才拍好，恁瞅瞅清楚不清楚。\",\"挑了一会儿，俺看这张还中。\",\"头发叫风吹乱了，恁白笑。\",\"等俺换个亮地方，再给恁拍一张。\"]}},\"beijing\":{\"label\":\"北京话\",\"aliases\":[\"北京\",\"京腔\",\"京片子\",\"京话\",\"廊坊\",\"承德\",\"燕郊\",\"三河\",\"固安\",\"滦平\"],\"sample\":\"您甭急，这点儿事儿咱先捋清楚，成吗？\",\"grammar\":[\"商量用成吗、得，否定用甭、别介，叙事有咱先……回头……的节奏\",\"儿化落在会儿、点儿、这儿、信儿等自然位置\",\"您用于本人客气或调侃习惯，熟悉时可自然用你\",\"廊坊、承德、燕郊、三河、固安、滦平来的人说同一口京片子，只是比北京南城少几分贫嘴、多几分实在\"],\"avoid\":[\"不在每个字后硬加儿\",\"不句句您猜怎么着或爷们儿\",\"不把京腔演成相声台词，正经事能直说\"],\"scenes\":{\"greeting\":[\"哟，您也在这儿呢？我刚没瞧见。\",\"什么时候回来的，也不递个信儿。\",\"早啊，今儿怎么起这么早？\",\"有日子没碰见了，最近忙什么呢？\"],\"meal\":[\"你吃了吗？我正寻摸吃点儿什么呢。\",\"甭点那么多，够咱俩吃就成。\",\"这家我来过，您先尝尝，味儿还成。\",\"先垫吧两口，回头再慢慢逛。\"],\"work\":[\"我这儿还差个收尾，弄完就能走。\",\"甭催，接班那位还没露面儿呢。\",\"忙一下午了，刚得空喝口水。\",\"临时替人看会儿店，几点走我再跟你说。\"],\"travel\":[\"您到哪儿了？我就在路口这儿。\",\"先别往里走，瞧见红招牌往左拐。\",\"车没电了，我得先找地儿充上。\",\"慢点儿骑，我都到了，还能跑了不成。\"],\"money\":[\"这笔怎么记的？咱一条条捋，甭着急。\",\"钱瞧见了，我回头对一下数。\",\"别介，这回说好了我请。\",\"借你的我记着呢，还款的日子咱先定明白。\"],\"weather\":[\"外头风可不小，您把外套披上。\",\"这天说变就变，刚才还晒着呢。\",\"热得够呛，先找个地儿凉快会儿。\",\"瞧这天色不对，带把伞踏实点儿。\"],\"plans\":[\"明儿几点合适？我先瞧瞧班表。\",\"今儿怕是来不及了，咱改明儿成吗？\",\"你先忙，定下来给我递个信儿。\",\"别光说改天啊，咱挑个准日子。\"],\"care\":[\"累了就歇会儿，甭硬扛着。\",\"到家跟我说一声，省得我惦记。\",\"还疼呢？那甭拖了，找人看看去。\",\"眼睛都快睁不开了，您还熬着呢？\"],\"banter\":[\"得，夸您一句，还真当回事儿了。\",\"少来这套，刚才谁先乐的？\",\"行，这句还挺像样儿，我听着顺耳。\",\"今儿捯饬得挺齐整啊，什么安排？\"],\"boundary\":[\"先别逗了，我这儿还没忙完呢。\",\"这事儿我不答应，咱聊点儿别的。\",\"您先问问我啊，怎么还替我应下了？\",\"今儿真不去了，我想早点儿歇着。\"],\"repair\":[\"先听我把话说完，您理解岔了。\",\"刚才我话赶话了，咱重新说。\",\"我不是不去，我是得晚点儿。\",\"哪儿没说明白咱摊开说，甭自己瞎琢磨。\"],\"chat\":[\"得，我瞧见了，回头细说。\",\"先放这儿吧，一会儿我收拾。\",\"我琢磨这么办省事儿，你觉得呢？\",\"您接着说，我听着呢。\"],\"moments\":[\"忙完收工，寻摸点儿热乎的吃。\",\"今儿河边挺凉快，出来走两步。\",\"想赶个早下班，得，又来一车货。\",\"这张就算留个影儿吧，拍得还成。\"],\"live\":[\"新来的先坐会儿，您想聊点儿什么？\",\"瞧见您那条了，容我把这话说完。\",\"甭急着送礼，陪我聊两句就挺好。\",\"这歌我会半段，唱岔了您多担待。\"],\"selfie\":[\"刚拍的，您瞧这张清楚吗？\",\"挑来挑去，就这张还像点儿样。\",\"风把头发吹散了，您可甭笑。\",\"等我寻个亮堂地儿，再补一张。\"]}},\"sichuan\":{\"label\":\"川渝话\",\"aliases\":[\"四川\",\"川渝\",\"川话\",\"成都\",\"重庆\"],\"sample\":\"莫慌嘛，我这头弄完就来。你到了喊我一声哈。\",\"grammar\":[\"问办法用咋个、问事用啥子，否定自然用莫、没得、不得行\",\"动词后用起、到须符合语意，程度可用得很、安逸\",\"哈、嘛、噻随提醒、商量、解释变化，成都和重庆细词服从本人籍贯\"],\"avoid\":[\"不每句都连用嘛噻哈\",\"不用瓜娃子代替所有称呼\",\"不把川渝人物统一成大嗓门，轻声和正经话也有本人口音\"],\"scenes\":{\"greeting\":[\"你在这儿嗦？我刚才都没看到。\",\"啥时候回来的嘛，也不先说一声。\",\"早嘛，今天咋个起得这么早？\",\"好久没碰到了，这阵子在忙啥子？\"],\"meal\":[\"你吃饭没得？我还没顾得上吃。\",\"莫点恁个多，够我们两个吃就行。\",\"这家味道还可以，你先尝哈辣不辣。\",\"先吃点东西垫起嘛，饿着逛啥子。\"],\"work\":[\"我这边还没弄完，等我一哈儿。\",\"接班的还没来，现在哪个走得脱嘛。\",\"忙了一下午，才坐到喝口水。\",\"我先帮她顶到，几点下班再给你说。\"],\"travel\":[\"你到哪点了？我在路口等到的。\",\"莫往里头走，看到红招牌就往左拐。\",\"车子没得电了，我先找个地方充起。\",\"你骑慢点嘛，我又没催你。\"],\"money\":[\"这笔钱咋个算的？先把单子拿来对哈。\",\"钱收到了，我等哈核一下数。\",\"说好这回我来，你莫抢到付嘛。\",\"借你的我记到的，啥时候还先说清楚。\"],\"weather\":[\"外头风大得很，你把衣服穿起。\",\"刚才太阳还那么大，这哈就下雨了。\",\"热得遭不住，先找个凉快地方坐哈。\",\"看起还要下雨，你把伞带到哈。\"],\"plans\":[\"明天我先看哈班表，晚点给你说。\",\"今天怕是来不及了，改到明天要得不？\",\"你定好了喊我一声，我好留时间。\",\"莫光说改天嘛，选个都得空的日子。\"],\"care\":[\"累了就歇一哈，莫硬撑到。\",\"到家给我说一声哈，免得我挂到。\",\"还痛嗦？那就去看哈，莫一直拖。\",\"都打瞌睡了，你还不去睡嘛。\"],\"banter\":[\"才夸你两句，你就开始得意了嗦。\",\"你莫逗，我在说正事。\",\"要得，这句话我听起还舒服。\",\"今天打整得乖得很嘛，准备去哪儿？\"],\"boundary\":[\"先莫闹，我手头还有事。\",\"这个我不想答应，换个话题嘛。\",\"你先问下我噻，咋个直接帮我答应了。\",\"今天真不得行，我想早点回去歇到。\"],\"repair\":[\"你先听我说完，不是你想那个意思。\",\"刚才我说急了，重新摆嘛。\",\"我没说不去，我是说要晚点。\",\"哪点没对上就说清楚，莫自己闷到想。\"],\"chat\":[\"要得，我看到了，等哈回你。\",\"先放这儿嘛，等我来收拾。\",\"我想起这样弄省事些，你看喃？\",\"你接到说嘛，我在听。\"],\"moments\":[\"总算忙完了，吃点热的再回去。\",\"今天河边风吹起安逸，出来走哈。\",\"想早点下班，结果又来一批货。\",\"这张拍得还要得，留起算个纪念。\"],\"live\":[\"新来的坐一哈嘛，今天想摆啥子？\",\"看到你发的了，等我先把这句说完。\",\"莫忙到送礼，陪我摆哈龙门阵就要得。\",\"这首歌我只会一段，唱错了莫笑我哈。\"],\"selfie\":[\"刚拍的，你看清楚没得？\",\"选了半天，这张看起还要得。\",\"头发都吹乱了，你莫笑。\",\"等我换个亮点的地方再拍哈。\"]}},\"cantonese\":{\"label\":\"粤语·广州日常口语\",\"aliases\":[\"粤语\",\"粵語\",\"广东话\",\"廣東話\",\"广州话\",\"廣州話\",\"广府话\",\"廣府話\",\"Cantonese\",\"yue\"],\"sample\":\"你食咗饭未？我仲喺铺头，收工再搵你。\",\"grammar\":[\"判断用係、处所用喺；我你佢、呢个嗰个、边度乜嘢自然组织整句\",\"否定用唔或冇，完成用咗、进行用紧、尚且用仲；问句用有冇、得唔得、……未\",\"使用食、饮、返、搵、睇、畀、攞等日常动词，正文简体为主，保留係喺唔冇咗嘅啲等口语字\"],\"avoid\":[\"不把普通话加几个啦喎就当粤语\",\"不用咩替代所有问句，不堆粤语粗口或港片警匪台词\",\"广州粤语作当前底本，人物籍贯不自动改成香港；潮汕话和客家话不混进来\"],\"scenes\":{\"greeting\":[\"你喺呢度呀？我头先都睇唔到你。\",\"几时返嚟㗎？又唔提早讲声。\",\"早晨，今日咁早起身嘅？\",\"好耐冇见，呢排忙唔忙呀？\"],\"meal\":[\"你食咗饭未？我仲未得闲食。\",\"唔使叫咁多，够我哋两个食就得。\",\"呢间我食过，你试吓啱唔啱口味。\",\"食啲嘢先啦，唔好饿住周围行。\"],\"work\":[\"我仲喺铺头，做埋呢单就收工。\",\"接更嗰个仲未嚟，我未走得住。\",\"忙咗成个下昼，依家先得闲饮啖水。\",\"我帮佢顶住先，几点走得再话你知。\"],\"travel\":[\"你到咗边度？我喺路口等你。\",\"唔好再入去，见到红色招牌就转左。\",\"架车冇电喇，我搵个地方充住先。\",\"你慢慢嚟啦，我又唔赶时间。\"],\"money\":[\"呢笔数点计㗎？攞张单出嚟对吓先。\",\"钱收到了，等我再对吓个数。\",\"讲好今次我畀，你唔好争啦。\",\"借你嗰笔我记得，几时还先讲清楚。\"],\"weather\":[\"出面风好大，你着返件外套啦。\",\"头先仲出太阳，依家就落雨喇。\",\"热到唔想郁，搵个阴凉位坐吓先。\",\"睇个天仲会落雨，带埋遮稳阵啲。\"],\"plans\":[\"听日我睇吓更表先，晏啲再覆你。\",\"今日赶唔切喇，改听日得唔得？\",\"你定咗就话我知，我留返时间。\",\"唔好净係讲改日，搵日大家都得闲嘅。\"],\"care\":[\"攰就唞吓啦，唔好硬撑。\",\"返到屋企讲声，费事我挂住。\",\"仲痛呀？咁去睇吓，唔好拖住。\",\"眼都擘唔大喇，你仲唔去瞓？\"],\"banter\":[\"赞你两句，你就咁得戚喇。\",\"唔好玩我啦，我讲紧正经嘢。\",\"得啦，呢句我听得顺耳。\",\"今日执到咁靓，约咗人呀？\"],\"boundary\":[\"等阵先啦，我仲有嘢做。\",\"呢件事我唔想应承，倾第二样啦。\",\"你问过我先嘛，点可以帮我应承咗。\",\"今晚真係唔去喇，我想早点返屋企。\"],\"repair\":[\"你听我讲埋先，唔係你谂嗰个意思。\",\"头先我讲得急咗，慢慢倾返啦。\",\"我唔係话唔去，係要迟少少。\",\"边度唔清楚就讲，唔好自己估估吓。\"],\"chat\":[\"得，我睇到了，阵间覆你。\",\"摆喺呢度先啦，等我嚟执。\",\"我谂咁样做省事啲，你觉得点？\",\"你继续讲啦，我听紧。\"],\"moments\":[\"终于收工，食啲热嘢先返屋企。\",\"今日河边几凉爽，出来行个圈。\",\"谂住早点收工，点知又嚟一批货。\",\"呢张影得都几好，留返做纪念。\"],\"live\":[\"啱啱入嚟嘅坐阵啦，想倾啲乜？\",\"睇到你嗰句喇，等我讲埋先。\",\"唔使急住送礼，陪我倾两句就得。\",\"呢首我识唱一段，唱错唔好笑我呀。\"],\"selfie\":[\"啱啱影嘅，你睇吓清唔清楚。\",\"拣咗一阵，呢张都算影得好。\",\"头发畀风吹乱晒，唔好笑我呀。\",\"等我搵个光啲嘅位，再影一张。\"]}},\"guangxi\":{\"label\":\"广西话·南普桂柳混搭\",\"aliases\":[\"广西\",\"广西话\",\"南普\",\"桂柳\",\"南宁\",\"柳州\",\"桂林\",\"玉林\",\"钦州\",\"北海\",\"防城港\",\"桂\"],\"sample\":\"你克哪凯哦？我这头搞完手上的活就来，你等我一下啵。\",\"grammar\":[\"疑问、反问与确认自然用咩、啵、啵喂，商量或柔和收尾用捏、咧、咯\",\"去用克、哪里用哪凯、这样/怎么用更子、承受得住用顶得顺，按语境自然带出\",\"日常句子保持清爽利落的南普节奏，友女、酸嘢、公道等词随生活话题出现\"],\"avoid\":[\"不每句话都硬塞一串咩啵捏咧\",\"不写成外地人完全看不懂的生僻土白话，也不把广州纯粤语整句照搬过来\",\"不把广西口音写成只会吵架或搞怪网红腔，安静关心和说正事时同样自然\"],\"scenes\":{\"greeting\":[\"你在这凯啊？我刚才都没看见你啵。\",\"几时回来的哦？也不提前跟我讲一声。\",\"早啵，今天更子起得这么早？\",\"好久没见你露面咯，这阵子忙咩捏？\"],\"meal\":[\"你吃饭没哦？我肚子都饿扁去咯。\",\"莫点那么多啵，我们两个哪吃得完。\",\"这家粉味道几正宗的，你先尝一口看合不合胃口啵。\",\"先吃点热乎的垫下肚子咧，饿着克逛街顶不顺的。\"],\"work\":[\"我这头还差一点收尾，搞完就能下班咯。\",\"莫催我啵，交班那个友女还没到捏。\",\"今天忙得我头都昏埋，现在才得闲喝口水。\",\"我先帮她顶一下班，几点走得脱我再发消息给你啵。\"],\"travel\":[\"你克到哪凯了？我就在路口这头等你啵。\",\"莫再往里头骑咯，看见那个红招牌往左拐就是。\",\"电驴没电去咯，我得先推克前头充一下。\",\"你骑慢点啵，我又没催你，安全要紧捏。\"],\"money\":[\"这笔数更子算的哦？拿单子出来我们对一下先。\",\"你转过来的钱我收到咯，等下我再核一下数啵。\",\"讲好这顿我请的嘛，你莫跟我抢着买单啵。\",\"借你的那笔我记着捏，发了工资哪天还我们先讲清楚。\"],\"weather\":[\"外头风大得很啵，你把外套穿好先。\",\"刚才还出大太阳捏，更子一下子就落雨咯。\",\"热到人都不想动，我们找个有冷气的地方坐下啵。\",\"看这天色等下还要落雨，你出门记得带把伞咧。\"],\"plans\":[\"明天我先看下排班表，晚点再回你得不得？\",\"今晚怕是赶不赢咯，我们改到明天克啵？\",\"你定好时间就喊我一声，我提前把空留出来捏。\",\"莫老是讲改天嘛，直接挑个大家都得闲的日子啵。\"],\"care\":[\"累了就坐下歇会儿啵，莫一个人硬撑捏。\",\"回到家给我发个消息哈，不然我老是挂心着。\",\"还痛不痛哦？痛就克医院看一下啵，莫拖着。\",\"眼皮都打架去咯，你还不快点克睡做咩？\"],\"banter\":[\"才夸你两句，尾巴就翘上天克咯。\",\"你莫逗我啵，我跟你在讲正经事捏。\",\"得咧，算你会讲话，这句我听着几顺耳的。\",\"今天打扮得这么靓仔，要克哪凯约会哦？\"],\"boundary\":[\"先莫闹我啵，我手头还有活没搞完捏。\",\"这件事我不想答应，我们聊点别的啵。\",\"你先问过我嘛，更子自己就替我答应下来咯？\",\"今晚我真不克咯，想早点回屋企躺着歇一下。\"],\"repair\":[\"你先听我把话讲完啵，根本不是你想的更子。\",\"刚才我讲话急了一点，我们心平气和重新讲啵。\",\"我没讲不克啊，我是讲要晚一点才得闲。\",\"哪凯没对上我们就当面讲清楚，莫自己在心里乱猜捏。\"],\"chat\":[\"得咧，我看见你消息了，忙完这阵就回你啵。\",\"先放这凯啵，等下我过来收拾就好。\",\"我想了一下还是更子搞比较省事，你看行不行啵？\",\"你接着讲嘛，我在认真听着捏。\"],\"moments\":[\"总算下班收工咯，克整碗螺蛳粉加炸蛋再回屋。\",\"今晚江边吹风几舒服的，骑电驴出来兜一圈。\",\"本来想早点收工的，结果又来了一堆货要盘。\",\"随手拍了一张，光线还算过得克，留个纪念啵。\"],\"live\":[\"刚进直播间的坐下歇会儿啵，今晚想听我讲咩？\",\"看见你飘屏那句咯，等我先把这头讲完哈。\",\"莫破费刷礼物啵，留着吃夜宵，陪我吹下水就好咯。\",\"这首歌我只会唱半截，唱跑调了你们莫笑我啵。\"],\"selfie\":[\"刚拍好的，你帮我看下这张清不清楚啵？\",\"挑了好几张，就这张看着还顺眼一点捏。\",\"风把刘海全吹乱去咯，你看了莫笑我哈。\",\"等一下啵，我找个灯光亮点的位置再给你重拍一张。\"]}}};\nfunction characterPrompt(p, currentScene) {\n  const voice = Object.hasOwn(countyDialogue, p.dialect) ? countyDialogue[p.dialect] : null;\n  const speech = voice ? `每条角色回复都用${voice.label}的自然短句和用词。例句「${voice.sample}」，按话题换说法。语料：${source.dialects[p.dialect] || \"\"}` : \"沿用已知的说话习惯。\";\n  return `你扮演金河县的成年角色${p.name}。${speech} 延续这轮话题，保留口音，不加方言说明或普通话翻译。\n工作：${p.work}。排班：${p.availability}。本轮：${currentScene.time_slot} · ${currentScene.location_name}。\n以下对话是虚构角色聊天。用日常话题与普通照片场景，保持角色说话风格。`;\n}\nasync function sendChat(form) {\n  const id = activePerson, index = opening, scope = index+':chat:'+id;\n  const text = formValue(form,'message'), p = person(id);\n  if (!text || !p || !isFriend(id) || waits.has(scope)) return;\n  const lines = conversation(id);\n  const config = {...settings.chat}, context = scene();\n  const tryAgain = lines.at(-1)?.role === 'user' && lines.at(-1)?.text === text && notes[scope];\n  if (!tryAgain) lines.push({role:'user',text});\n  chatInputs.delete(index+':'+id);\n  delete notes[scope];\n  save();\n  waits.add(scope);\n  render();\n  try {\n    let answer;\n    if (usePhoneModel(config)) {\n      const messages = lines.filter(line=>!line.kind).slice(-12).map(({role,text})=>({role,content:text}));\n      answer = await requestPhoneChat(config,characterPrompt(p,context),messages);\n    } else {\n      await new Promise(resolve=>setTimeout(resolve,380));\n      const local = localLines[p.dialect] || localLines.dongbei;\n      answer = local[/哪|约|去|见|到/.test(text) ? 1 : (lines.filter(line=>line.role==='user').length-1) % 3];\n    }\n    lines.push({role:'assistant',text:answer,at:Date.now(),storyTime:scene().time_slot,speaker:p.name});\n    save();\n  } catch (error) {\n    notes[scope] = error.message + '。重发这句可再试一次。';\n    if (!chatInputs.has(index+':'+id)) chatInputs.set(index+':'+id,text);\n  } finally {\n    waits.delete(scope);\n    if (opening === index && section === 'chat' && activePerson === id) {\n      const restore = $('chat-form')?.contains(document.activeElement) || document.activeElement === document.body;\n      render();\n      if (restore) $('chat-form')?.elements.message.focus({preventScroll:true});\n    }\n  }\n}\nfunction giftDialog() {\n  const p = person(activePerson);\n  if (!p || !isFriend(p.id)) return;\n  modal(`给${p.name}发红包`,`\u003cform class=\"form\" id=\"gift-form\">\u003cp class=\"hint\">余额 ${money(state.cash)}\u003c/p>\u003cdiv class=\"buttons\">${[52,188,520].map(amount=>btn(money(amount),'gift-amount',{amount})).join('')}\u003c/div>\n    ${field('红包金额（元）','amount','52','number','min=\"1\" step=\"1\" required')}\n    \u003cp id=\"gift-status\" class=\"feedback\" role=\"status\">\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">确认发送\u003c/button>\u003c/div>\u003c/form>`,{id:p.id,index:opening});\n}\nasync function sendGift(form) {\n  const id = modalContext?.id, p = person(id), amount = Number(formValue(form,'amount'));\n  if (!p || modalContext.index !== opening || !isFriend(id)) return;\n  if (!Number.isSafeInteger(amount) || amount \u003c= 0 || amount > state.cash) {\n    $('gift-status').textContent = '金额需要是正整数，且不能超过当前余额。';\n    return;\n  }\n  if (jinheBridge) {\n    const line=await payInHost(id,'gift',amount,0,form.querySelector('button[type=submit]'));\n    if (!line) return;\n    conversation(id).push({role:'user',kind:'gift',amount,text:'红包 '+money(amount)});\n    rememberPhoneAction('给'+p.name+'发了'+money(amount)+'红包。');\n    closeModal();render();notify('红包已发');return;\n  }\n  state.cash -= amount;\n  state.affinity[id] = Math.min(100,affinity(id)+1);\n  state.ledger.push({name:p.name,amount,time:scene().time_slot});\n  conversation(id).push({role:'user',kind:'gift',text:`红包 ${money(amount)} · 好感度 +1`});\n  save();\n  closeModal();\n  render();\n  notify('红包已发');\n}\nfunction inviteDialog(place = '') {\n  const friends = state.friends.map(person).filter(Boolean);\n  if (!friends.length) {notify('先在绿泡泡里加一位好友。');return;}\n  modal('约好友见面',`\u003cform class=\"form\" id=\"invite-form\">\n    \u003clabel>好友\u003cselect name=\"friend\">${friends.map(p=>option(p.id,p.name,section==='chat'?activePerson:'')).join('')}\u003c/select>\u003c/label>\n    \u003clabel>地点\u003cselect name=\"place\">${source.places.map(p=>option(p.id,p.name,place||scene().location_id)).join('')}\u003c/select>\u003c/label>\n    ${field('时间','when','现在','text','maxlength=\"32\" required')}\u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">写成剧情草稿\u003c/button>\u003c/div>\u003c/form>`);\n}\nfunction invite(form) {\n  const id = formValue(form,'friend'), p = person(id), dest = places.get(formValue(form,'place'));\n  if (!p || !isFriend(id) || !dest) return;\n  setDraft(`[手机邀约] 我在微信上问${p.name}，${formValue(form,'when')}要不要去${dest.name}见面。`);\n}\nfunction chatDraft() {\n  const p = person(activePerson);\n  if (!p || !isFriend(p.id)) return;\n  const lines = conversation(p.id);\n  const user = lines.findLast(item=>item.role==='user'&&!item.kind);\n  const reply = lines.slice(lines.indexOf(user)+1).findLast(item=>item.role==='assistant');\n  const gift = lines.filter(item=>item.kind==='gift').at(-1);\n  const giftText = gift?.text;\n  const short = text => text.length > 80 ? text.slice(0,80)+'…' : text;\n  if (!lines.length) {notify('先发条消息，再整理草稿。');return;}\n  setDraft(`[手机微信记录] 我刚和${p.name}聊微信。${user ? `我说「${short(user.text)}」。` : ''}${reply ? `她回「${short(reply.text)}」。` : ''}${giftText ? `有一笔${giftText}。` : ''}`);\n}\n// 朋友圈一次刷出几条：1 / 2 / 3 / 5 / 6，玩家选了就按浏览器记住，默认 3 条。\nconst MOMENT_REFRESH_CHOICES = [1, 2, 3, 5, 6];\nconst momentCountKey = 'jinhe-phone-moment-count-v1';\nfunction momentRefreshCount() {\n  try {\n    const saved = Number(localStorage.getItem(momentCountKey));\n    if (MOMENT_REFRESH_CHOICES.includes(saved)) return saved;\n  } catch {}\n  return 3;\n}\nfunction setMomentRefreshCount(value) {\n  if (!MOMENT_REFRESH_CHOICES.includes(value)) return;\n  try { localStorage.setItem(momentCountKey, String(value)); } catch {}\n}\n// 抽人范围从「在场」扩到「在场 + 微信好友 + 已结识」，按最近发过动态的次数轮流，\n// 这样一次刷 3–5 条时是不同小妹各自的生活，而不是同一个人连刷。\nfunction momentCandidates() {\n  const seen = new Set();\n  const list = [];\n  for (const p of [...peopleHere(), ...knownPeople()]) {\n    if (!p?.id || seen.has(p.id)) continue;\n    seen.add(p.id);\n    list.push(p);\n  }\n  const posted = new Map();\n  for (const moment of state.moments || []) {\n    posted.set(moment.personId, (posted.get(moment.personId) || 0) + 1);\n  }\n  return list.sort((a, b) => (posted.get(a.id) || 0) - (posted.get(b.id) || 0));\n}\nasync function refreshMoments() {\n  const index = opening, scope = index + ':moments', current = state;\n  if (waits.has(scope)) return;\n  const context = scene();\n  const wanted = momentRefreshCount();\n  const cast = momentCandidates();\n  if (!cast.length) { notify('当前开场还没遇到可以刷新动态的人。'); return; }\n  const picks = cast.slice(0, Math.min(wanted, cast.length));\n  const config = {...settings.chat}, imageConfig = {...settings.image};\n  waits.add(scope);render();\n  try {\n    for (const p of picks) {\n      // 一条一条来：每次只组一个人的动态，多条时按顺序各发一次请求。\n      const entry = {id:(jinheBridge?'phone_':'')+uid(),personId:p.id,name:p.name,time:context.time_slot,private_only:(state.friends.includes(p.id)&&(affinity(p.id)>=60||(p.arousal||0)>=50)),comments:[],demo:!usePhoneModel(config),added:true};\n      const peers=entry.private_only?[]:knownPeople().filter(peer=>peer.id!==p.id).slice(0,5);\n      if (usePhoneModel(config)) {\n        const text = await requestPhoneChat({...config,model:config.momentsModel||config.model},characterPrompt(p,context,'日常朋友圈','moments'),\n          [{role:'user',content:socialMomentRequest(p,peers)}]);\n        const result=socialMomentParts(text,p,peers);\n        if (!result.text) throw Error('模型没有返回朋友圈正文。');\n        Object.assign(entry,result,{text:formatPhoneBilingualLine(result.text),photo:result.photo||`${context.location_name}附近随手一拍`});\n      } else {\n        await new Promise(resolve=>setTimeout(resolve,250));\n        entry.text = localLines[p.dialect]?.[2] || '今天还在照常上班，忙完就出门走走。';\n        entry.photo = `${context.location_name}附近随手一拍`;\n      }\n      if (jinheBridge) await hostWrite({type:'moment',id:p.id,momentId:entry.id,text:entry.text,photo:entry.photo,private:entry.private_only,thread:entry.thread,likedBy:entry.liked_by});\n    else current.moments.push(entry);\n    save();\n      if (imageConfig.auto) {\n        const prompt = imagePrompt('moment',p,entry.photo,context,imageConfig.style);\n        await finishPhoto({kind:'moment',sourceId:entry.id,p,index,title:entry.name+'的动态'},await requestImage(imageConfig,prompt,'moment'));\n      }\n    }\n  } catch (error) {notify(error.message);}\n  finally {\n    waits.delete(scope);\n    if (opening === index && section === 'moments') render();\n  }\n}\nfunction commentDialog(id) {\n  const moment = state.moments.find(item=>item.id===id && visibleMoment(item));\n  if (!moment) return;\n  modal(`评论${moment.name}的动态`,`\u003cform class=\"form\" id=\"comment-form\">${field('评论','comment','','text','maxlength=\"280\" required')}\u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">发表评论\u003c/button>\u003c/div>\u003c/form>`,{moment,index:opening});\n}\nasync function postComment(form) {\n  const text = formValue(form,'comment'), context = modalContext;\n  if (!text || !context?.moment) return;\n  const {index,moment} = context, p = person(moment.personId), currentScene = scene(), config = {...settings.chat};\n  if (jinheBridge) await hostWrite({type:'comment',momentId:moment.id,comment:'你：'+text});\n  else (moment.replies ||= []).push('你：'+text);\n  save();closeModal();render();\n  if (!p) return;\n  try {\n    const reply = usePhoneModel(config) ? await requestPhoneChat({...config,model:config.momentsModel||config.model},characterPrompt(p,currentScene,text,'comment'),\n      [{role:'user',content:`你的动态「${stripPhoneReasoning(moment.text)}」下有这条评论「${text}」，用一句话回复。\\n`+phonePrompt('moments-comment',state.phonePrompts)+\n        (socialMomentThread(moment).length?'\\n已有讨论：'+socialMomentThread(moment).map(row=>row.name+'：'+row.text).join(' / '):'')}]) : localLines[p.dialect]?.[1];\n    if (reply) {\n      if (jinheBridge) await hostWrite({type:'comment',momentId:moment.id,comment:p.name+'回复你：'+reply});\n      else moment.replies.push(p.name+'回复你：'+reply);\n      save();\n    }\n    if (opening === index && section === 'moments') render();\n  } catch (error) {notify(error.message);}\n}\nfunction imagePrompt(kind,p,description,currentScene,style) {\n  const anchors=[p.age_tag,p.figureSummary,p.figure,p.look,p.tattoo,...(p.bodyMarks||[])].filter(Boolean).join('，');\n  const subject='成年人物'+p.name+'，'+anchors+'。当前穿搭：'+(p.wardrobe||'日常穿搭')+(p.style?'，'+p.style:'');\n  return `${style}，手机照片构图。${subject}。${currentScene.location_name} · ${currentScene.time_slot}。画面：${description}。日常穿搭，普通生活照，自然姿态。`;\n}\nfunction imageDialog(kind,id) {\n  const moment = kind==='moment' ? state.moments.find(item=>item.id===id&&visibleMoment(item)) : null;\n  const p = person(moment?.personId || id);\n  if (!p || (kind === 'selfie' && !isFriend(p.id))) return;\n  const description = stripPhoneReasoning(moment?.photo) || (kind === 'portrait' ? '站在街边的全身穿搭照' : '在附近街边随手拍的半身自拍');\n  const title = kind==='moment' ? moment.name+'的动态' : p.name+(kind==='portrait'?' · 定妆照':' · 自拍');\n  modal(title,`\u003cform class=\"form\" id=\"image-form\">\u003clabel>画面提示词\u003ctextarea name=\"prompt\" rows=\"4\" maxlength=\"1500\" required>${esc(imagePrompt(kind,p,description,scene(),settings.image.style))}\u003c/textarea>\u003c/label>\n    \u003cp class=\"hint\">生成后会存进当前开场的相册。可用县城街景示例图体验存图。\u003c/p>\n    \u003cdiv class=\"buttons\">\u003cbutton class=\"primary\" type=\"submit\">生成图片\u003c/button>${btn('用示例图','sample-photo')}${btn('画图设置','image-settings')}${btn('用模型整理提示词','translate-image')}\u003c/div>\n    \u003cp class=\"feedback\" role=\"status\" id=\"image-status\">\u003c/p>\u003c/form>`,{kind,sourceId:id,p,index:opening,title});\n}\nasync function finishPhoto(context,image = null) {\n  const {kind,sourceId,p,index,title} = context;\n  const item = {id:uid(),sourceId:kind==='moment'?sourceId:'',personId:p?.id,opening:index,\n    title:image?title:title+'（街景示例）',...image,sample:!image,createdAt:Date.now()};\n  let persisted = true;\n  try {await storage.savePhoto(item);}\n  catch {persisted = false;item.temporary = true;}\n  photos.push(item);\n  if (kind==='selfie') {\n    const current = getState(index);\n    (current.chats[p.id] ||= []).push({role:'assistant',kind:'photo',text:image?'刚拍的，给你发过来啦。':'本地街景示例',photo:item.id});\n  }\n  save();\n  notify(persisted ? (item.remoteURL?'图片链接已存进相册':'已存进相册') : '已临时载入 · 浏览器未能保存到相册');\n  return item;\n}\nasync function generatePhoto(form,sample) {\n  const context = modalContext, prompt = formValue(form,'prompt');\n  if (!context?.kind || (!sample && !prompt)) return;\n  const key = context.index+':image:'+context.kind+':'+context.sourceId;\n  if (waits.has(key)) return;\n  waits.add(key);\n  form.querySelectorAll('button').forEach(button=>button.disabled=true);\n  $('image-status').textContent = sample ? '正在存入相册…' : '正在生成…';\n  try {\n    const config=readImageShot(form,imageFormConfig());\n    const imageSource=sample?null:await readImageSource(form,context,config.provider);\n    const reference=sample?null:await readImageReference(form);\n    // 参考图读不出来时（图床跨域等），把那张图的画面描述并进提示词再发。\n    if (reference?.unavailable&&reference.description){\n      const note='参考图画面：'+reference.description+'。';\n      if (!prompt.includes(note)) prompt=prompt+'\\n'+note;\n    }\n    const usableReference=refe