formValue(form,'imageMode'),sourceFields=panel.querySelector('[data-image-source]');\n  if (sourceFields) {\n    sourceFields.hidden=mode==='generate';\n    sourceFields.querySelector('[data-image-mask]').hidden=mode!=='inpaint';\n  }\n  const preview=panel.querySelector('pre');\n  if (!preview) return;\n  // 本地 ComfyUI 的参数在工作流里，没有一个「将要发出去的 JSON」可预览。\n  if (config.provider==='comfy') {\n    preview.textContent='本地 ComfyUI · '+imageDimensionsForDisplay(config,kind);\n    return;\n  }\n  try {\n    const {body,generation}=imageRequestRecipe(config,imageFormPrompt(form),kind);\n    const parameters=body.parameters||body;\n    preview.textContent=[generation.model||imageProviders[generation.provider],imageSizeText(generation),\n      parameters.steps?'步数 '+parameters.steps+' · 提示词强度 '+(parameters.scale??parameters.cfg_scale)+' · 种子 '+(generation.options.seed||'随机'):'',\n      parameters.sampler||parameters.sampler_name?'采样器 '+(parameters.sampler||parameters.sampler_name):'',\n      body.quality?'质量 '+body.quality:'',\n      form.elements.imageReference?.files[0]?'附带 NovelAI 参考图':'',mode&&mode!=='generate'?'改图强度 '+formValue(form,'imageStrength'):'',\n      '正向词\\n'+(body.input??body.prompt),\n      (parameters.negative_prompt?'反向词\\n'+parameters.negative_prompt:''),\n      ...generation.characters.map((entry,i)=>'人物 '+(i+1)+'\\n'+entry.prompt+(entry.negative?'\\n反向词 '+entry.negative:''))].filter(Boolean).join('\\n\\n');\n  } catch(error) {preview.textContent=error.message;}\n}\nfunction imageFormPrompt(form) {\n  return formValue(form,'prompt')||(form.id==='custom-look-form'?\n    wardrobeImagePrompt(formValue(form,'title'),formValue(form,'description')):'');\n}\nfunction readImagePresets() {\n  try {\n    const list=JSON.parse(localStorage.getItem(imagePresetStorage)||'[]');\n    return Array.isArray(list)?list.filter(item=>typeof item?.name==='string'&&Object.hasOwn(imageProviders,item.provider)).slice(0,20):[];\n  } catch {return [];}\n}\nfunction storeImagePresets(list) {\n  try {localStorage.setItem(imagePresetStorage,JSON.stringify(list));}\n  catch {throw Error('浏览器未能保存生图预设。');}\n}\nfunction refreshImagePresetSelect(form,selected='') {\n  const preset=form.elements.imagePreset;\n  preset.innerHTML=option('','选择预设','')+readImagePresets().filter(item=>item.provider===imageFormConfig().provider)\n    .map(item=>option(item.name,item.name,selected)).join('');\n  preset.value=selected;\n}\nfunction manageImagePresets(form,open) {\n  const editor=form.querySelector('[data-image-presets]');\n  if (editor) {editor.hidden=!editor.hidden;return;}\n  const box=document.createElement('div');\n  box.className='stack';box.dataset.imagePresets='';\n  box.innerHTML=field('预设名称','imagePresetName',formValue(form,'imagePreset'),'text','maxlength=\"30\"')+\n    '\u003cdiv class=\"buttons\">'+btn('保存 / 覆盖同名','image-preset-save')+btn('删除选中预设','image-preset-delete')+'\u003c/div>'+\n    '\u003cp class=\"hint\">保存当前画幅和出图参数，可在同一接口的其他场景使用。\u003c/p>';\n  form.elements.imagePreset.closest('.pair').after(box);\n  if (open) box.querySelector('input').focus();\n}\nfunction saveImagePreset(form) {\n  const config=readImageShot(form,imageFormConfig()),name=formValue(form,'imagePresetName');\n  if (!name) throw Error('先填预设名称。');\n  const list=readImagePresets().filter(item=>item.name!==name||item.provider!==config.provider);\n  if (list.length>=20) throw Error('最多保存 20 个生图预设。');\n  list.push({name,provider:config.provider,generation:config.generation,novel:safeNovelImageOptions(config.novel),characters:config.characters});\n  storeImagePresets(list);refreshImagePresetSelect(form,name);notify('已保存生图预设');\n}\nfunction loadImagePreset(form) {\n  const name=formValue(form,'imagePreset'),config=imageFormConfig();\n  const saved=readImagePresets().find(item=>item.name===name&&item.provider===config.provider);\n  if (!saved) throw Error('先选择一个生图预设。');\n  const assign=(key,value)=>{if(form.elements[key]) form.elements[key].value=value;};\n  const options=safeImageGeneration(saved.generation),novel=safeNovelImageOptions(saved.novel);\n  assign('imageFrame',options.frame);\n  for (const [key,value] of Object.entries(options)) assign('image_'+key,value);\n  assign('novelArtistTags',novel.artistTags);assign('novelNegativePrompt',novel.negativePrompt);\n  if (form.elements.novelQualityTags) form.elements.novelQualityTags.checked=novel.qualityTags;\n  (Array.isArray(saved.characters)?saved.characters:[]).concat(Array(4).fill({})).slice(0,4).forEach((entry,i)=>{\n    assign('imagePerson'+i,entry?.prompt||'');assign('imagePersonNegative'+i,entry?.negative||'');\n    assign('imagePersonPosition'+i,entry?.position||'auto');\n  });\n  assign('imagePresetName',name);syncImageOptions(form);\n}\nfunction deleteImagePreset(form) {\n  const name=formValue(form,'imagePreset'),provider=imageFormConfig().provider;\n  if (!name) throw Error('先选择要删除的预设。');\n  storeImagePresets(readImagePresets().filter(item=>item.name!==name||item.provider!==provider));\n  refreshImagePresetSelect(form);form.elements.imagePresetName.value='';notify('已删除生图预设');\n}\nfunction imageGenerationDetails(item) {\n  const recipe=item.generation;\n  const buttons='\u003cdiv class=\"buttons\">'+(recipe?btn('复用生图参数','image-reuse',{id:item.id}):'')+\n    (item.blob&&imageHasDiffusion(settings.image.provider)?btn('用这张图改图','image-remix',{id:item.id}):'')+'\u003c/div>';\n  return buttons+(recipe?'\u003cdetails class=\"image-advanced\">\u003csummary>出图参数\u003c/summary>\u003cp class=\"hint\">'+\n    esc([recipe.model||imageProviders[recipe.provider],imageSizeText(recipe),recipe.options.seed!==''?'种子 '+recipe.options.seed:''].filter(Boolean).join(' · '))+\n    '\u003c/p>\u003cpre class=\"image-recipe\">'+esc(recipe.prompt)+'\u003c/pre>\u003c/details>':'');\n}\nfunction reuseImageGeneration(id,remix=false) {\n  const item=photos.find(photo=>photo.id===id&&photo.opening===opening);\n  if (!item||(!item.generation&&!remix)) return;\n  const recipe=item.generation;\n  if (!remix&&recipe.provider!==settings.image.provider) throw Error('这张图使用 '+imageProviders[recipe.provider]+'，请先切换画图接口。');\n  const compatible=recipe?.provider===settings.image.provider;\n  const base=compatible?recipe.options:undefined;\n  const config=compatible?{model:recipe.model,novel:recipe.novel,comfyUse:recipe.comfyUse||item.kind,generation:{...base,frame:'custom',width:recipe.width,height:recipe.height,\n    quality:recipe.quality??base.quality}}:undefined;\n  const origin=remix?item:photos.find(photo=>photo.id===item.sourcePhotoId&&photo.opening===opening);\n  openImageShot({kind:'remake',sourceId:id,index:opening,title:item.title+' · 再生成',p:person(item.personId),\n    imageConfig:config,origin,mode:remix?'img2img':recipe?.method,sourceOptions:recipe?.sourceOptions,\n    reference:compatible?recipe.reference:undefined,\n    characters:compatible?recipe.characters:[]},recipe?.prompt||'');\n}\nfunction bootImageSettings() {\n  const refresh=event=>{\n    if (event.target.name==='provider'||event.target.closest('[data-image-presets]')) return;\n    syncImageOptions(event.target.form);\n  };\n  document.addEventListener('input',refresh);\n  document.addEventListener('change',refresh);\n  Object.assign(actions,{\n    'image-preset-manage':(_,button)=>manageImagePresets(button.form,true),\n    'image-preset-save':(_,button)=>saveImagePreset(button.form),\n    'image-preset-load':(_,button)=>loadImagePreset(button.form),\n    'image-preset-delete':(_,button)=>deleteImagePreset(button.form),\n    'image-copy-prompt':async(_,button)=>{\n      const {body}=imageRequestRecipe(readImageShot(button.form,imageFormConfig()),imageFormPrompt(button.form),\n        button.form.id==='custom-look-form'?'wardrobe':modalContext?.kind);\n      await navigator.clipboard.writeText(body.input??body.prompt);notify('已复制正向提示词');\n    },\n    'image-reuse':({id})=>reuseImageGeneration(id),\n    'image-remix':({id})=>reuseImageGeneration(id,true),\n    // 切换参考图来源：只换网格与上传框，参考强度和相似程度这些输入原样保留。\n    'ref-tab':({kind,mode},button)=>{\n      const host=button.closest('.stack')?.querySelector('[data-ref-panel=\"'+mode+'\"]');\n      if (!host) return;\n      const picker=host.querySelector('.jh-ref-picker');\n      if (!picker) {host.innerHTML=referencePickerPanel(kind,mode,{referencePick:button.dataset.value});}\n      else {\n        // 就地换内容，保留同一份表单上下文。\n        const fresh=document.createElement('div');\n        fresh.innerHTML=referencePickerPanel(kind,mode,{referencePick:button.dataset.value});\n        host.replaceChildren(...fresh.firstElementChild.childNodes);\n      }\n      button.closest('[data-ref-tabs]')?.querySelectorAll('[data-do=ref-tab]').forEach(node=>{\n        node.setAttribute('aria-pressed',String(node===button));\n      });\n    }\n  });\n}\n\n// END_JINHE_IMAGE_OPTIONS\nconst defaults = {\n  chat:{provider:'openai',base:'',model:'',momentsModel:'',promptModel:'',key:'',temperature:.8,tokens:320,live:false,remember:false,\n    forward:'tavern',presetMode:'follow',presetName:'',hostSource:'',relayPreset:false},\n  image:{provider:'openai',base:'',model:'',key:'',style:'手机随拍',auto:false,remember:false,\n    generation:imageGenerationDefaults,\n    novel:{artistTags:'',negativePrompt:'blurry, low quality',qualityTags:true},\n    comfy:{base:'http://127.0.0.1:8188',model:'',workflow:''}}\n};\nfunction readLocal() {\n  try { return JSON.parse(localStorage.getItem(storeKey)) || {}; }\n  catch { return {}; }\n}\n// Browser preferences contain connection settings only. Story archives never enter this key.\nconst phoneApiSettingsKey='jinhe-phone-api-settings-v1';\nfunction privatePhoneApiSettings(value) {\n  return Object.fromEntries(['chat','image'].map(kind=>{\n    const config=value?.[kind]&&typeof value[kind]==='object'?value[kind]:{};\n    const copy=Object.fromEntries(Object.keys(defaults[kind]).filter(key=>Object.hasOwn(config,key)).map(key=>[key,config[key]]));\n    copy.remember=copy.remember===true;\n    copy.key=copy.remember&&typeof copy.key==='string'?copy.key:'';\n    if(kind==='image'&&Object.hasOwn(copy,'novel')){\n      const options=copy.novel, fallback=defaults.image.novel;\n      copy.novel={\n        artistTags:typeof options?.artistTags==='string'?options.artistTags:fallback.artistTags,\n        negativePrompt:typeof options?.negativePrompt==='string'?options.negativePrompt:fallback.negativePrompt,\n        qualityTags:options?.qualityTags!==false\n      };\n    }\n    if(kind==='image'&&Object.hasOwn(copy,'generation')) copy.generation=safeImageGeneration(copy.generation);\n    // 本地 ComfyUI 的地址、模型名和工作流也随浏览器记住，工作流可能有几十 KB。\n    if(kind==='image'&&Object.hasOwn(copy,'comfy')) copy.comfy=safePhoneComfy(copy.comfy);\n    // 转发方式与预设选择不是密钥，但也要跟着浏览器记住；限定取值，避免存进脏数据。\n    if(kind==='chat'){\n      if(Object.hasOwn(copy,'forward')) copy.forward=['tavern','host','relay','self'].includes(copy.forward)?copy.forward:'tavern';\n      if(Object.hasOwn(copy,'presetMode')) copy.presetMode=['follow','pick','manual'].includes(copy.presetMode)?copy.presetMode:'follow';\n      if(Object.hasOwn(copy,'presetName')) copy.presetName=typeof copy.presetName==='string'?copy.presetName.slice(0,80):'';\n      if(Object.hasOwn(copy,'hostSource')) copy.hostSource=typeof copy.hostSource==='string'?copy.hostSource.slice(0,40):'';\n      // 代发时是否顺带沿用酒馆预设的采样参数。默认关闭，只有明确勾过才是 true。\n      if(Object.hasOwn(copy,'relayPreset')) copy.relayPreset=copy.relayPreset===true;\n    }\n    return [kind,copy];\n  }));\n}\nfunction persistPhoneApiSettings(value) {\n  try {localStorage.setItem(phoneApiSettingsKey,JSON.stringify(privatePhoneApiSettings(value)));}\n  catch { /* The existing per-chat save still reports unavailable browser storage. */ }\n}\nfunction readPhoneApiSettings(legacy) {\n  try {\n    const shared=JSON.parse(localStorage.getItem(phoneApiSettingsKey));\n    if(shared&&typeof shared==='object')return privatePhoneApiSettings(shared);\n    if(legacy?.chat||legacy?.image){\n      const migrated=privatePhoneApiSettings(legacy);\n   