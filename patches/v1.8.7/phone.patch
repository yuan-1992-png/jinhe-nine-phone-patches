'accepted') return '已领取';\n  if (gift.status==='returned') return '已退回';\n  const passing=waits.has(socialScope(false,gift.personId));\n  return '待对方领取'+(passing?'':'\u003cdiv class=\"buttons\">'+btn('撤回','social-gift-cancel',{id:gift.id})+'\u003c/div>');\n}\nfunction showSocialMemos() {\n  header('私密备忘录','当前聊天',btn('新建','social-memo-edit',{},'primary'));\n  return '\u003cdiv class=\"pad stack\">'+(phoneMemos().length?phoneMemos().slice().reverse().map(memo=>\n    btn(esc(memo.title),'social-memo-edit',{id:memo.id})).join(''):empty('这里还没有备忘录','记下想留给自己的事。'))+'\u003c/div>';\n}\nfunction editSocialMemo({id}) {\n  const memo=phoneMemos().find(note=>note.id===id);\n  modal(memo?'编辑备忘录':'新建备忘录','\u003cform class=\"form\" id=\"social-memo-form\" data-id=\"'+esc(memo?.id||'')+'\">'+\n    field('标题','title',memo?.title||'','text','maxlength=\"45\" required')+\n    '\u003clabel>内容\u003ctextarea name=\"text\" maxlength=\"2000\" rows=\"8\">'+esc(memo?.text||'')+'\u003c/textarea>\u003c/label>'+\n    '\u003cdiv class=\"buttons\">\u003cbutton type=\"submit\" class=\"primary\">保存\u003c/button>'+\n    (memo?btn('写入正文草稿','social-memo-draft',{id})+btn('删除','social-memo-delete-ask',{id}):'')+'\u003c/div>\u003c/form>');\n}\nfunction bootJinheSocial() {\n  screens.call=renderSocialCall;screens.memos=showSocialMemos;\n  const open=openPage,draw=render,groupOpen=actions['os-group-open'],hubOpen=selectHubModule;\n  const go=handler=>(...args)=>{\n    const before=socialCapturePage();\n    if (before.section==='call'&&socialCall&&handler===open&&args[0]!=='call') endSocialCall(false);\n    const result=handler(...args);\n    socialRemember(before);\n    if (socialCall&&section!=='call') endSocialCall(false);\n    return result;\n  };\n  openPage=go(open);actions['os-group-open']=go(groupOpen);selectHubModule=go(hubOpen);\n  render=(...args)=>{\n    draw(...args);\n    document.querySelector('.phone')?.classList.toggle('social-call-open',section==='call');\n    const back=$('phone-header').qu