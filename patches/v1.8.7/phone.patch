d === 'claude' ? /\\/(?:messages|models)$/ : /\\/(?:chat\\/completions|models|images\\/generations)$/;\n  const root = path.replace(known,'');\n  url.pathname = root + (/\\/v\\d+(?:beta\\d*)?$/.test(root) ? '' : kind==='gemini' ? '/v1beta' : '/v1') + tail;\n  return url;\n}\nfunction bareRoute(config,fallback,pattern,tail) {\n  const url = parseBase(config,fallback);\n  url.pathname = url.pathname.replace(/\\/+$/,'').replace(pattern,'') + tail;\n  return url;\n}\nfunction authHeaders(config) {\n  if (config.provider === 'claude') return {\n    'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true',...(config.key?{'x-api-key':config.key}:{})\n  };\n  if (config.provider === 'gemini') return config.key ? {'x-goog-api-key':config.key} : {};\n  return config.key ? {Authorization:'Bearer '+config.key} : {};\n}\nasync function apiFetch(url,headers,body,timeout = 45000,signal) {\n  let response;\n  try {\n    const timeoutSignal=AbortSignal.timeout(timeout);\n    response = await fetch(url,{method:body?'POST':'GET',headers:{...headers,...(body?{'Content-Type':'application/json'}:{})},\n      body:body?JSON.stringify(body):undefined,credentials:'omit',redirect:'error',\n      signal:signal?(AbortSignal.any?.([signal,timeoutSignal])??signal):timeoutSignal});\n  } catch (error) {\n    if (signal?.aborted) throw Error('已中断发送。');\n    if (error.name === 'AbortError' || error.name === 'TimeoutError') throw Error('接口等待超时');\n    throw Error('浏览器连不上接口。请核对接口地址、网络和跨域设置');\n  }\n  if (!response.ok) {\n    const hints = {400:'请检查模型 ID 和接口参数',401:'请检查密钥',403:'密钥或模型可能没有调用权限',404:'请检查接口地址和模型 ID',429:'额度已用尽或请求太频繁'};\n    throw Error(`接口返回 HTTP ${response.status}${hints[response.status]?'，'+hints[response.status]:''}`);\n  }\n  return response;\n}\nasync function jsonResponse(response) {\n  try {return await response.json();}\n  catch {throw Error('接口返回的内容不是可读取的 JSON，请检查地址是否指向接口');}\n}\nfunction requireConfig(config, needsModel = true) {\n  if (!config.base && 