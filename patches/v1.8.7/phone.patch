 catch {notify('无法读取这份备份。');}\n  });\nfunction jinheApplySeseLines(nine, additions) {\n  const chats = nine.chats ||= {};\n  const changed = [];\n  for (const {id, lines, times=[]} of additions) {\n    const existing = chats[id] || [];\n    const ids = new Set(existing.map(line => line.id));\n    const appended = lines.filter(line => !ids.has(line.id));\n    const byId = new Map(times.map(item => [item.id,item.storyTime]));\n    let updated = false;\n    const retained = existing.map(line => {\n      const key = line.id || JSON.stringify([line.role,line.at,line.text?.slice(0,160)]);\n      const storyTime = byId.get(key);\n      if (!storyTime || line.storyTime === storyTime) return line;\n      updated = true;\n      return {...line,storyTime};\n    });\n    if (!updated && !appended.length) continue;\n    changed.push([id,chats[id]]);\n    chats[id] = appended.length ? retained.concat(appended).sort((a,b)=>(a.at||0)-(b.at||0)) : retained;\n  }\n  return changed;\n}\nwindow.importJinheSeseLines=additions=>{\n  const archiveState=archive[0];\n  if (!archiveState) return false;\n  const changed=jinheApplySeseLines(archiveState,additions);\n  if (!changed.length) return true;\n  if (!save()) {\n    for (const [id,lines] of changed) {\n      if (lines) archiveState.chats[id]=lines;\n      else delete archiveState.chats[id];\n    }\n    return false;\n  }\n  const focused=document.activeElement;\n  if (['contacts','chat'].includes(section)&&!$('modal').open&&!focused?.closest('form')) render();\n  return true;\n};\n  window.receiveJinheSnapshot=snapshot=>{\n    queuedHostSnapshot=structuredClone(snapshot);\n    const active=document.activeElement;\n    if ($('modal').open||active?.closest('form')||section==='editor'||section==='settings') return;\n    if (flushHostSnapshot()) render();\n  };\n  window.showJinheHostStatus=message=>{\n    if (window.lastJinheStatus===message) return;\n    window.lastJinheStatus=message;\n    notify(message);\n  };\n}\n\nbootHostClient();\