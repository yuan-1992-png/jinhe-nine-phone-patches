句子直接写。';\n\nfunction formatPhoneBilingualLine(text) {\n  return text.replace(/^(（[^\\r\\n]+?）)\\s*〔原话〕\\s*(?=\\S)/u, '$1\\n');\n}\n\nfunction buildPhoneChatPrompt(profile, context, relationship, speech, topic='', channel='chat', sequence='', dialogueLanguage='dialect', overrides) {\n  const mandarin = dialogueLanguage === 'mandarin';\n  const nativeMandarin = profile.dialect === 'mandarin';\n  const nativeSamples = nativeMandarin && ['chat', 'proactive', 'call'].includes(channel)\n    ? renderJinheSpeech(phoneDialectCorpus, 'mandarin', {\n      text: topic, channel, age: profile.age_tag, arousal: profile.arousal, seed: profile.id + ':' + sequence,\n    }) : jinheNativeMandarin;\n  const facts = {\n    姓名:profile.name, 年龄:profile.age_tag, 方言:mandarin ? undefined : profile.dialect_label, 籍贯:profile.hometown, 职业流派:profile.archetypeLabel || profile.archetype,\n    相处习惯:profile.interactionStyle, 性格反差:profile.contrast, 最近心情:profile.voice,\n    好感度:relationship, 职业:profile.work, 排班:profile.availability, 日常:profile.routine,\n    当前穿搭:profile.wardrobe, 服装风格:profile.style, 账务近况:profile.debt,\n    上次见面:profile.lastLocation, 人物备注:profile.rosterNote,\n    // 主剧情刚发生的事、她此刻的身体状态和心声：让微信上的她知道刚才在正文里发生了什么，\n    // 不会出现主剧情刚亲完、打开微信她还在客套问好的割裂感。\n    刚发生的事:profile.storyMemory || '', 此刻状态:profile.bodyNow || '', 心声:profile.voice || ''\n  };\n  const texting = phoneTextingStyles[profile.archetype] || '按她档案里的身份和习惯说话，用日常短句';\n  const band = phoneIntimacyBand(relationship, profile.arousal);\n  // 连珠炮：正文用 || 分段，前端按顺序逐条弹出，模拟真人一次发好几条。\n  const split = channel === 'chat' ? '连发两三条时，用 || 分隔整条消息。意译和对应原句属于同一条。' : '';\n  const languageRule = mandarin ? phoneMandarinDialogue : nativeMandarin ? nativeSamples : dialogueLanguage === 'bilingual'\n    ? channel === 'moments' ? '朋友圈正文只占第一行。' + phoneInlineBilingual : phoneBilingualDialogue\n    : '按角色的方言直接给出原话，无需附意译。';\n  return [\n    '你扮演金河县的成年角色，与玩家使用手机私聊。保持人物自己的说话习惯、关系进展和当前处境。',\n    languageRule,\n    mandarin && nativeMandarin && nativeSamples !== jinheNat