request.result.createObjectStore('photos',{keyPath:'id'});\n    request.onsuccess = () => resolve(request.result);\n    request.onerror = request.onblocked = () => resolve(null);\n  } catch { resolve(null); }\n});\nfunction photoURL(item) {\n  if (!item) return '';\n  if (item.sample) return source.wallpaper;\n  if (item.blob instanceof Blob) return item.previewURL || (item.previewURL = URL.createObjectURL(item.blob));\n  return remotePhotoURL(item.remoteURL);\n}\nconst avatar = (p, big = false) => {\n  const colors = {dongbei:'#a8bafd',zhongyuan:'#dafa85',beijing:'#f0acc8',sichuan:'#c6a8f3'};\n  return `\u003cspan aria-hidden=\"true\" class=\"avatar${big?' big':''}\" style=\"--accent:${colors[p?.dialect] || '#b9b2c2'}\">${esc(p?.name?.slice(-1) || '河')}\u003c/span>`;\n};\nconst empty = (heading, detail, action = '') => `\u003cdiv class=\"empty\">\u003cstrong>${heading}\u003c/strong>\u003cp>${detail}\u003c/p>${action}\u003c/div>`;\nconst heading = text => `\u003cdiv class=\"heading\">${text}\u003c/div>`;\nconst replyMode = () => settings.chat.live ? '独立聊天接口' : jinheBridge?'使用酒馆模型':'离线演示';\nconst affinity = id => state.affinity[id] ?? person(id)?.affinity ?? 0;\nfunction header(title, sub = '', right = '', back = 'home') {\n  $('phone-header').innerHTML = `\u003cdiv class=\"app-header\">${iconBtn('返回','left','open',{page:back})}\u003cdiv>\u003ch2>${esc(title)}\u003c/h2>${sub ? `\u003csmall>${esc(sub)}\u003c/small>` : ''}\u003c/div>\u003cspan class=\"spacer\">\u003c/span>${right}\u003c/div>`;\n}\nfunction renderHome() {\n  const p = peopleHere()[0];\n  const art = assetFor(scene().location_id);\n  const wallpaper = photoURL(photos.find(item => item.id === state.wallpaper)) || (art ? encodeURI(\"地点图/\" + art.file) : source.wallpaper);\n  return `\u003cdiv class=\"home-screen\">\n    \u003cdiv class=\"home-time\">\u003ctime>${esc(clockTime())}\u003c/time>\u003cdiv class=\"day\">${esc(scene().time_slot.split(' ')[0])}\u003cspan>金河县 · 第 ${scene().day} 天\u003c/span>\u003c/