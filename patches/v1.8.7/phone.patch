 Error('壁纸请使用 HTTPS 图片网址。');\n  return url.href;\n}\nfunction normalizePhoneTheme(value) {\n  phoneThemeKeys(value,['schema','version','name','mode','colors','ui','wallpaper','icons'],'主题');\n  if(value.schema!==phoneThemeSchema||value.version!==1)throw Error('这不是九号机 v1 主题文件。请先导出模板，再按模板修改。');\n  if(typeof value.name!=='string'||!value.name.trim()||value.name.trim().length>30)throw Error('主题名称请填写 1–30 个字。');\n  if(value.mode!==undefined&&!['dark','light'].includes(value.mode))throw Error('mode 只能是 dark 或 light。');\n  const base=phoneThemeBuiltins.find(item=>item.id===(value.mode==='light'?'milk':'mist')).theme;\n  const theme=phoneThemeClone(base);theme.name=value.name.trim();theme.mode=value.mode||base.mode;\n  if(value.colors!==undefined){\n    phoneThemeKeys(value.colors,Object.keys(phoneThemeColors),'colors');\n    for(const [key,color] of Object.entries(value.colors))theme.colors[key]=phoneThemeColor(color,'colors.'+key);\n  }\n  if(value.ui!==undefined){\n    phoneThemeKeys(value.ui,Object.keys(phoneThemeDefault.ui),'ui');\n    const ranges={cardRadius:[0,28],iconRadius:[0,30],iconSize:[40,60],fontSize:[12,18],blur:[0,24],wallpaperDim:[0,1]};\n    for(const [key,setting] of Object.entries(value.ui)){\n      if(key==='columns'){if(![3,4].includes(setting))throw Error('ui.columns 只能为 3 或 4。');}\n      else if(key==='fontFamily'){if(!Object.hasOwn(phoneThemeFonts,setting))throw Error('ui.fontFamily 只能为 system、serif 或 rounded。');}\n      else {const [min,max]=ranges[key];if(typeof setting!=='number'||!Number.isFinite(setting)||setting\u003cmin||setting>max)throw Error('ui.'+key+' 应在 '+min+'–'+max+' 之间。');}\n      theme.ui[key]=setting;\n    }\n  }\n  if(value.wallpaper!==undefined)theme.wallpaper=phoneThemeWallpaperURL(value.wallpaper);\n  theme.icons={};\n  if(value.icons!==undefined){\n    phoneThemeKeys(value.icons,Object.keys(phoneThemeAppNames),'icons');\n    for(const [app,settings] of Object.entries(value.icons)){\n      phoneThemeKeys(settings,['color','gly