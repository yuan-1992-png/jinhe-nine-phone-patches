x 0}\n\n\n/* END_JINHE_EXPERIENCE_STYLE */\n.tavern-phone .mast,.tavern-phone .intro,.tavern-phone .rail{display:none!important}.tavern-phone,.tavern-phone .stage,.tavern-phone .device,.tavern-phone .phone{height:100dvh;min-height:0;width:100%;max-width:none;margin:0;padding:0}.tavern-phone .stage,.tavern-phone .device{display:block}.tavern-phone .phone{overflow:hidden;border:0;border-radius:30px}.tavern-phone .rail-actions{display:inline-flex}.raw-tree{overflow:auto;max-height:260px;padding:9px}.raw-tree pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.72rem}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"mast wrap\">\u003cdiv class=\"brand\">\u003cspan class=\"brandmark\" id=\"brand-icon\" aria-hidden=\"true\">\u003c/span>\u003cspan>金河九号随身机\u003c/span>\u003c/div>\u003cdiv class=\"version\">\u003ci aria-hidden=\"true\">\u003c/i>合并设计预览 · v1.4.4\u003c/div>\u003c/header>\n\u003cmain class=\"wrap stage\">\n  \u003csection class=\"intro\" aria-labelledby=\"title\">\n    \u003cdiv class=\"caption-line\">金河县 · 剧情随身机\u003c/div>\n    \u003ch1 id=\"title\">金河\u003cspan>随身机\u003c/span>\u003c/h1>\n    \u003cp>接上县城的消息。聊两句，翻翻动态，想出门就点开九号地图。\u003c/p>\n    \u003cbutton class=\"primary\" data-do=\"open\" data-page=\"hub\">打开金河应用 \u003cspan aria-hidden=\"true\">↗\u003c/span>\u003c/button>\n    \u003cdiv class=\"minor\">\u003cspan class=\"signal-dot\" aria-hidden=\"true\">\u003c/span>\u003cspan id=\"desktop-mode\">离线演示可用\u003c/span>\u003c/div>\n  \u003c/section>\n  \u003csection class=\"device\" aria-label=\"金河随身机交互原型\">\n    \u003cdiv class=\"phone\">\n      \u003cdiv class=\"statusbar\">\u003cspan id=\"status-time\">21:18\u003c/span>\u003ci class=\"camera\" aria-hidden=\"true\">\u003c/i>\u003cdiv class=\"hardware\">\u003cspan class=\"bars\" aria-hidden=\"true\">\u003c/span>\u003cspan class=\"battery\" aria-hidden=\"true\">\u003c/span>\u003c/div>\u003c/div>\n      \u003cheader id=\"phone-header\">\u003c/header>\n      \u003cdiv class=\"screen\" id=\"screen\