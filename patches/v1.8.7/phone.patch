adius:12px;background:#3d565b;color:#fff;font-size:12px;overflow-wrap:anywhere}\n.social-call{position:relative;isolation:isolate;min-height:100%;padding:18px;display:grid;gap:8px;align-content:start;text-align:center;color:#fff;background:#191a22;overflow:hidden}\n.social-call::before{position:absolute;content:\"\";inset:-12px;z-index:-1;background:linear-gradient(#191a2288,#191a22ec),var(--call-cover) center/cover;filter:blur(10px)}\n.social-call-open #dock{display:none}\n.os-island[data-call-speaking=true] .os-led{background:#f1c477;box-shadow:0 0 9px #f3ae6480}\n@media(prefers-reduced-motion:no-preference){\n  .social-call::before{animation:jinhe-call-background 5s ease-in-out infinite alternate}\n  .os-island[data-call-speaking=true] .os-led{animation:jinhe-call-led .85s ease-in-out infinite alternate}\n}\n@keyframes jinhe-call-background{to{transform:scale(1.06)}}\n@keyframes jinhe-call-led{to{transform:scale(1.35);opacity:.65}}\n.social-call strong{font-size:20px}\n.social-call-portrait{margin:auto;width:100%;min-height:110px;display:grid;place-items:center}\n.social-call-portrait:has(>span:not(.avatar)){height:145px;align-items:end;border-radius:13px;background:linear-gradient(transparent,#17171cb3),var(--call-cover) center/cover}\n.social-call-portrait>span:not(.avatar){padding-bottom:8px;font-size:12px}\n.social-call-lines{display:grid;gap:7px;text-align:left;overflow-wrap:anywhere}\n.social-call-lines p{color:inherit;margin:0;background:#101018b8;border-radius:8px;padding:7px}\n.social-call-footer{padding:8px;display:grid;gap:6px}\n.social-call-footer .feedback{margin:0}\n.bubble[data-do=social-line]{cursor:pointer}\n.bubble.receipt[data-gift-status=accepted]{filter:saturate(.65);opacity:.9}\n.bubble.receipt[data-gift-status=returned]{filter:grayscale(.82);opacity:.82}\n.social-moment-thread>div{white-space:pre-wrap;overflow-wrap:anywhere}\n.social-moment-thread .social-moment-reply{padding-inline-start:12px}\n.social-moment-likes{font-size:12px;margin:5px 0}\n\n\n/* END_JINHE_EXPERIENCE_STYLE */\n.tavern-phone .mast,.tavern-phone .intro,.tavern-phone .rail{display:none!important}.tavern-phone,.tavern-phone .stage,.tavern-phone .device,.tavern-phone .phone{height:100dvh;min-height:0;width:100%;max-width:none;margin:0;padding:0}.tavern-phone .stage,.tavern-phone .device{display:block}.tavern-phone .phone{overflow:hidden;border:0;border-radius:30px}.tavern-phone .rail-actions{display:inline-flex}.raw-tree{overflow:auto;max-height:260px;padding:9px}.raw-tree pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.72rem}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader class=\"mast wrap\">\u003cdiv class=\"brand\">\u003cspan class=\"brandmark\" id=\"brand-icon\" aria-hidden=\"true\">\u003c/span>\u003cspan>金河九号随身机\u003c/span>\u003c/div>\u003cdiv class=\"version\">\u003ci aria-hidden=\"true\">\u003c/i>合并设计预览 · v1.4.4\u003c/div>\u003c/header>\n\u003cmain class=\"wrap stage\">\n  \u003csection class=\"intro\" aria-labelledby=\"title\">\n    \u003cdiv class=\"caption-line\">金河县 · 剧情随身机\u003c/div>\n    \u003ch1 id=\"title\">金河\u003cspan>随身机\u003c/span>\u003c/h1>\n    \u003cp>接上县城的消息。聊两句，翻翻动态，想出门就点开九号地图。\u003c/p>\n    \u003cbutton class=\"primary\" data-do=\"open\" data-page=\"hub\">打开金河应用 \u003cspan aria-hidden=\"true\">↗\u003c/span>\u003c/button>\n    \u003cdiv class=\"minor\">\u003cspan class=\"signal-dot\" aria-hidden=\"true\">\u003c/span>\u003cspan id=\"desktop-mode\">离线演示可用\u003c/span>\u003c/div>\n  \u003c/section>\n  \u003csection class=\"device\" aria-label=\"金河随身机交互原型\">\n    \u003cdiv class=\"phone\">\n      \u003cdiv class=\"statusbar\">\u003cspan id=\"status-time\">21:18\u003c/span>\u003ci class=\"camera\" aria-hidden=\"true\">\u003c/i>\u003cdiv class=\"hardware\">\u003cspan class=\"bars\" aria-hidden=\"true\">\u003c/span>\u003cspan class=\"battery\" aria-hidden=\"true\">\u003c/span>\u003c/div>\u003c/div>\n      \u003cheader id=\"phone-header\">\u003c/header>\n      \u003cdiv class=\"screen\" id=\"screen\