+async function phoneChatProxy(action,config,body={}) {
+  if (config.provider!=='openai'||config.forward!=='relay'||!['status','generate'].includes(action)) {
+    throw Error('请在 OpenAI 兼容接口设置中启用酒馆后端转发。');
+  }
+  if (!config.base) throw Error('请先填写九号机的接口地址。');
+  const url=baseRoute(config,chatDefaults.openai,'openai','/models');
+  if (url.search) throw Error('通过酒馆转发时，接口地址请填写不带查询参数的 Base URL。');
+  const reverseProxy=url.origin+url.pathname.slice(0,-'/models'.length);
+  const context=SillyTavern.getContext();
+  if (typeof context?.getRequestHeaders!=='function') throw Error('酒馆后端未就绪，请重新打开九号机。');
+  let response;
+  try {
+    response=await hostPage.fetch('/api/backends/chat-completions/'+action,{
+      method:'POST',headers:context.getRequestHeaders(),credentials:'same-origin',redirect:'error',
+      body:JSON.stringify({...body,chat_completion_source:'openai',reverse_proxy:reverseProxy,
+        proxy_password:config.key||'',stream:false,tool_choice:'none'}),
+      signal:AbortSignal.timeout(45000),
+    });
+  } catch (error) {
+    if (error.name==='AbortError'||error.name==='TimeoutError') throw Error('酒馆转发等待超时。');
+    throw Error('连不上酒馆后端，请重新打开九号机。');
+  }
+  if (!response.ok) throw Error('酒馆转发返回 HTTP '+response.status+'，请检查接口地址和 API 密钥。');
+  const data=await jsonResponse(response);
+  if (data?.error) {
+    const message=typeof data.error.message==='string'?data.error.message:'请检查接口地址和 API 密钥';
+    throw Error('酒馆转发失败 · '+message);
+  }
+  return data;
+}
