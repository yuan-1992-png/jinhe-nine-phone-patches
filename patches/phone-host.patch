+async function phoneComfyRequest(scope, iframe, action, config, workflow) {
+  const isCurrent=()=>iframe===activeFrame&&currentChat()===scope.chat;
+  if (!isCurrent()) throw Error('聊天已切换，请重新打开九号机。');
+  const headers=SillyTavern.getContext().getRequestHeaders();
+  let route,body;
+  if (action==='workflow') {
+    // Read the default API graph from Tavern. Custom graphs live in the phone settings.
+    route='workflow';
+    body={file_name:'Default_Comfy_Workflow.json'};
+  } else {
+    const url=parseBase({base:config.base},'http://127.0.0.1:8188');
+    if (url.search||url.hash) throw Error('ComfyUI 地址请填写服务根地址，去掉查询参数和片段。');
+    body={url:url.href.replace(/\/$/,'')};
+    if (action==='ping'||action==='models') route=action;
+    else if (action==='generate'&&workflow&&typeof workflow==='object'&&!Array.isArray(workflow)) {
+      route='generate';
+      body.prompt=JSON.stringify({prompt:workflow});
+    } else throw Error('无效的 ComfyUI 请求。');
+  }
+  const response=await hostPage.fetch('/api/sd/comfy/'+route,{
+    method:'POST',headers,credentials:'same-origin',body:JSON.stringify(body)
+  });
+  if (!response.ok) {
+    if (route==='ping'||route==='models') throw Error('酒馆后端连不上 ComfyUI，请检查地址与服务状态。');
+    const detail=(await response.text()).trim().slice(0,450);
+    throw Error('ComfyUI 请求失败（HTTP '+response.status+'）'+(detail?' · '+detail:''));
+  }
+  if (!isCurrent()) throw Error('手机已关闭或聊天已切换。');
+  return route==='ping'?true:response.json();
+}
