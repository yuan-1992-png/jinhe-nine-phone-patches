+async function syncJinheSese() {
+  if (disposed||generationActive||jinheSeseBusy) return;
+  const scope = phoneStoryScope(), adapter = hostPage.__jinheSeseAdapter164;
+  if (scope?.character!==jinheSeseCard||!adapter) { lastSync=null; return; }
+    const ctx=SillyTavern.getContext(), id=ctx.chat.length-1, row=ctx.chat[id], swipe=row?.swipe_id??0;
+    const state=row?.variables?.[swipe]?.stat_data;
+    const version=adapter.revision?.(scope);
+    if (version===null) { lastSync=null; return; }
+    const inputs=contactInputs(state), archiveVersion=syncArchiveVersion;
+    const samePeople=lastSync?.chat===scope.chat && lastSync.adapter===adapter && lastSync.inputs===inputs;
+    if (samePeople && lastSync.id===id && lastSync.swipe===swipe && lastSync.version===version &&
+        version!==undefined && lastSync.archiveVersion===archiveVersion && !jinheSesePendingFriends && state) return;
+    const mark=(history=true)=>{lastSync={history,chat:scope.chat,adapter,inputs,id,swipe,version,archiveVersion};};
+  const storage = hostPage.localStorage;
+  const archiveKey = phoneStorageKey(scope), journalKey = archiveKey+':sese-sync-v1';
+  syncKey=archiveKey;
+  const same = () => {
+    const active = phoneStoryScope();
+    return !disposed&&active?.chat===scope.chat&&active.character===scope.character;
+  };
+  jinheSeseBusy = true;
+  try {
+    const year = JSON.parse(storage.getItem(archiveKey)||'null');
+    const nine = year?.archive?.[0];
+    if (!nine?.chats) { mark(false); return; }
+    const snapshot = rawSnapshot();
+    if (snapshot.mvu.isDuringExtraAnalysis?.()) return;
+    const data = snapshot.kernel.project(snapshot.data.stat_data);
+    const names = [...new Set([...data.knownIds,...data.presentIds])].map(id=>data.people[id]?.name).filter(Boolean);
+    const sese = adapter.read(scope,names,samePeople && lastSync.history?250:2000);
+    if (!sese) return;
+    const prior = JSON.parse(storage.getItem(journalKey)||'[]');
+    const done = new Set(Array.isArray(prior)?prior:[]);
+    const plan = jinheSesePlan(data,nine,sese,done,!samePeople || !lastSync.history);
+    const pending = jinheSesePendingFriends?.signature===snapshot.signature?jinheSesePendingFriends.ids:[];
+    if ((pending.length||plan.addToNine.length)&&!await jinheSaveSeseFriends(scope,[...pending,...plan.addToNine])) return;
+    if (!same()||generationActive) return;
+
+    let nineSaved = !plan.nineLines.length;
+    if (!nineSaved && activeFrame?.contentWindow?.importJinheSeseLines) {
+      nineSaved = activeFrame.contentWindow.importJinheSeseLines(plan.nineLines);
+    } else if (!nineSaved && !activeFrame) {
+      const current = JSON.parse(storage.getItem(archiveKey)||'null');
+      if (current?.archive?.[0]?.chats) {
+        jinheApplySeseLines(current.archive[0],plan.nineLines);
+        storage.setItem(archiveKey,JSON.stringify(current));
+        nineSaved = true;
+      }
+    }
+    const seseSaved = !plan.seseUpdates.length||await adapter.append(scope,plan.seseUpdates);
+    if (!same()) return;
+    if (nineSaved) for (const key of plan.nineDone) done.add(key);
+    if (seseSaved) for (const key of plan.seseDone) done.add(key);
+    const encoded = JSON.stringify([...done].slice(-30000));
+    if (storage.getItem(journalKey)!==encoded) storage.setItem(journalKey,encoded);
+    if (nineSaved && seseSaved) mark();
+    jinheSeseLastError = '';
+  } catch (error) {
+    if (jinheSeseLastError!==error.message) {
+      jinheSeseLastError = error.message;
+      console.warn('[金河手机互通]',error.message);
+    }
+  } finally {
+    jinheSeseBusy = false;
+  }
+}
