@@ -221,0 +222,213 @@ const hostDocument=hostPage.document;
+const jinheSeseCard = '金河县的精神小妹们v1.6.4 · 九号随身机.png';
+const jinheSesePrefix = 'jinhe_sese_';
+const jinheNinePrefix = 'jinhe_nine_';
+const jinheSharedName = name => typeof name === 'string'
+  ? name.normalize('NFKC').replace(/\s+/g,'').toLowerCase() : '';
+let jinheSeseBusy = false;
+let syncKey = '', syncArchiveVersion = 0, lastSync = null;
+function archiveChanged(event) {
+  if (event.key === syncKey || event.key === null) syncArchiveVersion++;
+}
+function contactInputs(state) {
+  const entries = group => Object.entries(group || {}).map(([id,p])=>
+    [id,p?.name,p?.snapshot?.name,p?.present,p?.wechat_unlocked]);
+  return JSON.stringify([entries(state?.collection?.roster),entries(state?.active_girls)]);
+}
+let jinheSeseTimer = null;
+let jinheSesePendingFriends = null;
+let jinheSeseLastError = '';
+
+function jinheSesePlan(data,nine,sese,prior,fullHistory=true) {
+  const byName = new Map();
+  const chats = new Map();
+  const nineFriends = new Set(data.friends);
+  const seseFriends = new Set(sese.friends.map(jinheSharedName));
+  for (const id of new Set([...data.knownIds,...data.presentIds])) {
+    const name = data.people[id]?.name?.trim();
+    const key = jinheSharedName(name);
+    if (!key || name.length > 60) continue;
+    const overlap = byName.has(key);
+    byName.set(key,overlap?null:{id,name});
+  }
+  for (const chat of sese.conversations) {
+    const key = jinheSharedName(chat.name);
+    if (key) chats.set(key,chats.has(key)?null:chat);
+  }
+  const synced = new Set(prior);
+  const addToNine = [], nineLines = [], seseUpdates = [];
+  const nineDone = [], seseDone = [];
+  for (const [key,person] of byName) {
+    if (!person || chats.has(key)&&!chats.get(key)) continue;
+    const {id,name} = person;
+    const hasNine = nineFriends.has(id), hasSese = seseFriends.has(key);
+    const nineContact = 'contact:nine:'+id, seseContact = 'contact:sese:'+id;
+    const importFriend = hasSese&&!hasNine&&!synced.has(nineContact)&&nineFriends.size+addToNine.length<50;
+    const exportFriend = hasNine&&!hasSese&&!synced.has(seseContact);
+    if (importFriend) {addToNine.push(id);nineDone.push(nineContact);}
+    if (exportFriend) seseDone.push(seseContact);
+    if (hasNine&&hasSese) {nineDone.push(nineContact);seseDone.push(seseContact);}
+    if ((!hasNine&&!importFriend)||(!hasSese&&!exportFriend)) continue;
+
+    const left = Array.isArray(nine.chats[id])?nine.chats[id]:[], right = chats.get(key)?.messages||[];
+    const nineIds = new Set(left.map(line=>line.id)), seseIds = new Set(right.map(line=>line.id));
+    const toSese = [], toNine = [], nineTimes = [], seseTimes = [];
+    const leftById = new Map(left.map(line=>[line.id,line]));
+    const rightById = new Map(right.map(line=>[line.id,line]));
+    const recentLeft = new Set(left.slice(-250)), recentRight = new Set(right.slice(-250));
+    for (const line of fullHistory ? left : recentLeft) {
+      if (!line || line.failed || (line.kind&&line.kind!=='voice') ||
+          !['user','assistant'].includes(line.role) || typeof line.text!=='string' || !line.text.trim() ||
+          !Number.isFinite(line.at)) continue;
+      const native = typeof line.id==='string'&&line.id || JSON.stringify([line.role,line.at,line.text.slice(0,160)]);
+      if (native.startsWith(jinheSesePrefix)) continue;
+      const mirrored = jinheNinePrefix+native;
+      const copy = rightById.get(mirrored);
+      if (copy && line.storyTime && line.storyTime !== copy.storyTime) seseTimes.push({id:mirrored,storyTime:line.storyTime});
+      else if (copy?.storyTime && !line.storyTime) nineTimes.push({id:native,storyTime:copy.storyTime});
+      const token = 'line:sese:'+id+':'+mirrored;
+      if (synced.has(token) || (!recentLeft.has(line) && !copy)) continue;
+      if (!seseIds.has(mirrored)) {
+        toSese.push({id:mirrored,from:line.role==='user'?'me':name,type:line.kind||'text',
+          content:line.text.slice(0,4000),ts:line.at,...(line.storyTime?{storyTime:line.storyTime}:{})});
+        seseIds.add(mirrored);
+      }
+      seseDone.push(token);
+    }
+    for (const line of right) {
+      if (!line || typeof line.id!=='string' || !line.id || line.id.startsWith(jinheNinePrefix) ||
+          typeof line.content!=='string' || !line.content.trim() || !Number.isFinite(line.ts)) continue;
+      const self = line.from==='me';
+      if (!self&&jinheSharedName(line.from)!==key) continue;
+      const mirrored = jinheSesePrefix+line.id;
+      const copy = leftById.get(mirrored);
+      if (copy && line.storyTime && copy.storyTime !== line.storyTime) nineTimes.push({id:mirrored,storyTime:line.storyTime});
+      const token = 'line:nine:'+id+':'+mirrored;
+      if (synced.has(token) || (!recentRight.has(line) && !copy)) continue;
+      if (!nineIds.has(mirrored)) {
+        toNine.push({id:mirrored,role:self?'user':'assistant',...(self?{}:{speaker:name}),
+          ...(line.type==='voice'?{kind:'voice'}:{}),text:line.content.slice(0,4000),at:line.ts,...(line.storyTime?{storyTime:line.storyTime}:{})});
+        nineIds.add(mirrored);
+      }
+      nineDone.push(token);
+    }
+    if (toNine.length||nineTimes.length) nineLines.push({id,lines:toNine,times:nineTimes});
+    if (exportFriend||toSese.length||seseTimes.length) seseUpdates.push({name,addFriend:exportFriend,messages:toSese,times:seseTimes});
+  }
+  return {addToNine,nineLines,seseUpdates,nineDone,seseDone};
+}
+
+function jinheApplySeseLines(nine, additions) {
+  const chats = nine.chats ||= {};
+  const changed = [];
+  for (const {id, lines, times=[]} of additions) {
+    const existing = chats[id] || [];
+    const ids = new Set(existing.map(line => line.id));
+    const appended = lines.filter(line => !ids.has(line.id));
+    const byId = new Map(times.map(item => [item.id,item.storyTime]));
+    let updated = false;
+    const retained = existing.map(line => {
+      const key = line.id || JSON.stringify([line.role,line.at,line.text?.slice(0,160)]);
+      const storyTime = byId.get(key);
+      if (!storyTime || line.storyTime === storyTime) return line;
+      updated = true;
+      return {...line,storyTime};
+    });
+    if (!updated && !appended.length) continue;
+    changed.push([id,chats[id]]);
+    chats[id] = appended.length ? retained.concat(appended).sort((a,b)=>(a.at||0)-(b.at||0)) : retained;
+  }
+  return changed;
+}
