+async function jinheSaveSeseFriends(scope,ids) {
+  return queuePhoneWrite(async()=>{
+    const active = phoneStoryScope();
+    if (disposed||generationActive||active?.chat!==scope.chat||active?.character!==scope.character) return false;
+    const ctx = SillyTavern.getContext(), snapshot = rawSnapshot();
+    if (snapshot.mvu.isDuringExtraAnalysis?.()||typeof ctx.saveChat!=='function') return false;
+    const data = snapshot.kernel.project(snapshot.data.stat_data);
+    const friends = [...new Set([...data.friends,...ids])];
+    const pending = jinheSesePendingFriends;
+    if (friends.length===data.friends.length && pending?.signature!==snapshot.signature) return true;
+    if (friends.length!==data.friends.length) {
+      if (friends.length>50||!ids.every(id=>data.knownIds.includes(id)||data.presentIds.includes(id))) return false;
+      const next = snapshot.kernel.apply(snapshot.data.stat_data,{type:'edit',patch:{friends}});
+      await snapshot.mvu.replaceMvuData({...snapshot.data,stat_data:next},snapshot.selector);
+      const applied = rawSnapshot();
+      if (applied.chat!==snapshot.chat||applied.id!==snapshot.id||applied.swipe!==snapshot.swipe) return false;
+      jinheSesePendingFriends = {signature:applied.signature,ids};
+    }
+    await ctx.saveChat();
+    jinheSesePendingFriends = null;
+    sendUpdate();
+    return true;
+  });
+}
